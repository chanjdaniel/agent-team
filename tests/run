#!/usr/bin/env bash
# Run the code's checks: shellcheck on every shell script in bin/, tests/ (not the
# vendored bats), servers/ and toolkits/, then the whole bats suite on the vendored bats-core,
# then the toolkit tests (node --test on tests/toolkits/, after servers/install), which need
# Docker for their throwaway MongoDB.
# The bats files run as many at once as the team's CPU budget allows, each in a bats of its own
# (every test is sandboxed, so files share nothing), the slowest first by tests/shards' weights:
# one line per file as it ends, then the whole output of each file that failed, and the count of
# tests passed. How many at once is TEAM_JOBS when set (a whole number above 0, else refused),
# else, when a team home is found, team-capacity jobs (the floor of the level's CPU budget, at
# least 1: 3 at minor on 12 cores), else nproc (CI, a fresh clone).
# Every part but shellcheck alone and a --list (a shard's or --changed's) runs under the
# machine's heavy-run lock (team-heavy run, whose cost sample is heavy:tests-run), so a suite
# waits for another suite or a gate's end-to-end run instead of overlapping it; under a heavy run
# already (TEAM_HEAVY_HELD set, as a local check team-checks runs), it runs at once.
#
# Usage: tests/run [shellcheck|bats [--shard <k>/<n> [--list]|--changed [<base>] [--list]]|toolkits]
#        (default: all three)
# With --shard, bats runs shard k of n of the files as tests/shards splits them, by each file's
# seconds in CI (tests/timings.tsv), as CI's shard jobs do; --list prints that shard's files and
# runs none. A shard with no file (n above the file count) passes, running nothing.
# With --changed, bats runs the files a change reaches, by the repository's naming, from the paths
# changed since <base> (default origin/dev: git diff --name-only --no-renames <base>...HEAD) and in
# the working tree (git status --porcelain, untracked files included), both sides of a rename and
# a deleted path among them, printing them first; it runs nothing, and says so, when no path
# changed, and --list prints them, one tests/<name>.bats per line, and runs none. Every changed
# path reaches tests/repo.bats; one under bin/, roles/, templates/, settings/ or plugins/ also
# tests/coordinator-manual.bats; a script (bin/team-<x>, bin/claude-coordinator, a hook under
# bin/hooks/) its own tests/<script>.bats and tests/<script>-*.bats, every bats file that names it
# as a word, and those of each script under bin/ that names it (a doctor check that names it, what
# a doctor check reaches); bin/lib/doctor.d/* the tests/team-doctor*, team-bootstrap*,
# team-load-check and team-resume files and what bin/team-doctor reaches, which runs every check;
# any other file of bin/lib/ the bats files named after it or naming lib/<it>, and those of each
# file under bin/ that names lib/<it> or, for a .jq module, includes or imports it (a bin/lib file
# through its own users in turn); tests/helpers/<h> the bats files naming helpers/<h> outside a
# comment (a .bash helper without .bash, as load names it), and those of each helper naming it so;
# tests/<f>.bats itself; any other file under tests/ the bats files named after it or naming its
# path; any other path (roles/, templates/, sops/, a root file such as CLAUDE.md) the bats files
# naming it or one of its directories as <dir>/; and every file, bin/lib/team.sh,
# bin/lib/platform.sh, bin/lib/ledger.jq, bin/lib/ledger-contract.json, tests/helpers/common.bash,
# tests/run, tests/shards, tests/fixtures/ or tests/vendor/, and each file under bin/ that team.sh
# or platform.sh reads or runs in its code ($TEAM_LIB/<file>, a bin/ script, a jq include:
# tools.jq, tools.lock, records, guarded, team-project, team-lease and others), which every test
# runs through. Beyond those reads, a whole-suite file's mention of a bin/ file is not followed, or
# most of bin/lib would reach the whole suite. A named base that is no commit is a usage error; a
# missing origin/dev is refused.
# Exit 0 when every check passes; CI runs each part as its own job. The last line is the wall
# time, so a slower suite shows, and when the bats ran, how many files at once.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# The suite needs no team home (every test makes its own), as on CI or a fresh clone.
# shellcheck disable=SC2034 # read by bin/lib/team.sh
team_home_report=1
# shellcheck source=bin/lib/team.sh
source "$root/bin/lib/team.sh" "$@"

usage="usage: tests/run [shellcheck|bats [--shard <k>/<n> [--list]|--changed [<base>] [--list]]|toolkits]"
what=${1:-all} shard='' changed='' base='' list=''
if [[ $what == bats && $# -gt 1 && $2 == --changed ]]; then
  changed=1 base=origin/dev
  rest=("${@:3}")
  if [[ ${#rest[@]} -gt 0 && ${rest[0]} != -* ]]; then base=${rest[0]} rest=("${rest[@]:1}"); fi
  if [[ ${#rest[@]} -gt 0 ]]; then
    [[ ${#rest[@]} -eq 1 && ${rest[0]} == --list ]] || usage_error "$usage"
    list=1
  fi
  if ! git -C "$root" rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
    [[ $# -gt 2 && $3 == "$base" ]] || die "no $base to compare with in $root: fetch it, or name a base (tests/run bats --changed <base>)"
    usage_error "--changed: no commit $base; $usage"
  fi
elif [[ $what == bats && $# -gt 1 ]]; then
  if ! [[ $# -le 4 && $2 == --shard && ${3:-} =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] ||
    ((BASH_REMATCH[1] > BASH_REMATCH[2])); then
    usage_error "$usage"
  fi
  shard=$3
  if [[ $# -eq 4 ]]; then [[ $4 == --list ]] || usage_error "$usage"; list=1; fi
else
  [[ $# -le 1 && $what =~ ^(all|shellcheck|bats|toolkits)$ ]] || usage_error "$usage"
fi

if [[ -n ${TEAM_JOBS:-} && ! $TEAM_JOBS =~ ^[1-9][0-9]*$ ]]; then
  die "TEAM_JOBS is the count of bats files to run at once, a whole number above 0, not '$TEAM_JOBS'"
fi

# Every part but shellcheck alone and a --list runs under the machine's heavy-run lock
# (bin/team-heavy).
if [[ $what != shellcheck && -z $list && -z ${TEAM_HEAVY_HELD:-} ]]; then
  exec "$root/bin/team-heavy" run --label "tests/run ${*:-all} in ${root/#"$HOME"/\~}" --kind tests-run -- "$0" "$@"
fi

# Every file under bin/, tests/, servers/ and toolkits/ that is a shell script by its shebang or
# extension.
shell_scripts() {
  local file
  while IFS= read -r file; do
    if [[ $file == *.sh || $file == *.bash || $file == *.bats ]] ||
      head -n 1 "$file" | grep -Eq '^#!.*\b(ba)?sh\b'; then
      echo "$file"
    fi
  done < <(cd "$root" && find bin tests servers toolkits \( -path tests/vendor -o -path servers/node_modules -o -path 'servers/.*' \) -prune -o -type f -print | sort)
}

# The tests/*.bats files to run, the slowest first (so none of them starts last), one path per
# line: every one, with --shard k/n only shard k's (tests/shards), with --changed only the
# selection's ($selected).
bats_files() {
  local k=1 n=1
  if [[ -n $shard ]]; then k=${shard%/*} n=${shard#*/}; fi
  "$root/tests/shards" "$n" | awk -F'\t' -v k="$k" -v root="$root" -v changed="$changed" -v selected="$selected" '
    BEGIN { n = split(selected, list, "\n"); for (i = 1; i <= n; i++) chosen[list[i]] = 1 }
    $1 == k && (changed == "" || $3 in chosen) { print root "/" $3 }'
}

# The paths --changed starts from (see the header), one per line, relative to the checkout.
changed_paths() {
  local entry
  git -C "$root" diff --name-only --no-renames "$base...HEAD"
  while IFS= read -r -d '' entry; do
    echo "${entry:3}"
    # A rename or copy's entry is followed by its source's path.
    if [[ ${entry:0:2} == *[RC]* ]]; then IFS= read -r -d '' entry && echo "$entry"; fi
  done < <(git -C "$root" status --porcelain=v1 -z --untracked-files=all)
}

# The files the selection reads, from the checkout's root: the bats files that grep "$@" matches,
# the matches of an existing glob, and the files under bin/ a change can reach a script through.
naming() { grep -l "$@" tests/*.bats || (($? == 1)); }
glob() { compgen -G "$1" || true; }
own_files() { glob "tests/$1.bats"; glob "tests/$1-*.bats"; }
bin_files() { find bin -path bin/lib/vendor -prune -o -type f -print; }
doctor_files() {
  glob 'tests/team-doctor*.bats'
  glob 'tests/team-bootstrap*.bats'
  glob 'tests/team-load-check.bats'
  glob 'tests/team-resume.bats'
}
# The files under bin/ that bin/lib/team.sh and platform.sh read or run in their code (not in a
# comment), as $TEAM_LIB/<file>, $TEAM_LIB/../<script>, $(dirname "$TEAM_LIB")/<script> or a jq
# include or import, one path per line: every script that sources the library runs them.
library_reads() {
  grep -hv '^[[:space:]]*#' bin/lib/team.sh bin/lib/platform.sh |
    grep -oE '\$TEAM_LIB/(\.\./)?[A-Za-z0-9._-]+|\$\(dirname "\$TEAM_LIB"\)/[A-Za-z0-9._-]+|(include|import) "[A-Za-z0-9_-]+"' |
    sed -E -e 's#^\$TEAM_LIB/\.\./#bin/#' -e 's#^\$TEAM_LIB/#bin/lib/#' -e 's#^\$\(dirname "\$TEAM_LIB"\)/#bin/#' \
      -e 's#^(include|import) "(.*)"$#bin/lib/\2.jq#' || true
}
declare -A library_read=()
whole_suite() {
  case $1 in
    bin/lib/team.sh | bin/lib/platform.sh | bin/lib/ledger.jq | bin/lib/ledger-contract.json) ;;
    tests/helpers/common.bash | tests/run | tests/shards | tests/fixtures/* | tests/vendor/*) ;;
    *) [[ -n ${library_read[$1]:-} ]] ;;
  esac
}

# A doctor check's: the doctor's, bootstrap's, load check's and resume's bats files, and what
# bin/team-doctor reaches, since every check runs inside it.
doctor_reach() {
  doctor_files
  script_reach bin/team-doctor
}

# A script's bats files: its own and those naming it as a word.
script_files() { own_files "$1" && naming -wF -- "$1"; }

# A script's (bin/team-<x>, bin/claude-coordinator, a hook): its own, and its callers' under bin/.
declare -A script_seen=()
script_reach() {
  local name=${1##*/} caller
  [[ -z ${script_seen[$1]:-} ]] || return 0
  script_seen[$1]=1
  script_files "$name"
  while IFS= read -r caller; do
    if [[ $caller == "$1" ]] || whole_suite "$caller"; then continue; fi
    case $caller in
      bin/lib/doctor.d/*) doctor_reach ;;
      bin/team-* | bin/claude-coordinator | bin/hooks/*) script_files "${caller##*/}" ;;
    esac
  done < <(bin_files | xargs grep -lwF -- "$name" || true)
}

# A bin/lib file's (or directory's, by its first part under bin/lib/): the files named after it
# or naming lib/<it>, and its users' under bin/, each bin/lib one once.
declare -A lib_seen=()
lib_reach() {
  local key=${1#bin/lib/} pattern user
  key=${key%%/*}
  [[ -z ${lib_seen[$key]:-} ]] || return 0
  lib_seen[$key]=1
  pattern="lib/${key//./\\.}([^A-Za-z0-9_-]|\$)"
  own_files "${key%.*}"
  naming -E -- "$pattern"
  [[ $key != *.jq ]] || pattern+="|(include|import) \"${key%.jq}\""
  while IFS= read -r user; do
    if [[ $user == bin/lib/"$key" || $user == bin/lib/"$key"/* ]] || whole_suite "$user"; then continue; fi
    case $user in
      bin/lib/doctor.d/*) doctor_reach ;;
      bin/lib/*) lib_reach "$user" ;;
      *) script_reach "$user" ;;
    esac
  done < <(bin_files | xargs grep -lE -- "$pattern" || true)
}

# A tests/helpers file's: the bats files naming helpers/<it> outside a comment (as `load
# helpers/<it>` does), and those of each helper naming it so.
declare -A helper_seen=()
helper_reach() {
  local key=${1#tests/helpers/} pattern helper
  key=${key%.bash}
  [[ -z ${helper_seen[$key]:-} ]] || return 0
  helper_seen[$key]=1
  pattern="^[^#]*helpers/${key//./\\.}([^A-Za-z0-9_-]|\$)"
  naming -E -- "$pattern"
  while IFS= read -r helper; do
    [[ $helper != "$1" ]] || continue
    if whole_suite "$helper"; then glob 'tests/*.bats'; else helper_reach "$helper"; fi
  done < <(grep -lE -- "$pattern" tests/helpers/*.bash || true)
}

# The bats files one changed path reaches (see the header), one per line, repeats and all.
reach() {
  local dir
  echo tests/repo.bats
  case $1 in
    bin/* | roles/* | templates/* | settings/* | plugins/*) echo tests/coordinator-manual.bats ;;
  esac
  case $1 in
    bin/lib/doctor.d/*) doctor_reach ;;
    bin/lib/*) lib_reach "$1" ;;
    bin/team-* | bin/claude-coordinator | bin/hooks/*) script_reach "$1" ;;
    tests/helpers/*) helper_reach "$1" ;;
    tests/*/*) own_files "$(basename "${1%.*}")"; naming -F -- "$1" ;;
    tests/*.bats) echo "$1" ;;
    tests/*) own_files "$(basename "${1%.*}")"; naming -F -- "$1" ;;
    *)
      naming -F -- "$1"
      dir=$1
      while [[ $dir == */* ]]; do
        dir=${dir%/*}
        naming -F -- "$dir/"
      done ;;
  esac
}

# The bats files --changed runs (see the header), one tests/<name>.bats per line, sorted: every
# one when a changed path is a whole-suite one, none when no path changed.
changed_selection() {
  local paths path
  paths=$(changed_paths | sort -u) || return 1
  cd "$root"
  while IFS= read -r path; do [[ -z $path ]] || library_read[$path]=1; done < <(library_reads)
  while IFS= read -r path; do
    if [[ -n $path ]] && whole_suite "$path"; then
      glob 'tests/*.bats'
      return
    fi
  done <<<"$paths"
  while IFS= read -r path; do
    [[ -z $path ]] || reach "$path"
  done <<<"$paths" | while IFS= read -r path; do
    [[ ! -f $path ]] || echo "$path"
  done
}

# How many bats files run at once (see the header), read once the heavy-run lock is held.
parallelism() {
  if [[ -n ${TEAM_JOBS:-} ]]; then
    echo "$TEAM_JOBS"
  elif [[ -z $TEAM_HOME_PROBLEM && -n $TEAM_HOME && -d $TEAM_HOME ]]; then
    TEAM_HOME=$TEAM_HOME "$root/bin/team-capacity" jobs
  else
    nproc
  fi
}

# The bats files (bats_files), in parallel (see the header); fails if any file fails.
run_bats() {
  local file failed=0 names
  out=$(mktemp -d)
  trap 'rm -rf "$out"' EXIT
  # Each file's output goes to $out/<file>, with $out/<file>.failed beside it when it fails.
  bats_files >"$out/files" || { echo "bats: tests/shards could not split the files"; return 1; }
  if [[ -n $changed ]]; then
    if [[ ! -s $out/files ]]; then
      echo "bats: no path changed since $base, so no file runs"
      return 0
    fi
    echo "bats --changed $base: $(wc -l <"$out/files") of $(find "$root/tests" -maxdepth 1 -name '*.bats' | wc -l) files"
    mapfile -t names <<<"$selected"
    printf '  %s\n' "${names[@]}"
  elif [[ ! -s $out/files ]]; then
    echo "bats: shard $shard has no file"
    return 0
  fi
  # shellcheck disable=SC2016 # expanded by each file's bash
  tr '\n' '\0' <"$out/files" |
    xargs -0 -r -n 1 -P "$jobs" bash -c '
      name=${2##*/} verdict=ok
      "$0/tests/vendor/bats-core/bin/bats" "$2" >"$1/$name" 2>&1 || { verdict="not ok"; touch "$1/$name.failed"; }
      printf "%s tests/%s (%ds)\n" "$verdict" "$name" "$SECONDS"' "$root" "$out"
  for file in "$out"/*.bats; do
    [[ -e $file.failed ]] || continue
    failed=$((failed + 1))
    printf '\n--- tests/%s\n' "${file##*/}"
    cat "$file"
  done
  echo "bats: $(cat "$out"/*.bats | grep -c '^ok ') tests passed; $failed of $(find "$out" -name '*.bats' | wc -l) files failed"
  ((failed == 0))
}

selected=''
if [[ -n $changed ]]; then
  selected=$(changed_selection | LC_ALL=C sort -u) || die "could not read the paths changed since $base"
fi
if [[ -n $list && -n $changed ]]; then
  [[ -z $selected ]] || echo "$selected"
  exit
elif [[ -n $list ]]; then
  files=$(bats_files) || die "tests/shards could not split the files"
  while IFS= read -r file; do [[ -z $file ]] || echo "${file#"$root/"}"; done <<<"$files"
  exit
fi
fail=0 jobs=''
SECONDS=0
if [[ $what == all || $what == shellcheck ]]; then
  mapfile -t scripts < <(shell_scripts)
  echo "shellcheck $(shellcheck --version | sed -n 's/^version: //p'): ${#scripts[@]} scripts"
  (cd "$root" && shellcheck -x "${scripts[@]}") || fail=1
fi
if [[ $what == all || $what == bats ]]; then
  jobs=$(parallelism)
  run_bats || fail=1
fi
if [[ $what == all || $what == toolkits ]]; then
  if "$root/servers/install"; then
    node --test "$root"/tests/toolkits/*.test.mjs || fail=1
  else
    fail=1
  fi
fi
printf 'tests/run %s: %dm %02ds%s\n' "$what" $((SECONDS / 60)) $((SECONDS % 60)) \
  "${jobs:+, up to $jobs bats file$( ((jobs == 1)) || echo s) at once}"
exit $fail
