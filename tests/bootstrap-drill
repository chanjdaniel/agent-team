#!/usr/bin/env bash
# Drive bin/team-bootstrap on a fresh machine as the setup SOP's agent would, for the Bootstrap
# workflow's jobs: run it with no terminal; when it stops for a step needing sudo, play Daniel by
# running that stage in a pseudo-terminal (script), where the runner's sudo asks no password; end
# at the first step only Daniel can take, then print the bootstrap's log.
#
# Usage: tests/bootstrap-drill <machine name>
# Exit 0 when the bootstrap ends at a step of Daniel's in the projects stage or a later one, or set
# up; 1 when it failed on its own, or stopped at a step of Daniel's in an earlier stage, which the
# runner should have got past: the drill plays every earlier step (the name, by --name, and each
# sudo stage, in a pseudo-terminal), so an earlier stop leaves most of the bootstrap unproven.
# Its last line, on every way it ends, is the run's record for team-drill import, which reads it
# from the job's log: "drill-record: machine=<its argument> verdict=<pass, exactly when it exits 0,
# else fail> commit=<the HEAD of its checkout, or unknown> claude=<the first word of claude
# --version, claude looked for on PATH and then in ~/.local/bin, where the bootstrap installs it,
# or none>". It is written with no jq, which a bootstrap that failed early may not have installed,
# and the drill needs no team home, which a runner does not have.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
machine=${1-}
out=''

# The run's record line, from the exit status the drill ends with: drill_record <status>
drill_record() {
  local verdict=fail commit claude=none bin version=''
  (($1 != 0)) || verdict=pass
  commit=$(git -C "$root" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null) || commit=unknown
  bin=$(command -v claude 2>/dev/null) || bin=$HOME/.local/bin/claude
  if [[ -x $bin ]]; then
    if command -v timeout >/dev/null; then
      version=$(timeout 10 "$bin" --version 2>/dev/null </dev/null) || version=''
    else
      version=$("$bin" --version 2>/dev/null </dev/null) || version=''
    fi
    read -r version _ <<<"$version" || true
  fi
  claude=${version:-none}
  echo "drill-record: machine=$machine verdict=$verdict commit=$commit claude=$claude"
}

on_exit() {
  local status=$?
  [[ -z $out ]] || rm -f "$out"
  drill_record "$status"
  exit "$status"
}
trap on_exit EXIT

[[ $# -eq 1 ]] || { echo "usage: tests/bootstrap-drill <machine name>" >&2; exit 2; }
out=$(mktemp)

for round in 1 2 3 4; do
  echo "== round $round: team-bootstrap, as the agent runs it"
  "$root/bin/team-bootstrap" --name "$1" </dev/null | tee "$out" || true
  last=$(tail -n 1 "$out")
  [[ $last =~ ^[a-z]+:\ Daniel:\ in\ your\ own\ terminal\ run\ .*--stage\ ([a-z]+), ]] || break
  echo "== Daniel's terminal: team-bootstrap --stage ${BASH_REMATCH[1]}"
  if [[ $(uname -s) == Darwin ]]; then
    script -q /dev/null "$root/bin/team-bootstrap" --stage "${BASH_REMATCH[1]}"
  else
    script -qec "$root/bin/team-bootstrap --stage ${BASH_REMATCH[1]}" /dev/null
  fi
done

echo "== the installers' log"
tail -n 200 "$HOME/.local/state/agent-team/bootstrap.log" 2>/dev/null || true
echo "== it ended with: $last"
[[ $last =~ ^([a-z]+):\ (Daniel|summary): ]] || exit 1
case ${BASH_REMATCH[1]} in
  projects | config | heartbeat | check) ;;
  *)
    echo "== it stopped at the ${BASH_REMATCH[1]} stage, before the projects stage, which the drill reaches by playing Daniel's earlier steps"
    exit 1
    ;;
esac
