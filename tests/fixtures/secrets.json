{
  "about": "Every secret file the team needs, read by team-secrets; never a value. target is a path under HOME, mode its octal mode, ref the 1Password secret reference of the Document titled with the id in the agent-team vault (op://agent-team/<id>/<file name>), about what it is; enabled false leaves an entry out until it is needed. machine/secrets.md says where each comes from and how to rotate it.",
  "secrets": [
    {
      "id": "discord-bot-env",
      "target": ".claude/channels/discord/.env",
      "mode": "600",
      "ref": "op://agent-team/discord-bot-env/.env",
      "about": "the Discord bot token, from the Discord developer portal"
    },
    {
      "id": "discord-access-json",
      "target": ".claude/channels/discord/access.json",
      "mode": "600",
      "ref": "op://agent-team/discord-access-json/access.json",
      "about": "the Discord plugin's allowlist of who may message the coordinator"
    },
    {
      "id": "conventioner-env",
      "target": "Documents/projects/personal/Conventioner/.env",
      "mode": "600",
      "ref": "op://agent-team/conventioner-env/.env",
      "about": "Conventioner's Docker Compose environment"
    },
    {
      "id": "conventioner-front-end-env",
      "target": "Documents/projects/personal/Conventioner/front-end/.env",
      "mode": "600",
      "ref": "op://agent-team/conventioner-front-end-env/.env",
      "about": "Conventioner's front-end dev server environment"
    },
    {
      "id": "conventioner-back-end-env",
      "target": "Documents/projects/personal/Conventioner/back-end/.env",
      "mode": "600",
      "ref": "op://agent-team/conventioner-back-end-env/.env",
      "about": "Conventioner's back-end dev server environment"
    },
    {
      "id": "hub-env",
      "target": "agent-team/hub/.env",
      "mode": "600",
      "ref": "op://agent-team/hub-env/.env",
      "about": "the hub bot's token, from phase 2",
      "enabled": false
    }
  ]
}
