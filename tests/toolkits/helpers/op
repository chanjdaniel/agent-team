#!/usr/bin/env bash
# A stand-in for the 1Password CLI in the toolkit tests: `op read --no-newline <ref>` and
# `op signout`, driven by files in $OP_STUB_DIR, never by variables (a variable would put the
# value in the launcher's starting environment, which is what the tests look for):
#   value    what `op read` prints, with no newline
#   values/<reference with each / and : replaced by _>
#            what `op read <reference>` prints in place of value, when present, so each
#            reference can have its own (op://vault/item/field reads values/op___vault_item_field)
#   mode     ok (the default), fail (op read fails like a declined prompt), signout-fail
#   calls    appended: one line per call, its arguments and where its stdin points
# It runs no command from PATH, so the tests' spies on cat, head and hostname see only what the
# server itself runs.
set -euo pipefail

dir=${OP_STUB_DIR:?OP_STUB_DIR is not set}
mode=ok
if [[ -f $dir/mode ]]; then mode=$(<"$dir/mode"); fi
# Where stdin points, by what it is rather than through /proc, which macOS has none of.
if [[ /dev/stdin -ef /dev/null ]]; then stdin=/dev/null
elif [[ -p /dev/stdin ]]; then stdin=pipe
elif [[ -t 0 ]]; then stdin=terminal
else stdin=other; fi
echo "$* stdin=$stdin" >>"$dir/calls"

case $1 in
  read)
    [[ $# == 3 && $2 == --no-newline ]] || { echo "[ERROR] op stub: unexpected arguments: $*" >&2; exit 2; }
    if [[ $mode == fail ]]; then
      echo "[ERROR] 2026/10/22 12:00:00 could not read secret '$3': error initializing client: authorization prompt dismissed, please try again" >&2
      exit 1
    fi
    file=$dir/values/${3//[\/:]/_}
    [[ -f $file ]] || file=$dir/value
    IFS= read -r -d '' value <"$file" || true
    printf '%s' "$value"
    ;;
  signout)
    if [[ $mode == signout-fail ]]; then
      echo "[ERROR] 2026/10/22 12:00:00 signout: connection reset" >&2
      exit 1
    fi
    ;;
  *)
    echo "[ERROR] op stub: unknown command $1" >&2
    exit 2
    ;;
esac
