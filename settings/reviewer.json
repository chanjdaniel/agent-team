{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "@TEAM_CODE@/bin/hooks/scratch-only-edits"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(@TEAM_CODE@/bin/team-review-status *)",
      "Bash(@TEAM_CODE@/bin/team-review-comment *)",
      "Bash(@TEAM_CODE@/bin/team-checks *)",
      "Bash(@TEAM_CODE@/bin/team-ci-wait *)"
    ],
    "deny": [
      "Bash(team-post *)",
      "Bash(*/bin/team-post *)",
      "Bash(team-thread wait*)",
      "Bash(*/bin/team-thread wait*)"
    ]
  },
  "skillOverrides": {
    "domain-modeling": "name-only",
    "implement": "off",
    "no-mistakes": "off",
    "prototype": "off",
    "research": "off",
    "resolving-merge-conflicts": "off",
    "simplify": "off",
    "tdd": "name-only",
    "writing-for-agents": "name-only"
  }
}
