{
  "crossSessionInbound": "accept",
  "permissions": {
    "allow": ["mcp__prod-read__*", "Edit(./.scratch/**)"],
    "deny": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent",
      "NotebookEdit",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "SendUserFile",
      "PushNotification",
      "SendFeedback",
      "DesignSync",
      "EnterWorktree",
      "CronCreate",
      "RemoteTrigger",
      "ScheduleWakeup",
      "Read(//proc/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "@TEAM_HOME@/bin/hooks/scratch-only-edits" }]
      },
      {
        "matcher": "^mcp__.*prod-(read|write).*__",
        "hooks": [{ "type": "command", "command": "@TEAM_HOME@/bin/hooks/ops-log", "args": ["@TASK_DIR@"], "onFailure": "block" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*prod-(read|write).*__",
        "hooks": [{ "type": "command", "command": "@TEAM_HOME@/bin/hooks/ops-log", "args": ["@TASK_DIR@"] }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__.*prod-(read|write).*__",
        "hooks": [{ "type": "command", "command": "@TEAM_HOME@/bin/hooks/ops-log", "args": ["@TASK_DIR@"] }]
      }
    ]
  },
  "env": {
    "MCP_TIMEOUT": "120000"
  }
}
