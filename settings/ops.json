{
  "crossSessionInbound": "accept",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "disableBundledSkills": true,
  "disableSkillShellExecution": true,
  "permissions": {
    "allow": ["mcp__prod-read__*", "mcp__vercel-read__*", "Edit(./.scratch/answer.md)"],
    "ask": [
      "mcp__*prod-write*",
      "mcp__prod-write__insert-many",
      "mcp__prod-write__update-many",
      "mcp__prod-write__delete-many",
      "mcp__prod-write__create-index",
      "mcp__prod-write__drop-index",
      "mcp__plugin_prod-write_prod-write__insert-many",
      "mcp__plugin_prod-write_prod-write__update-many",
      "mcp__plugin_prod-write_prod-write__delete-many",
      "mcp__plugin_prod-write_prod-write__create-index",
      "mcp__plugin_prod-write_prod-write__drop-index"
    ],
    "deny": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Read(//proc/**)",
      "Read(**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/scratch-only-edits", "args": [".scratch/answer.md"], "onFailure": "block", "timeout": 30 }]
      },
      {
        "matcher": "^mcp__.*(prod-(read|write)|vercel-read).*__",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/ops-log", "args": ["@TASK_DIR@"], "onFailure": "block", "timeout": 30 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*(prod-(read|write)|vercel-read).*__",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/ops-log", "args": ["@TASK_DIR@"] }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__.*(prod-(read|write)|vercel-read).*__",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/ops-log", "args": ["@TASK_DIR@"] }]
      }
    ]
  },
  "env": {
    "MCP_TIMEOUT": "120000"
  }
}
