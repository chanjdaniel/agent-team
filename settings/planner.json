{
  "permissions": {
    "allow": [
      "Bash(@TEAM_CODE@/bin/team-post @TASK@ --thread interview --file *)",
      "Bash(@TEAM_CODE@/bin/team-thread wait @TASK@)",
      "Bash(@TEAM_CODE@/bin/team-thread wait @TASK@ --after *)",
      "Bash(@TEAM_CODE@/bin/team-tickets @TASK@ --check)"
    ],
    "deny": [
      "Bash(team-post --coordinator*)",
      "Bash(team-post * --coordinator*)",
      "Bash(team-post * --thread task*)",
      "Bash(*/bin/team-post --coordinator*)",
      "Bash(*/bin/team-post * --coordinator*)",
      "Bash(*/bin/team-post * --thread task*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/scratch-only-edits" }]
      }
    ]
  },
  "skillOverrides": {
    "code-review": "off",
    "implement": "off",
    "no-mistakes": "off",
    "resolving-merge-conflicts": "off",
    "security-review": "off",
    "simplify": "off",
    "tdd": "off"
  }
}
