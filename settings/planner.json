{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/scratch-only-edits" }]
      }
    ]
  },
  "skillOverrides": {
    "code-review": "off",
    "implement": "off",
    "no-mistakes": "off",
    "resolving-merge-conflicts": "off",
    "security-review": "off",
    "simplify": "off",
    "tdd": "off"
  }
}
