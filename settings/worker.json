    "find-skills": "off",
    "git-guardrails-claude-code": "off",
    "grilling": "off",
    "init": "off",
    "keybindings-help": "off",
    "lavish": "off",
    "loop": "off",
    "migrate-to-shoehorn": "off",
    "scaffold-exercises": "off",
    "schedule": "off",
    "setup-pre-commit": "off",
    "update-config": "off",
    "wizard": "off"
  },
  "attribution": {
    "commit": ""
  },
  "env": {
    "AGENT_TEAM_ROLE": "@ROLE@",
    "AGENT_TEAM_TASK": "@TASK@",
    "LAVISH_AXI_TELEMETRY": "0",
    "CODEGRAPH_TELEMETRY": "0",
    "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
