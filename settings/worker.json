{
  "enabledPlugins": {
    "discord@claude-plugins-official": false,
    "mongodb-atlas@claude-plugins-official": false
  },
  "disableClaudeAiConnectors": true,
  "isolatePeerMachines": true,
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push origin dev*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:dev*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(*team-lease*--steal*)",
      "Bash(*team-resume*--steal*)",
      "Bash(git push * lease)",
      "Bash(git push * lease *)",
      "Bash(git push *:lease)",
      "Bash(git push *:lease *)",
      "Bash(git push *refs/heads/lease*)",
      "Bash(sudo)",
      "Bash(sudo *)",
      "Bash(claude --bg*)",
      "Bash(claude --background*)",
      "Bash(claude -p*)",
      "Bash(claude --print*)",
      "Bash(claude * --bg*)",
      "Bash(claude * --background*)",
      "Bash(claude * -p*)",
      "Bash(claude * --print*)",
      "Bash(claude agents*)",
      "Bash(claude respawn*)",
      "Bash(*/claude --bg*)",
      "Bash(*/claude --background*)",
      "Bash(*/claude -p*)",
      "Bash(*/claude --print*)",
      "Bash(*/claude * --bg*)",
      "Bash(*/claude * --background*)",
      "Bash(*/claude * -p*)",
      "Bash(*/claude * --print*)",
      "Bash(*/claude agents*)",
      "Bash(*/claude respawn*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git * --no-verify)",
      "Bash(git * --no-verify *)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n -*)",
      "Bash(git *config* core.hooksPath *)",
      "Bash(git *config* core.hookspath *)",
      "Bash(git *config*unset* core.hooksPath*)",
      "Bash(git *config*unset* core.hookspath*)",
      "Bash(git *config* \"core.hooksPath\" *)",
      "Bash(git *config* \"core.hookspath\" *)",
      "Bash(git *config* 'core.hooksPath' *)",
      "Bash(git *config* 'core.hookspath' *)",
      "Bash(git *config*unset* \"core.hooksPath\"*)",
      "Bash(git *config*unset* \"core.hookspath\"*)",
      "Bash(git *config*unset* 'core.hooksPath'*)",
      "Bash(git *config*unset* 'core.hookspath'*)",
      "Bash(git *-c core.hooksPath*)",
      "Bash(git *-c core.hookspath*)",
      "Bash(gh pr merge*)",
      "Bash(gh-axi pr merge*)",
      "Bash(gh api*pulls/*/merge*)",
      "Bash(gh api*git/refs* -X*)",
      "Bash(gh api* -X*git/refs*)",
      "Bash(gh api*git/refs* --method*)",
      "Bash(gh api* --method*git/refs*)",
      "Bash(gh api*git/refs* -f*)",
      "Bash(gh api* -f*git/refs*)",
      "Bash(gh api*git/refs* -F*)",
      "Bash(gh api* -F*git/refs*)",
      "Bash(gh api*git/refs* --field*)",
      "Bash(gh api* --field*git/refs*)",
      "Bash(gh api*git/refs* --raw-field*)",
      "Bash(gh api* --raw-field*git/refs*)",
      "Bash(gh api*git/refs* --input*)",
      "Bash(gh api* --input*git/refs*)",
      "Bash(vercel*)",
      "Bash(*mongodb+srv://*)",
      "Bash(*python* *migrate_user_emails*)",
      "Bash(*th-compose* *migrate_user_emails*)",
      "Bash(*uv run* *migrate_user_emails*)",
      "Bash(op *)",
      "Bash(* op *)",
      "Bash(*op read*)",
      "Bash(*op run*)",
      "Bash(*op item*)",
      "Bash(*op document*)",
      "Bash(*node *start-server.mjs*)",
      "Bash(./*start-server.mjs*)",
      "Bash(/*start-server.mjs*)",
      "Bash(toolkits/*start-server.mjs*)",
      "Bash(*node *mongodb-mcp*)",
      "Bash(./*mongodb-mcp*)",
      "Bash(/*mongodb-mcp*)",
      "Bash(servers/*mongodb-mcp*)",
      "Bash(*npx *mongodb-mcp*)",
      "Bash(*npm exec *mongodb-mcp*)",
      "Bash(*node_modules/.bin/mongodb-mcp*)",
      "Bash(scripts/*start-server.mjs*)",
      "Bash(*&& scripts/*start-server.mjs*)",
      "Bash(*; scripts/*start-server.mjs*)",
      "Bash(env *start-server.mjs*)",
      "Bash(bun *start-server.mjs*)",
      "Bash(deno *start-server.mjs*)",
      "Bash(env *mongodb-mcp*)",
      "Bash(bun *mongodb-mcp*)",
      "Bash(deno *mongodb-mcp*)",
      "Bash(*--plugin-dir*prod-*)",
      "Bash(*--mcp-config*prod-*)",
      "Bash(*team-worker *ops *)",
      "Bash(*team-load-check *ops*)",
      "Bash(*/proc/*/environ*)",
      "Read(//proc/**)"
    ]
  },
  "attribution": {
    "commit": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/lease-fence" }]
      }
    ]
  }
}
