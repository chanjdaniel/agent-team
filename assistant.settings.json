    "domain-modeling": "name-only",
    "fewer-permission-prompts": "off",
    "git-guardrails-claude-code": "off",
    "implement": "off",
    "init": "off",
    "keybindings-help": "off",
    "migrate-to-shoehorn": "off",
    "no-mistakes": "name-only",
    "prototype": "name-only",
    "resolving-merge-conflicts": "name-only",
    "run": "name-only",
    "scaffold-exercises": "off",
    "security-review": "name-only",
    "setup-pre-commit": "off",
    "simplify": "off",
    "tdd": "off"
