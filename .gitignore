# Generated per launch by bin/team-worker
tasks/*/settings.*.json
tasks/*/mcp.*.json
.claude/worktrees/
# The load check's scratch from before it ran in .claude/worktrees/load-check, still on the machines
# that ran it then: drop the line once no machine has it
.claude/load-check/
tasks/T0/
.scratch/

# The ledger's append lock (bin/lib/team.sh)
ledger.jsonl.lock

# The pinned MCP servers' install and its scratch (servers/install)
servers/node_modules/
servers/.staging.*/
servers/.old.*/
servers/.install.lock

# The toolkits' eval runs (claude plugin eval)
toolkits/*/evals/results/
