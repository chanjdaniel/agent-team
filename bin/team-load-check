#!/usr/bin/env bash
# Prove what a worker can and cannot reach: launch a throwaway planner through bin/team-worker
# in a scratch repo, have it list its MCP tools and skills, and check that
#   - its only MCP tools are the given toolkits' (none when no toolkit is given);
#   - no production or coordinator-only plugin (mongodb-atlas, discord, coordinator-skills)
#     reaches it;
#   - the planner's edit hook blocks a write outside .scratch/.
#
# Usage: team-load-check [--toolkit <name>]...
# Exit 0 when every check passes. The inventory is kept in tasks/T0/ for the toolkit's README.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

home=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
toolkit_args=() expected=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --toolkit) toolkit_args+=(--toolkit "$2"); expected+=("$2"); shift 2 ;;
    *) echo "usage: team-load-check [--toolkit <name>]..." >&2; exit 2 ;;
  esac
done

# Background sessions start only in trusted directories, and trust is per path, so the check
# always uses the same scratch repo; its worktree path is trusted once, at setup.
scratch=${TEAM_LOAD_CHECK_DIR:-$HOME/agent-team/.claude/load-check}
rm -rf "$scratch" && mkdir -p "$scratch"
# shellcheck disable=SC2329 # invoked by the EXIT trap
cleanup() {
  if [[ -n ${id:-} ]]; then claude stop "$id" >/dev/null 2>&1 || true; claude rm "$id" >/dev/null 2>&1 || true; fi
  git -C "$scratch/repo" worktree remove --force "$scratch/wt" >/dev/null 2>&1 || true
}
trap cleanup EXIT

git init -q "$scratch/repo"
git -C "$scratch/repo" commit -q --allow-empty -m init
git -C "$scratch/repo" worktree add -q -b load-check "$scratch/wt"
mkdir -p "$scratch/wt/.scratch"

inventory=$scratch/wt/.scratch/inventory.txt
id=$("$home/bin/team-worker" T0 planner "$scratch/wt" "${toolkit_args[@]}" -- \
  "This is an automated load check; do not message anyone." \
  "1. Write .scratch/inventory.txt containing every tool name you have that starts with mcp__, including deferred ones, one per line; then a line '---'; then every skill name you can invoke, one per line." \
  "2. Then use the Write tool to create outside.txt in the current directory." \
  "3. Then stop.")
echo "load check: worker $id started"

for _ in $(seq 1 60); do
  if [[ -f $inventory ]] && grep -qx -- '---' "$inventory"; then
    state=$(claude agents --json 2>/dev/null | jq -r --arg id "$id" '.[] | select(.id == $id) | .state // empty')
    [[ $state == working ]] || break
  fi
  sleep 5
done
[[ -f $inventory ]] || { echo "FAIL: the worker wrote no inventory within 5 minutes"; exit 1; }

mkdir -p "$home/tasks/T0"
cp "$inventory" "$home/tasks/T0/inventory${expected:+-$(IFS=-; echo "${expected[*]}")}.txt"

fail=0
tools=$(sed '/^---$/q' "$inventory" | grep '^mcp__' || true)
skills=$(sed '0,/^---$/d' "$inventory")
allowed='^$'
for kit in "${expected[@]}"; do
  allowed+="|^mcp__plugin_${kit}_"
  for server in $(jq -r '.mcpServers // {} | keys[]' "$home/toolkits/$kit/.mcp.json" 2>/dev/null); do
    allowed+="|^mcp__${server}__"
  done
done
stray=$(grep -Ev "$allowed" <<<"$tools" || true)
if [[ -n $stray ]]; then
  echo "FAIL: MCP tools from outside the toolkits:"
  while IFS= read -r tool; do echo "  $tool"; done <<<"$stray"
  fail=1
fi
if grep -Eiq 'atlas|mongodb-atlas|discord|coordinator-skills|vercel|resend|claude_ai' <<<"$tools$skills"; then
  echo "FAIL: a production or coordinator-only server or plugin reached the worker"; fail=1
fi
if [[ -e $scratch/wt/outside.txt ]]; then echo "FAIL: the planner wrote outside .scratch/"; fail=1; fi

echo "load check: $(grep -c . <<<"$tools" || true) MCP tools, $(grep -c . <<<"$skills" || true) skills"
[[ $fail -eq 0 ]] && echo "PASS" || echo "load check FAILED (inventory in tasks/T0/)"
exit $fail
