#!/usr/bin/env bash
# Take a worker's message to the task's next step: log its events, then hand the work on.
#
# Usage: team-next T<n> [--from <session>] [--sent-back <list>] [--next <NN>] -- '<the worker's message>'
#   --from       the sender, as team-log --from-message takes it, when the message cannot tell it
#   --sent-back  with a DONE findings message, the numbers sent back, logged as the review's sent_back
#   --next       with a builder's DONE <NN>, the ticket to launch next instead of the lowest-numbered
#                ready one; a ticket with a Waits for: line is launched only so
# First every check, each refusal changing nothing (no ledger line, no brief, no launch): the task
# is open (team-open's opened, not closed) and not held (a held with no resumed since), has no ask
# to Daniel that nothing settled yet, and the message reads as team-log --from-message --print
# reads it (its refusal is team-log's, with its exit code).
# Then it logs, through team-log, each of the message's events that the ledger does not already
# hold since the sending worker's launch (the session its events name, else the task's latest
# launch): a ticket-done of the same ticket, a done of the same session, a pr of the same url and
# head, a review of the same head and verdict, any other event with the same fields; so a rerun
# never logs one twice. Each line it prints is one step: "logged <event> <key=value>..." or
# "already logged <event> ...", then the hand-off's.
# The hand-off of a builder's DONE <NN> <sha>... <line>: refused, before anything is logged, when
# the task has no plan-approved; when the same ticket-done (its ticket and shas) is logged already
# and a launch other than an ops session's follows it ("already handed off"); when NN is none of
# team-tickets T<n>'s tickets; when a sha is not a commit the sending builder's worktree's HEAD
# holds; when --next names a ticket that is not ready or waiting once NN is done; or when tickets
# remain of which none is ready, each named with
# what it waits on. Otherwise the next ticket, --next's or the lowest-numbered ready one once NN
# is done, gets team-brief T<n> builder-ticket --set ticket=<NN> --name build-<NN> in its
# project, or, when every ticket is done, builder-deliver --name deliver (its goal from the plan)
# in the sending builder's project; a brief a launch already read is refused, and one no launch
# read (a rerun after a failed launch) is rendered again with --force. The brief is rendered
# before the events are logged, then team-worker T<n> builder launches it in the task's worktree
# of that project with the toolkits of the task's latest builder launch, and the last line is
# "launched T<n>-builder <session id>". A launch that fails is finished by running the same
# command again, which logs nothing twice.
# Any other message is logged, and the last line says it has no hand-off.
# It never posts to Discord, sends a message, merges, approves a plan or answers a question.
# Exit codes: 0 done, 1 refused, 2 a malformed command line; when a script it runs fails, that
# script's own code, 75 (try again later) among them.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

bin=$(dirname "$TEAM_LIB")
usage="usage: team-next T<n> [--from <session>] [--sent-back <list>] [--next <NN>] -- '<the worker's message>'"

[[ $# -ge 1 && $1 =~ ^T[0-9]+$ ]] || usage_error "$usage"
task=$1
shift
log_opts=() next=''
declare -A given=()
while (($#)) && [[ $1 != -- ]]; do
  case $1 in
    --from | --sent-back | --next)
      [[ -z ${given[$1]:-} ]] || usage_error "$1 is given twice"
      [[ $# -ge 2 && -n $2 ]] || usage_error "$1 needs a value"
      given[$1]=1
      if [[ $1 == --next ]]; then
        [[ $2 =~ ^[0-9]{2}$ ]] || usage_error "--next takes a two-digit ticket number, got '$2'"
        next=$2
      else
        log_opts+=("$1" "$2")
      fi
      shift 2
      ;;
    -*) usage_error "unknown option '$1'; $usage" ;;
    *) usage_error "missing '--' before the worker's message; $usage" ;;
  esac
done
[[ ${1:-} == -- ]] || usage_error "missing '--' before the worker's message; $usage"
shift
message="$*"
[[ -n ${message//[[:space:]]/} ]] || usage_error "missing the worker's message; $usage"

# A sibling script of this checkout, with the team home passed explicitly.
sibling() {
  TEAM_HOME=$TEAM_HOME "$bin/$1" "${@:2}"
}

# The task: open, not held, no ask unsettled.
events=$(open_task_events "$task")
problems=$(ledger_jq '[
    if standing("held") then
      (map(select(.event == "held")) | last) as $h | "\($task) is held since \($h.ts): \($h.reason)" else empty end,
    (pending_asks[] | "\($task) has an unanswered ask, \(.id), since \(.ts)")]
  | join("; ")' -r --arg task "$task" <<<"$events")
[[ -z $problems ]] || die "$problems"

# The message's events, as team-log reads them, nothing logged yet.
printed=$(sibling team-log "$task" --from-message "$message" "${log_opts[@]}" --print) || exit
parsed=$(jq -cs . <<<"$printed")

# The message's kind as the hand-off reads it, for what is printed.
kind=$(jq -rn --arg m "$message" '$m | gsub("^\\s+"; "") | [splits("\\s+")] | .[1:3]
  | (.[1] // "") as $sub
  | if .[0] == "DONE" and ($sub | test("^[0-9]{2}$")) then "DONE <NN>"
    elif .[0] == "DONE" and ($sub | IN("review-ready", "merged", "pass", "findings", "gate")) then join(" ")
    else .[0] end')
ticket_done=$(jq -c 'map(select(.event == "ticket-done")) | first' <<<"$parsed")
[[ -z $next || $ticket_done != null ]] || usage_error "--next is taken only with a builder's DONE <NN> message, not $kind"

# Which of the message's events the ledger holds since the sender's launch: each as {event, at},
# at the index of the event that holds it, or null; anchor is the sender's launch's index.
held=$(ledger_jq '. as $events
  | def same($p): .event == $p.event and
      if $p.event == "ticket-done" then .ticket == $p.ticket
      elif $p.event == "done" then .session == $p.session and .role == $p.role
      elif $p.event == "pr" then .url == $p.url and same_head(.head; $p.head)
      elif $p.event == "review" then .verdict == $p.verdict and same_head(.head; $p.head)
      else del(.ts) == ($p | del(.ts)) end;
    ([$parsed[] | .session | strings] | first) as $session
  | ([to_entries[] | select(.value.event == "launch" and ($session == null or .value.session == $session)) | .key] | last // -1) as $anchor
  | {anchor: $anchor,
     events: [$parsed[] | . as $p
       | {event: $p, at: ([range($anchor + 1; $events | length) | select($events[.] | same($p))] | first)}]}' \
  -c --argjson parsed "$parsed" <<<"$events")

# log_events: logs each event the ledger does not hold yet through team-log, printing one line each.
log_events() {
  local count i one name fields
  count=$(jq '.events | length' <<<"$held")
  for ((i = 0; i < count; i++)); do
    one=$(jq -c ".events[$i]" <<<"$held")
    name=$(jq -r .event.event <<<"$one")
    mapfile -d '' -t fields < <(jq -j '.event | del(.ts, .task, .event) | to_entries[]
      | "\(.key)=\(.value | if type == "string" then . else tojson end)\u0000"' <<<"$one")
    if jq -e '.at != null' <<<"$one" >/dev/null; then
      echo "already logged $name ${fields[*]}"
    else
      sibling team-log "$task" "$name" "${fields[@]}" || exit
      echo "logged $name ${fields[*]}"
    fi
  done
}

if [[ $ticket_done == null ]]; then
  log_events
  echo "no hand-off for $kind"
  exit 0
fi

# A builder's DONE <NN>: the next ticket's builder, or the deliverer.
jq -e 'any(.[]; .event == "plan-approved")' <<<"$events" >/dev/null ||
  die "$task has no plan-approved, so no ticket hand-off; approve the plan first (step 3 of the manual)"
ticket=$(jq -r .ticket <<<"$ticket_done")

# Already handed off: the same ticket-done (its ticket and shas) is logged, and a launch follows
# it. Read before the sender, whom team-log takes to be the latest builder, the next one once the
# hand-off launched it.
after=$(ledger_jq '. as $events
  | ([to_entries[] | select(.value.event == "ticket-done" and .value.ticket == $reported.ticket and .value.commits == $reported.commits) | .key] | last) as $at
  | if $at == null then null
    else first($events[$at + 1:][] | select(.event == "launch" and .role != "ops")) // null end' \
  -c --argjson reported "$ticket_done" <<<"$events")
[[ $after == null ]] ||
  die "ticket $ticket is already handed off: $(jq -r --arg task "$task" '"\($task)-\(.role) \(.session) was launched at \(.ts)"' <<<"$after") after its ticket-done"
session=$(jq -r 'map(select(.event == "done")) | first | .session' <<<"$parsed")
launch=$(ledger_jq 'map(select(.event == "launch" and .session == $session)) | last
  | . + {worktree: (.worktree | local_path($home))}' -c --arg session "$session" <<<"$events")

tickets=$(sibling team-tickets "$task" --json) || exit
jq -e --arg t "$ticket" 'any(.[]; .ticket == $t)' <<<"$tickets" >/dev/null ||
  die "$task has no ticket $ticket: its tickets are $(jq -r 'map(.ticket) | sort | if . == [] then "none" else join(", ") end' <<<"$tickets")"

# Every sha is a commit the sending builder's worktree's HEAD holds.
sender_wt=$(jq -r .worktree <<<"$launch")
[[ -d $sender_wt ]] || die "the sending builder's worktree $sender_wt is not on this machine"
while IFS= read -r sha; do
  if ! commit=$(git -C "$sender_wt" rev-parse -q --verify "$sha^{commit}" 2>/dev/null) ||
    ! git -C "$sender_wt" merge-base --is-ancestor "$commit" HEAD 2>/dev/null; then
    die "$sha is not a commit the HEAD of $sender_wt holds, so ticket $ticket is not handed off"
  fi
done < <(jq -r '.commits[]' <<<"$ticket_done")

# The tickets once NN is done, and the next one.
tickets=$(jq -c --arg t "$ticket" 'map(if .ticket == $t then .state = "done" | .session = null else . end)
  | [.[] | select(.state == "done") | .ticket] as $done
  | map(if .state == "blocked" then (.on - $done) as $on
      | if $on == [] then .on = [] | .state = (if .waits_for == null then "ready" else "waiting" end) else .on = $on end
    else . end)
  | sort_by(.ticket)' <<<"$tickets")
waits='def waits: .ticket + " " + .state + ({blocked: " on \(.on | join(", "))", running: " in session \(.session)", waiting: ": \(.waits_for)"}[.state] // "");'
if [[ -n $next ]]; then
  chosen=$(jq -c --arg n "$next" 'map(select(.ticket == $n)) | first' <<<"$tickets")
  [[ $chosen != null ]] || die "--next $next is none of $task's tickets: they are $(jq -r 'map(.ticket) | join(", ")' <<<"$tickets")"
  jq -e '.state == "ready" or .state == "waiting"' <<<"$chosen" >/dev/null ||
    die "--next $next is not ready once $ticket is done: $(jq -r "$waits waits" <<<"$chosen")"
elif jq -e 'all(.[]; .state == "done")' <<<"$tickets" >/dev/null; then
  chosen=deliver
else
  chosen=$(jq -c 'map(select(.state == "ready")) | first' <<<"$tickets")
  [[ $chosen != null ]] ||
    die "tickets remain once $ticket is done, but none is ready: $(jq -r "$waits"' map(select(.state != "done") | waits) | join("; ")' <<<"$tickets"); --next <NN> launches a waiting one"
fi

if [[ $chosen == deliver ]]; then
  template=builder-deliver name=deliver sets=()
  project=$(jq -r '.project // empty' <<<"$launch")
else
  ticket_next=$(jq -r .ticket <<<"$chosen")
  template=builder-ticket name=build-$ticket_next sets=(--set "ticket=$ticket_next")
  project=$(jq -r .project <<<"$chosen")
fi
[[ -n $project ]] || die "the sending builder's launch names no project, so the deliverer has none"
worktree=$(task_worktrees "$task" | jq -r --arg p "$project" 'select(.project == $p) | .worktree' | tail -n 1)
[[ -n $worktree ]] || die "$task has no open worktree in $project"

# The brief: refused when a launch read it, rendered again when none did.
force=()
if [[ -e $TEAM_HOME/tasks/$task/brief-$name.md ]]; then
  used=$(jq -c --arg b "brief-$name" 'map(select(.event == "launch" and .brief == $b)) | last' <<<"$events")
  [[ $used == null ]] ||
    die "brief-$name was launched already ($(jq -r --arg task "$task" '"\($task)-\(.role) \(.session) at \(.ts)"' <<<"$used")), so it is not launched again"
  force=(--force)
fi
toolkits=()
while IFS= read -r kit; do toolkits+=(--toolkit "$kit"); done < <(jq -r 'map(select(.event == "launch" and .role == "builder")) | last | .toolkits[]?' <<<"$events")

brief=$(sibling team-brief "$task" "$template" --project "$project" --name "$name" "${sets[@]}" "${force[@]}") || exit
log_events
echo "brief $brief"
id=$(sibling team-worker "$task" builder "$worktree" "${toolkits[@]}" -- "Read your brief at $brief") || {
  status=$?
  echo "${0##*/}: the launch failed; run the same command again to finish it, which logs nothing twice" >&2
  exit "$status"
}
echo "launched $task-builder $id"
