#!/usr/bin/env bash
# Take a worker's message to the task's next step: log its events, then hand the work on; or start
# a phase's ready tickets' builders, up to its cap (--fill).
#
# Usage: team-next T<n> [--from <session>] [--sent-back <list>] [--relay <id>] [--next <NN>] [--checks <file>]
#                  [--since <file>] [--template rereview|verify] -- '<the worker's message>'
#        team-next T<n> --fill [--next <NN>]
#   --from       the sender, as team-log --from-message takes it, when the message cannot tell it
#   --relay      with an ops session's DONE, the Discord id of the message that relayed its answer,
#                logged as its done's relay, as team-log --from-message takes it
#   --sent-back  with a DONE findings message, required, the numbers sent back (none for none), logged
#                as the review's sent_back; with a DONE pass, the findings it counts that go back
#                before the merge, required while it counts any
#   --next       with a builder's DONE <NN> or --fill, the ticket to launch next (first) instead of
#                the lowest-numbered ready one; a ticket with a Waits for: line is launched only so
#   --fill       launch the ready tickets of the phase being built up to its cap, with no message
#   --checks     with a review launch, the first review's checks file (the reviewer's checks);
#                required when the task has no review yet, refused once it has one
#   --since      with a rereview launch, a file of the coordinator's words, added after the derived
#                since; refused for the first review and for verify
#   --template   with a review launch after the first, rereview or verify instead of the rule's
# First every check, each refusal changing nothing (no ledger line, no brief, no launch): the
# message reads as team-log --from-message --print reads it (its refusal is team-log's, with its
# exit code), and launch_refusal in bin/lib/ledger.jq, the one guard team-worker checks too, takes
# a launch of the role the hand-off launches (a builder for a ticket, a findings round or a stow's
# round, a reviewer for a review, none for a message that launches nothing): the task is open
# ("T<n> is closed", "T<n> is not open: the ledger has no opened event for it"), not on Daniel's
# hold ("T<n> is on Daniel's hold since <since> (<id>): <reason>; only Daniel's word lifts it:
# ..."), and has no ask to Daniel that nothing settled and no launch went past ("T<n> has an
# unanswered ask, <id>, since <ts>"); it takes no --past-ask, so a message refused for an ask is
# logged with team-log --from-message, as the manual says.
# Then it logs, through team-log, each of the message's events that the ledger does not already
# hold since the sending worker's launch (the session its events name, else the task's latest
# launch): a ticket-done of the same ticket, a done of the same session and report (an ops
# session's: of the same report_chars, its relay aside), a pr of the
# same url and head, a review of the same head and verdict, any other event with the same fields;
# so a rerun never logs one twice. Each line it prints is one step: "logged <event> <key=value>..."
# or "already logged <event> ...", then the hand-off's.
# The hand-off of a builder's DONE <NN> <sha>... <line>: refused, before anything is logged, when
# the task has no plan-approved; when the same ticket-done (its ticket and shas) is logged already
# and a launch other than an ops session's follows it ("already handed off"); when NN is none of
# team-tickets T<n>'s tickets; when a sha is not a commit the sending builder's worktree's HEAD
# holds; when --next names a ticket that is not ready or waiting once NN is done, or one of
# another phase than the one being built; or when tickets of that phase remain of which none is
# ready, each named with what it waits on. A ticket's phase is its Phase: line's, else 1
# (team-tickets), and the phase being built is the earliest, up to NN's, with a ticket not done.
# Otherwise the next ticket, --next's or that phase's lowest-numbered ready one once NN is done,
# gets team-brief T<n> builder-ticket --set ticket=<NN> --name build-<NN> in its project; when
# none of NN's phase or an earlier one is left, NN's phase's deliverer gets builder-deliver (its
# goal from the plan) --name deliver, or for a task of more than one phase --name deliver-p<n>
# with tickets set to "every ticket of phase <n> (<its tickets>)", a name a launch already read
# taking -2, -3 and so on, in the sending builder's project; the next phase's first ticket is
# launched by hand, as the first one is. Each is launched as a builder with the toolkits of the
# task's latest builder launch. In a phase whose cap is above 1 (below), a DONE <NN> with tickets of
# its phase left is logged and checked the same way, but its hand-off is --fill's, and none ready
# is no refusal, since others may run; with cap 1 every step above is as it was.
# --fill, with no message, takes the same task checks and needs a plan-approved; it launches the
# ready tickets of the phase being built (the earliest with a ticket not done), as team-tickets
# T<n> --json reads them (its refusal is its own). A phase's cap is the latest plan-approved's
# parallel (team-log), its entry for that phase, the last entry for a later phase, and 1 when the
# latest plan-approved has none, so a later approval without it builds one ticket at a time again.
# Running are the phase's tickets team-tickets calls running, whatever their sessions' state. With
# cap 1, the lowest-numbered ready ticket is launched in the task's worktree, as a DONE <NN>'s
# hand-off launches it (T<n>-builder), when none runs. With a cap above 1, each ready ticket is
# launched in number order while fewer than the cap run, one with no Touches: line only when none
# runs and nothing beside it once it does: team-open --task T<n> --ticket NN (a ticket worktree,
# which a rerun reuses), team-brief T<n> builder-ticket --ticket NN --name build-NN (with --force
# when the brief exists and no launch read it, refused when one did), then team-worker as a builder
# in that worktree (T<n>-builder-NN). --next adds a ready or waiting ticket of that phase first,
# within the cap, refused as with a DONE <NN> ("--next NN is none of T<n>'s tickets: they are ...",
# "is not ready: ...", "is in phase <q>, but phase <p> has tickets not done: ..."). Each line it
# prints is a step: "worktree <path> for ticket NN", "brief <path>", "launched T<n>-builder-NN
# <id>"; then, with ready tickets left unlaunched, "full: <k> of phase <p>'s cap <c> build
# (<tickets>)" (", and NN builds alone (no Touches: line)" when such a ticket runs) "; ready and
# waiting for a slot: <tickets>", each with no Touches: line marked so; having launched nothing
# with none ready, "nothing to launch: <each ticket of the phase not done with what it waits on>",
# or with every ticket done "phase <p>'s tickets are all done: its deliverer comes from the last
# ticket's DONE". A room refusal (exit 75) of team-worker stops the fill, "no room for build-NN:
# the launch said <its last stderr line>; ready and waiting for room: <NN and the tickets after
# it>; run team-next T<n> --fill once there is room", exit 75, and so does a pool with no free
# slot, "no worktree for ticket NN: <team-open's reason>; ..."; the ticket worktree is kept for the
# next fill, and any other failure exits with its code.
# A DONE <NN> whose sender's launch has a ticket (ticket NN's builder in its ticket worktree,
# T<n>-builder-NN; one of another ticket is refused) is integrated, under the lock
# ~/.local/state/agent-team/integrate/T<n>.lock, an exclusive flock waiting TEAM_NEXT_LOCK_SECONDS
# (default 60, a whole number, else exit 2) and, still held then, exit 75 "another team-next is
# integrating a ticket of T<n> (<lock>); run this again". Its checks, in order, change nothing: the
# ticket worktree is on this machine and on its ticket branch (else exit 1); it has no change to a
# tracked file and no untracked file git does not ignore; the message's last sha is its HEAD, and
# every sha is a commit that HEAD holds (else exit 1); that HEAD holds the task branch's tip; the
# task worktree is on the task branch with no change to a tracked file (else exit 1). The second,
# third and fourth print instead the line to send, exit 0: "send to T<n>-builder-NN (<id>): T<n>
# your worktree has uncommitted changes (<files>): ...", "... your DONE NN must list the head you
# tested last, the HEAD of your worktree, <head8>; ...", "... the task branch moved: merge <task
# branch> at <tip8> into your branch, ...". Then the task branch fast-forwards to that head in the
# task worktree, "integrated ticket NN: <task branch> <old8>..<new8> in <task worktree>" ("already
# integrated ..." when it is there, or when the tip holds it, as after a run that ended past its
# fast-forward with another ticket landed on top since, the fourth check then passing); the
# ticket's file and its build notes NN.md and NN-* are copied back from the ticket worktree's task
# directory into the task worktree's, "copied back <path>" each; the message's events are logged,
# the ticket-done with head, the head the ticket landed as (the task branch's new tip but on such a
# rerun); and the ticket worktree is returned (below). Then the lock is released, and the hand-off
# is read again: once the phase's tickets are all done, its deliverer as above, unless a builder
# launch of a deliver brief follows the phase's last ticket-done, "already handed off: <that
# launch>", exit 0; else --fill's, none ready being no refusal. A rerun once the ticket-done is
# logged skips the checks and the logging ("already logged ..."), and goes on from the return; the
# "already handed off" refusal above holds for a DONE from the task worktree only. Nothing is
# pushed: the task branch reaches origin with the deliverer's push.
# Every run, before its hand-off (once its events are logged, or in --fill before it launches),
# returns each open ticket worktree on this machine whose ticket is done (a ticket-done since the
# worktree was given to it and its latest launch there) through team-close T<n> --ticket NN,
# "returned <path> for ticket NN", or, when its builder is still busy (exit 75), "kept <path>:
# <team-close's reason>; the next team-next run of T<n> returns it"; any other failure exits with
# its code.
# The hand-off of a builder's PR <url> (with or without its merged <base> conflicts: line), DONE
# review-ready <sha> or DONE merged <base> <sha> conflicts: <files or none> is a fresh reviewer's
# launch: refused, before anything is logged, when the task has no plan-approved; when the same
# pr (url and head) or done (session and report) is logged already and a reviewer's launch follows
# it with no review since ("already handed off"); and for a DONE, when its sha is not the HEAD of
# the sending builder's worktree. The worktree is the sending builder's, or for a PR the task's
# worktree in the project whose repo holds the PR. With no review logged yet, the brief is
# team-brief T<n> reviewer --name review with --checks as its checks (refused without one), the
# PR's url and head (a PR) or the reported head (review-ready; no pr); after one, it is
# rereview, or verify when the latest review sent findings back and either counted
# none but plain notes or reviewed the head this message reports (a round that only edited the PR
# body), --template choosing instead, and a DONE merged always a rereview; it is named
# rereview-<k>, the lowest k from 2 whose brief no launch read, and takes the PR's url and head (a
# PR) or the reported head (review-ready), the rest derived by team-brief (a DONE merged's head
# from GitHub, and its since naming the merge's conflicted files), --since added after the
# derived since. Each of these briefs names the instruction and settings files its head changes
# against the base, team-brief's instruction_files; a brief team-brief refuses (that list
# unreadable, say, or exit 75 on an unreachable origin) logs and launches nothing, with its exit
# code. It launches as a reviewer with the toolkits of the task's latest reviewer launch, else of
# its latest builder launch.
# A reviewer's DONE pass or DONE findings launches nothing: refused, before anything is logged,
# when the task has no plan-approved, a DONE findings without --sent-back, a pass that counts a
# blocking, correctness, security, real-data or note-change finding with no --sent-back list of
# them (they go back before the merge, so it prints no merge line), and a pass whose PR head on
# GitHub (team-state T<n> --json) is not the reviewed head, naming both (exit 75 when GitHub
# cannot be read). Once the review and its done are logged, the last line is what is
# left for the coordinator, the holder being the task's latest builder launch, under 250k while
# team-state reads its context under 250,000 tokens or none, and gone when its session is not
# live. For a pass on a PR: "merge ask: <full PR URL> at <head>, agent-review <state>, checks
# green" (or the failing, pending and missing checks), "merge pre-approved: run team-merge T<n> for
# ..." instead while team-state's plan-time approval stands, or "merge on the standing word: run
# team-merge T<n> for ..." while it does not and a standing word of Daniel's stands for the PR's
# project (team-state's pr.standing_word, null for the team's own project), the review found no
# guarded area and no review of the task counted a security or real-data finding or logged no
# counts (which team-merge refuses both words for), each guarded area and such review named with
# the word it holds back, and the before notes to queue as follow-ups; for a PR behind its base,
# "merge base: ..." instead, read with base_merge in the project's primary checkout once the PR's
# branch and the base are fetched there:
# "run team-catch-up T<n>, which needs no rereview" when the reviewed head merges the base cleanly,
# then "then, once the checks pass on its merge: " and the merge line above for the reviewed head
# with no checks (its guarded areas, risky reviews and before notes as they are), else the
# builder-merge-base brief for the holder under 250k, else a fresh builder, after the
# holder's STOW when it is live, with "conflicts on <files>" after the behind count for a conflict,
# or "(whether the merge is clean is not known: <why>)" when the fetch or git fails. For a pass
# with no PR (a review-ready, a gated or Disclosure task's, or a later phase's whose earlier PR
# GitHub says is merged), the message telling the holder to go on with its delivery. For findings,
# or a pass that sent some
# back (which team-log logs as findings): the message for the holder under 250k (its name, the
# findings sent back and the findings file the message names, for a pass the newest of review.md
# and rereview*.md in the holder's task directory, as team-brief derives a round's, and that
# each is fixed as narrowly as it asks, a fix reaching shapes it does not name a T<n> QUESTION
# first), else the T<n> STOW to send it (after recovering it when gone), or no hand-off when
# nothing was sent back.
# The churn rule: when this review sent back a finding its widening= marks (one in what the last
# fix added), the task's previous review (the latest before this one, on a rerun the latest
# before the line that holds it) sent back one of its own, and every finding this one sent back
# outside its widening may be a plain note, the last line is instead "churn: findings <W> of the
# review of <head> sit in what the fix since the last review added, as findings <P> of the
# review of <previous head> did: decide whether to narrow them (the holder makes each a
# documented limit in the code's header instead of widening the fix, and the next rereview's
# --since says so), revert the fix that widened, or run one more round: <the line above>", each
# list's numbers sent back and each head's first 8 characters; with
# "the review found guarded areas <them>, so ask Daniel with team-ask T<n> <an id> --file <the
# question>" for decide when its guarded names guardrails, permissions or secrets. Nothing is
# launched either way. Its documented limit: the counts do not say which number is which kind,
# so a sent-back finding outside widening is taken as a plain note only when the review counts
# no blocking, correctness, security or real-data finding, and a round whose serious findings
# are all widening but which sends back a plain note outside it is a plain fix round. A verify
# review, or a first review, marks no widening, so either breaks a chain, and so does a phase's
# first review, which follows a pass.
# A PAUSED stowed (its reason the word stowed, alone or with more after it) while the latest
# review sent findings back, with no launch since
# it but an ops session's, launches the fix round: team-brief T<n> builder-round --name
# round-<k>, the lowest k from 1 whose brief no launch read, every fact derived (the findings,
# the newest findings file, the PR and the plan's goal), in the project of the task's latest
# builder launch, as a builder with its toolkits; any other PAUSED stowed has no hand-off.
# A ticket's brief is refused when a launch already read it (the deliverer, round and rereview
# names take the next free one instead), and each brief is rendered again with --force when none
# did (a rerun after a failed launch). The brief is rendered before the events
# are logged, then team-worker launches it, and the last line is "launched T<n>-<role> <session
# id>". A launch that fails is finished by running the same command again, which logs nothing
# twice.
# Any other message is logged, and the last line says it has no hand-off: an ops session's DONE
# among them, whatever its first word, which team-log logs as its length and never its text, as
# it does the ops session's QUESTION.
# It never posts to Discord, sends a message, merges, approves a plan or answers a question.
# Refused, exit 1, before it reads or changes anything: a worker session (an AGENT_TEAM_ROLE but
# coordinator; worker_refusal in bin/lib/team.sh), in every form; --help still answers.
# Exit codes: 0 done, 1 refused, 2 a malformed command line; when a script it runs fails, that
# script's own code, 75 (try again later) among them.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
why=$(worker_refusal "" "runs no team-next") && die "$why"

bin=$(dirname "$TEAM_LIB")
usage="usage: team-next T<n> [--from <session>] [--sent-back <list>] [--relay <id>] [--next <NN>] [--checks <file>] [--since <file>] [--template rereview|verify] -- '<the worker's message>' | team-next T<n> --fill [--next <NN>]"

[[ $# -ge 1 && $1 =~ ^T[0-9]+$ ]] || usage_error "$usage"
task=$1
shift
log_opts=() next='' checks='' since='' template_opt='' fill=''
declare -A given=()
while (($#)) && [[ $1 != -- ]]; do
  case $1 in
    --fill)
      [[ -z $fill ]] || usage_error "--fill is given twice"
      fill=1
      shift
      ;;
    --from | --sent-back | --relay | --next | --checks | --since | --template)
      [[ -z ${given[$1]:-} ]] || usage_error "$1 is given twice"
      [[ $# -ge 2 && -n $2 ]] || usage_error "$1 needs a value"
      given[$1]=1
      case $1 in
        --next)
          [[ $2 =~ ^[0-9]{2}$ ]] || usage_error "--next takes a two-digit ticket number, got '$2'"
          next=$2
          ;;
        --relay)
          [[ $2 =~ ^[1-9][0-9]{0,18}$ ]] || usage_error "--relay takes the Discord id of the relay's message, got '$2'"
          log_opts+=("$1" "$2")
          ;;
        --checks) checks=$2 ;;
        --since) since=$2 ;;
        --template)
          [[ $2 == rereview || $2 == verify ]] || usage_error "--template takes rereview or verify, got '$2'"
          template_opt=$2
          ;;
        *) log_opts+=("$1" "$2") ;;
      esac
      shift 2
      ;;
    -*) usage_error "unknown option '$1'; $usage" ;;
    *) usage_error "missing '--' before the worker's message; $usage" ;;
  esac
done
if [[ -n $fill ]]; then
  [[ $# -eq 0 ]] || usage_error "--fill takes no message; $usage"
  for opt in "${!given[@]}"; do
    [[ $opt == --next ]] || usage_error "--fill takes only --next, not $opt; $usage"
  done
  message=''
else
  [[ ${1:-} == -- ]] || usage_error "missing '--' before the worker's message; $usage"
  shift
  message="$*"
  [[ -n ${message//[[:space:]]/} ]] || usage_error "missing the worker's message; $usage"
fi

# A sibling script of this checkout, with the team home passed explicitly.
sibling() {
  TEAM_HOME=$TEAM_HOME "$bin/$1" "${@:2}"
}

events=$(task_event_array "$task")

# The message's events, as team-log reads them, nothing logged yet: one compact object a line,
# joined into one array; --fill has none.
parsed='[]'
if [[ -z $fill ]]; then
  printed=$(sibling team-log "$task" --from-message "$message" "${log_opts[@]}" --print) || exit
  parsed_lines=()
  while IFS= read -r line; do [[ -z $line ]] || parsed_lines+=("$line"); done <<<"$printed"
  printf -v parsed '%s,' "${parsed_lines[@]}"
  parsed="[${parsed%,}]"
fi

# same($p): whether the event is the parsed event $p, as a rerun finds it logged.
same_def='def same($p): .event == $p.event and
  if $p.event == "ticket-done" then .ticket == $p.ticket
  elif $p.event == "done" then .session == $p.session and .role == $p.role and .report == $p.report
    and .report_chars == $p.report_chars
  elif $p.event == "pr" then .url == $p.url and same_head(.head; $p.head)
  elif $p.event == "review" then .verdict == $p.verdict and same_head(.head; $p.head)
  else del(.ts) == ($p | del(.ts)) end;'

# In one jq run over the task's events and the message's:
# - kind: the message's kind as the hand-off reads it, for what is printed. A PAUSED stowed is the
#   answer to a STOW: its paused event's cause is stow (park_cause in bin/lib/ledger.jq: the word
#   stowed, alone or followed by more, "stowed, handoff.md written").
# - back: the findings a pass counts that go back before the merge, as text, or nothing.
# - held: which of the message's events the ledger holds since the sender's launch, each as
#   {event, at}, at the index of the event that holds it, or null; anchor is the sender's launch's
#   index.
# - briefs: the briefs the task's launches read, one name a line (brief_launched).
# - builder_kits, reviewer_kits: the toolkits of the task's latest launch of that role, else of its
#   latest builder launch, one a line (hand_off).
# - sender_wt, launch_project, sender_ticket, sender_session: the worktree, as a local path, the
#   project, the ticket (a ticket worktree's builder's) and the session of the launch of the session
#   the parsed done names (a launch of null's when it names none).
# - review: the message's review, or null.
# - latest: the task's latest review, or null.
launch_def='def sender_launch: ($parsed | map(select(.event == "done")) | first | .session | tostring) as $session
  | map(select(.event == "launch" and .session == $session)) | last
  | . + {worktree: (.worktree | local_path($home))};'
held_prog="$same_def"' . as $events
  | ([$parsed[] | .session | strings] | first) as $session
  | ([to_entries[] | select(.value.event == "launch" and ($session == null or .value.session == $session)) | .key] | last // -1) as $anchor
  | {anchor: $anchor,
     events: [$parsed[] | . as $p
       | {event: $p, at: ([range($anchor + 1; $events | length) | select($events[.] | same($p))] | first)}]}'
kind='' back='' held='' briefs='' builder_kits='' reviewer_kits='' sender_wt='' launch_project=''
sender_ticket='' sender_session='' review='' latest=''
json_vars --ledger kind='$message | gsub("^\\s+"; "") | [splits("\\s+")] | .[1:3]
  | (.[1] // "") as $sub
  | if .[0] == "DONE" and any($parsed[]; .event == "done" and .role == "ops") then "DONE"
    elif .[0] == "DONE" and ($sub | test("^[0-9]{2}$")) then "DONE <NN>"
    elif .[0] == "DONE" and ($sub | IN("review-ready", "merged", "pass", "findings", "gate")) then join(" ")
    else .[0] end
  | if . == "PAUSED" and any($parsed[]; .event == "paused" and park_cause == "stow")
    then "PAUSED stowed" else tostring end' \
  back='$parsed | map(select(.event == "review")) | first | select((.sent_back // []) == [])
    | [(.findings // {}) as $f | "blocking", "correctness", "security", "real-data", "note-change"
        | select(($f[.] // 0) > 0) | {kind: ., n: $f[.]}]
    | select(. != []) | (map(.n) | add) as $total
    | map("\(.n) \(.kind)") | (if length < 2 then join("") else "\(.[:-1] | join(", ")) and \(.[-1])" end)
    | "\(.) finding\(if $total == 1 then ", which goes" else "s, which go" end) back"' \
  held="$held_prog" \
  briefs='[.[] | select(.event == "launch") | .brief | strings] | join("\n")' \
  builder_kits='map(select(.event == "launch" and .role == "builder")) | last | [.toolkits[]?] | join("\n")' \
  reviewer_kits='(map(select(.event == "launch" and .role == "reviewer")) | last)
    // (map(select(.event == "launch" and .role == "builder")) | last) | [.toolkits[]?] | join("\n")' \
  sender_wt="$launch_def sender_launch | .worktree | tostring" \
  launch_project="$launch_def sender_launch | .project // empty" \
  sender_ticket="$launch_def sender_launch | .ticket // empty" sender_session="$launch_def sender_launch | .session // empty" \
  review='$parsed | map(select(.event == "review")) | first | tojson' latest='map(select(.event == "review")) | last | tojson' \
  -- --arg message "$message" --argjson parsed "$parsed" <<<"$events"

# Whether a launch of the task read brief-<name>: brief_launched <name>
brief_launched() {
  [[ $'\n'$briefs$'\n' == *$'\n'"brief-$1"$'\n'* ]]
}
case $kind in
  "DONE <NN>") handoff=ticket ;;
  PR | "DONE review-ready" | "DONE merged") handoff=review ;;
  "DONE pass" | "DONE findings") handoff=verdict ;;
  "PAUSED stowed") handoff=round ;;
  *) handoff=none ;;
esac
[[ -z $fill ]] || handoff=fill
[[ -z $next || $handoff == ticket || $handoff == fill ]] || usage_error "--next is taken only with a builder's DONE <NN> message, not $kind"
for opt in --checks --since --template; do
  [[ -z ${given[$opt]:-} || $handoff == review ]] ||
    usage_error "$opt is taken only with a builder's PR, DONE review-ready or DONE merged message, not $kind"
done
[[ $kind != "DONE findings" || -n ${given[--sent-back]:-} ]] ||
  die "a DONE findings needs --sent-back <list>, the numbers that go back to the builder (none for no fix round)"

# The task takes a launch of the role the hand-off launches, or with none a message, by the one
# guard team-worker checks (launch_refusal): open, not on Daniel's hold, no ask open.
case $handoff in
  ticket | round) launch_role=builder ;;
  review) launch_role=reviewer ;;
  verdict) if [[ $kind == "DONE findings" ]]; then launch_role=builder; else launch_role=''; fi ;;
  *) launch_role='' ;;
esac
refusal=''
json_vars --ledger refusal='[launch_refusal($task; $role; [])] | join("; ")' -- --arg task "$task" --arg role "$launch_role" <<<"$events"
[[ -z $refusal ]] || die "$refusal"
# A pass that counts a finding which goes back before the merge (a blocking, correctness, security
# or real-data one, or a plain note on a changed line) takes --sent-back with them, never a merge.
if [[ $kind == "DONE pass" ]]; then
  [[ -z $back ]] ||
    die "the pass counts $back to the builder before the merge (step 5), so there is no merge yet: run it again with --sent-back <their numbers>, and the round goes as a DONE findings' does, through the holder or builder-round"
fi

# log_events: logs each event the ledger does not hold yet through team-log, printing one line each,
# then returns the done tickets' worktrees (return_done_tickets); a second call does nothing.
# Each event is read as its kind, whether it is held, its count of fields and its key=value
# fields, NUL-separated, in one jq run.
events_logged=''
log_events() {
  local records i n name fields
  [[ -z $events_logged ]] || return 0
  events_logged=1
  mapfile -d '' -t records < <(jq -j '.events[] | [.event.event, (if .at != null then "held" else "" end),
    (.event | del(.ts, .task, .event) | to_entries | length | tostring),
    (.event | del(.ts, .task, .event) | to_entries[] | "\(.key)=\(.value | if type == "string" then . else tojson end)")][]
    | . + "\u0000"' <<<"$held")
  for ((i = 0; i < ${#records[@]}; i += 3 + n)); do
    name=${records[i]} n=${records[i + 2]}
    fields=("${records[@]:i+3:n}")
    if [[ -n ${records[i + 1]} ]]; then
      echo "already logged $name ${fields[*]}"
    else
      sibling team-log "$task" "$name" "${fields[@]}" || exit
      echo "logged $name ${fields[*]}"
    fi
  done
  return_done_tickets
}

# sibling_said <prefix> <script> <arg>...: run the sibling <script> with its stderr passed
# through, setting out to its stdout, rc to its exit code and said to the last line of its stderr
# that starts with <prefix> (with an empty prefix, its last line that is not blank), or nothing.
sibling_said() {
  local prefix=$1 err
  err=$(mktemp)
  rc=0
  out=$(sibling "${@:2}" 2>"$err") || rc=$?
  cat -- "$err" >&2
  said=$(awk -v p="$prefix" 'NF && (p == "" || index($0, p) == 1) { l = $0 } END { print l }' "$err")
  rm -f -- "$err"
}

# return_ticket <NN> <worktree>: ticket NN's worktree returned through team-close --ticket, its
# stderr passed through; a 75 (its builder still busy) keeps it for the next run, any other failure
# exits with its code.
return_ticket() {
  local rc out said
  sibling_said 'team-close: ' team-close "$task" --ticket "$1"
  said=${said:-team-close: it gave no reason}
  if ((rc == 0)); then
    echo "returned $2 for ticket $1"
  elif ((rc == 75)); then
    echo "kept $2: ${said#team-close: }; the next team-next run of $task returns it"
  else
    exit "$rc"
  fi
}

# return_done_tickets: returns each open ticket worktree on this machine whose ticket is done (a
# ticket-done of it after the worktree was given to it and after its latest launch there), once a
# run, over the ledger as it is now.
tickets_returned=''
return_done_tickets() {
  local now n path
  [[ -z $tickets_returned ]] || return 0
  tickets_returned=1
  ledger_jq 'any(open_worktrees(.[]; $home); .ticket != null)' -e <<<"$events" >/dev/null || return 0
  now=$(task_event_array "$task")
  while IFS=$'\t' read -r n path; do
    [[ -z $n || ! -d $path ]] || return_ticket "$n" "$path"
  done < <(ledger_jq '. as $events | to_entries as $all
    | open_worktrees(.[]; $home) | select(.ticket != null) | . as $w
    | ([$all[] | select((.value.event | IN("worktree-added", "worktree-moved", "rehomed"))
        and .value.project == $w.project and .value.ticket == $w.ticket) | .key] | last // -1) as $given
    | ([$all[] | select(.value.event == "launch" and .value.ticket == $w.ticket) | .key] | last // -1) as $ran
    | select(any($all[]; .value.event == "ticket-done" and .value.ticket == $w.ticket
        and .key > $given and .key > $ran))
    | [.ticket, .worktree] | @tsv' -r <<<"$now")
}

# brief_force <name>: refuses brief-<name> when a launch read it, and sets force to --force when it
# exists and none did (a rerun after a failed launch), else to nothing.
brief_force() {
  local used
  force=()
  [[ -e $TEAM_HOME/tasks/$task/brief-$1.md ]] || return 0
  if brief_launched "$1"; then
    used=$(jq -r --arg b "brief-$1" --arg task "$task" 'map(select(.event == "launch" and .brief == $b)) | last
      | "\($task)-\(.role) \(.session) at \(.ts)"' <<<"$events")
    die "brief-$1 was launched already ($used), so it is not launched again"
  fi
  force=(--force)
}

# hand_off <role> <template> <name> <project> <worktree> [<team-brief option>...]: renders the
# brief (refused when a launch read it, with --force when one exists that none did), logs the
# events, and launches <role> in <worktree> with the toolkits of the task's latest launch of
# <role>, else of its latest builder launch.
hand_off() {
  local role=$1 template=$2 name=$3 project=$4 worktree=$5 force=() toolkits=() kit kits brief id status
  brief_force "$name"
  case $role in builder) kits=$builder_kits ;; *) kits=$reviewer_kits ;; esac
  while IFS= read -r kit; do [[ -z $kit ]] || toolkits+=(--toolkit "$kit"); done <<<"$kits"

  brief=$(sibling team-brief "$task" "$template" --project "$project" --name "$name" "${@:6}" "${force[@]}") || exit
  log_events
  echo "brief $brief"
  id=$(sibling team-worker "$task" "$role" "$worktree" "${toolkits[@]}" -- "Read your brief at $brief") || {
    status=$?
    echo "${0##*/}: the launch failed; run the same command again to finish it, which logs nothing twice" >&2
    exit "$status"
  }
  echo "launched $task-$role $id"
}

# project_worktree <project>: the task's own open worktree in <project> (never a ticket worktree),
# or a refusal.
project_worktree() {
  local worktree
  worktree=$(ledger_jq '[open_worktrees(.[]; $home) | select(.project == $p and .ticket == null)] | last
      | select(. != null) | .worktree | tostring' -r --arg p "$1" <<<"$events")
  [[ -n $worktree ]] || die "$task has no open worktree in $1"
  echo "$worktree"
}

# A ticket's state with what it waits on, as the hand-offs name it: "02 blocked on 01".
waits='def waits: .ticket + " " + .state + ({blocked: " on \(.on | join(", "))", running: " in session \(.session)", waiting: ": \(.waits_for)"}[.state] // "");'

# The plan's caps, the latest plan-approved's parallel, 1 when it has none; cap_of <phase>: that
# phase's, the last one for a later phase, refused when the caps are malformed (a hand-edited line).
caps=$(jq -r 'map(select(.event == "plan-approved")) | last | .parallel // "1" | tostring' <<<"$events")
cap_of() {
  local -a list
  [[ $caps =~ ^[1-3](,[1-3])*$ ]] ||
    die "$task's latest plan-approved has parallel '$caps', which is not a cap from 1 to 3 per phase joined by commas; log the approval again with team-log $task plan-approved by=<who> parallel=<caps>"
  IFS=, read -ra list <<<"$caps"
  if (($1 <= ${#list[@]})); then echo "${list[$1 - 1]}"; else echo "${list[-1]}"; fi
}

# launch_ticket <NN> <project> <cap> <the tickets waiting after it>: ticket NN's builder, at cap 1 in
# the task's worktree as today's hand-off launches it, else in a ticket worktree of its own
# (team-open --task T<n> --ticket NN, which a rerun reuses) on team-brief --ticket; a room refusal
# (exit 75) of team-open or team-worker stops the fill, naming NN and the tickets after it.
launch_ticket() {
  local n=$1 project=$2 cap=$3 rest=$4 name=build-$1 force=() toolkits=() kit worktree opened brief id rc out said
  local session=$task-builder
  brief_force "$name"
  while IFS= read -r kit; do [[ -z $kit ]] || toolkits+=(--toolkit "$kit"); done <<<"$builder_kits"
  if ((cap == 1)); then
    worktree=$(project_worktree "$project") || exit
    brief=$(sibling team-brief "$task" builder-ticket --project "$project" --name "$name" --set "ticket=$n" "${force[@]}") || exit
  else
    # Its reason, the last line it starts with its name (a full pool's list of slots follows it).
    sibling_said 'team-open: ' team-open --task "$task" --ticket "$n"
    opened=$out said=${said:-team-open: it gave no reason}
    if ((rc == 75)); then
      echo "${0##*/}: no worktree for ticket $n: ${said%:}; ready and waiting for room: $n$rest; run team-next $task --fill once there is room" >&2
      exit 75
    fi
    ((rc == 0)) || exit "$rc"
    worktree=$(jq -r .worktree <<<"$opened")
    echo "worktree $worktree for ticket $n"
    brief=$(sibling team-brief "$task" builder-ticket --ticket "$n" --project "$project" --name "$name" "${force[@]}") || exit
    session+=-$n
  fi
  echo "brief $brief"
  sibling_said '' team-worker "$task" builder "$worktree" "${toolkits[@]}" -- "Read your brief at $brief"
  id=$out said=${said:-it printed nothing}
  if ((rc == 75)); then
    echo "${0##*/}: no room for $name: the launch said $said; ready and waiting for room: $n$rest; run team-next $task --fill once there is room" >&2
    exit 75
  elif ((rc != 0)); then
    echo "${0##*/}: the launch failed; run the same command again to finish it, which logs nothing twice" >&2
    exit "$rc"
  fi
  echo "launched $session $id"
}

# fill: launches, in number order (--next's first), each ready ticket of the phase being built (the
# earliest with a ticket not done) while fewer than its cap run, as the header says, printing one
# line a step and, when it launched nothing or tickets wait, the line that says why.
fill() {
  local tickets phase building cap problem open running_tsv candidates_tsv n alone project k=0 c
  local -a running=() waiting=() todo=() todo_projects=() bare=() launched=()
  tickets=$(sibling team-tickets "$task" --json) || exit
  json_vars phase='.phase' building='.building' problem='.problem' open='.open' \
    running_tsv='[.running[] | [.ticket, .alone] | @tsv] | join("\n")' \
    candidates_tsv='[.candidates[] | [.ticket, .alone, .project] | @tsv] | join("\n")' \
    <<<"$(jq -c --arg n "$next" --arg task "$task" "$waits"'
    def ph: .phase // 1;
    ([.[] | select(.state != "done") | ph] | min) as $b
    | ($b // ([.[] | ph] | max) // 1) as $p
    | (map(select(.ticket == $n)) | first) as $nx
    | ([sort_by(.ticket)[] | select(.state != "done" and ph == $p) | waits] | join("; ")) as $open
    | {phase: $p, building: $b, open: $open,
       problem: (if $n == "" then null
         elif $nx == null then "--next \($n) is none of \($task)'"'"'s tickets: they are \(map(.ticket) | sort | join(", "))"
         elif ($nx.state | IN("ready", "waiting") | not) then "--next \($n) is not ready: \($nx | waits)"
         elif ($nx | ph) != $b then "--next \($n) is in phase \($nx | ph), but phase \($b) has tickets not done: \($open)"
         else null end),
       running: [sort_by(.ticket)[] | select(.state == "running" and ph == $p) | {ticket, alone: (.touches == null)}],
       candidates: ([$nx | select(. != null)] + [sort_by(.ticket)[] | select(.state == "ready" and ph == $p)]
         | reduce .[] as $t ([]; if any(.[]; .ticket == $t.ticket) then . else . + [$t] end)
         | map({ticket, alone: (.touches == null), project}))}' <<<"$tickets")"
  [[ -z $problem ]] || die "$problem"
  cap=$(cap_of "$phase") || exit
  return_done_tickets
  alone=''
  while IFS=$'\t' read -r n c; do
    [[ -n $n ]] || continue
    running+=("$n") k=$((k + 1))
    if ((cap > 1)) && [[ $c == true && -z $alone ]]; then alone=$n; fi
  done <<<"$running_tsv"
  while IFS=$'\t' read -r n c project; do
    [[ -z $n ]] || { todo+=("$n") bare+=("$c") todo_projects+=("$project"); }
  done <<<"$candidates_tsv"

  local i j rest note
  for ((i = 0; i < ${#todo[@]}; i++)); do
    n=${todo[i]} note=''
    ((cap == 1)) || [[ ${bare[i]} != true ]] || note=" (no Touches: line, so it builds alone)"
    if [[ -n $alone ]] || ((k >= cap)) || [[ -n $note && $k -gt 0 ]]; then
      waiting+=("$n$note")
      continue
    fi
    rest=''
    for ((j = i + 1; j < ${#todo[@]}; j++)); do rest+=", ${todo[j]}"; done
    launch_ticket "$n" "${todo_projects[i]}" "$cap" "$rest"
    launched+=("$n") running+=("$n") k=$((k + 1))
    [[ -z $note ]] || alone=$n
  done

  if ((${#waiting[@]})); then
    local built
    built=$(printf '%s\n' "${running[@]}" | sort | paste -sd, - | sed 's/,/, /g')
    printf -v rest '%s, ' "${waiting[@]}"
    echo "full: $k of phase $phase's cap $cap build ($built)${alone:+, and $alone builds alone (no Touches: line)}; ready and waiting for a slot: ${rest%, }"
  elif ((${#launched[@]} == 0)); then
    if [[ -z $building ]]; then
      echo "phase $phase's tickets are all done: its deliverer comes from the last ticket's DONE"
    else
      echo "nothing to launch: $open"
    fi
  fi
}

# A stow hands a round on only while the latest review (findings, or a pass logged before team-log made it so)
# sent findings back and no launch (an ops session's aside) has taken them since.
if [[ $handoff == round ]] && ! jq -e '(to_entries | map(select(.value.event == "review")) | last) as $r
    | $r != null and ($r.value.sent_back // []) != []
      and (any(.[$r.key + 1:][]; .event == "launch" and .role != "ops") | not)' <<<"$events" >/dev/null; then
  log_events
  echo "no hand-off for $kind: no review's sent-back findings wait for a round"
  exit 0
fi

if [[ $handoff == none ]]; then
  log_events
  echo "no hand-off for $kind"
  exit 0
fi

if [[ $handoff == fill ]]; then
  jq -e 'any(.[]; .event == "plan-approved")' <<<"$events" >/dev/null ||
    die "$task has no plan-approved, so no ticket is launched; approve the plan first (step 3 of the manual)"
  fill
  exit 0
fi

jq -e 'any(.[]; .event == "plan-approved")' <<<"$events" >/dev/null ||
  die "$task has no plan-approved, so no $handoff hand-off; approve the plan first (step 3 of the manual)"

# "3, 5 and 6" from a JSON list.
and_list() {
  jq -r 'map(tostring) | if length < 2 then join("") else "\(.[:-1] | join(", ")) and \(.[-1])" end' <<<"$1"
}

# holder_findings_file: the library's findings_file in the task directory of the task's latest
# builder launch's worktree, as <task_dir>/<file>, or nothing; team-brief derives a round's from
# the same function.
holder_findings_file() {
  local launch dir newest
  launch=$(ledger_jq 'map(select(.event == "launch" and .role == "builder")) | last
    | {worktree: (.worktree | local_path($home)), project}' -c <<<"$events")
  dir=$(team_project "$(jq -r .project <<<"$launch")" task_dir) || return 0
  newest=$(findings_file "$(jq -r .worktree <<<"$launch")/$dir")
  if [[ -n $newest ]]; then echo "$dir/$newest"; fi
}

if [[ $handoff == verdict ]]; then
  state=$(sibling team-state "$task" --json) || exit
  # In one jq run over the task's state: its PR (null when none); the builder who holds the
  # worktree's context, the task's latest builder launch (holder, false when none), its session,
  # whether it holds it (live and under 250k: holds, else full or gone) and its context as
  # "<context>k"; whether GitHub could not be read for the PR, its url, error and head; whether
  # that head is the reviewed one; the fix round's findings (sent), the reviewed head's first 8
  # characters, and the PR's facts for a merge base.
  pr='' holder='' session='' holds='' context='' pr_error='' pr_url='' pr_reason='' live_head='' reviewed=''
  same='' sent='' short='' behind='' base='' pr_project='' branch='' before=''
  json_vars --ledger pr='.pr | if (.state? // "") == "merged" then null else . end | tojson' holder='[.workers[] | select(.role == "builder")] | last | . != null' \
    session='[.workers[] | select(.role == "builder")] | last | .session | tostring' \
    holds='[.workers[] | select(.role == "builder")] | last
      | if .live | not then "gone" elif (.context | type) == "number" and .context >= 250000 then "full" else "holds" end' \
    context='[.workers[] | select(.role == "builder")] | last
      | if .live | not then "gone" elif (.context | type) == "number" then "\(.context / 1000 | round)k" else "context unknown" end' \
    pr_error='.pr | objects | has("error")' pr_url='.pr | objects | .url | tostring' pr_reason='.pr | objects | .error | tostring' \
    live_head='.pr | objects | .head | tostring' reviewed='$review.head | tostring' \
    same='same_head(.pr | objects | .head | tostring; $review.head | tostring)' \
    sent='$review.sent_back // [] | tojson' short='$review.head[:8] | tostring' \
    behind='.pr | objects | .behind_by // 0' base='.pr | objects | .base | tostring' \
    pr_project='.pr | objects | .project // empty' branch='.pr | objects | .branch // empty' \
    before='$review.before // [] | map(tostring)
      | if length < 2 then join("") else "\(.[:-1] | join(", ")) and \(.[-1])" end' \
    -- --argjson review "$review" <<<"$state"
  [[ $holder == true ]] || die "$task has no builder launch, so no builder holds the review's work"
  who="$task-builder ($session, $context)"
  gone="$task-builder $session is gone: recover it (the recover-worker skill), then send it"
  if [[ $kind == "DONE pass" && $pr != null ]]; then
    # A pass is taken only on the PR's head as GitHub has it now.
    if [[ $pr_error == true ]]; then
      echo "${0##*/}: GitHub cannot be read for $pr_url ($pr_reason); run the same command again" >&2
      exit 75
    fi
    [[ $same == true ]] ||
      die "the PR's head $live_head moved past the reviewed head $reviewed, so the pass is not taken; re-review the new head"
  fi
  log_events

  if [[ $kind == "DONE findings" || $sent != '[]' ]]; then
    if [[ $sent == '[]' ]]; then
      echo "no hand-off: the review sent nothing back, so there is no fix round"
    else
      if [[ $kind == "DONE findings" ]]; then
        file=$(jq -rn --arg m "$message" '$m | gsub("^\\s+"; "") | [splits("\\s+")] | .[3]')
      else
        file=$(holder_findings_file)
      fi
      where=${file:+in $file}
      stow="$task STOW; its PAUSED stowed goes to team-next, which launches the round"
      case $holds in
        holds) fix="send to $who: $task fix findings $(and_list "$sent") ${where:-of the review of $short} on the same branch, each as narrowly as it asks (a fix that would reach shapes it does not name is a $task QUESTION first), then deliver again as your brief says" ;;
        full) fix="send to $who: $stow" ;;
        gone) fix="$gone $stow" ;;
      esac
      # The churn rule (see the header), over the ledger as it was before this run logged anything,
      # the previous review on a rerun the latest before the index that holds this one.
      churn=$(jq -c --argjson review "$review" --argjson held "$held" '
        def sent_widening: (.sent_back // []) as $s | [(.widening // [])[] | select(IN($s[]))];
        ([$held.events[] | select(.event.event == "review") | .at] | first) as $at
        | ([to_entries[] | select(.value.event == "review" and ($at == null or .key < $at)) | .value] | last) as $prev
        | ($review | sent_widening) as $w
        | (($prev // {}) | sent_widening) as $p
        | ($review.findings // {}) as $f
        | any("blocking", "correctness", "security", "real-data"; ($f[.] // 0) > 0) as $serious
        | any(($review.sent_back // [])[]; IN($w[]) | not) as $outside
        | select($w != [] and $p != [] and (($serious and $outside) | not))
        | {w: $w, p: $p, short: $review.head[:8], prev_short: $prev.head[:8],
           areas: [($review.guarded // [])[] | select(IN("guardrails", "permissions", "secrets"))]}' <<<"$events")
      if [[ -z $churn ]]; then
        echo "$fix"
      else
        whom=decide
        areas=$(jq -c .areas <<<"$churn")
        if [[ $areas != '[]' ]]; then
          whom="the review found guarded areas $(and_list "$areas"), so ask Daniel with team-ask $task <an id> --file <the question>"
        fi
        echo "churn: findings $(and_list "$(jq -c .w <<<"$churn")") of the review of $(jq -r .short <<<"$churn") sit in what the fix since the last review added, as findings $(and_list "$(jq -c .p <<<"$churn")") of the review of $(jq -r .prev_short <<<"$churn") did: $whom whether to narrow them (the holder makes each a documented limit in the code's header instead of widening the fix, and the next rereview's --since says so), revert the fix that widened, or run one more round: $fix"
      fi
    fi
    exit 0
  fi

  if [[ $pr == null ]]; then
    # No PR yet: a gated project's builder waits for the pass to run its gate, a Disclosure task's
    # to push and open its PR.
    go_on="$task the review of $short passed: go on with your delivery"
    if [[ $holds == gone ]]; then echo "$gone $go_on"; else echo "send to $who: $go_on"; fi
    exit 0
  fi
  url=$pr_url
  caught=''
  if ((behind > 0)); then
    # Whether the reviewed head merges the base cleanly, read in the project's primary checkout once
    # the PR's branch and the base are fetched: clean is team-catch-up's, else the holder's step.
    behind_by="$behind behind $base"
    if [[ -z $pr_project ]]; then
      behind_by+=" (whether the merge is clean is not known: the PR's repo is no registered project's)"
    else
      project=$pr_project
      primary=$(team_project "$project" path)
      rc=0
      if [[ -z $branch ]]; then
        behind_by+=" (whether the merge is clean is not known: GitHub did not name the PR's branch)"
      elif ! fetched=$(git -C "$primary" fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" \
        "+refs/heads/$base:refs/remotes/origin/$base" 2>&1); then
        behind_by+=" (whether the merge is clean is not known: the PR's branch $branch and $base cannot be fetched into $primary: $(grep -m1 . <<<"$fetched" || echo "git fetch failed"))"
      elif merged=$(base_merge "$primary" "$live_head" "origin/$base") || rc=$?; ((rc == 0)); then
        echo "merge base: $url is $behind_by, and merges it cleanly: run team-catch-up $task, which needs no rereview (step 6)"
        caught=1
      elif ((rc == 1)); then
        behind_by+=" and conflicts on $(and_list "$(jq -Rnc '[inputs | select(. != "")]' <<<"$merged")")"
      else
        behind_by+=" (whether the merge is clean is not known: $merged)"
      fi
    fi
    if [[ -z $caught ]]; then
      step="merge base: $url is $behind_by, so it merges $base first (step 6):"
      case $holds in
        holds) echo "$step render team-brief $task builder-merge-base, send its path to $who and log team-log $task resumed brief=<its file name without .md>, which holds team-sweep's merge-due" ;;
        full) echo "$step send $task STOW to $who, then launch a fresh builder on team-brief $task builder-merge-base" ;;
        gone) echo "$step $task-builder $session is gone, so launch a fresh builder on team-brief $task builder-merge-base" ;;
      esac
      exit 0
    fi
  fi
  # The task's reviews, this one too once (a rerun finds it logged), each one that counted a
  # security or real-data finding or logged no counts named: team-merge refuses the plan-time
  # and standing words for such a task.
  risky=$(jq -c --argjson review "$review" --argjson held "$held" '
    map(select(.event == "review"))
    + (if any($held.events[]; .event.event == "review" and .at == null) then [$review] else [] end)
    | [.[] | "the review of \(.head[:7]) at \(.ts) " as $r
      | if has("findings") | not then "\($r)logged no counts"
        else [.findings | ("security", "real-data") as $k | .[$k] // 0 | select(. > 0) | "\(.) \($k)"]
          | select(. != []) | (map(split(" ")[0] | tonumber) | add) as $n
          | "\($r)counted \(join(" and ")) finding\(if $n == 1 then "" else "s" end)" end]' <<<"$events")
  # The merge ask's facts, or the plan-time or standing word's merge; after a clean catch-up's line,
  # the same for once the merge's checks pass, with no checks of the head it was made from.
  jq -r --arg task "$task" --argjson review "$review" --argjson risky "$risky" --arg caught "$caught" \
    --arg before "$before" '
    (.pr | if $caught != "" then "\(.url) at \(.head)"
      else "\(.url) at \(.head), agent-review \(.agent_review), "
        + ([(.checks.failing | select(. != []) | "failing: \(join(", "))"),
            (.checks.pending | select(. != []) | "pending: \(join(", "))"),
            (.required_missing | select(. != []) | "missing: \(join(", "))")]
          | if . == [] then "checks green" else "checks \(join("; "))" end) end) as $facts
    | (.merge_preapproval | . != null and .withdrawn == null and .opted_in == true and .own != true) as $planned
    | (.pr.standing_word | . != null and .word != null and .withdrawn == null) as $standing
    | ([if $planned then "plan-time" else empty end, if $standing then "standing" else empty end]
       | if . == [] then ""
         elif length == 1 then ", so the \(.[0]) word does not hold"
         else ", so the \(join(" and ")) words do not hold" end) as $held
    | ($review.guarded // []) as $guarded
    | (if $caught != "" then "then, once the checks pass on its merge: " else "" end)
    + if $guarded != [] or $risky != [] then "merge ask: \($facts)"
      elif $planned then "merge pre-approved: run team-merge \($task) for \($facts)"
      elif $standing then "merge on the standing word: run team-merge \($task) for \($facts)"
      else "merge ask: \($facts)" end
    + (if $guarded == [] then ""
       else "; the review found guarded areas: \($guarded | join(", "))\($held)" end)
    + (if $held != "" and $risky != [] then
         "; \($risky | if length < 2 then join("") else "\(.[:-1] | join(", ")) and \(.[-1])" end)\($held)"
       else "" end)
    + (if $before == "" then "" else "; queue before notes \($before) as follow-ups and say where each went" end)' <<<"$state"
  exit 0
fi

if [[ $handoff == round ]]; then
  # The stowed builder's round goes to a fresh builder in the latest builder launch's project.
  project=$(jq -r 'map(select(.event == "launch" and .role == "builder")) | last | .project // empty' <<<"$events")
  [[ -n $project ]] || die "$task has no builder launch naming a project, so the round has none"
  worktree=$(project_worktree "$project") || exit
  # round-<k>: the lowest k from 1 whose brief no launch read.
  k=1
  while [[ -e $TEAM_HOME/tasks/$task/brief-round-$k.md ]] &&
    brief_launched "round-$k"; do
    k=$((k + 1))
  done
  hand_off builder builder-round "round-$k" "$project" "$worktree"
  exit 0
fi

if [[ $handoff == review ]]; then
  # In one jq run: the event the hand-off follows (key: the pr of a PR, else the builder's done),
  # its url and head; when that event is logged already and a reviewer's launch follows it with no
  # review since (a review since means the message is a later round's, the same PR head after a
  # round that only edited its body), that launch; the head the done reports; and the projects of
  # the task's open worktrees, one a line.
  key_event='done'
  [[ $kind != PR ]] || key_event='pr'
  after='' url='' head='' reported='' projects=''
  json_vars --ledger after="$same_def"' . as $events | ($parsed | map(select(.event == $k)) | first) as $key
    | ([to_entries[] | select(.value | same($key)) | .key] | last) as $at
    | if $at == null then null
      else $events[$at + 1:] as $rest
      | if any($rest[]; .event == "review") then null
        else first($rest[] | select(.event == "launch" and .role == "reviewer")) // null end end
    | select(. != null) | "\($task)-\(.role) \(.session) was launched at \(.ts) after its \($key.event)"' \
    url='$parsed | map(select(.event == $k)) | first | .url | tostring' \
    head='$parsed | map(select(.event == $k)) | first | .head | tostring' \
    reported='$parsed | map(select(.event == "done")) | first | .report | select(. != null) | [splits("\\s+")]
      | if .[0] == "merged" then .[2] else .[1] end | tostring' \
    projects='reduce (open_worktrees(.[]; $home) | .project | tostring) as $p ([]; if IN(.[]; $p) then . else . + [$p] end)
      | join("\n")' \
    -- --argjson parsed "$parsed" --arg k "$key_event" --arg task "$task" <<<"$events"
  [[ -z $after ]] || die "$kind is already handed off: $after"

  sets=()
  if [[ $kind == PR ]]; then
    [[ $url =~ ^https://github\.com/([^/]+/[^/]+)/pull/[0-9]+/?$ ]]
    repo=${BASH_REMATCH[1]}
    project=''
    while IFS= read -r p; do
      [[ -n $p ]] || continue
      r=$(team_project "$p" repo) || exit 1
      [[ ${r,,} != "${repo,,}" ]] || project=$p
    done <<<"$projects"
    [[ -n $project ]] || die "$url is in no repo of $task's open worktrees"
    worktree=$(project_worktree "$project") || exit
    sets=(--set "pr=$url" --set "head=$head")
  else
    # The reported head must be the HEAD of the sending builder's worktree.
    worktree=$sender_wt project=$launch_project
    [[ -n $project ]] || die "the sending builder's launch names no project, so its review has none"
    [[ -d $worktree ]] || die "the sending builder's worktree $worktree is not on this machine"
    if ! head=$(git -C "$worktree" rev-parse -q --verify "$reported^{commit}" 2>/dev/null) ||
      [[ $head != "$(git -C "$worktree" rev-parse HEAD)" ]]; then
      die "$reported is not the HEAD of $worktree ($(git -C "$worktree" rev-parse --short=8 HEAD)), so it is not reviewed"
    fi
    [[ $kind == "DONE merged" ]] || sets=(--set "head=$head")
  fi

  if [[ $latest == null ]]; then
    [[ -n $checks ]] || die "$task has no review yet, so its first reviewer needs --checks <file>, the review's checks"
    [[ -z $template_opt ]] || die "$task has no review yet, so its first reviewer takes the reviewer brief, not --template $template_opt"
    [[ -z $since ]] || die "$task has no review yet, so there is no since for --since"
    template=reviewer name=review
    sets+=(--set-file "checks=$checks")
  else
    [[ -z $checks ]] || die "$task has a review already, so --checks is for its first reviewer only; a rereview takes --since"
    if [[ -n $template_opt ]]; then
      template=$template_opt
    elif [[ $kind == "DONE merged" ]]; then
      template=rereview
    else
      template=$(ledger_jq 'if ($latest.sent_back // []) != []
          and ((($latest.findings // {}) as $f | ["blocking", "correctness", "security", "real-data"] | all(.[]; $f[.] == 0))
            or same_head($latest.head; $head))
        then "verify" else "rereview" end' -nr --argjson latest "$latest" --arg head "$head")
    fi
    [[ $template == rereview || $kind != "DONE merged" ]] ||
      die "a DONE merged is re-reviewed with rereview, whose since names the merge; verify reads only a round's fix"
    [[ -z $since || $template == rereview ]] || die "--since is for a rereview; verify derives no since"
    [[ -z $since ]] || sets+=(--set-file "since=$since")
    # rereview-<k>: the lowest k from 2 whose brief no launch read.
    k=2
    while [[ -e $TEAM_HOME/tasks/$task/brief-rereview-$k.md ]] &&
      brief_launched "rereview-$k"; do
      k=$((k + 1))
    done
    name=rereview-$k
  fi
  hand_off reviewer "$template" "$name" "$project" "$worktree" "${sets[@]}"
  exit 0
fi

# A builder's DONE <NN>: the next ticket's builder, or the deliverer.
# In one jq run: the ticket, its shas one a line, and, when the same ticket-done (its ticket and
# shas) is logged already and a launch follows it, that launch; the launch is read before the
# sender, whom team-log takes to be the latest builder, the next one once the hand-off launched it.
ticket='' commits='' after=''
json_vars ticket='$reported.ticket | tostring' commits='[$reported.commits[]? | tostring] | join("\n")' \
  after='. as $events
  | ([to_entries[] | select(.value.event == "ticket-done" and .value.ticket == $reported.ticket and .value.commits == $reported.commits) | .key] | last) as $at
  | if $at == null then null
    else first($events[$at + 1:][] | select(.event == "launch" and .role != "ops")) // null end
  | select(. != null) | "\($task)-\(.role) \(.session) was launched at \(.ts)"' \
  -- --argjson reported "$(jq -c 'map(select(.event == "ticket-done")) | first' <<<"$parsed")" \
  --arg task "$task" <<<"$events"
[[ -z $after || -n $sender_ticket ]] || die "ticket $ticket is already handed off: $after after its ticket-done"
[[ -z $sender_ticket || $sender_ticket == "$ticket" ]] ||
  die "$task-builder-$sender_ticket ($sender_session) is ticket $sender_ticket's builder, so its DONE $ticket is not integrated"

tickets=$(sibling team-tickets "$task" --json) || exit

# In one jq run over the tickets: whether NN is one, and once NN is done (updated): the tickets,
# NN's phase, whether the task has more than one phase, the phase being built (the earliest, up to
# NN's, with a ticket not done; empty when none), the ticket chosen (--next's, else that phase's
# lowest-numbered ready one), whether it is ready or waiting, what it waits on, its phase, its
# project, and NN's phase's tickets as a list.
updated='def updated: map(if .ticket == $t then .state = "done" | .session = null else . end)
  | [.[] | select(.state == "done") | .ticket] as $done
  | map(if .state == "blocked" then (.on - $done) as $on
      | if $on == [] then .on = [] | .state = (if .waits_for == null then "ready" else "waiting" end) else .on = $on end
    else . end)
  | sort_by(.ticket);
  def phase: map(select(.ticket == $t)) | first | .phase // 1;
  def building: phase as $p | [.[] | select(.state != "done" and (.phase // 1) <= $p) | .phase // 1] | min;
  def chosen: if $n != "" then map(select(.ticket == $n)) | first
    else building as $b | map(select(.state == "ready" and (.phase // 1) == $b)) | first end;'
known='' listed='' phase='' phased='' building='' chosen='' chosen_ok='' chosen_waits='' chosen_phase=''
chosen_ticket='' chosen_project='' phase_tickets=''
json_vars known='any(.[]; .ticket == $t)' listed='map(.ticket) | sort | if . == [] then "none" else join(", ") end' \
  phase="$updated updated | phase" phased="$updated updated | map(.phase // 1) | unique | length > 1" \
  building="$updated updated | building // empty" \
  chosen="$updated updated | chosen | tojson" \
  chosen_ok="$updated updated | chosen | select(. != null) | .state == \"ready\" or .state == \"waiting\"" \
  chosen_waits="$updated $waits updated | chosen | select(. != null) | waits" \
  chosen_phase="$updated updated | chosen | select(. != null) | .phase // 1" \
  chosen_ticket="$updated updated | chosen | select(. != null) | .ticket | tostring" \
  chosen_project="$updated updated | chosen | select(. != null) | .project | tostring" \
  phase_tickets="$updated updated | phase as \$p | [.[] | select((.phase // 1) == \$p) | .ticket] | map(tostring)
    | if length < 2 then join(\"\") else \"\\(.[:-1] | join(\", \")) and \\(.[-1])\" end" \
  -- --arg t "$ticket" --arg n "$next" <<<"$tickets"
[[ $known == true ]] || die "$task has no ticket $ticket: its tickets are $listed"

# shas_held <worktree>: refused unless every sha is a commit the HEAD of <worktree> holds.
shas_held() {
  local sha commit
  while IFS= read -r sha; do
    [[ -n $sha ]] || continue
    if ! commit=$(git -C "$1" rev-parse -q --verify "$sha^{commit}" 2>/dev/null) ||
      ! git -C "$1" merge-base --is-ancestor "$commit" HEAD 2>/dev/null; then
      die "$sha is not a commit the HEAD of $1 holds, so ticket $ticket is not handed off"
    fi
  done <<<"$commits"
}

# Every sha is a commit the sending builder's worktree's HEAD holds; a ticket worktree's builder's
# are checked in the integration's order, under its lock.
if [[ -z $sender_ticket ]]; then
  [[ -d $sender_wt ]] || die "the sending builder's worktree $sender_wt is not on this machine"
  shas_held "$sender_wt"
fi

# The not-done tickets of the phase being built, each with what it waits on.
open_list() {
  jq -r --arg t "$ticket" --argjson b "$building" "$updated $waits"' updated | map(select(.state != "done" and (.phase // 1) == $b) | waits) | join("; ")' <<<"$tickets"
}
phase_cap=$(cap_of "$phase") || exit
if [[ -n $next ]]; then
  [[ $chosen != null ]] || die "--next $next is none of $task's tickets: they are $(jq -r --arg t "$ticket" "$updated"' updated | map(.ticket) | join(", ")' <<<"$tickets")"
  [[ $chosen_ok == true ]] || die "--next $next is not ready once $ticket is done: $chosen_waits"
  [[ -n $building ]] ||
    die "phase $phase's tickets are all done once $ticket is, so its deliverer comes next, not --next $next"
  [[ $chosen_phase == "$building" ]] ||
    die "--next $next is in phase $chosen_phase, but phase $building has tickets not done: $(open_list)"
elif [[ -z $building ]]; then
  chosen=deliver
elif ((phase_cap > 1)) || [[ -n $sender_ticket ]]; then
  # In a phase whose cap is above 1, or after an integration, the fill hands off, which says why
  # when it launches nothing.
  :
else
  [[ $chosen != null ]] ||
    die "tickets $([[ $phased == false ]] || echo "of phase $building ")remain once $ticket is done, but none is ready: $(open_list); --next <NN> launches a waiting one"
fi
# changed_files <worktree> [untracked]: its changes to tracked files, then with untracked its
# untracked files git does not ignore, joined by ", ", or nothing.
changed_files() {
  {
    git -C "$1" diff --name-only HEAD
    [[ -z ${2:-} ]] || git -C "$1" ls-files --others --exclude-standard
  } | paste -sd, | sed 's/,/, /g'
}

# integrate: ticket NN's tested head fast-forwards the task branch, under the task's lock, as the
# header says: the five checks, the fast-forward, the copy back of the ticket's file and build
# notes, the events with the ticket-done's head, and the return of its worktree; a rerun after
# the ticket-done is logged skips to the return.
integrate() {
  local wait=${TEAM_NEXT_LOCK_SECONDS:-60} lock lock_fd ticket_line tw branch task_wt task_branch name
  local head last tip old dirty on rel src dst file landed
  local -a copies
  [[ $wait =~ ^[0-9]+$ ]] || usage_error "TEAM_NEXT_LOCK_SECONDS takes a whole number of seconds, got '$wait'"
  lock=$HOME/.local/state/agent-team/integrate/$task.lock
  mkdir -p "${lock%/*}"
  exec {lock_fd}>>"$lock"
  # Homebrew's flock refuses -w 0, so no wait is -n.
  if ! if ((wait == 0)); then flock -n "$lock_fd"; else flock -w "$wait" "$lock_fd"; fi; then
    echo "${0##*/}: another team-next is integrating a ticket of $task ($lock); run this again" >&2
    exit 75
  fi
  # The ledger as it is under the lock, so a DONE integrated meanwhile is a rerun here.
  events=$(task_event_array "$task")
  held=$(ledger_jq "$held_prog" -c --argjson parsed "$parsed" <<<"$events")
  if ! jq -e 'any(.events[]; .event.event == "ticket-done" and .at != null)' <<<"$held" >/dev/null; then
    ticket_line=$(ledger_jq '[open_worktrees(.[]; $home) | select(.project == $p and (.ticket == $t or .ticket == null))]
      | [(map(select(.ticket == $t)) | last), (map(select(.ticket == null)) | last)]
      | map(if . == null then "", "" else .worktree, .branch end) | .[]' \
      -r --arg p "$launch_project" --arg t "$ticket" <<<"$events")
    # One per line, since a tab is IFS whitespace and an empty field between two would collapse.
    { IFS= read -r tw; IFS= read -r branch; IFS= read -r task_wt; IFS= read -r task_branch; } <<<"$ticket_line"
    name="$task-builder-$ticket ($sender_session)"
    [[ -n $tw ]] || die "$task has no open worktree of ticket $ticket, so nothing is integrated"
    [[ -n $task_wt ]] || die "$task has no open worktree in $launch_project, so nothing is integrated"
    # 1. The ticket worktree is here, on its ticket branch.
    [[ -d $tw ]] || die "ticket $ticket's worktree $tw is not on this machine, so nothing is integrated"
    on=$(git -C "$tw" symbolic-ref -q --short HEAD) || on="a detached HEAD"
    [[ $on == "$branch" ]] ||
      die "ticket $ticket's worktree $tw is on $on, not its ticket branch $branch, so nothing is integrated"
    # 2. Nothing in it is uncommitted.
    dirty=$(changed_files "$tw" untracked)
    if [[ -n $dirty ]]; then
      echo "send to $name: $task your worktree has uncommitted changes ($dirty): commit or remove them, run your checks again and send DONE $ticket again with your head last"
      exit 0
    fi
    # 3. The last sha is its HEAD, and it holds every sha.
    head=$(git -C "$tw" rev-parse HEAD)
    last=$(grep . <<<"$commits" | tail -n 1)
    if [[ $(git -C "$tw" rev-parse -q --verify "$last^{commit}" 2>/dev/null) != "$head" ]]; then
      echo "send to $name: $task your DONE $ticket must list the head you tested last, the HEAD of your worktree, ${head:0:8}; run your checks on it and send DONE $ticket again"
      exit 0
    fi
    shas_held "$tw"
    # 4. Its HEAD holds the task branch's tip, unless the tip holds its HEAD: a run that ended
    # after its fast-forward, with another ticket landed on top since, left it integrated.
    tip=$(git -C "$task_wt" rev-parse -q --verify "refs/heads/$task_branch") ||
      die "the task branch $task_branch is not in $task_wt, so nothing is integrated"
    landed=''
    [[ $tip == "$head" ]] || ! git -C "$tw" merge-base --is-ancestor HEAD "$tip" || landed=1
    if [[ -z $landed ]] && ! git -C "$tw" merge-base --is-ancestor "$tip" HEAD; then
      echo "send to $name: $task the task branch moved: merge $task_branch at ${tip:0:8} into your branch, run your checks again on the merged head and send DONE $ticket again with that head last"
      exit 0
    fi
    # 5. The task worktree is on the task branch, with no changes to tracked files.
    on=$(git -C "$task_wt" symbolic-ref -q --short HEAD) || on="a detached HEAD"
    [[ $on == "$task_branch" ]] || die "the task worktree $task_wt is on $on, so nothing fast-forwards it"
    dirty=$(changed_files "$task_wt")
    [[ -z $dirty ]] || die "the task worktree $task_wt has changes to $dirty, so nothing fast-forwards it"

    old=$(git -C "$task_wt" rev-parse HEAD)
    if [[ $old == "$head" ]]; then
      echo "already integrated ticket $ticket: $task_branch is at ${head:0:8} in $task_wt"
    elif [[ -n $landed ]]; then
      echo "already integrated ticket $ticket: $task_branch at ${tip:0:8} holds ${head:0:8} in $task_wt"
    else
      git -C "$task_wt" merge -q --ff-only "$head" >&2 ||
        die "the task branch $task_branch in $task_wt cannot fast-forward to ${head:0:8}; its reason is above"
      echo "integrated ticket $ticket: $task_branch ${old:0:8}..${head:0:8} in $task_wt"
    fi
    # The ticket's file and its build notes, NN.md and NN-*, from the ticket worktree's task directory.
    rel=$(team_project "$launch_project" task_dir) || exit 1
    src=$tw/$rel dst=$task_wt/$rel
    copies=("tickets/$(jq -r --arg t "$ticket" 'map(select(.ticket == $t)) | first | .file | split("/") | last' <<<"$tickets")"
      "build-notes/$ticket.md")
    for file in "$src/build-notes/$ticket"-*; do copies+=("build-notes/${file##*/}"); done
    for file in "${copies[@]}"; do
      [[ -f $src/$file ]] || continue
      mkdir -p "$(dirname "$dst/$file")"
      cp -p -- "$src/$file" "$dst/$file"
      echo "copied back $dst/$file"
    done
    held=$(jq -c --arg head "$head" '.events |= map(if .event.event == "ticket-done" then .event.head = $head else . end)' <<<"$held")
  fi
  log_events
  flock -u "$lock_fd"
  exec {lock_fd}>&-
}

if [[ -n $sender_ticket ]]; then
  integrate
  # The hand-off, read again now that the ticket is done: the deliverer once the phase's tickets
  # are all done, launched once, else the fill.
  tickets=$(sibling team-tickets "$task" --json) || exit
  events=$(task_event_array "$task")
  building=$(jq -r --arg t "$ticket" --arg n "$next" "$updated"' updated | building // empty' <<<"$tickets")
  if [[ -n $building ]]; then
    fill
    exit 0
  fi
  handed=$(jq -r --arg task "$task" --argjson phase "$phase" \
    --argjson mine "$(jq -c --argjson p "$phase" '[.[] | select((.phase // 1) == $p) | .ticket]' <<<"$tickets")" '
    ([to_entries[] | select(.value.event == "ticket-done" and (.value.ticket | IN($mine[]))) | .key] | last) as $at
    | first(.[($at // -1) + 1:][] | select(.event == "launch" and .role == "builder"
        and ((.brief // "") | startswith("brief-deliver"))))
    | "\($task)-\(.role) \(.session) was launched at \(.ts) on \(.brief)"' <<<"$events")
  if [[ -n $handed ]]; then
    echo "already handed off: $handed"
    exit 0
  fi
  briefs=$(jq -r '[.[] | select(.event == "launch") | .brief | strings] | join("\n")' <<<"$events")
  chosen=deliver
elif [[ $chosen != deliver ]] && ((phase_cap > 1)); then
  log_events
  fill
  exit 0
fi

if [[ $chosen == deliver ]]; then
  # deliver, or deliver-p<n> for a phase of a phased task; a name a launch read takes -2, -3...
  base=deliver sets=()
  if [[ $phased == true ]]; then
    base=deliver-p$phase
    sets=(--set "tickets=every ticket of phase $phase ($phase_tickets)")
  fi
  template=builder-deliver name=$base k=1
  while [[ -e $TEAM_HOME/tasks/$task/brief-$name.md ]] &&
    brief_launched "$name"; do
    k=$((k + 1))
    name=$base-$k
  done
  project=$launch_project
else
  template=builder-ticket name=build-$chosen_ticket sets=(--set "ticket=$chosen_ticket")
  project=$chosen_project
fi
[[ -n $project ]] || die "the sending builder's launch names no project, so the deliverer has none"
worktree=$(project_worktree "$project") || exit
hand_off builder "$template" "$name" "$project" "$worktree" "${sets[@]}"
