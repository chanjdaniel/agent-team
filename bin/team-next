#!/usr/bin/env bash
# Take a worker's message to the task's next step: log its events, then hand the work on.
#
# Usage: team-next T<n> [--from <session>] [--sent-back <list>] [--next <NN>] [--checks <file>]
#                  [--since <file>] [--template rereview|verify] -- '<the worker's message>'
#   --from       the sender, as team-log --from-message takes it, when the message cannot tell it
#   --sent-back  with a DONE findings message, required, the numbers sent back (none for none), logged
#                as the review's sent_back; with a DONE pass, the findings it counts that go back
#                before the merge, required while it counts any
#   --next       with a builder's DONE <NN>, the ticket to launch next instead of the lowest-numbered
#                ready one; a ticket with a Waits for: line is launched only so
#   --checks     with a review launch, the first review's checks file (the reviewer's checks);
#                required when the task has no review yet, refused once it has one
#   --since      with a rereview launch, a file of the coordinator's words, added after the derived
#                since; refused for the first review and for verify
#   --template   with a review launch after the first, rereview or verify instead of the rule's
# First every check, each refusal changing nothing (no ledger line, no brief, no launch): the task
# is open (team-open's opened, not closed) and not held (a held with no resumed since), has no ask
# to Daniel that nothing settled yet, and the message reads as team-log --from-message --print
# reads it (its refusal is team-log's, with its exit code).
# Then it logs, through team-log, each of the message's events that the ledger does not already
# hold since the sending worker's launch (the session its events name, else the task's latest
# launch): a ticket-done of the same ticket, a done of the same session and report, a pr of the
# same url and head, a review of the same head and verdict, any other event with the same fields;
# so a rerun never logs one twice. Each line it prints is one step: "logged <event> <key=value>..."
# or "already logged <event> ...", then the hand-off's.
# The hand-off of a builder's DONE <NN> <sha>... <line>: refused, before anything is logged, when
# the task has no plan-approved; when the same ticket-done (its ticket and shas) is logged already
# and a launch other than an ops session's follows it ("already handed off"); when NN is none of
# team-tickets T<n>'s tickets; when a sha is not a commit the sending builder's worktree's HEAD
# holds; when --next names a ticket that is not ready or waiting once NN is done, or one of
# another phase than the one being built; or when tickets of that phase remain of which none is
# ready, each named with what it waits on. A ticket's phase is its Phase: line's, else 1
# (team-tickets), and the phase being built is the earliest, up to NN's, with a ticket not done.
# Otherwise the next ticket, --next's or that phase's lowest-numbered ready one once NN is done,
# gets team-brief T<n> builder-ticket --set ticket=<NN> --name build-<NN> in its project; when
# none of NN's phase or an earlier one is left, NN's phase's deliverer gets builder-deliver (its
# goal from the plan) --name deliver, or for a task of more than one phase --name deliver-p<n>
# with tickets set to "every ticket of phase <n> (<its tickets>)", a name a launch already read
# taking -2, -3 and so on, in the sending builder's project; the next phase's first ticket is
# launched by hand, as the first one is. Each is launched as a builder with the toolkits of the
# task's latest builder launch.
# The hand-off of a builder's PR <url> (with or without its merged <base> conflicts: line), DONE
# review-ready <sha> or DONE merged <base> <sha> conflicts: <files or none> is a fresh reviewer's
# launch: refused, before anything is logged, when the task has no plan-approved; when the same
# pr (url and head) or done (session and report) is logged already and a reviewer's launch follows
# it with no review since ("already handed off"); and for a DONE, when its sha is not the HEAD of
# the sending builder's worktree. The worktree is the sending builder's, or for a PR the task's
# worktree in the project whose repo holds the PR. With no review logged yet, the brief is
# team-brief T<n> reviewer --name review with --checks as its checks (refused without one), the
# PR's url and head (a PR) or the reported head (review-ready; no pr); after one, it is
# rereview, or verify when the latest review sent findings back and either counted
# none but plain notes or reviewed the head this message reports (a round that only edited the PR
# body), --template choosing instead, and a DONE merged always a rereview; it is named
# rereview-<k>, the lowest k from 2 whose brief no launch read, and takes the PR's url and head (a
# PR) or the reported head (review-ready), the rest derived by team-brief (a DONE merged's head
# from GitHub, and its since naming the merge's conflicted files), --since added after the
# derived since. It launches as a reviewer with the toolkits of the task's latest reviewer
# launch, else of its latest builder launch.
# A reviewer's DONE pass or DONE findings launches nothing: refused, before anything is logged,
# when the task has no plan-approved, a DONE findings without --sent-back, a pass that counts a
# blocking, correctness, security, real-data or note-change finding with no --sent-back list of
# them (they go back before the merge, so it prints no merge line), and a pass whose PR head on
# GitHub (team-state T<n> --json) is not the reviewed head, naming both (exit 75 when GitHub
# cannot be read). Once the review and its done are logged, the last line is what is
# left for the coordinator, the holder being the task's latest builder launch, under 250k while
# team-state reads its context under 250,000 tokens or none, and gone when its session is not
# live. For a pass on a PR: "merge ask: <full PR URL> at <head>, agent-review <state>, checks
# green" (or the failing, pending and missing checks), "merge pre-approved: run team-merge T<n>
# for ..." instead while team-state's plan-time approval stands, or "merge on the standing word: run
# team-merge T<n> for ..." while it does not and a standing word of Daniel's stands for the PR's
# project (team-state's pr.standing_word), the review found no guarded area and no review of the
# task counted a security or real-data finding or logged no counts (which team-merge refuses both
# words for), each guarded area and such review named with the word it holds back, and the before
# notes to queue as follow-ups; for a PR behind its base, "merge base: ..." instead, read with
# base_merge in the project's primary checkout once the PR's branch and the base are fetched there:
# "run team-catch-up T<n>, which needs no rereview" when the reviewed head merges the base cleanly,
# then "then, once the checks pass on its merge: " and the merge line above for the reviewed head
# with no checks (its guarded areas, risky reviews and before notes as they are), else the
# builder-merge-base brief for the holder under 250k, else a fresh builder, after the
# holder's STOW when it is live, with "conflicts on <files>" after the behind count for a conflict,
# or "(whether the merge is clean is not known: <why>)" when the fetch or git fails. For a pass
# with no PR (a review-ready, a gated or Disclosure task's), the message telling the holder to go
# on with its delivery. For findings, or a pass that sent some
# back (which team-log logs as findings): the message for the holder under 250k (its name, the
# findings sent back and the findings file the message names, for a pass the newest of review.md
# and rereview*.md in the holder's task directory, as team-brief derives a round's), else the
# T<n> STOW to send it (after recovering it when gone), or no hand-off when nothing was sent back.
# A PAUSED stowed (its reason the word stowed, alone or with more after it) while the latest
# review sent findings back, with no launch since
# it but an ops session's, launches the fix round: team-brief T<n> builder-round --name
# round-<k>, the lowest k from 1 whose brief no launch read, every fact derived (the findings,
# the newest findings file, the PR and the plan's goal), in the project of the task's latest
# builder launch, as a builder with its toolkits; any other PAUSED stowed has no hand-off.
# A ticket's brief is refused when a launch already read it (the deliverer, round and rereview
# names take the next free one instead), and each brief is rendered again with --force when none
# did (a rerun after a failed launch). The brief is rendered before the events
# are logged, then team-worker launches it, and the last line is "launched T<n>-<role> <session
# id>". A launch that fails is finished by running the same command again, which logs nothing
# twice.
# Any other message is logged, and the last line says it has no hand-off.
# It never posts to Discord, sends a message, merges, approves a plan or answers a question.
# Exit codes: 0 done, 1 refused, 2 a malformed command line; when a script it runs fails, that
# script's own code, 75 (try again later) among them.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

bin=$(dirname "$TEAM_LIB")
usage="usage: team-next T<n> [--from <session>] [--sent-back <list>] [--next <NN>] [--checks <file>] [--since <file>] [--template rereview|verify] -- '<the worker's message>'"

[[ $# -ge 1 && $1 =~ ^T[0-9]+$ ]] || usage_error "$usage"
task=$1
shift
log_opts=() next='' checks='' since='' template_opt=''
declare -A given=()
while (($#)) && [[ $1 != -- ]]; do
  case $1 in
    --from | --sent-back | --next | --checks | --since | --template)
      [[ -z ${given[$1]:-} ]] || usage_error "$1 is given twice"
      [[ $# -ge 2 && -n $2 ]] || usage_error "$1 needs a value"
      given[$1]=1
      case $1 in
        --next)
          [[ $2 =~ ^[0-9]{2}$ ]] || usage_error "--next takes a two-digit ticket number, got '$2'"
          next=$2
          ;;
        --checks) checks=$2 ;;
        --since) since=$2 ;;
        --template)
          [[ $2 == rereview || $2 == verify ]] || usage_error "--template takes rereview or verify, got '$2'"
          template_opt=$2
          ;;
        *) log_opts+=("$1" "$2") ;;
      esac
      shift 2
      ;;
    -*) usage_error "unknown option '$1'; $usage" ;;
    *) usage_error "missing '--' before the worker's message; $usage" ;;
  esac
done
[[ ${1:-} == -- ]] || usage_error "missing '--' before the worker's message; $usage"
shift
message="$*"
[[ -n ${message//[[:space:]]/} ]] || usage_error "missing the worker's message; $usage"

# A sibling script of this checkout, with the team home passed explicitly.
sibling() {
  TEAM_HOME=$TEAM_HOME "$bin/$1" "${@:2}"
}

# The task: open, not held, no ask unsettled.
events=$(task_event_array "$task")
open_status='' problems=''
json_vars --ledger open_status=task_status problems='[
    if standing("held") then
      (map(select(.event == "held")) | last) as $h | "\($task) is held since \($h.ts): \($h.reason)" else empty end,
    (pending_asks[] | "\($task) has an unanswered ask, \(.id), since \(.ts)")]
  | join("; ")' -- --arg task "$task" <<<"$events"
case $open_status in
  open) ;;
  closed) die "$task is closed" ;;
  *) die "$task is not open: the ledger has no opened event for it" ;;
esac
[[ -z $problems ]] || die "$problems"

# The message's events, as team-log reads them, nothing logged yet: one compact object a line,
# joined into one array.
printed=$(sibling team-log "$task" --from-message "$message" "${log_opts[@]}" --print) || exit
parsed_lines=()
while IFS= read -r line; do [[ -z $line ]] || parsed_lines+=("$line"); done <<<"$printed"
printf -v parsed '%s,' "${parsed_lines[@]}"
parsed="[${parsed%,}]"

# same($p): whether the event is the parsed event $p, as a rerun finds it logged.
same_def='def same($p): .event == $p.event and
  if $p.event == "ticket-done" then .ticket == $p.ticket
  elif $p.event == "done" then .session == $p.session and .role == $p.role and .report == $p.report
  elif $p.event == "pr" then .url == $p.url and same_head(.head; $p.head)
  elif $p.event == "review" then .verdict == $p.verdict and same_head(.head; $p.head)
  else del(.ts) == ($p | del(.ts)) end;'

# In one jq run over the task's events and the message's:
# - kind: the message's kind as the hand-off reads it, for what is printed. A PAUSED stowed is the
#   answer to a STOW: its paused event's reason is the word stowed, alone or followed by more
#   ("stowed, handoff.md written"), never a word that only starts with it.
# - back: the findings a pass counts that go back before the merge, as text, or nothing.
# - held: which of the message's events the ledger holds since the sender's launch, each as
#   {event, at}, at the index of the event that holds it, or null; anchor is the sender's launch's
#   index.
# - briefs: the briefs the task's launches read, one name a line (brief_launched).
# - builder_kits, reviewer_kits: the toolkits of the task's latest launch of that role, else of its
#   latest builder launch, one a line (hand_off).
# - launch: the launch of the session the parsed done names, its worktree a local path (a launch
#   of null's when it names none); sender_wt its worktree, launch_project its project.
# - review: the message's review, or null.
# - latest: the task's latest review, or null.
launch_def='def sender_launch: ($parsed | map(select(.event == "done")) | first | .session | tostring) as $session
  | map(select(.event == "launch" and .session == $session)) | last
  | . + {worktree: (.worktree | local_path($home))};'
kind='' back='' held='' briefs='' builder_kits='' reviewer_kits='' launch='' sender_wt='' launch_project=''
review='' latest=''
json_vars --ledger kind='$message | gsub("^\\s+"; "") | [splits("\\s+")] | .[1:3]
  | (.[1] // "") as $sub
  | if .[0] == "DONE" and ($sub | test("^[0-9]{2}$")) then "DONE <NN>"
    elif .[0] == "DONE" and ($sub | IN("review-ready", "merged", "pass", "findings", "gate")) then join(" ")
    else .[0] end
  | if . == "PAUSED" and (try any($parsed[]; .event == "paused" and (.reason | test("^stowed(\\W|$)"))) catch false)
    then "PAUSED stowed" else tostring end' \
  back='$parsed | map(select(.event == "review")) | first | select((.sent_back // []) == [])
    | [(.findings // {}) as $f | "blocking", "correctness", "security", "real-data", "note-change"
        | select(($f[.] // 0) > 0) | {kind: ., n: $f[.]}]
    | select(. != []) | (map(.n) | add) as $total
    | map("\(.n) \(.kind)") | (if length < 2 then join("") else "\(.[:-1] | join(", ")) and \(.[-1])" end)
    | "\(.) finding\(if $total == 1 then ", which goes" else "s, which go" end) back"' \
  held="$same_def"' . as $events
  | ([$parsed[] | .session | strings] | first) as $session
  | ([to_entries[] | select(.value.event == "launch" and ($session == null or .value.session == $session)) | .key] | last // -1) as $anchor
  | {anchor: $anchor,
     events: [$parsed[] | . as $p
       | {event: $p, at: ([range($anchor + 1; $events | length) | select($events[.] | same($p))] | first)}]}' \
  briefs='[.[] | select(.event == "launch") | .brief | strings] | join("\n")' \
  builder_kits='map(select(.event == "launch" and .role == "builder")) | last | [.toolkits[]?] | join("\n")' \
  reviewer_kits='(map(select(.event == "launch" and .role == "reviewer")) | last)
    // (map(select(.event == "launch" and .role == "builder")) | last) | [.toolkits[]?] | join("\n")' \
  launch="$launch_def sender_launch | tojson" sender_wt="$launch_def sender_launch | .worktree | tostring" \
  launch_project="$launch_def sender_launch | .project // empty" \
  review='$parsed | map(select(.event == "review")) | first | tojson' latest='map(select(.event == "review")) | last | tojson' \
  -- --arg message "$message" --argjson parsed "$parsed" <<<"$events"

# Whether a launch of the task read brief-<name>: brief_launched <name>
brief_launched() {
  [[ $'\n'$briefs$'\n' == *$'\n'"brief-$1"$'\n'* ]]
}
case $kind in
  "DONE <NN>") handoff=ticket ;;
  PR | "DONE review-ready" | "DONE merged") handoff=review ;;
  "DONE pass" | "DONE findings") handoff=verdict ;;
  "PAUSED stowed") handoff=round ;;
  *) handoff=none ;;
esac
[[ -z $next || $handoff == ticket ]] || usage_error "--next is taken only with a builder's DONE <NN> message, not $kind"
for opt in --checks --since --template; do
  [[ -z ${given[$opt]:-} || $handoff == review ]] ||
    usage_error "$opt is taken only with a builder's PR, DONE review-ready or DONE merged message, not $kind"
done
[[ $kind != "DONE findings" || -n ${given[--sent-back]:-} ]] ||
  die "a DONE findings needs --sent-back <list>, the numbers that go back to the builder (none for no fix round)"
# A pass that counts a finding which goes back before the merge (a blocking, correctness, security
# or real-data one, or a plain note on a changed line) takes --sent-back with them, never a merge.
if [[ $kind == "DONE pass" ]]; then
  [[ -z $back ]] ||
    die "the pass counts $back to the builder before the merge (step 5), so there is no merge yet: run it again with --sent-back <their numbers>, and the round goes as a DONE findings' does, through the holder or builder-round"
fi

# log_events: logs each event the ledger does not hold yet through team-log, printing one line each.
# Each event is read as its kind, whether it is held, its count of fields and its key=value
# fields, NUL-separated, in one jq run.
log_events() {
  local records i n name fields
  mapfile -d '' -t records < <(jq -j '.events[] | [.event.event, (if .at != null then "held" else "" end),
    (.event | del(.ts, .task, .event) | to_entries | length | tostring),
    (.event | del(.ts, .task, .event) | to_entries[] | "\(.key)=\(.value | if type == "string" then . else tojson end)")][]
    | . + "\u0000"' <<<"$held")
  for ((i = 0; i < ${#records[@]}; i += 3 + n)); do
    name=${records[i]} n=${records[i + 2]}
    fields=("${records[@]:i+3:n}")
    if [[ -n ${records[i + 1]} ]]; then
      echo "already logged $name ${fields[*]}"
    else
      sibling team-log "$task" "$name" "${fields[@]}" || exit
      echo "logged $name ${fields[*]}"
    fi
  done
}

# hand_off <role> <template> <name> <project> <worktree> [<team-brief option>...]: renders the
# brief (refused when a launch read it, with --force when one exists that none did), logs the
# events, and launches <role> in <worktree> with the toolkits of the task's latest launch of
# <role>, else of its latest builder launch.
hand_off() {
  local role=$1 template=$2 name=$3 project=$4 worktree=$5 used force=() toolkits=() kit kits brief id status
  if [[ -e $TEAM_HOME/tasks/$task/brief-$name.md ]]; then
    if brief_launched "$name"; then
      used=$(jq -r --arg b "brief-$name" --arg task "$task" 'map(select(.event == "launch" and .brief == $b)) | last
        | "\($task)-\(.role) \(.session) at \(.ts)"' <<<"$events")
      die "brief-$name was launched already ($used), so it is not launched again"
    fi
    force=(--force)
  fi
  case $role in builder) kits=$builder_kits ;; *) kits=$reviewer_kits ;; esac
  while IFS= read -r kit; do [[ -z $kit ]] || toolkits+=(--toolkit "$kit"); done <<<"$kits"

  brief=$(sibling team-brief "$task" "$template" --project "$project" --name "$name" "${@:6}" "${force[@]}") || exit
  log_events
  echo "brief $brief"
  id=$(sibling team-worker "$task" "$role" "$worktree" "${toolkits[@]}" -- "Read your brief at $brief") || {
    status=$?
    echo "${0##*/}: the launch failed; run the same command again to finish it, which logs nothing twice" >&2
    exit "$status"
  }
  echo "launched $task-$role $id"
}

# project_worktree <project>: the task's open worktree in <project>, or a refusal.
project_worktree() {
  local worktree
  worktree=$(ledger_jq '[open_worktrees(.[]; $home) | select(.project == $p)] | last
      | select(. != null) | .worktree | tostring' -r --arg p "$1" <<<"$events")
  [[ -n $worktree ]] || die "$task has no open worktree in $1"
  echo "$worktree"
}

# A stow hands a round on only while the latest review (findings, or a pass logged before team-log made it so)
# sent findings back and no launch (an ops session's aside) has taken them since.
if [[ $handoff == round ]] && ! jq -e '(to_entries | map(select(.value.event == "review")) | last) as $r
    | $r != null and ($r.value.sent_back // []) != []
      and (any(.[$r.key + 1:][]; .event == "launch" and .role != "ops") | not)' <<<"$events" >/dev/null; then
  log_events
  echo "no hand-off for $kind: no review's sent-back findings wait for a round"
  exit 0
fi

if [[ $handoff == none ]]; then
  log_events
  echo "no hand-off for $kind"
  exit 0
fi

jq -e 'any(.[]; .event == "plan-approved")' <<<"$events" >/dev/null ||
  die "$task has no plan-approved, so no $handoff hand-off; approve the plan first (step 3 of the manual)"

# "3, 5 and 6" from a JSON list.
and_list() {
  jq -r 'map(tostring) | if length < 2 then join("") else "\(.[:-1] | join(", ")) and \(.[-1])" end' <<<"$1"
}

# holder_findings_file: the library's findings_file in the task directory of the task's latest
# builder launch's worktree, as <task_dir>/<file>, or nothing; team-brief derives a round's from
# the same function.
holder_findings_file() {
  local launch dir newest
  launch=$(ledger_jq 'map(select(.event == "launch" and .role == "builder")) | last
    | {worktree: (.worktree | local_path($home)), project}' -c <<<"$events")
  dir=$(team_project "$(jq -r .project <<<"$launch")" task_dir) || return 0
  newest=$(findings_file "$(jq -r .worktree <<<"$launch")/$dir")
  if [[ -n $newest ]]; then echo "$dir/$newest"; fi
}

if [[ $handoff == verdict ]]; then
  state=$(sibling team-state "$task" --json) || exit
  # In one jq run over the task's state: its PR (null when none); the builder who holds the
  # worktree's context, the task's latest builder launch (holder, false when none), its session,
  # whether it holds it (live and under 250k: holds, else full or gone) and its context as
  # "<context>k"; whether GitHub could not be read for the PR, its url, error and head; whether
  # that head is the reviewed one; the fix round's findings (sent), the reviewed head's first 8
  # characters, and the PR's facts for a merge base.
  pr='' holder='' session='' holds='' context='' pr_error='' pr_url='' pr_reason='' live_head='' reviewed=''
  same='' sent='' short='' behind='' base='' pr_project='' branch='' before=''
  json_vars --ledger pr='.pr | tojson' holder='[.workers[] | select(.role == "builder")] | last | . != null' \
    session='[.workers[] | select(.role == "builder")] | last | .session | tostring' \
    holds='[.workers[] | select(.role == "builder")] | last
      | if .live | not then "gone" elif (.context | type) == "number" and .context >= 250000 then "full" else "holds" end' \
    context='[.workers[] | select(.role == "builder")] | last
      | if .live | not then "gone" elif (.context | type) == "number" then "\(.context / 1000 | round)k" else "context unknown" end' \
    pr_error='.pr | objects | has("error")' pr_url='.pr | objects | .url | tostring' pr_reason='.pr | objects | .error | tostring' \
    live_head='.pr | objects | .head | tostring' reviewed='$review.head | tostring' \
    same='same_head(.pr | objects | .head | tostring; $review.head | tostring)' \
    sent='$review.sent_back // [] | tojson' short='$review.head[:8] | tostring' \
    behind='.pr | objects | .behind_by // 0' base='.pr | objects | .base | tostring' \
    pr_project='.pr | objects | .project // empty' branch='.pr | objects | .branch // empty' \
    before='$review.before // [] | map(tostring)
      | if length < 2 then join("") else "\(.[:-1] | join(", ")) and \(.[-1])" end' \
    -- --argjson review "$review" <<<"$state"
  [[ $holder == true ]] || die "$task has no builder launch, so no builder holds the review's work"
  who="$task-builder ($session, $context)"
  gone="$task-builder $session is gone: recover it (the recover-worker skill), then send it"
  if [[ $kind == "DONE pass" && $pr != null ]]; then
    # A pass is taken only on the PR's head as GitHub has it now.
    if [[ $pr_error == true ]]; then
      echo "${0##*/}: GitHub cannot be read for $pr_url ($pr_reason); run the same command again" >&2
      exit 75
    fi
    [[ $same == true ]] ||
      die "the PR's head $live_head moved past the reviewed head $reviewed, so the pass is not taken; re-review the new head"
  fi
  log_events

  if [[ $kind == "DONE findings" || $sent != '[]' ]]; then
    if [[ $sent == '[]' ]]; then
      echo "no hand-off: the review sent nothing back, so there is no fix round"
    else
      if [[ $kind == "DONE findings" ]]; then
        file=$(jq -rn --arg m "$message" '$m | gsub("^\\s+"; "") | [splits("\\s+")] | .[3]')
      else
        file=$(holder_findings_file)
      fi
      where=${file:+in $file}
      stow="$task STOW; its PAUSED stowed goes to team-next, which launches the round"
      case $holds in
        holds) echo "send to $who: $task fix findings $(and_list "$sent") ${where:-of the review of $short} on the same branch, then deliver again as your brief says" ;;
        full) echo "send to $who: $stow" ;;
        gone) echo "$gone $stow" ;;
      esac
    fi
    exit 0
  fi

  if [[ $pr == null ]]; then
    # No PR yet: a gated project's builder waits for the pass to run its gate, a Disclosure task's
    # to push and open its PR.
    go_on="$task the review of $short passed: go on with your delivery"
    if [[ $holds == gone ]]; then echo "$gone $go_on"; else echo "send to $who: $go_on"; fi
    exit 0
  fi
  url=$pr_url
  caught=''
  if ((behind > 0)); then
    # Whether the reviewed head merges the base cleanly, read in the project's primary checkout once
    # the PR's branch and the base are fetched: clean is team-catch-up's, else the holder's step.
    behind_by="$behind behind $base"
    if [[ -z $pr_project ]]; then
      behind_by+=" (whether the merge is clean is not known: the PR's repo is no registered project's)"
    else
      project=$pr_project
      primary=$(team_project "$project" path)
      rc=0
      if [[ -z $branch ]]; then
        behind_by+=" (whether the merge is clean is not known: GitHub did not name the PR's branch)"
      elif ! fetched=$(git -C "$primary" fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" \
        "+refs/heads/$base:refs/remotes/origin/$base" 2>&1); then
        behind_by+=" (whether the merge is clean is not known: the PR's branch $branch and $base cannot be fetched into $primary: $(grep -m1 . <<<"$fetched" || echo "git fetch failed"))"
      elif merged=$(base_merge "$primary" "$live_head" "origin/$base") || rc=$?; ((rc == 0)); then
        echo "merge base: $url is $behind_by, and merges it cleanly: run team-catch-up $task, which needs no rereview (step 6)"
        caught=1
      elif ((rc == 1)); then
        behind_by+=" and conflicts on $(and_list "$(jq -Rnc '[inputs | select(. != "")]' <<<"$merged")")"
      else
        behind_by+=" (whether the merge is clean is not known: $merged)"
      fi
    fi
    if [[ -z $caught ]]; then
      step="merge base: $url is $behind_by, so it merges $base first (step 6):"
      case $holds in
        holds) echo "$step render team-brief $task builder-merge-base and send its path to $who" ;;
        full) echo "$step send $task STOW to $who, then launch a fresh builder on team-brief $task builder-merge-base" ;;
        gone) echo "$step $task-builder $session is gone, so launch a fresh builder on team-brief $task builder-merge-base" ;;
      esac
      exit 0
    fi
  fi
  # The task's reviews, this one too once (a rerun finds it logged), each one that counted a
  # security or real-data finding or logged no counts named: team-merge refuses the plan-time
  # and standing words for such a task.
  risky=$(jq -c --argjson review "$review" --argjson held "$held" '
    map(select(.event == "review"))
    + (if any($held.events[]; .event.event == "review" and .at == null) then [$review] else [] end)
    | [.[] | "the review of \(.head[:7]) at \(.ts) " as $r
      | if has("findings") | not then "\($r)logged no counts"
        else [.findings | ("security", "real-data") as $k | .[$k] // 0 | select(. > 0) | "\(.) \($k)"]
          | select(. != []) | (map(split(" ")[0] | tonumber) | add) as $n
          | "\($r)counted \(join(" and ")) finding\(if $n == 1 then "" else "s" end)" end]' <<<"$events")
  # The merge ask's facts, or the plan-time or standing word's merge; after a clean catch-up's line,
  # the same for once the merge's checks pass, with no checks of the head it was made from.
  jq -r --arg task "$task" --argjson review "$review" --argjson risky "$risky" --arg caught "$caught" \
    --arg before "$before" '
    (.pr | if $caught != "" then "\(.url) at \(.head)"
      else "\(.url) at \(.head), agent-review \(.agent_review), "
        + ([(.checks.failing | select(. != []) | "failing: \(join(", "))"),
            (.checks.pending | select(. != []) | "pending: \(join(", "))"),
            (.required_missing | select(. != []) | "missing: \(join(", "))")]
          | if . == [] then "checks green" else "checks \(join("; "))" end) end) as $facts
    | (.merge_preapproval | . != null and .withdrawn == null and .opted_in == true and .own != true) as $planned
    | (.pr.standing_word | . != null and .word != null and .withdrawn == null) as $standing
    | ([if $planned then "plan-time" else empty end, if $standing then "standing" else empty end]
       | if . == [] then ""
         elif length == 1 then ", so the \(.[0]) word does not hold"
         else ", so the \(join(" and ")) words do not hold" end) as $held
    | ($review.guarded // []) as $guarded
    | (if $caught != "" then "then, once the checks pass on its merge: " else "" end)
    + if $guarded != [] or $risky != [] then "merge ask: \($facts)"
      elif $planned then "merge pre-approved: run team-merge \($task) for \($facts)"
      elif $standing then "merge on the standing word: run team-merge \($task) for \($facts)"
      else "merge ask: \($facts)" end
    + (if $guarded == [] then ""
       else "; the review found guarded areas: \($guarded | join(", "))\($held)" end)
    + (if $held != "" and $risky != [] then
         "; \($risky | if length < 2 then join("") else "\(.[:-1] | join(", ")) and \(.[-1])" end)\($held)"
       else "" end)
    + (if $before == "" then "" else "; queue before notes \($before) as follow-ups and say where each went" end)' <<<"$state"
  exit 0
fi

if [[ $handoff == round ]]; then
  # The stowed builder's round goes to a fresh builder in the latest builder launch's project.
  project=$(jq -r 'map(select(.event == "launch" and .role == "builder")) | last | .project // empty' <<<"$events")
  [[ -n $project ]] || die "$task has no builder launch naming a project, so the round has none"
  worktree=$(project_worktree "$project") || exit
  # round-<k>: the lowest k from 1 whose brief no launch read.
  k=1
  while [[ -e $TEAM_HOME/tasks/$task/brief-round-$k.md ]] &&
    brief_launched "round-$k"; do
    k=$((k + 1))
  done
  hand_off builder builder-round "round-$k" "$project" "$worktree"
  exit 0
fi

if [[ $handoff == review ]]; then
  # In one jq run: the event the hand-off follows (key: the pr of a PR, else the builder's done),
  # its url and head; when that event is logged already and a reviewer's launch follows it with no
  # review since (a review since means the message is a later round's, the same PR head after a
  # round that only edited its body), that launch; the head the done reports; and the projects of
  # the task's open worktrees, one a line.
  key_event='done'
  [[ $kind != PR ]] || key_event='pr'
  after='' url='' head='' reported='' projects=''
  json_vars --ledger after="$same_def"' . as $events | ($parsed | map(select(.event == $k)) | first) as $key
    | ([to_entries[] | select(.value | same($key)) | .key] | last) as $at
    | if $at == null then null
      else $events[$at + 1:] as $rest
      | if any($rest[]; .event == "review") then null
        else first($rest[] | select(.event == "launch" and .role == "reviewer")) // null end end
    | select(. != null) | "\($task)-\(.role) \(.session) was launched at \(.ts) after its \($key.event)"' \
    url='$parsed | map(select(.event == $k)) | first | .url | tostring' \
    head='$parsed | map(select(.event == $k)) | first | .head | tostring' \
    reported='$parsed | map(select(.event == "done")) | first | .report | select(. != null) | [splits("\\s+")]
      | if .[0] == "merged" then .[2] else .[1] end | tostring' \
    projects='reduce (open_worktrees(.[]; $home) | .project | tostring) as $p ([]; if IN(.[]; $p) then . else . + [$p] end)
      | join("\n")' \
    -- --argjson parsed "$parsed" --arg k "$key_event" --arg task "$task" <<<"$events"
  [[ -z $after ]] || die "$kind is already handed off: $after"

  sets=()
  if [[ $kind == PR ]]; then
    [[ $url =~ ^https://github\.com/([^/]+/[^/]+)/pull/[0-9]+/?$ ]]
    repo=${BASH_REMATCH[1]}
    project=''
    while IFS= read -r p; do
      [[ -n $p ]] || continue
      r=$(team_project "$p" repo) || exit 1
      [[ ${r,,} != "${repo,,}" ]] || project=$p
    done <<<"$projects"
    [[ -n $project ]] || die "$url is in no repo of $task's open worktrees"
    worktree=$(project_worktree "$project") || exit
    sets=(--set "pr=$url" --set "head=$head")
  else
    # The reported head must be the HEAD of the sending builder's worktree.
    worktree=$sender_wt project=$launch_project
    [[ -n $project ]] || die "the sending builder's launch names no project, so its review has none"
    [[ -d $worktree ]] || die "the sending builder's worktree $worktree is not on this machine"
    if ! head=$(git -C "$worktree" rev-parse -q --verify "$reported^{commit}" 2>/dev/null) ||
      [[ $head != "$(git -C "$worktree" rev-parse HEAD)" ]]; then
      die "$reported is not the HEAD of $worktree ($(git -C "$worktree" rev-parse --short=8 HEAD)), so it is not reviewed"
    fi
    [[ $kind == "DONE merged" ]] || sets=(--set "head=$head")
  fi

  if [[ $latest == null ]]; then
    [[ -n $checks ]] || die "$task has no review yet, so its first reviewer needs --checks <file>, the review's checks"
    [[ -z $template_opt ]] || die "$task has no review yet, so its first reviewer takes the reviewer brief, not --template $template_opt"
    [[ -z $since ]] || die "$task has no review yet, so there is no since for --since"
    template=reviewer name=review
    sets+=(--set-file "checks=$checks")
  else
    [[ -z $checks ]] || die "$task has a review already, so --checks is for its first reviewer only; a rereview takes --since"
    if [[ -n $template_opt ]]; then
      template=$template_opt
    elif [[ $kind == "DONE merged" ]]; then
      template=rereview
    else
      template=$(ledger_jq 'if ($latest.sent_back // []) != []
          and ((($latest.findings // {}) as $f | ["blocking", "correctness", "security", "real-data"] | all(.[]; $f[.] == 0))
            or same_head($latest.head; $head))
        then "verify" else "rereview" end' -nr --argjson latest "$latest" --arg head "$head")
    fi
    [[ $template == rereview || $kind != "DONE merged" ]] ||
      die "a DONE merged is re-reviewed with rereview, whose since names the merge; verify reads only a round's fix"
    [[ -z $since || $template == rereview ]] || die "--since is for a rereview; verify derives no since"
    [[ -z $since ]] || sets+=(--set-file "since=$since")
    # rereview-<k>: the lowest k from 2 whose brief no launch read.
    k=2
    while [[ -e $TEAM_HOME/tasks/$task/brief-rereview-$k.md ]] &&
      brief_launched "rereview-$k"; do
      k=$((k + 1))
    done
    name=rereview-$k
  fi
  hand_off reviewer "$template" "$name" "$project" "$worktree" "${sets[@]}"
  exit 0
fi

# A builder's DONE <NN>: the next ticket's builder, or the deliverer.
# In one jq run: the ticket, its shas one a line, and, when the same ticket-done (its ticket and
# shas) is logged already and a launch follows it, that launch; the launch is read before the
# sender, whom team-log takes to be the latest builder, the next one once the hand-off launched it.
ticket='' commits='' after=''
json_vars ticket='$reported.ticket | tostring' commits='[$reported.commits[]? | tostring] | join("\n")' \
  after='. as $events
  | ([to_entries[] | select(.value.event == "ticket-done" and .value.ticket == $reported.ticket and .value.commits == $reported.commits) | .key] | last) as $at
  | if $at == null then null
    else first($events[$at + 1:][] | select(.event == "launch" and .role != "ops")) // null end
  | select(. != null) | "\($task)-\(.role) \(.session) was launched at \(.ts)"' \
  -- --argjson reported "$(jq -c 'map(select(.event == "ticket-done")) | first' <<<"$parsed")" \
  --arg task "$task" <<<"$events"
[[ -z $after ]] || die "ticket $ticket is already handed off: $after after its ticket-done"

tickets=$(sibling team-tickets "$task" --json) || exit

# In one jq run over the tickets: whether NN is one, and once NN is done (updated): the tickets,
# NN's phase, whether the task has more than one phase, the phase being built (the earliest, up to
# NN's, with a ticket not done; empty when none), the ticket chosen (--next's, else that phase's
# lowest-numbered ready one), whether it is ready or waiting, what it waits on, its phase, its
# project, and NN's phase's tickets as a list.
waits='def waits: .ticket + " " + .state + ({blocked: " on \(.on | join(", "))", running: " in session \(.session)", waiting: ": \(.waits_for)"}[.state] // "");'
updated='def updated: map(if .ticket == $t then .state = "done" | .session = null else . end)
  | [.[] | select(.state == "done") | .ticket] as $done
  | map(if .state == "blocked" then (.on - $done) as $on
      | if $on == [] then .on = [] | .state = (if .waits_for == null then "ready" else "waiting" end) else .on = $on end
    else . end)
  | sort_by(.ticket);
  def phase: map(select(.ticket == $t)) | first | .phase // 1;
  def building: phase as $p | [.[] | select(.state != "done" and (.phase // 1) <= $p) | .phase // 1] | min;
  def chosen: if $n != "" then map(select(.ticket == $n)) | first
    else building as $b | map(select(.state == "ready" and (.phase // 1) == $b)) | first end;'
known='' listed='' phase='' phased='' building='' chosen='' chosen_ok='' chosen_waits='' chosen_phase=''
chosen_ticket='' chosen_project='' phase_tickets=''
json_vars known='any(.[]; .ticket == $t)' listed='map(.ticket) | sort | if . == [] then "none" else join(", ") end' \
  phase="$updated updated | phase" phased="$updated updated | map(.phase // 1) | unique | length > 1" \
  building="$updated updated | building // empty" \
  chosen="$updated updated | chosen | tojson" \
  chosen_ok="$updated updated | chosen | select(. != null) | .state == \"ready\" or .state == \"waiting\"" \
  chosen_waits="$updated $waits updated | chosen | select(. != null) | waits" \
  chosen_phase="$updated updated | chosen | select(. != null) | .phase // 1" \
  chosen_ticket="$updated updated | chosen | select(. != null) | .ticket | tostring" \
  chosen_project="$updated updated | chosen | select(. != null) | .project | tostring" \
  phase_tickets="$updated updated | phase as \$p | [.[] | select((.phase // 1) == \$p) | .ticket] | map(tostring)
    | if length < 2 then join(\"\") else \"\\(.[:-1] | join(\", \")) and \\(.[-1])\" end" \
  -- --arg t "$ticket" --arg n "$next" <<<"$tickets"
[[ $known == true ]] || die "$task has no ticket $ticket: its tickets are $listed"

# Every sha is a commit the sending builder's worktree's HEAD holds.
[[ -d $sender_wt ]] || die "the sending builder's worktree $sender_wt is not on this machine"
while IFS= read -r sha; do
  [[ -n $sha ]] || continue
  if ! commit=$(git -C "$sender_wt" rev-parse -q --verify "$sha^{commit}" 2>/dev/null) ||
    ! git -C "$sender_wt" merge-base --is-ancestor "$commit" HEAD 2>/dev/null; then
    die "$sha is not a commit the HEAD of $sender_wt holds, so ticket $ticket is not handed off"
  fi
done <<<"$commits"

# The not-done tickets of the phase being built, each with what it waits on.
open_list() {
  jq -r --arg t "$ticket" --argjson b "$building" "$updated $waits"' updated | map(select(.state != "done" and (.phase // 1) == $b) | waits) | join("; ")' <<<"$tickets"
}
if [[ -n $next ]]; then
  [[ $chosen != null ]] || die "--next $next is none of $task's tickets: they are $(jq -r --arg t "$ticket" "$updated"' updated | map(.ticket) | join(", ")' <<<"$tickets")"
  [[ $chosen_ok == true ]] || die "--next $next is not ready once $ticket is done: $chosen_waits"
  [[ -n $building ]] ||
    die "phase $phase's tickets are all done once $ticket is, so its deliverer comes next, not --next $next"
  [[ $chosen_phase == "$building" ]] ||
    die "--next $next is in phase $chosen_phase, but phase $building has tickets not done: $(open_list)"
elif [[ -z $building ]]; then
  chosen=deliver
else
  [[ $chosen != null ]] ||
    die "tickets $([[ $phased == false ]] || echo "of phase $building ")remain once $ticket is done, but none is ready: $(open_list); --next <NN> launches a waiting one"
fi

if [[ $chosen == deliver ]]; then
  # deliver, or deliver-p<n> for a phase of a phased task; a name a launch read takes -2, -3...
  base=deliver sets=()
  if [[ $phased == true ]]; then
    base=deliver-p$phase
    sets=(--set "tickets=every ticket of phase $phase ($phase_tickets)")
  fi
  template=builder-deliver name=$base k=1
  while [[ -e $TEAM_HOME/tasks/$task/brief-$name.md ]] &&
    brief_launched "$name"; do
    k=$((k + 1))
    name=$base-$k
  done
  project=$launch_project
else
  template=builder-ticket name=build-$chosen_ticket sets=(--set "ticket=$chosen_ticket")
  project=$chosen_project
fi
[[ -n $project ]] || die "the sending builder's launch names no project, so the deliverer has none"
worktree=$(project_worktree "$project") || exit
hand_off builder "$template" "$name" "$project" "$worktree" "${sets[@]}"
