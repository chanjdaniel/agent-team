#!/usr/bin/env bash
# Tell where the tasks' and the workers' time went: hours per task and per phase and the counts,
# from the ledger; each worker's lifetime, from the ledger; and where it went, from the time rows.
#
# Usage: team-time [--since <ISO>] [--until <ISO>] [--task T<n>] [--json]
# Measures each task team-time can place, one with an opened event (legacy tasks are left out),
# from its opened to its closed, or to --until (default now) while it is open, cut to the window
# from --since (default the ledger's start) to --until; --task measures that task alone.
# Each stretch of a task's time is one phase, walked through its events in ledger order:
#   a park (waiting, blocked, paused, held) holds until the next launch or resumed, or, for a
#   wait on Daniel, merge-approved, never an answered; it is classed first match wins: wait:limit
#   (the usage, token, weekly or session limit), wait:off (stowed, shutdown, OS update, handoff);
#   then its on, when given, decides before its reason, in any case: wait:daniel (on=Daniel),
#   wait:task (on=T<n>), unattributed (on=coordinator), gate (on=gate), wait:other
#   (on=schedule), wait:external (any other party); then its reason: wait:external (GitHub
#   Support, Dependabot), wait:task ("waits for T<n>" and the like), wait:denial (a blocked
#   naming a denial or refusal), wait:daniel (naming Daniel), wait:machine (load, memory,
#   Docker, a restart, an outage), gate (a pause naming the gate), wait:daniel (a waiting),
#   wait:other; a park logged after the fact with since holds from since, not from its own ts;
#   an asked with no park standing is a wait on Daniel until it and every ask asked while it
#   stands are settled, each by an answered or merge-preapproved with its id or a merge-approved
#   whose url its text names, or a launch, resumed or another park ends it;
#   with no park, the last marker: a planner or ops launch planning, a builder's building, a
#   reviewer's review, merge-approved merging, a passing review while a plan-time approval of the
#   task stands (a merge-preapproved of a project with no later merge-preapproval-withdrawn of it)
#   merging until the merged, or until a withdrawal leaves none standing with no merge-approved
#   since that review, and a done (save one in that merging), merged or review unattributed (the
#   coordinator's turn, or a gate run the ledger did not see); a task starts unattributed;
#   with no park, an ask still open while the phase is unattributed is a wait on Daniel.
# A gate-run's minutes, ending at its ts, are gate time taken from building, unattributed or a
# wait on Daniel.
# Then the counts, of the events in the window: gate runs per PR (a run's PR is the first pr
# event after it, else the latest before it), by cause ("none" for a first run) and by outcome,
# with each step's median minutes; reviews and findings per PR (a review's PR is the latest pr
# event before it, else the first after it); builder launches and tickets done per task; denials
# (blocked events classed wait:denial); Daniel's answers, each asked matched to the task's next
# event that settles it, with the median and 90th percentile minutes by nearest rank; and each
# done's seconds to the task's next event.
# Then each worker's lifetime, from the ledger's events up to --until, legacy tasks included: one
# per launch with a session. Its rounds are its reports: its session's dones and, for a builder,
# the task's prs, after its launch and before the task's next builder launch (a pr names no
# session: a delivering builder's PR <url> is logged as one), each ending a round that the task's
# ticket-dones in that span before it join (with no report after them, a round of their own, or
# after a report a late log of work it reported, dropped); an event within 5 minutes after a
# round's last joins it unless both are dones, since the coordinator logs a report's done with its
# ticket-done or pr. It runs from its launch to its last round's last event (ended done when that
# round holds a done, else pr or ticket-done); else, for a reviewer, to the task's last review
# before its next reviewer launch (review); else to the first after it of the task's next launch
# of the same role (replaced), its stowed (stowed) or its closed (closed); else it is running.
# Its project is the launch's, else the task's; its path the task's, else "-"; its model the
# launch's, else "default"; its first done the minutes to its first round's report; its phases
# its task's phase minutes over its span (null for a legacy task). A lifetime is in the
# window when it ended in it; one running at --until is listed apart with its age, in no average.
# The averages, over the window's lifetimes in minutes: workers, mean, median, 90th percentile by
# nearest rank and longest, by role, by role and path, by role and project, by role and model; then
# the ten longest. A session in a later round after --until counts again, longer, in a later window.
# Then where the workers' time went, from each launched session's time rows (team-tokens --help),
# read by running team-tokens time --since <the earliest start among the window's lifetimes>
# --until <until> once, and not at all with no lifetime: a lifetime's rows are all those whose
# session begins with its own, so its transcript time can run past its end. Each row's key is
# classed when the report runs, first match wins, looking through "background " and its kind:
# model, compaction, wait:message, wait:other, wait:error; for a command checks (team-checks, or a
# name naming a linter, formatter or type checker, go vet), gate (no-mistakes, git push
# no-mistakes), ci (team-ci-wait, gh or gh-axi pr checks, run watch or run view), tests (tests/run,
# bats, playwright, pytest, vitest, jest, go, cargo, npm, pnpm, yarn or bun test, npm run test...
# and the like, a program named with test), stacks (team-stack, docker), browser
# (chrome-devtools-axi, team-ui), git (any other git, gh or gh-axi);
# for a tool browser (Chrome DevTools'), subagents (Agent), files (Read, Edit, Write, Grep, Glob,
# NotebookEdit); else other. A lifetime's unseen minutes are its minutes less its transcript's,
# when more: time before its transcript's first line or after its last, as a dead or stuck session
# waiting for its replacement. Its waits are cut to its span, then split by its task's phases ("-"
# for a legacy task). The breakdown is over the window's lifetimes with rows: per role the minutes
# and share of each class, unseen included; the fifteen keys with the most minutes; and per role
# the minutes waiting for a message by what the task was doing. When team-tokens fails (no machine
# name, no Python 3.11), the rest prints and the breakdown is one line, unavailable with
# team-tokens's first error line.
# Prints the tables as text; --json prints the report (schema team-time/1): since, until, wall,
# tasks (task, project, path, closed, wall, hours per phase), phases (all, share in percent, and
# projects), gate_runs (per_pr, by_cause, by_outcome, step_minutes), reviews, builders, denials,
# answers (answered, unanswered, median_minutes, p90_minutes), done_to_next (count,
# median_seconds, p90_seconds, within_minute) and workers: lifetimes (task, project, path, role,
# session, model, start, end, ended, minutes, rounds, first_done_minutes, phases, transcript),
# running (the same, with age_minutes), stats (by_role, by_role_path, by_role_project,
# by_role_model, each a list of role, the group's key, workers, mean, median, p90 and longest),
# longest (sessions, longest first), breakdown (null when team-tokens failed: coverage {lifetimes,
# transcripts, roles}, classes and share {role and all: {class: minutes, or percent}}, top (key,
# class, minutes, calls, longest, lifetimes) and waits {role: {phase: minutes}}) and transcripts
# {rows (those read, null when it failed), error}; a lifetime's transcript is null with no row,
# else minutes, first, last, classes, top (its three: key, minutes, calls, longest), unseen and
# waits {class: {phase: minutes}}. Hours have three decimals, minutes one.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-time [--since <ISO>] [--until <ISO>] [--task T<n>] [--json]"

since='' until='' task='' json=''
while (($# > 0)); do
  case $1 in
    --since | --until | --task)
      [[ $# -ge 2 ]] || usage_error "$usage"
      printf -v "${1#--}" '%s' "$2"
      shift 2
      ;;
    --json)
      json=1
      shift
      ;;
    *) usage_error "$usage" ;;
  esac
done
iso='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
[[ -z $since || $since =~ $iso ]] || usage_error "--since must be a UTC time like 2026-10-22T01:00:00Z"
[[ -z $until || $until =~ $iso ]] || usage_error "--until must be a UTC time like 2026-10-22T01:00:00Z"
[[ -z $task || $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"
until=${until:-$(date -u +%FT%TZ)}
[[ -z $since || $since < $until ]] || usage_error "--since must come before --until"

ledger=$TEAM_HOME/ledger.jsonl
[[ -f $ledger ]] || die "no ledger at $ledger"

# The task report, then the workers report beside it: workers.jq reads the ledger's lines after the
# task report's one line, since each report reads the ledger as its input and time.jq stays as is.
report=$(
  {
    jq -L "$TEAM_LIB" -cnR --arg since "$since" --arg until "$until" --arg task "$task" '
      include "time"; include "ledger";
      time_report(if $since == "" then 0 else $since | fromdate end; $until | fromdate;
        if $since == "" then null else $since end; $until; if $task == "" then null else $task end)' "$ledger"
    cat "$ledger"
  } | jq -L "$TEAM_LIB" -cnR --arg since "$since" --arg until "$until" --arg task "$task" '
    include "workers"; include "time"; include "ledger";
    (input | fromjson) as $report
    | $report + {workers: workers_report(if $since == "" then 0 else $since | fromdate end; $until | fromdate;
        if $task == "" then null else $task end)}'
)

# Where the workers' time went: the time rows of the days from the earliest lifetime's start, read
# through team-tokens, the one transcript parser; when it cannot run, its first error line.
first=$(jq -r '[.workers.lifetimes[].start] | min // empty' <<<"$report")
rows='' error=''
if [[ -n $first ]]; then
  err=$(mktemp)
  trap 'rm -f "$err"' EXIT
  since_args=(--since "$first")
  [[ $first < $until ]] || since_args=()
  if ! rows=$(TEAM_HOME=$TEAM_HOME "$(dirname "${BASH_SOURCE[0]}")/team-tokens" time "${since_args[@]}" --until "$until" </dev/null 2>"$err"); then
    rows=''
    IFS= read -r error <"$err" || true
    error=${error:-team-tokens time failed with no message}
  fi
fi
report=$(
  { printf '%s\n' "$report"; printf '%s' "$rows"; } | jq -L "$TEAM_LIB" -cn --arg error "$error" '
    include "workers"; include "time"; include "ledger";
    input as $report | [inputs] as $rows
    | $report | .workers |= workers_join($rows; if $error == "" then null else $error end)'
)

if [[ -n $json ]]; then
  jq . <<<"$report"
else
  jq -L "$TEAM_LIB" -r 'include "workers"; include "time"; include "ledger"; time_text, "", workers_text' <<<"$report"
fi
