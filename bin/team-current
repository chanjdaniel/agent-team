#!/usr/bin/env bash
# Edit the coordinator's current items, the team home's tasks/current.md, by a short id.
#
# Usage: team-current add <kind> <task or -> <text> --where <detail>
#        team-current done <id>
#        team-current list
#        team-current check
# The file is "# Current items", then one line per item, "- <kind> <task or -> <text> | <where>".
# An item's id is the first 6 hex digits of the sha256 of its line without the leading "- ".
# add appends the item's line (making the file, with its title, when there is none) and prints its
# id; the text is the words between the task and --where, joined by spaces. done removes the one
# item whose id is <id> or starts with it (at least 4 hex digits), and prints it. list prints each
# item as "<id> <its line without "- ">". check prints each line that add would refuse, as
# "tasks/current.md:<n>: <reasons>", and every line that is neither the title, blank nor an item,
# exiting 1 when there is any; it never writes.
# add refuses: a kind other than ask, owe, next, queued or watch; a task that is not T<n> or -;
# text holding " | " or a newline; a line over 300 characters; a line already in the file; and a
# where that is none of these: an http(s) URL (a Discord link is one), a Discord id (optionally
# "Discord <id>"), "ledger <UTC time>" (as 2026-11-01T07:08:11Z), or a file in the team home,
# named relative to it, in full or under ~/. A where under /tmp/, /var/tmp/, /var/folders/,
# /private/var/folders/, $TMPDIR or ~/.claude/jobs/ is refused as a temp path.
# add and done change the file under the ledger's lock and commit it alone (commit_records), as
# "chore: current <kind> <task>" and "chore: current done <id>", then push the team home's
# branch. A commit the team home's hooks refuse undoes the change and exits 1; a push that fails
# keeps the commit for the next checkpoint to push, saying so on stderr, and exits 0.
# Exit codes: 0 done, 1 refused or a check failed, 2 a malformed command line.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-current add <kind> <task or -> <text> --where <detail> | done <id> | list | check"
current=$TEAM_HOME/tasks/current.md
rel=tasks/current.md
title="# Current items"
max_length=300

# The id of an item line: item_id <line>
item_id() {
  printf '%s' "${1#- }" | sha256sum | cut -c1-6
}

# The team home, resolved, and the temp directories, each resolved (macOS's /var/folders is /private/var/folders), / never one.
home=$(realpath -m -- "$TEAM_HOME")
temp_roots=()
for root in /tmp /var/tmp /var/folders /private/var/folders "$HOME/.claude/jobs" ${TMPDIR:+"$TMPDIR"}; do
  root=$(realpath -m -- "$root")
  [[ -z ${root%/} ]] || temp_roots+=("${root%/}")
done

# Whether the resolved <path> is under one of the temp directories: is_temp <path>
is_temp() {
  local root
  for root in "${temp_roots[@]}"; do
    [[ $1/ == "$root"/* ]] && return 0
  done
  return 1
}

# Why <where> is no place for an item's detail, or nothing when it is one: where_problem <where>
where_problem() {
  local where=$1 path resolved
  if [[ $where =~ ^https?://[^[:space:]]+$ || $where =~ ^(Discord\ )?[0-9]{17,20}$ ||
    $where =~ ^ledger\ [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
    return 0
  fi
  path=$where
  # shellcheck disable=SC2088 # a literal ~/, as the coordinator writes it
  [[ $path != '~/'* ]] || path=$HOME/${path#'~/'}
  [[ $path == /* ]] || path=$TEAM_HOME/$path
  resolved=$(realpath -m -- "$path")
  if [[ $resolved == "$home"/* && -f $resolved ]]; then
    return 0
  elif [[ $resolved != "$home"/* ]] && is_temp "$resolved"; then
    echo "the where '$where' is a temp path"
  else
    echo "the where '$where' is not a file in the team home"
  fi
}

# Why an item of <kind>, <task>, <text> and <where> may not be the line <line> of the file, one
# reason per line, nothing when it may; <lines> names the array of the file's lines, for the
# duplicate, and <at> the line's own index in it (-1 for a new line): item_problems <kind> <task>
# <text> <where> <line> <lines> <at>
item_problems() {
  local kind=$1 task=$2 text=$3 where=$4 line=$5 at=$7 i length
  local -n others=$6
  [[ $kind =~ ^(ask|owe|next|queued|watch)$ ]] || echo "kind '$kind' is not ask, owe, next, queued or watch"
  [[ $task =~ ^(T[0-9]+|-)$ ]] || echo "task '$task' is not T<n> or -"
  [[ -n $text ]] || echo "the line has no text"
  [[ $text != *' | '* ]] || echo "the text holds ' | '"
  [[ $text != *$'\n'* ]] || echo "the text holds a newline"
  if [[ $where == *' | '* ]]; then
    echo "the where holds ' | '"
  elif [[ $where == *$'\n'* ]]; then
    echo "the where holds a newline"
  else
    where_problem "$where"
  fi
  length=$(jq -rn --arg line "$line" '$line | length')
  ((length <= max_length)) || echo "the line is $length characters, over $max_length"
  for ((i = 0; i < ${#others[@]} && (at < 0 || i < at); i++)); do
    if [[ ${others[i]} == "$line" ]]; then
      echo "the line is already in $rel, at line $((i + 1))"
      break
    fi
  done
}

# item_problems' reasons on one line, joined by "; ", nothing when there are none: problems_line
# <item_problems' arguments>
problems_line() {
  local -a reasons
  local IFS=$'\x1f' joined
  mapfile -t reasons < <(item_problems "$@")
  ((${#reasons[@]})) || return 0
  joined="${reasons[*]}"
  printf '%s\n' "${joined//$'\x1f'/; }"
}

# The file's lines, into the array lines (none when there is no file): read_lines
read_lines() {
  lines=()
  [[ ! -e $current ]] || mapfile -t lines <"$current"
}

# Write the array lines as the file, under the ledger's lock (commit_records holds it): write_lines
write_lines() {
  printf '%s\n' "${lines[@]}" >"$current"
}

# The edits, each run by commit_records under the ledger's lock, so the change and its commit are
# one step; each reads the file afresh there and keeps it in $scratch/before and $scratch/after.
edit_add() {
  local problems
  read_lines
  keep before
  problems=$(problems_line "$kind" "$task" "$text" "$where" "$line" lines -1)
  [[ -z $problems ]] || die "refusing the item: $problems"
  ((${#lines[@]})) || lines=("$title")
  lines+=("$line")
  write_lines || die "cannot write $current"
  keep after
  item_id "$line"
}

edit_done() {
  read_lines
  keep before
  find_match
  [[ $(item_id "${lines[match]}") == "$id" ]] || die "$rel changed meanwhile; run it again"
  removed=${lines[match]}
  unset 'lines[match]'
  lines=("${lines[@]}")
  write_lines || die "cannot write $current"
  keep after
  echo "removed $id ${removed#- }"
}

# The index in the array lines of the one item whose id starts with $prefix, as match; refuses an
# id matching none or more than one: find_match
find_match() {
  local i
  local -a matches=()
  for i in "${!lines[@]}"; do
    [[ ${lines[i]} == '- '* && $(item_id "${lines[i]}") == "$prefix"* ]] && matches+=("$i")
  done
  ((${#matches[@]} > 0)) || die "$prefix matches no item in $rel"
  if ((${#matches[@]} > 1)); then
    die "$prefix matches ${#matches[@]} items: $(for i in "${matches[@]}"; do
      printf '%s %s; ' "$(item_id "${lines[i]}")" "${lines[i]#- }"
    done | sed 's/; $//')"
  fi
  match=${matches[0]}
}

# Keep the file as it is now as $scratch/<name>, or note there is none: keep <name>
keep() {
  rm -f "$scratch/$1" "$scratch/$1.none"
  if [[ -e $current ]]; then cp "$current" "$scratch/$1"; else : >"$scratch/$1.none"; fi
}

# Commit the change records_edit makes, as <message>; when the commit fails, undo the change, if
# the file still holds it, and exit 1: commit_change <message>
commit_change() {
  local rc=0
  mkdir -p "$TEAM_HOME/tasks"
  commit_records "$1" "$rel" || rc=$?
  ((rc)) || return 0
  if git -C "$TEAM_HOME" show "HEAD:$rel" 2>/dev/null | cmp -s - "$scratch/after"; then
    return 0
  fi
  {
    flock -x 9
    if cmp -s "$current" "$scratch/after"; then
      if [[ -e $scratch/before.none ]]; then rm -f "$current"; else cp "$scratch/before" "$current"; fi
      git -C "$TEAM_HOME" restore --staged -- "$rel" 2>/dev/null || true
    fi
  } 9>>"$TEAM_HOME/ledger.jsonl.lock"
  die "$rel: not committed, so the change is undone"
}

(($#)) || usage_error "$usage"
command=$1
shift
case $command in
  add)
    where='' has_where='' words=()
    while (($#)); do
      if [[ $1 == --where ]]; then
        (($# > 1)) || usage_error "$usage"
        where=$2 has_where=1
        shift 2
      else
        words+=("$1")
        shift
      fi
    done
    [[ -n $has_where && -n $where && ${#words[@]} -ge 3 ]] || usage_error "$usage"
    kind=${words[0]} task=${words[1]}
    text="${words[*]:2}"
    line="- $kind $task $text | $where"
    scratch=$(mktemp -d)
    trap 'rm -rf "$scratch"' EXIT
    NET_ERR=$scratch/err
    # shellcheck disable=SC2034 # read by commit_records
    records_edit=edit_add
    commit_change "chore: current $kind $task"
    ;;
  done)
    (($# == 1)) || usage_error "$usage"
    [[ $1 =~ ^[0-9a-f]{4,6}$ ]] || usage_error "an id is 4 to 6 hex digits, not '$1'"
    prefix=$1 removed=''
    read_lines
    find_match
    id=$(item_id "${lines[match]}")
    scratch=$(mktemp -d)
    trap 'rm -rf "$scratch"' EXIT
    NET_ERR=$scratch/err
    # shellcheck disable=SC2034 # read by commit_records
    records_edit=edit_done
    commit_change "chore: current done $id"
    ;;
  list)
    (($# == 0)) || usage_error "$usage"
    read_lines
    for item in "${lines[@]}"; do
      [[ $item == '- '* ]] && printf '%s %s\n' "$(item_id "$item")" "${item#- }"
    done
    true
    ;;
  check)
    (($# == 0)) || usage_error "$usage"
    read_lines
    bad=0
    for i in "${!lines[@]}"; do
      item=${lines[i]}
      problems=''
      if [[ -z $item || $item == "$title" ]]; then
        continue
      elif [[ $item != '- '* ]]; then
        problems="not an item line (- <kind> <task or -> <text> | <where>)"
      else
        body=${item#- }
        bars=${body//' | '/$'\x1f'}
        bars=${bars//[!$'\x1f']/}
        if ((${#bars} == 0)); then
          problems="the line has no ' | <where>'"
        elif ((${#bars} > 1)); then
          problems="the line holds ' | ' more than once"
        else
          head=${body%% | *} where=${body#* | }
          read -r kind task text <<<"$head" || true
          problems=$(problems_line "$kind" "${task:-}" "${text:-}" "$where" "$item" lines "$i")
        fi
      fi
      if [[ -n $problems ]]; then
        echo "$rel:$((i + 1)): $problems"
        bad=1
      fi
    done
    exit "$bad"
    ;;
  *) usage_error "$usage" ;;
esac
