#!/usr/bin/env bash
# Find what the coordinator must not leave unattended, from the ledger, the live session list, the
# team's stow plan and the heartbeat's health view.
#
# Usage: team-sweep [--json | --wait]
# Reads only ledger.jsonl, claude agents --json, team-capacity plan --json (from the stored
# readings), team-timers health --json (the health view, from the heartbeat's health record, the
# lease record and the fence file, asked for at most 10 s, and only on a machine with a team
# name), the registry once the ledger holds a merge-standing (merge-due, below) and, through
# bin/lib/session-activity, the live sessions' transcripts: their modification times, and from a
# session's quiet past the default limit only its times, tool names, tool call ids, commands and
# background task marks (never GitHub, never a tool's output or a message's text, and never a new
# reading of the machine's load), so it runs in about a second.
# A task is open when it has events and no closed; it is parked when its phase is held, blocked
# or awaiting-merge, when it has an ask nothing settled (no answered or merge-preapproved with its
# id, no merge-approved whose url its text names), or when its latest paused or waiting has no
# later resumed or launch; an awaiting-merge task that nothing else parks is merge-due instead
# while Daniel's plan-time or standing merge word stands. Findings, one line each with the task,
# the session and the next step:
#   no-worker      an open task, not parked, with an opened or launch event and no live session
#                  among its launches at work: busy, waiting for input or silent (one idle with a
#                  ledger event since its launch, a denied aside, has handed the next step back);
#                  merged is told to close, and merged-part (a merged naming phases_left, phases
#                  with a ticket not done) to launch the next phase's first ticket's builder
#   waiting-input  a live session of an open task, not parked, whose state is blocked
#   silent         a live, idle session of an open task, not parked, with no ledger event for the
#                  task after that session's latest launch but denied ones (one waiting for input
#                  is not also silent)
#   stalled        a live, busy session of an open task, not parked, not waiting for input, whose
#                  transcripts (its own and its subagents', under ~/.claude/projects) have not been
#                  written for longer than its limit (stall_limits in bin/lib/ledger.jq), the
#                  largest of its running calls', each read from its whole command: 180 minutes for
#                  a command with no-mistakes as a word (the gate), 110 for one that runs
#                  team-ci-wait (which ends by about 100), none for one that runs team-thread wait (an
#                  interview's wait on Daniel), else 50, and 50 when none runs. A running call is a
#                  tool call started since the session's startedAt with no result yet, or in the
#                  background with no task notification yet. "<name> <short id> has written nothing
#                  for <h>h<mm>m" (or <m>m under an hour), then ', waiting on "<command>" (Bash, in
#                  the background, running <h>h<mm>m)' for the newest foreground call (it holds the
#                  turn) or else the oldest, "Bash in a subagent" for a subagent's, a tool other
#                  than Bash by its name, and ", and <n> more running" when others run; or " with no
#                  tool call running". None for a session whose transcript cannot be found
#   merge-due      an open task in awaiting-merge with a plan-time merge approval not withdrawn (its
#                  latest merge-preapproved of a project with no later merge-preapproval-withdrawn
#                  of it) or a standing word of Daniel's on one of its projects (those of its
#                  opened and worktree-added events: the latest merge-standing or
#                  merge-standing-withdrawn of the project or all, logged under any task, is a
#                  merge-standing) that a standing word may cover (standing_projects in
#                  bin/lib/team.sh: every registered project but the team's own, whose PRs merge
#                  only on the per-head word), no ask nothing settled, no paused or waiting
#                  standing, no merge-base round in flight (its latest builder launch or resumed
#                  naming a merge-base brief, with no review, caught-up or merged since and a
#                  worker on it live with no done since) and a PR not merged with no review-side
#                  reason against the word (team-state's: the latest review of the latest head
#                  the task logged for it a pass that found no guarded area, and no review of the
#                  task that counted a security or real-data finding or left its counts out),
#                  with session null:
#                  "awaiting the merge of
#                  <those PRs' URLs> on Daniel's plan-time word on
#                  <projects>, with no ask open; next: run team-merge T<n>; on a refusal, ask
#                  Daniel for the per-head word with team-ask", with "standing word on
#                  <projects>" for the standing word, or "plan-time word on <projects> and
#                  standing word on <projects>" for both, and no other finding of the task's; the
#                  ledger names no PR's project, so any word on one of the task's projects counts,
#                  and GitHub is not read: team-merge says when a project no longer opts in, a
#                  PR's own project has no word or a changed path is guarded. The registry is read
#                  only once the ledger holds a merge-standing; when it cannot be read, no
#                  standing word counts and a line on stderr says why
#   stray          a live session named like a team worker (T<n>-<role>) whose task is closed or
#                  not in the ledger; never one of T0, the load check's task
#   coordinator-twin  after every task finding, with task null: one for each session named
#                  coordinator in the session list but the one the sweep runs in
#                  (CLAUDE_CODE_SESSION_ID's), when more than one is listed, with session its short
#                  id: "coordinator-twin: coordinator <id> (<kind>, <state or status>, started
#                  <time>) is a second session named coordinator on this machine; next: read claude
#                  logs <id> for anything left to log, then stop it with claude stop <id>" ("ask
#                  Daniel to end it, an interactive session, pid <pid>" for an interactive one, and
#                  "started at an unknown time" for one whose startedAt is not a number); when
#                  CLAUDE_CODE_SESSION_ID names none of them, each is "one of <n> sessions named
#                  coordinator" and its next starts "if it is not you, ". The list is this
#                  machine's: a Remote Control twin is the coordinator's own ListAgents check
#                  (bin/hooks/session-digest)
#   activity       after the coordinator-twin findings, with task and session null: session-activity
#                  failed (a Python older than 3.11, say, or a session with a transcript whose
#                  startedAt is not epoch milliseconds) or printed no JSON object, so no busy
#                  worker can be found stalled: "activity: <its last line on stderr>, so no busy
#                  worker is found stalled: fix what session-activity names"
#   level-stow     after the activity finding, with task and session null: team-capacity plan (from
#                  the stored readings) confirms the team over its budget at its level and names
#                  tasks to stow, newest first: "level: over budget at minor (30%): stow T174, then
#                  T171" (the coordinator sends their workers STOW, then runs team-stow)
#   level-resume   after it, with task and session null: the first task stowed, waiting to
#                  resume (for the level or a handoff), oldest stow first, whose roles' estimates
#                  fit the budget again and that nothing holds (a held standing, or a waiting or
#                  blocked logged after its stow standing, until a resumed): "level: T171 fits
#                  again: relaunch its builder"
#   level-launch   after it, with task and session null: the first task whose launches were
#                  refused for room (a standing paused of cause room, as park_cause reads
#                  team-worker's "no room for session:<role>" line, which the task's next launch
#                  or a resumed ends), oldest refusal first, whose
#                  roles fit again and that nothing holds (a held standing, or a waiting or
#                  blocked logged after its latest refusal standing, until a resumed): "level: T5
#                  has room again: launch its reviewer, refused for room at <time>"
#   level          in their place, with task and session null: team-capacity plan failed:
#                  "level: <its last line on stderr>: fix what team-capacity names"
#   retro-due      after the level findings, with task and session null: a retro is due, as
#                  team-retro status computes it (retros scheduled, no retro task open, the due
#                  time past): "retro due since <time> (every <n>h, last retro <T<n> or none>):
#                  run the retro skill"
#   checkpoint-stale  after retro-due, with task and session null: the health view's alerting
#                  problems whose sweep kind it is (checkpoint: failing two runs in a row or no
#                  good checkpoint for 15 minutes; heartbeat: no run for 15 minutes), in one
#                  finding: "checkpoint: <the problem's plain text>; next: fix what it names
#                  (heartbeat-failures.log has every line), then run team-checkpoint --force"
#   health         after it, with task and session null: the view's alerting problems whose sweep
#                  kind is health (login-refused, ledger, a step failing 12 runs in a row), joined
#                  by "; " in one finding: "health: <their plain texts>; next: fix what each
#                  names; team-timers health lists them"; or, when the view cannot be read
#                  (team-timers fails, times out or prints no team-health/1 view), "health: <its
#                  last line on stderr>: fix what team-timers names". The offline problem and the
#                  coordinator's own (coordinator, unattended) raise none, and a machine that does
#                  not hold the lease has no problems
# With --json, the findings as a list of {task, kind, session, name, next, text}.
# Exit 0 with no findings (and nothing printed but --json's []), 1 with findings, and 1 with the
# reason on stderr and nothing on stdout when the session list cannot be read.
#
# --wait is the coordinator's sweep watch, run with Bash run_in_background, which has no expiry
# and wakes it once, when the command ends: it looks every 30 s and ends once a finding that was
# not there at its first look has stood for three minutes, printing every finding in the text
# form and exiting 0. A finding is its task, kind and session. One there at the first look (most
# often the one just acted on) ends it only once it has stood for 30 minutes, at every readable
# look since, so a worker that stays stuck is never left unwatched for long; one that clears
# within three minutes (a no-worker between a DONE and the next launch) never ends it; either
# one, once cleared, counts as new when it comes back. It exits 1 with the reason
# on stderr when the session list cannot be read for five minutes running. Time is counted in
# looks, WAIT_SECONDS apart (a test steps it with a stub sleep), and TEAM_SWEEP_BASELINE_SECONDS
# replaces the 30 minutes' seconds (BASELINE_SECONDS, the tests' seam). Re-arm it after acting on
# what it printed.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

# --wait: seconds between looks, how long a new finding must stand, how long one there at the
# first look must, and how long the session list may stay unreadable.
WAIT_SECONDS=30
STAND_SECONDS=180
BASELINE_SECONDS=${TEAM_SWEEP_BASELINE_SECONDS:-1800}
UNREADABLE_SECONDS=300

[[ $BASELINE_SECONDS =~ ^[0-9]+$ ]] || usage_error "TEAM_SWEEP_BASELINE_SECONDS must be a number of seconds"

usage="usage: team-sweep [--json | --wait]"
mode=text
case $# in
  0) ;;
  1)
    case $1 in
      --json) mode=json ;;
      --wait) mode=watch ;;
      *) usage_error "$usage" ;;
    esac
    ;;
  *) usage_error "$usage" ;;
esac

ledger=$TEAM_HOME/ledger.jsonl
[[ -e $ledger ]] || ledger=/dev/null

# The quiet time from which session-activity may read a session's transcripts: the default stall
# limit, since no session quieter than that is stalled.
parse_after=$(ledger_jq 'stall_limits.default' -nr)

# session-activity's object for the session list (a JSON array), as {sessions: <its object>}:
# session_activity <sessions>
# When it fails, or prints no JSON object, {error: <its last line on stderr>} (~ for the home
# directory), which is the activity finding, so no session is stalled and the other findings
# still come.
session_activity() {
  local out errors status=0 reason
  errors=$(mktemp)
  out=$("$TEAM_LIB/session-activity" --parse-after "$parse_after" <<<"$1" 2>"$errors") || status=$?
  if ((status)); then
    reason=$(grep . "$errors" | tail -n 1) || reason="session-activity failed with exit $status and no reason given"
  elif ! out=$(jq -ce 'select(type == "object")' <<<"$out" 2>/dev/null); then
    reason="session-activity printed no JSON object"
  fi
  rm -f "$errors"
  if [[ -n ${reason:-} ]]; then
    jq -cn --arg error "${reason//"$HOME/"/"~/"}" '{error: $error}'
  else
    printf '{"sessions":%s}\n' "$out"
  fi
}

# The stow plan as one compact line: team-capacity plan --json's object, from the stored readings
# only (it takes none, so it writes nothing) and the session list in <file>, the look's own, or
# {error} with the last line team-capacity said on stderr (~ for the home directory) when it
# fails: level_plan <file>
level_plan() {
  local out err line
  out=$(mktemp) err=$(mktemp)
  if TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-capacity" plan --json --sessions "$1" >"$out" 2>"$err" </dev/null; then
    jq -c . "$out"
  else
    line=$(grep . "$err" | tail -n 1) || line="team-capacity plan failed with no reason given"
    jq -cn --arg error "${line//"$HOME/"/"~/"}" '{error: $error}'
  fi
  rm -f "$out" "$err"
}

# The most team-timers health may take, in seconds; it reads three files.
HEALTH_TIMEOUT=10

# The health view as one compact line: team-timers health --json's object (exit 1 with problems is
# a view all the same), {} on a machine with no team name, which holds no lease and so is not
# asked, or {error} with the last line team-timers said on stderr (~ for the home directory) when
# it prints no view: health_view
health_view() {
  local out err rc=0 line
  if ! machine_name >/dev/null 2>&1; then echo '{}'; return; fi
  out=$(mktemp) err=$(mktemp)
  TEAM_HOME=$TEAM_HOME bounded "$HEALTH_TIMEOUT" "$(dirname "$TEAM_LIB")/team-timers" health --json >"$out" 2>"$err" </dev/null || rc=$?
  if ! jq -ce 'select(type == "object" and .schema == "team-health/1" and (.problems | type) == "array")' "$out" 2>/dev/null; then
    if ((rc == 124)); then
      line="team-timers health timed out after $HEALTH_TIMEOUT s"
    else
      line=$(grep . "$err" | tail -n 1) || line="team-timers health exited $rc with no view"
    fi
    jq -cn --arg error "${line//"$HOME/"/"~/"}" '{error: $error}'
  fi
  rm -f "$out" "$err"
}

# The projects a standing word may cover (standing_projects in bin/lib/team.sh: every registered
# one but the team's own) as one JSON array, read only once the ledger holds a merge-standing,
# else []; with a registry it cannot read, [], saying why on stderr.
standing_covered() {
  local found err
  if ! grep -qF merge-standing "$ledger"; then echo '[]'; return; fi
  err=$(mktemp)
  if found=$(standing_projects 2>"$err"); then
    jq -cR '[., inputs | select(. != "")]' <<<"$found"
  else
    echo "team-sweep: counts no standing word of Daniel's, since the registry cannot be read: $(grep -m 1 . "$err" || echo "team-project failed")" >&2
    echo '[]'
  fi
  rm -f "$err"
}

# The findings now, as JSON in FINDINGS, from the ledger, a fresh read of the session list, the
# stow plan and the live sessions' transcripts; fails with the reason on stderr when the session
# list cannot be read.
look() {
  local sessions plan activity plan_file covered health plan_pid health_pid
  sessions=$(LIVE_SESSIONS='' && live_sessions && printf '%s' "$LIVE_SESSIONS") || return 1
  plan_file=$(mktemp)
  printf '%s\n' "$sessions" >"$plan_file.sessions"
  level_plan "$plan_file.sessions" >"$plan_file" &
  plan_pid=$!
  health_view >"$plan_file.health" &
  health_pid=$!
  activity=$(session_activity "$sessions")
  wait "$plan_pid" || true
  wait "$health_pid" || true
  plan=$(cat "$plan_file")
  health=$(cat "$plan_file.health")
  rm -f "$plan_file" "$plan_file.sessions" "$plan_file.health"
  [[ -n $plan ]] || plan='{"error": "team-capacity plan printed nothing"}'
  [[ -n $health ]] || health='{"error": "team-timers health printed nothing"}'
  covered=$(standing_covered)
  FINDINGS=$(ledger_jq 'ledger_events | sweep($sessions; $plan; $activity; $covered; $health; $self)' -nRc \
    --argjson sessions "$sessions" --argjson plan "$plan" --argjson activity "$activity" --argjson covered "$covered" \
    --argjson health "$health" --arg self "${CLAUDE_CODE_SESSION_ID:-}" "$ledger")
}

# The sweep watch: see --wait in the header.
wait_for_finding() {
  local look_n=0 failing_since='' key first=1
  local -A initial=() since=() now=()
  err=$(mktemp)
  trap 'rm -f "$err"' EXIT
  while :; do
    if look 2>"$err"; then
      failing_since=''
      now=()
      while IFS= read -r key; do
        now[$key]=1
        if ((first)); then
          initial[$key]=1
        elif [[ -z ${initial[$key]:-} && -z ${since[$key]:-} ]]; then
          since[$key]=$look_n
        fi
      done < <(jq -r '.[] | "\(.task)/\(.kind)/\(.session)"' <<<"$FINDINGS")
      first=0
      for key in "${!initial[@]}"; do
        if [[ -z ${now[$key]:-} ]]; then
          unset "initial[$key]"
        elif ((look_n * WAIT_SECONDS >= BASELINE_SECONDS)); then
          jq -r '.[].text' <<<"$FINDINGS"
          return 0
        fi
      done
      for key in "${!since[@]}"; do
        if [[ -z ${now[$key]:-} ]]; then
          unset "since[$key]"
        elif (((look_n - since[$key]) * WAIT_SECONDS >= STAND_SECONDS)); then
          jq -r '.[].text' <<<"$FINDINGS"
          return 0
        fi
      done
    else
      [[ -n $failing_since ]] || failing_since=$look_n
      if (((look_n - failing_since) * WAIT_SECONDS >= UNREADABLE_SECONDS)); then
        echo "team-sweep: $(sed -n 's/^team-sweep: //p' "$err" | tail -n 1), for $((UNREADABLE_SECONDS / 60)) minutes running" >&2
        return 1
      fi
    fi
    sleep "$WAIT_SECONDS"
    look_n=$((look_n + 1))
  done
}

case $mode in
  watch) wait_for_finding ;;
  json)
    look
    jq . <<<"$FINDINGS"
    [[ $FINDINGS == '[]' ]]
    ;;
  text)
    look
    jq -r '.[].text' <<<"$FINDINGS"
    [[ $FINDINGS == '[]' ]]
    ;;
esac
