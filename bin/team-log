#!/usr/bin/env bash
# Record an event the coordinator writes by hand in the ledger, against the ledger contract.
#
# Usage: team-log T<n> <event> [key=value]...
#        team-log --check [<file>]
# Appends {ts (now, UTC), task, event, key: value...}. A value is stored as JSON when it parses
# as JSON (a list, a number, true) and as a string otherwise; a field the contract types as a
# string is always a string. note is allowed on every kind. Kinds written by another script
# (opened, launch, merged, closed...) are refused, and so is a merge-approved whose url is not
# one of the task's pr events (a trailing slash aside). A park (waiting, blocked, paused, held)
# logged after the fact takes since=<UTC time>, when it began: no later than now and no earlier
# than the task's latest event, or it is refused naming both times; no other kind takes since.
# --check checks a ledger (default: the team home's): every line is JSON with ts, task and
# event, and lines from strict_from on meet their kind's fields; exit 1 lists each bad line.
set -euo pipefail

# Printed by --help after the header.
help_more() {
  echo
  ledger_jq '"Ledger contract, strict from \($contract.strict_from) (bin/lib/ledger-contract.json):", ($contract | contract_table)' -nr
}

source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-log T<n> <event> [key=value]... | team-log --check [<file>]"

if [[ ${1:-} == --check ]]; then
  [[ $# -le 2 ]] || usage_error "$usage"
  file=${2:-$TEAM_HOME/ledger.jsonl}
  [[ -f $file ]] || die "no ledger at $file"
  report=$(ledger_jq 'check_ledger($contract)' -nRc <"$file")
  read -r total bad < <(jq -r '"\(.total) \(.bad | length)"' <<<"$report")
  if ((bad > 0)); then
    jq -r --arg file "$file" '.bad[] | "\($file):\(.line): \(.problems | join("; "))"' <<<"$report" >&2
    echo "$file: $bad of $total lines break the ledger contract" >&2
    exit 1
  fi
  if ((total == 1)); then echo "$file: 1 line meets the ledger contract"; else echo "$file: $total lines meet the ledger contract"; fi
  exit 0
fi

[[ $# -ge 2 ]] || usage_error "$usage"
task=$1 event=$2
shift 2
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"
ledger_jq '$contract.kinds | has($event)' -ne --arg event "$event" >/dev/null ||
  die "unknown event kind '$event'; team-log --help lists the kinds"

declare -A seen=()
pairs=()
for pair in "$@"; do
  key=${pair%%=*}
  [[ $pair == *=?* && $key =~ ^[a-z][a-z0-9_]*$ ]] || usage_error "not a key=value: '$pair'"
  [[ $key != ts && $key != task && $key != event ]] || usage_error "$key is set by team-log"
  [[ -z ${seen[$key]:-} ]] || usage_error "$key is given twice"
  seen[$key]=${pair#*=}
  pairs+=("$key" "${pair#*=}")
done

# Daniel's word is on one PR: the approval names it as one of the task's pr events does.
if [[ $event == merge-approved && -n ${seen[url]:-} ]]; then
  problem=$(task_events "$task" | jq -nr --arg url "${seen[url]}" --arg events "$task's pr events" '
    [inputs | select(.event == "pr") | .url | strings] as $prs
    | if any($prs[]; rtrimstr("/") == ($url | rtrimstr("/"))) then empty
      elif $prs == [] then "\($url) is not a PR of \($events); it has none"
      else "\($url) is not a PR of \($events):" + ($prs | map("\n  " + .) | add) end')
  [[ -z $problem ]] || die "$problem"
fi

# A park logged after the fact says when it began: a UTC time between the task's latest event and now.
if [[ -n ${seen[since]:-} ]]; then
  case $event in waiting | blocked | paused | held) ;; *) die "since is taken only by a park (waiting, blocked, paused, held), not $event" ;; esac
  since=${seen[since]}
  jq -ne --arg t "$since" '$t | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$") and ((try fromdate catch null) | . != null and todate == $t)' >/dev/null ||
    die "since must be a UTC time like 2026-10-22T01:00:00Z, got '$since'"
  now=$(date -u +%FT%TZ)
  [[ ! $since > $now ]] || die "since $since is later than now ($now)"
  latest=$(task_events "$task" | jq -nr '[inputs | .ts | strings] | last // empty')
  [[ -z $latest || ! $since < $latest ]] || die "since $since is earlier than $task's latest event, at $latest"
fi

# Each value is typed by the contract when it names the field, and by whether it parses as JSON
# otherwise; ledger_append then checks the event against the contract.
ledger_append "$(ledger_jq '
  field_types($contract.kinds[$event]) as $types
  | $ARGS.positional as $pairs
  | reduce range(0; $pairs | length; 2) as $i ({ts: (now | todate), task: $task, event: $event};
      $pairs[$i] as $key | $pairs[$i + 1] as $raw
      | .[$key] = if ($types[$key] | type) == "array" or $types[$key] == "string" then $raw
        else ((try ($raw | fromjson) catch null) | if . == null or (type == "number" and isnan) then $raw else . end)
        end)' -nc --arg task "$task" --arg event "$event" --args "${pairs[@]}")"
