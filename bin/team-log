#!/usr/bin/env bash
# Record an event the coordinator writes by hand in the ledger, against the ledger contract.
#
# Usage: team-log T<n> <event> [key=value]...
#        team-log --check [<file>]
# Appends {ts (now, UTC), task, event, key: value...}. A value is stored as JSON when it parses
# as JSON (a list, a number, true) and as a string otherwise; a field the contract types as a
# string or an id, any discord_* field, and a whole number of 16 digits or more (which a JSON
# number cannot hold exactly) are always strings. note is allowed on every kind. Kinds team-log is not a writer of
# (opened, launch, merged, closed...) are refused, and so is a merge-approved whose url is not
# one of the task's pr events (a trailing slash aside), or with no head, or a head neither a pr
# event of that url nor a review of the task since its first pr event logged (heads compare by
# the shorter one's prefix, at least 7 characters), or whose discord_message, a Discord id, was
# sent before the first of those events that logged the head; so is an answered whose id and
# discord_message an earlier answered of the task logged (team-answer reads it from Discord). A
# merge-preapproved is refused when its project is not one of the task's opened or worktree-added
# events, is the team's own (own_project, whatever the registry says), or does not opt in now
# (team-project's merge_with_plan); when its ask names no asked of the task; when its
# discord_message is a string of digits that is no Discord id, or was sent before the latest asked
# of that id; and when its scope is empty or holds an entry that is not a clean repository path (a
# string with no leading /, no . or .. segment, no empty segment, no glob character *?[ and no
# whitespace; a directory ends in /). A merge-preapproval-withdrawn is refused unless a
# merge-preapproved of its project stands for the task (its latest, with no withdrawal since). A
# branch-renamed, the task's new branch in a project after the gate rewrote the remote one, is
# refused when its project is not one of the task's opened or worktree-added events, its branch is
# the task's there now (the latest opened, worktree-added or branch-renamed of the project), does
# not name the task, or is no branch name git takes (git check-ref-format --branch). A
# review's findings, when given, must count exactly blocking, correctness, security, real-data and
# note, each a whole number, and its guarded list only ci, dependencies, migrations, settings,
# permissions and secrets. A park
# (waiting, blocked, paused, held) logged after the fact takes since=<UTC time>, when it began:
# no later than now and no earlier than the task's latest event, or it is refused naming both
# times; no other kind takes since.
# --check checks a ledger (default: the team home's): every line is JSON with ts, task and
# event, and lines from strict_from on meet their kind's fields, a Discord id written as a whole
# number (as team-log wrote one before the contract typed it) passing too; exit 1 lists each bad
# line.
set -euo pipefail

# Printed by --help after the header.
help_more() {
  echo
  ledger_jq '"Ledger contract, strict from \($contract.strict_from) (bin/lib/ledger-contract.json):", ($contract | contract_table)' -nr
}

source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-log T<n> <event> [key=value]... | team-log --check [<file>]"

if [[ ${1:-} == --check ]]; then
  [[ $# -le 2 ]] || usage_error "$usage"
  file=${2:-$TEAM_HOME/ledger.jsonl}
  [[ -f $file ]] || die "no ledger at $file"
  report=$(ledger_jq 'check_ledger($contract)' -nRc <"$file")
  read -r total bad < <(jq -r '"\(.total) \(.bad | length)"' <<<"$report")
  if ((bad > 0)); then
    jq -r --arg file "$file" '.bad[] | "\($file):\(.line): \(.problems | join("; "))"' <<<"$report" >&2
    echo "$file: $bad of $total lines break the ledger contract" >&2
    exit 1
  fi
  if ((total == 1)); then echo "$file: 1 line meets the ledger contract"; else echo "$file: $total lines meet the ledger contract"; fi
  exit 0
fi

[[ $# -ge 2 ]] || usage_error "$usage"
task=$1 event=$2
shift 2
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"
ledger_jq '$contract.kinds | has($event)' -ne --arg event "$event" >/dev/null ||
  die "unknown event kind '$event'; team-log --help lists the kinds"

declare -A seen=()
pairs=()
for pair in "$@"; do
  key=${pair%%=*}
  [[ $pair == *=?* && $key =~ ^[a-z][a-z0-9_]*$ ]] || usage_error "not a key=value: '$pair'"
  [[ $key != ts && $key != task && $key != event ]] || usage_error "$key is set by team-log"
  [[ -z ${seen[$key]:-} ]] || usage_error "$key is given twice"
  seen[$key]=${pair#*=}
  pairs+=("$key" "${pair#*=}")
done

# Daniel's word is on one PR at one head: the approval names the PR as one of the task's pr events
# does, and a head that PR's pr events, or the task's reviews since its first one, logged (pr_heads
# in bin/lib/ledger.jq), its message sent no earlier than the first of them, as team-merge holds.
if [[ $event == merge-approved && -n ${seen[url]:-} ]]; then
  problem=$(task_events "$task" | ledger_jq '
    [inputs] as $all
    | [$all[] | select(.event == "pr" and (.url | type) == "string")] as $prs
    | ($all | pr_heads($url)) as $mine
    | if $mine == [] and $prs == [] then "\($url) is not a PR of \($events); it has none"
      elif $mine == [] then "\($url) is not a PR of \($events):" + ($prs | map("\n  " + .url) | add)
      elif $head == "" then "merge-approved needs head, the full sha of the PR'"'"'s head Daniel was asked on"
      elif ($all | head_logged($url; $head)) != null then empty
      else "head \($head) is not a head the pr events of \($url), or the reviews since, logged:"
        + (reduce ($mine[] | .head) as $h ([]; if IN(.[]; $h) then . else . + [$h] end) | map("\n  " + .) | add) end' \
    -nr --arg url "${seen[url]}" --arg head "${seen[head]:-}" --arg events "$task's pr events")
  [[ -z $problem ]] || die "$problem"
  message=${seen[discord_message]:-}
  # A Discord id holds the milliseconds since 2015-01-01 above its low 22 bits.
  if [[ $message =~ ^[1-9][0-9]{0,18}$ ]]; then
    logged=$(task_events "$task" | ledger_jq '[inputs] | head_logged($url; $head) | "\(.ts) \(.event)"' \
      -nr --arg url "${seen[url]}" --arg head "${seen[head]}")
    sent=$(((10#$message >> 22) / 1000 + 1420070400))
    ((sent >= $(date -ud "${logged% *}" +%s))) ||
      die "Discord message $message was sent at $(date -ud "@$sent" +%FT%TZ), before the ${logged#* } event that first logged head ${seen[head]} at ${logged% *}, so it is not Daniel's word on that head"
  fi
fi

# Daniel's plan-time word is on the task's PR in one of its projects, which opts in now and is not
# the team's own, answering an ask the task logged, in a message sent no earlier than the latest
# asked of that id, over a scope of clean repository paths, as team-merge holds it.
# Refuses a project that is none of the task's opened or worktree-added events: task_project <project>
task_project() {
  local problem
  problem=$(task_events "$task" | ledger_jq '
    reduce (inputs | select(.event == "opened" or .event == "worktree-added") | .project | strings) as $p
      ([]; if IN(.[]; $p) then . else . + [$p] end)
    | if IN(.[]; $project) then empty
      elif . == [] then "\($project) is not a project of \($task)'"'"'s opened or worktree-added events; it has none"
      else "\($project) is not a project of \($task)'"'"'s opened or worktree-added events: \(join(", "))" end' \
    -nr --arg project "$1" --arg task "$task")
  [[ -z $problem ]] || die "$problem"
}

if [[ $event == merge-preapproved ]]; then
  project=${seen[project]:-}
  if [[ -n $project ]]; then
    task_project "$project"
    ! own_project "$project" ||
      die "$project is the team's own project, whose PRs merge only on Daniel's word per head, never on a plan-time word"
    opted=$(team_project "$project" merge_with_plan) || exit 1
    [[ $opted == true ]] ||
      die "$project does not opt in to a plan-time merge approval: its merge_with_plan in projects.toml is $opted"
  fi
  if [[ -n ${seen[ask]:-} ]]; then
    asked=$(task_events "$task" | ledger_jq '[inputs] | latest_asked($id) | .ts // empty' -nr --arg id "${seen[ask]}")
    [[ -n $asked ]] || die "$task logged no asked with id ${seen[ask]}, so merge-preapproved answers no ask of it"
    message=${seen[discord_message]:-}
    # A string of digits that is no Discord id the contract would take; any other string it refuses.
    if [[ $message =~ ^[0-9]+$ ]]; then
      [[ $message =~ ^[1-9][0-9]{0,18}$ ]] || die "discord_message $message is not a Discord id"
      sent=$(((10#$message >> 22) / 1000 + 1420070400))
      ((sent >= $(date -ud "$asked" +%s))) ||
        die "Discord message $message was sent at $(date -ud "@$sent" +%FT%TZ), before the asked ${seen[ask]} at $asked, so it is not Daniel's answer to that ask"
    fi
  fi
  if [[ -n ${seen[scope]:-} ]]; then
    problem=$(ledger_jq '$raw | try fromjson catch null
      | if type != "array" then empty
        elif . == [] then "scope is empty: it lists every path the plan may change, each a file or a directory ending in /"
        else [scope_problems] | select(. != []) | "scope holds entries that are not clean repository paths:" + (map("\n  " + .) | add) end' \
      -nr --arg raw "${seen[scope]}")
    [[ -z $problem ]] || die "$problem"
  fi
fi

# A withdrawal ends the plan-time word standing for the project: its latest merge-preapproved,
# with no withdrawal since.
if [[ $event == merge-preapproval-withdrawn && -n ${seen[project]:-} ]]; then
  task_events "$task" | ledger_jq '[inputs] | merge_preapproval($project) | . != null and .withdrawn == null' \
    -ne --arg project "${seen[project]}" >/dev/null ||
    die "$task has no standing merge-preapproved of ${seen[project]} to withdraw"
fi

# The task's new branch in one of its projects names the task, as team-close holds a worktree's
# branch to, is a branch name git takes, and is not its branch there now.
if [[ $event == branch-renamed && -n ${seen[project]:-} && -n ${seen[branch]:-} ]]; then
  task_project "${seen[project]}"
  branch=${seen[branch]}
  [[ $branch != "$(task_events "$task" | ledger_jq '[inputs] | task_branch($project) // ""' -nr --arg project "${seen[project]}")" ]] ||
    die "$branch is already $task's branch for ${seen[project]}"
  [[ $branch =~ (^|[^[:alnum:]])$task($|[^[:digit:]]) ]] || die "$branch does not name $task, as a branch of its worktree must"
  git check-ref-format --branch "$branch" >/dev/null 2>&1 ||
    die "$branch is not a branch name git takes (git check-ref-format --branch)"
fi

# A review's finding counts and guarded areas, as the reviewer's DONE gives them.
if [[ $event == review ]]; then
  problem=$(ledger_jq '
    def listed: (.[:-1] | join(", ")) + " and " + last;
    def lines: map("\n  " + .) | add;
    ($findings | try fromjson catch null) as $f
    | ($guarded | try fromjson catch null) as $g
    | ($f | objects | [findings_problems] | select(. != [])
        | "findings holds the count of each finding kind, exactly \(finding_kinds | listed), each a whole number:" + lines),
      ($g | arrays | [guarded_problems] | select(. != [])
        | "guarded lists the guarded areas the change touches, each one of \(guarded_areas | listed):" + lines)' \
    -nr --arg findings "${seen[findings]:-}" --arg guarded "${seen[guarded]:-}")
  [[ -z $problem ]] || die "$problem"
fi

# One Discord message answers an ask once: a second answered of the same id and message is a
# repeat, as team-answer refuses it.
if [[ $event == answered && -n ${seen[id]:-} && -n ${seen[discord_message]:-} ]] &&
  task_events "$task" | ledger_jq '[inputs] | answered_from($id; $message)' -ne \
    --arg id "${seen[id]}" --arg message "${seen[discord_message]}" >/dev/null; then
  die "$task already logged answered id=${seen[id]} from Discord message ${seen[discord_message]}"
fi

# A park logged after the fact says when it began: a UTC time between the task's latest event and now.
if [[ -n ${seen[since]:-} ]]; then
  case $event in waiting | blocked | paused | held) ;; *) die "since is taken only by a park (waiting, blocked, paused, held), not $event" ;; esac
  since=${seen[since]}
  jq -ne --arg t "$since" '$t | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$") and ((try fromdate catch null) | . != null and todate == $t)' >/dev/null ||
    die "since must be a UTC time like 2026-10-22T01:00:00Z, got '$since'"
  now=$(date -u +%FT%TZ)
  [[ ! $since > $now ]] || die "since $since is later than now ($now)"
  latest=$(task_events "$task" | jq -nr '[inputs | .ts | strings] | last // empty')
  [[ -z $latest || ! $since < $latest ]] || die "since $since is earlier than $task's latest event, at $latest"
fi

# Each value is typed by the contract when it names the field, and by whether it parses as JSON
# otherwise, but for a Discord id (a discord_* field) and a whole number too long for a JSON
# number to hold exactly, kept as written; ledger_append then checks the event against the
# contract.
ledger_append "$(ledger_jq '
  field_types($contract.kinds[$event]) as $types
  | $ARGS.positional as $pairs
  | reduce range(0; $pairs | length; 2) as $i ({ts: (now | todate), task: $task, event: $event};
      $pairs[$i] as $key | $pairs[$i + 1] as $raw
      | .[$key] = if ($types[$key] | type) == "array" or ($types[$key] | IN("string", "id"))
          or ($key | startswith("discord_")) or ($raw | test("^-?[0-9]{16,}$")) then $raw
        else ((try ($raw | fromjson) catch null) | if . == null or (type == "number" and isnan) then $raw else . end)
        end)' -nc --arg task "$task" --arg event "$event" --args "${pairs[@]}")"
