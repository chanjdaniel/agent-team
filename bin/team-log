#!/usr/bin/env bash
# Record an event the coordinator writes by hand in the ledger, against the ledger contract.
#
# Usage: team-log T<n> <event> [key=value]...
#        team-log T<n> --from-message '<message>' [--from <session>] [--sent-back <list>] [--relay <id>] [--print]
#        team-log --check [<file>]
#        team-log --check-lifecycle [<file>]
#        team-log --fix-sent-back [<file>]
# Appends {ts (now, UTC), task, event, key: value...}, each value typed as the contract types its field.
# The event is checked against the task's state too, by the lifecycle table (bin/lib/lifecycle.json,
# through ledger_append in bin/lib/team.sh): one the table refuses (a closed task's held, a review
# of a task with no opened) is logged with one "team-log: lifecycle: <problem> (logged anyway; ...)"
# line per problem on stderr while the table's lifecycle_from is not set or later than the event,
# and refused, logging nothing, from it on.
# A list field (array, or numbers (a list of whole numbers), as sent_back and before are) takes
# a JSON list, or a comma list as a worker's message writes it (commits=a0017cce,9e0e3990,
# sent_back=5,6, guarded=ci,secrets), each item trimmed, an empty item refused, and
# none is the empty list (guarded=none).
# A list of whole numbers stores each item of a comma list, and each numeric string of a JSON list, as a number, and refuses one that is no whole number, naming it.
# An object field takes a JSON object, or key:value pairs separated by commas (findings=blocking:0,correctness:1,security:0,real-data:0,note-change:2,note-before:0),
# each trimmed, a value a number when it reads as one; a list or object value that starts with [ or { is read only as JSON.
# Any other value is stored as JSON when it parses as JSON (a number, true) and as a string
# otherwise; a field the contract types as a string, a choice or an id, any discord_* field, and a
# whole number of 16 digits or more (which a JSON number cannot hold exactly) are always strings.
# note is allowed on every kind. Kinds team-log is not a writer of
# (opened, launch, merged, closed...) are refused, and so is a merge-approved whose url is not
# one of the task's pr events (a trailing slash aside), or with no head, or a head neither a pr
# event of that url nor a review of the task since its first pr event logged (heads compare by
# the shorter one's prefix, at least 7 characters), or whose discord_message, a Discord id, was
# sent before the first of those events that logged the head; so is an asked with a script or a
# sha256, which only team-ask --script logs, with the question that names both; so is an
# answered that names a discord_message, whatever its value, since only team-answer logs one,
# having read the message and checked it is Daniel's (an answered with no message, given at the
# terminal, is logged), and an answered that names an item, the waiting list's number, since only
# team-answer --item logs one, having checked the message names it. A plan-approved
# (by=Daniel ask=<id> discord_message=<id>, or by=coordinator) records plan, each of the plan's
# files that exists (tasks/T<n>/plan.md, and the task directory's spec.md and scope.txt; plan_files
# in bin/lib/team.sh) to its sha256, and scope, scope.txt's non-blank lines, when it exists; it is
# refused for a by but Daniel or coordinator; Daniel's with no ask or discord_message, an ask the
# task never logged, or a message that is no Discord id or was sent before the latest asked of
# that id; the coordinator's with either, or while the approval standing is withdrawn, which
# only Daniel's approval ends; a plan or scope given, which team-log records itself; a
# closed task; no tasks/T<n>/plan.md; a task whose opened project has no open worktree that is a
# directory on this machine, since its spec.md and scope.txt could not be hashed; a scope.txt that
# lists no path or holds a line that is no clean repository path (a string with no leading /, no .
# or .. segment, no empty segment, no glob character *?[ and no whitespace; a directory ends in /);
# and a second approval whose by and plan equal the one standing (plan_approval in
# bin/lib/ledger.jq). A plan-approval-withdrawn (discord_message=<id>, Daniel's message, which
# team-log takes as named, since a withdrawal only stops work) is refused for a closed task, a
# message that is no Discord id, and when no approval stands. A kind the contract marks retired is
# refused before anything else is read, logging nothing, with its reason: merge-preapproved,
# merge-preapproval-withdrawn, merge-standing and merge-standing-withdrawn, retired by T276, since
# the approved plan is the merge word, which merge-default-withdrawn withdraws; --check still passes
# the lines logged before. A merge-default-withdrawn, Daniel's withdrawal of the default merge word,
# or a merge-default-restored, its giving back (scope=<task|project|all> discord_message=<id>
# discord_channel=<id>), is refused when its scope is neither task (the task it is logged under),
# all (every project) nor a project team-project --list names, when it is task on a closed task,
# when its discord_message or discord_channel is no Discord id, and when its discord_channel is
# neither #coordinator's channel nor the task's latest thread, naming both; a merge-default-restored
# is refused too when no PR it covers has a withdrawal as the latest of the two kinds covering it,
# over the whole ledger (a task's PRs in each project of its opened and worktree-added events;
# default_restore_withdrawn in bin/lib/ledger.jq). A branch-renamed, the task's new branch in a
# project after the gate rewrote the remote one, is refused when its project is not one of the
# task's opened or worktree-added events, its branch is the task's there now (the latest opened,
# worktree-added or branch-renamed of the project), does not name the task, or is no branch name git
# takes (git check-ref-format --branch). A review whose sent_back names any finding is logged with
# verdict findings, a pass's too, since a pass whose notes go back before the merge is not ready to
# merge. A review's findings, when given, must count exactly blocking, correctness, security,
# real-data, note-change and note-before, each a whole number, and its guarded list only ci,
# migrations, deploy, permissions, secrets and guardrails, the areas of bin/lib/guarded
# (dependencies and settings are retired); its before, the numbers of its plain notes on code the PR
# did not change, distinct whole numbers above 0, is required when findings counts a note-before, as
# many as it counts, and a sent_back naming one of them is refused, since such a note is queued,
# never sent back; its widening, the numbers of a rereview's new findings in what the last fix
# added, distinct whole numbers above 0 too, is refused naming any before lists, since a before note
# is on code the PR did not change, and may name a finding sent_back does not. A park (waiting,
# blocked, paused, held) carries a cause, one bin/lib/lifecycle.json's causes give its kind, and a
# cause= given is kept: a held is daniel-hold, Daniel's hold, and is refused without discord_message
# ("a held is Daniel's hold, and needs discord_message, the id of Daniel's message saying so"); a
# waiting on=Daniel (any case) is daniel, on anyone else outside (ask is team-ask's); a blocked
# on=T<m> is task, any other worker (denial, for a denial that stops the work, is given); a paused
# has no default and is refused without one ("a paused needs cause=, one of limit, machine,
# shutdown, worker"). A park logged after the fact takes since=<UTC time>, when it began: no later
# than now and no earlier than the task's latest event, or it is refused naming both times; no other
# kind takes since. A resumed names what it ends, and is refused with none of id, all=true and brief
# ("resumed needs id=<a standing park>, all=true or brief=<brief>; team-state T<n> lists the
# standing parks"): id=<park> ends that park, Daniel's hold only with discord_message, their word
# lifting it, and never an ask's wait, which its ask's answer ends; all=true every standing park
# whose cause in bin/lib/lifecycle.json takes all (all but Daniel's hold and an ask's wait);
# brief=<brief> alone, a merge-base round's holder brief, none. The lifecycle table names a resumed
# id= the fold would not end (of no standing park, of an ask's wait, of Daniel's hold with no
# discord_message) and a held while Daniel's hold stands, warned or refused as above.
# A retro-change is refused when its retro names a
# task with no opened event of path retro, or a retro with no answered of id retro.
# A gate-run whose cause is base-merge and whose outcome is not aborted, in either form, is logged
# with one line on stderr saying the gated delivery brief asks no gate run for a base merge; --print,
# which logs nothing, prints no such line.
# An event of a kind the contract marks pushed at once (Daniel's word: answered, plan-approved,
# plan-approval-withdrawn, merge-approved, merge-default-withdrawn, merge-default-restored,
# retro-schedule) is committed and pushed to the team home's origin
# before team-log ends (ledger_push in bin/lib/team.sh), in either form; a push that fails, or
# one not tried while the team holds offline, is one line on stderr, and the exit stays 0.
# --from-message reads a worker's message whole (bin/lib/messages.jq) into the events the
# coordinator's message table gives it, checks each as above, and logs them all, or with --print
# prints them as JSON lines and logs nothing; any refusal logs none. The message starts with the
# task. QUESTION <text> is a question; BLOCKED <text> and NEED toolkit <name> a blocked of cause
# worker; PAUSED <why> a paused, its cause its first word's (stowed stow, held coordinator-hold,
# offline offline, any other worker), its reason the whole why; each park carrying the sender's
# role and session when the sender is known (--from's launch, else the only latest launch of a role
# with no report since), and neither when it is not, a --from naming no launch refused; FAILED <why> a failed; INJECTION <where> <what> an injection (source its first
# word). PR <url>, optionally followed by merged <base> conflicts: <files or none>, is a pr whose
# head is the PR's on GitHub (gh pr view), and a branch-renamed when the PR's head branch is not
# the task's in the project of the PR's repo. DONE <NN> <sha>... <line> is a ticket-done (commits
# the shas of 7 to 40 hex digits, note the line) and the builder's done; DONE review-ready <sha> and
# DONE merged <base> <sha> conflicts: <files or none> the builder's done, report the rest;
# DONE pass <PR url or head> and DONE findings <path>, each followed by findings=, before=,
# guarded=, on a rereview widening=, and, when the reviewer added a memory, memory= as team-log
# takes them, a review and the reviewer's done, either taking --sent-back's list as sent_back (a
# pass's being the notes that go back before the merge, which make it a findings review, as above;
# no other message takes it);
# DONE gate <key=value>... a gate-run;
# any other DONE the sender's done, report the rest. An ops session's DONE, whatever its first word
# when --from names that session, and its QUESTION, whose text may hold production data, log its
# length in characters and never its text: the done report_chars=<n>, the question chars=<n>; its
# BLOCKED, PAUSED, FAILED and INJECTION are logged as every role's. --relay <id>, the Discord id of
# the coordinator's message that relayed an ops answer, is logged as that done's relay, and refused
# with any other message; an id that is not one is a malformed command line. A review's head is the head of the brief record
# (tasks/T<n>/<brief>.json) that the reviewer's latest launch read, else a pass's own head, else
# it is refused naming head=. The role is the kind's (builder, reviewer), else that of --from's
# launch (its session name T<n>-<role>, or its session id), else that of the only latest launch of a
# role with no report since (a done, review, ticket-done or pr that ends it); two are refused,
# naming both. The session is that role's latest launch. A DONE pass or DONE findings on a project
# whose agent-review the reviewer App posts (the project of any of the task's pr events, by its
# project or its URL's repo, or of the task's latest reviewer launch, when own_bar in
# bin/lib/team.sh gives it the App) is refused, logging nothing, unless --from is the session id
# of the task's latest reviewer launch, the refusal naming it; the name T<n>-reviewer is refused
# there too.
# --check checks a ledger (default: the team home's): every line is JSON with ts, task and
# event, and lines from strict_from on meet their kind's fields, a Discord id written as a whole
# number (as team-log wrote one before the contract typed it) passing too; exit 1 lists each bad
# line. A sent_back or before from strict_from on that holds whole numbers as strings, as
# team-log stored them before, passes too, but each such line is named on stderr with
# --fix-sent-back, and the last line counts them.
# --check-lifecycle replays a ledger (default: the team home's) against the lifecycle table
# (bin/lib/lifecycle.json, check_lifecycle in bin/lib/ledger.jq), in one pass: each task's events
# in ledger order, each checked against the state the ones before it reach, and prints one line
# per event that breaks the table, "<file>:<line>: <task> <kind>: <problem>" (several joined with
# "; "), then "<file>: <n> of <total> lines break the lifecycle table, <m> of them from its
# lifecycle_from on" or "<file>: <total> lines meet the lifecycle table". A line that is no JSON
# object with a task and an event is --check's to name, and this one passes it. It exits 1, all on
# stderr, when <m> is above 0 (lifecycle_from set and an event at or after it breaks the table),
# else 0, all on stdout, so it names what the table would refuse before anything is refused.
# --fix-sent-back is the one-time conversion of those strings (default: the team home's ledger), run under the ledger's lock:
# on every line, legacy too, it stores the whole numbers that sent_back and before hold as
# strings as numbers, leaves every other line byte for byte, and prints how many lines it changed;
# a string there that is no whole number refuses the whole conversion, naming each line, and
# changes nothing.
# Refused, exit 1, before it reads or changes anything: a worker session (an AGENT_TEAM_ROLE but
# coordinator; worker_refusal in bin/lib/team.sh), in every form, --print, --check and
# --check-lifecycle included; --help still answers.
set -euo pipefail

# Printed by --help after the header.
help_more() {
  echo
  ledger_jq '"Ledger contract, strict from \($contract.strict_from) (bin/lib/ledger-contract.json):", ($contract | contract_table)' -nr
}

source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
why=$(worker_refusal "" "runs no team-log") && die "$why"

usage="usage: team-log T<n> <event> [key=value]... | team-log T<n> --from-message '<message>' [--from <session>] [--sent-back <list>] [--relay <id>] [--print] | team-log --check [<file>] | team-log --check-lifecycle [<file>] | team-log --fix-sent-back [<file>]"

if [[ ${1:-} == --check ]]; then
  [[ $# -le 2 ]] || usage_error "$usage"
  file=${2:-$TEAM_HOME/ledger.jsonl}
  [[ -f $file ]] || die "no ledger at $file"
  report=$(ledger_jq 'check_ledger($contract)' -nRc <"$file")
  read -r total bad noted < <(jq -r '"\(.total) \(.bad | length) \(.noted | length)"' <<<"$report")
  # The bad lines first, so a caller reading the first line (team-doctor) names a problem.
  jq -r --arg file "$file" '(.bad[] | "\($file):\(.line): \(.problems | join("; "))"),
    (.noted[] | "\($file):\(.line): \(.notes | join("; "))")' <<<"$report" >&2
  notes=''
  if ((noted == 1)); then
    notes="; 1 holds whole numbers as strings, which team-log --fix-sent-back stores as numbers"
  elif ((noted > 1)); then
    notes="; $noted hold whole numbers as strings, which team-log --fix-sent-back stores as numbers"
  fi
  if ((bad > 0)); then
    echo "$file: $bad of $total lines break the ledger contract$notes" >&2
    exit 1
  fi
  if ((total == 1)); then echo "$file: 1 line meets the ledger contract$notes"; else echo "$file: $total lines meet the ledger contract$notes"; fi
  exit 0
fi

if [[ ${1:-} == --check-lifecycle ]]; then
  [[ $# -le 2 ]] || usage_error "$usage"
  file=${2:-$TEAM_HOME/ledger.jsonl}
  [[ -f $file ]] || die "no ledger at $file"
  report=$(ledger_jq 'check_lifecycle' -nRc <"$file")
  late=$(jq -r '.from as $from | [.bad[] | select($from != null and .ts >= $from)] | length' <<<"$report")
  lines=$(jq -r --arg file "$file" '(.bad[] | "\($file):\(.line): \(.task) \(.event): \(.problems | join("; "))"),
    if .bad == [] then "\($file): \(.total) \(if .total == 1 then "line meets" else "lines meet" end) the lifecycle table"
    else "\($file): \(.bad | length) of \(.total) lines break the lifecycle table, \($late) of them from its lifecycle_from on" end' \
    --argjson late "$late" <<<"$report")
  if ((late > 0)); then
    echo "$lines" >&2
    exit 1
  fi
  echo "$lines"
  exit 0
fi

# The one-time conversion, read and written under the lock ledger_append takes, the ledger
# replaced whole by a copy beside it with its mode, so no reader sees half of it.
if [[ ${1:-} == --fix-sent-back ]]; then
  [[ $# -le 2 ]] || usage_error "$usage"
  file=${2:-$TEAM_HOME/ledger.jsonl}
  [[ -f $file ]] || die "no ledger at $file"
  {
    flock -x 9
    report=$(ledger_jq '[inputs | number_strings($contract)] | {
        changed: map(select(. != {})) | length,
        bad: [to_entries[] | (.key + 1) as $line | .value | to_entries[]
          | {line: $line, field: .key, strings: [.value[] | select(whole_number_string | not)]} | select(.strings != [])]}' \
      -nRc <"$file")
    read -r changed bad < <(jq -r '"\(.changed) \([.bad[].line] | unique | length)"' <<<"$report")
    if ((bad > 0)); then
      jq -r --arg file "$file" '.bad[] | "\($file):\(.line): \(.field) holds \(.strings | map(tojson) | join(", ")), "
        + if (.strings | length) == 1 then "which is no whole number" else "which are no whole numbers" end' <<<"$report" >&2
      if ((bad == 1)); then lines="1 line holds"; else lines="$bad lines hold"; fi
      die "$file: $lines strings that are no whole numbers in a list of whole numbers, so nothing changed"
    fi
    if ((changed == 0)); then
      echo "$file: no line's sent_back or before holds a whole number as a string; nothing changed"
      exit 0
    fi
    fixed=$(mktemp "$file.XXXXXX")
    trap 'rm -f "$fixed"' EXIT
    ledger_jq 'inputs | numbers_fixed($contract)' -nRr <"$file" >"$fixed"
    chmod --reference="$file" "$fixed"
    mv "$fixed" "$file"
  } 9>>"$file.lock"
  if ((changed == 1)); then
    echo "$file: 1 line changed, the whole numbers its sent_back or before held as strings now numbers"
  else
    echo "$file: $changed lines changed, the whole numbers their sent_back or before held as strings now numbers"
  fi
  exit 0
fi

[[ $# -ge 2 ]] || usage_error "$usage"
task=$1
shift
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"

# The task's events as one JSON array in TASK_EVENTS, read from the ledger once, before anything
# is logged: task_events_once
TASK_EVENTS=''
task_events_once() {
  [[ -n $TASK_EVENTS ]] || TASK_EVENTS=$(task_event_array "$task")
}

# <line> with its ts now, a UTC time to the second as jq's todate writes it; the line is one that
# check_event typed, whose first key is ts: stamped <line>
stamped() {
  # Exported, or Bash's strftime keeps the zone it read at start.
  local -x TZ=UTC0
  local now
  [[ $1 == '{"ts":"'*'",'* ]] || die "not a typed line, ts first: $1"
  printf -v now '%(%Y-%m-%dT%H:%M:%SZ)T' -1
  printf '%s\n' "{\"ts\":\"$now\",${1#\{\"ts\":\"*\",}"
}

# One event, checked as every event team-log appends is, its typed line left in typed (ts the
# time of the check): check_event <event> [key=value]...
check_event() {
event=$1
shift

# A retired kind (its contract entry's retired, the reason) is refused before anything else is
# read, so the ledger lines logged before it still check while no new one is logged.
retired=$(ledger_jq '$contract.kinds[$event].retired // empty' -nr --arg event "$event")
[[ -z $retired ]] || die "$event is retired by $retired"

local -A seen=()
local pairs=() bad=''
for pair in "$@"; do
  key=${pair%%=*}
  if [[ $pair != *=?* || ! $key =~ ^[a-z][a-z0-9_]*$ ]]; then bad="not a key=value: '$pair'"
  elif [[ $key == ts || $key == task || $key == event ]]; then bad="$key is set by team-log"
  elif [[ -n ${seen[$key]:-} ]]; then bad="$key is given twice"
  fi
  [[ -z $bad ]] || break
  seen[$key]=${pair#*=}
  pairs+=("$key" "${pair#*=}")
done
# An unknown kind is named before a malformed pair.
if [[ -n $bad ]]; then
  ledger_jq '$contract.kinds | has($event)' -ne --arg event "$event" >/dev/null ||
    die "unknown event kind '$event'; team-log --help lists the kinds"
  usage_error "$bad"
fi

# A logged message id always means one team-answer read and checked, so team-log writes an
# answered only with no message id (a decision Daniel gave at the terminal), and with no item, the
# waiting list's number, which team-answer --item checks the message names.
[[ $event != answered || -z ${seen[item]:-} ]] ||
  die "an answered that names an item of the waiting list is logged only by team-answer --item, which reads Daniel's message and checks it names that number: team-answer --item ${seen[item]} <the message's id>"
[[ $event != answered || -z ${seen[discord_message]:-} ]] ||
  die "an answered that names a Discord message is logged only by team-answer, which reads it and checks it is Daniel's: team-answer $task ${seen[id]:-<id>} <the message's id>"

# Each value is typed by the contract when it names the field, and by whether it parses as JSON
# otherwise (typed_value in bin/lib/ledger.jq), so the checks below read the values the line
# will hold; ledger_append then checks the event against the contract and the lifecycle table.
typed=$(ledger_jq '
  if $contract.kinds | has($event) | not then "unknown event kind '"'"'\($event)'"'"'; team-log --help lists the kinds" | halt_error(1) else
  field_types($contract.kinds[$event]) as $types
  | $ARGS.positional as $pairs
  | reduce range(0; $pairs | length; 2) as $i ({line: {ts: (now | todate), task: $task, event: $event}, problems: []};
      $pairs[$i] as $key | ($pairs[$i + 1] | typed_value($key; $types[$key])) as $typed
      | .line[$key] = $typed.value | .problems += ($typed.problems // []))
  | if .problems == [] then .line | review_sent_back else .problems | join("; ") | halt_error(1) end end' \
  -nc --arg task "$task" --arg event "$event" --args "${pairs[@]}" 2>&1) || die "${typed%$'\n'}"

# A park carries its cause (bin/lib/lifecycle.json's causes): a cause= given is kept; a held is
# Daniel's hold and needs their message; a waiting on Daniel is daniel, on anyone else outside; a
# blocked on a task is task, any other worker; a paused has no default.
case $event in
  held | blocked | waiting | paused)
    typed=$(jq -c '
      if .event == "held" and .discord_message == null then
        "a held is Daniel'"'"'s hold, and needs discord_message, the id of Daniel'"'"'s message saying so" | halt_error(1)
      elif .cause != null then .
      elif .event == "held" then .cause = "daniel-hold"
      elif .event == "waiting" then .cause = (if (.on // "" | tostring | ascii_downcase) == "daniel" then "daniel" else "outside" end)
      elif .event == "blocked" then .cause = (if (.on // "" | tostring | test("^[Tt][0-9]+$")) then "task" else "worker" end)
      else "a paused needs cause=, one of limit, machine, shutdown, worker" | halt_error(1) end' <<<"$typed" 2>&1) ||
      die "${typed%$'\n'}"
    ;;
  # A resumed names what it ends, so one never lifts every park again.
  resumed)
    jq -e '.id != null or .all == true or .brief != null' <<<"$typed" >/dev/null ||
      die "resumed needs id=<a standing park>, all=true or brief=<brief>; team-state $task lists the standing parks"
    ;;
esac

# Daniel's word is on one PR at one head: the approval names the PR as one of the task's pr events
# does, and a head that PR's pr events, or the task's reviews since its first one, logged (pr_heads
# in bin/lib/ledger.jq), its message sent no earlier than the first of them, as team-merge holds.
if [[ $event == merge-approved && -n ${seen[url]:-} ]]; then
  task_events_once
  problem=$(ledger_jq '
    . as $all
    | [$all[] | select(.event == "pr" and (.url | type) == "string")] as $prs
    | ($all | pr_heads($url)) as $mine
    | if $mine == [] and $prs == [] then "\($url) is not a PR of \($events); it has none"
      elif $mine == [] then "\($url) is not a PR of \($events):" + ($prs | map("\n  " + .url) | add)
      elif $head == "" then "merge-approved needs head, the full sha of the PR'"'"'s head Daniel was asked on"
      elif ($all | head_logged($url; $head)) != null then empty
      else "head \($head) is not a head the pr events of \($url), or the reviews since, logged:"
        + (reduce ($mine[] | .head) as $h ([]; if IN(.[]; $h) then . else . + [$h] end) | map("\n  " + .) | add) end' \
    -r --arg url "${seen[url]}" --arg head "${seen[head]:-}" --arg events "$task's pr events" <<<"$TASK_EVENTS")
  [[ -z $problem ]] || die "$problem"
  message=${seen[discord_message]:-}
  # A Discord id holds the milliseconds since 2015-01-01 above its low 22 bits.
  if [[ $message =~ ^[1-9][0-9]{0,18}$ ]]; then
    logged=$(ledger_jq 'head_logged($url; $head) | "\(.ts) \(.event)"' \
      -r --arg url "${seen[url]}" --arg head "${seen[head]}" <<<"$TASK_EVENTS")
    sent=$(((10#$message >> 22) / 1000 + 1420070400))
    ((sent >= $(date -ud "${logged% *}" +%s))) ||
      die "Discord message $message was sent at $(date -ud "@$sent" +%FT%TZ), before the ${logged#* } event that first logged head ${seen[head]} at ${logged% *}, so it is not Daniel's word on that head"
  fi
fi

# A plan approval says who approved which plan: Daniel, answering an ask the task logged in a
# message sent no earlier than it, or the coordinator, with neither; team-log records the plan's
# files (plan_files in bin/lib/team.sh) and scope.txt's lines itself, refuses an approval of a
# closed task or of no plan, a second one by the same approver of the same files, and the
# coordinator's after Daniel's withdrawal, which only their approval ends. A withdrawal
# needs an approval standing (plan_approval in bin/lib/ledger.jq).
if [[ $event == plan-approved || $event == plan-approval-withdrawn ]]; then
  task_events_once
  [[ $(ledger_jq 'task_status' -r <<<"$TASK_EVENTS") != closed ]] ||
    die "$task is closed, so it takes no $event"
fi
if [[ $event == plan-approval-withdrawn ]]; then
  message=${seen[discord_message]:-}
  [[ ! $message =~ ^[0-9]+$ || $message =~ ^[1-9][0-9]{0,18}$ ]] || die "discord_message $message is not a Discord id"
  ledger_jq 'plan_approval | . != null and .state == "approved"' -e <<<"$TASK_EVENTS" >/dev/null ||
    die "$task has no plan approval standing, so plan-approval-withdrawn withdraws nothing"
fi
if [[ $event == plan-approved ]]; then
  for key in plan scope; do
    [[ -z ${seen[$key]:-} ]] ||
      die "$key is recorded by team-log itself, from the plan's files and scope.txt: give by=Daniel ask=<id> discord_message=<id>, or by=coordinator"
  done
  by=${seen[by]:-}
  [[ $by == Daniel || $by == coordinator ]] ||
    die "by names who approved the plan, Daniel or coordinator, got '$by'"
  if [[ $by == Daniel ]]; then
    [[ -n ${seen[ask]:-} && -n ${seen[discord_message]:-} ]] ||
      die "Daniel's approval names the ask it answers and their message: team-log $task plan-approved by=Daniel ask=<id> discord_message=<id>"
    asked=$(ledger_jq 'latest_asked($id) | .ts // empty' -r --arg id "${seen[ask]}" <<<"$TASK_EVENTS")
    [[ -n $asked ]] || die "$task logged no asked with id ${seen[ask]}, so the plan approval answers no ask of it"
    message=${seen[discord_message]}
    [[ $message =~ ^[1-9][0-9]{0,18}$ ]] || die "discord_message $message is not a Discord id"
    # A Discord id holds the milliseconds since 2015-01-01 above its low 22 bits.
    sent=$(((10#$message >> 22) / 1000 + 1420070400))
    ((sent >= $(date -ud "$asked" +%s))) ||
      die "Discord message $message was sent at $(date -ud "@$sent" +%FT%TZ), before the asked ${seen[ask]} at $asked, so it is not Daniel's answer to that ask"
  else
    for key in ask discord_message; do
      [[ -z ${seen[$key]:-} ]] || die "the coordinator's approval takes no $key, which only Daniel's names: team-log $task plan-approved by=coordinator"
    done
    withdrawn=$(ledger_jq 'plan_approval | select(.state == "withdrawn") | "\(.ts) in Discord message \(.discord_message)"' -r <<<"$TASK_EVENTS")
    [[ -z $withdrawn ]] ||
      die "$task's plan approval was withdrawn at $withdrawn, so only Daniel approves it again: team-log $task plan-approved by=Daniel ask=<id> discord_message=<id>"
  fi
  [[ -f $TEAM_HOME/tasks/$task/plan.md ]] || die "$task has no plan at tasks/$task/plan.md, so there is no plan to approve"
  plan=$(plan_files "$task") || die "cannot read $task's plan files"
  found=$(plan_task_dir "$task") || die "cannot read $task's task directory"
  if [[ -z $found ]]; then
    plan_project=$(jq -r 'first(.[] | select(.event == "opened") | .project | strings) // empty' <<<"$TASK_EVENTS")
    if [[ -n $plan_project ]]; then
      plan_worktree=$(task_worktrees "$task" | jq -r --arg p "$plan_project" 'select(.project == $p) | .worktree | strings' | tail -n 1)
      [[ -n $plan_worktree ]] ||
        die "$task has no open worktree of $plan_project, so its spec.md and scope.txt cannot be hashed"
      die "$task's worktree of $plan_project, $plan_worktree, is not a directory on this machine, so its spec.md and scope.txt cannot be hashed: approve the plan on the machine that holds it"
    fi
  fi
  scope=null
  if [[ -n $found && -f ${found%%$'\t'*}/scope.txt ]]; then
    scope=$(jq -Rnc '[inputs | select(test("\\S"))]' <"${found%%$'\t'*}/scope.txt")
    problem=$(ledger_jq 'if . == [] then "\($file) lists no path: list every path the plan may change, each a file or a directory ending in /, or remove it for no scope"
      else [scope_problems] | select(. != []) | "\($file) holds lines that are not clean repository paths:" + (map("\n  " + .) | add) end' \
      -r --arg file "${found#*$'\t'}/scope.txt" <<<"$scope")
    [[ -z $problem ]] || die "$problem"
  fi
  standing=$(ledger_jq 'plan_approval | select(.state == "approved" and .by == $by and .plan == $plan) | .ts' \
    -r --arg by "$by" --argjson plan "$plan" <<<"$TASK_EVENTS")
  [[ -z $standing ]] || die "$task's plan is approved already by $by, at $standing, with the same files, so a second approval means nothing"
  typed=$(jq -c --argjson plan "$plan" --argjson scope "$scope" '.plan = $plan | if $scope == null then . else .scope = $scope end' <<<"$typed")
fi

# Refuses a project that is none of the task's opened or worktree-added events: task_project <project>
task_project() {
  local problem
  task_events_once
  problem=$(ledger_jq '
    reduce (.[] | select(.event == "opened" or .event == "worktree-added") | .project | strings) as $p
      ([]; if IN(.[]; $p) then . else . + [$p] end)
    | if IN(.[]; $project) then empty
      elif . == [] then "\($project) is not a project of \($task)'"'"'s opened or worktree-added events; it has none"
      else "\($project) is not a project of \($task)'"'"'s opened or worktree-added events: \(join(", "))" end' \
    -r --arg project "$1" --arg task "$task" <<<"$TASK_EVENTS")
  [[ -z $problem ]] || die "$problem"
}

# Daniel's withdrawal of the default word, and its giving back, name a scope (task, the task they
# are logged under, which must be open; all; or a project the registry names) and a message
# team-merge can read back: Discord ids, in #coordinator's channel or the task's latest thread. A
# giving back needs a withdrawal standing that it covers (default_restore_withdrawn in
# bin/lib/ledger.jq, over the whole ledger).
if [[ $event == merge-default-withdrawn || $event == merge-default-restored ]]; then
  scope=${seen[scope]:-}
  registered=$(team_project --list) || exit 1
  if [[ $scope == task ]]; then
    task_events_once
    [[ $(ledger_jq 'task_status' -r <<<"$TASK_EVENTS") != closed ]] ||
      die "$task is closed, so scope=task names no PR it may still merge: name its project, or all"
  elif [[ -n $scope && $scope != all ]] && ! grep -qxF -- "$scope" <<<"$registered"; then
    if [[ -z $registered ]]; then names=': it names none'; else names=": $(sed ':a;N;$!ba;s/\n/, /g' <<<"$registered")"; fi
    die "scope $scope is neither task, the task it is logged under, all, every project, nor a project projects.toml names$names"
  fi
  for key in discord_message discord_channel; do
    [[ -z ${seen[$key]:-} || ${seen[$key]} =~ ^[1-9][0-9]{0,18}$ ]] || die "$key ${seen[$key]} is not a Discord id"
  done
  channel=${seen[discord_channel]:-}
  if [[ -n $channel && $channel != "$COORDINATOR_CHANNEL" ]]; then
    task_events_once
    thread=$(jq -r '[.[] | select(.event == "thread") | .discord_thread | select(. != null) | tostring] | last // empty' <<<"$TASK_EVENTS")
    [[ $channel == "$thread" ]] ||
      die "discord_channel $channel is neither #coordinator's channel, $COORDINATOR_CHANNEL, nor $task's thread$(if [[ -n $thread ]]; then echo ", $thread"; else echo ": it has none"; fi)"
  fi
  if [[ $event == merge-default-restored && -n $scope ]]; then
    ledger=$TEAM_HOME/ledger.jsonl
    [[ -e $ledger ]] || ledger=/dev/null
    ledger_jq '[inputs | fromjson? | objects] | task_projects as $projects | default_events
      | default_restore_withdrawn({task: $task, scope: $scope}; $projects)' \
      -nRe --arg task "$task" --arg scope "$scope" <"$ledger" >/dev/null ||
      die "no withdrawal of the default word stands that scope=$scope of $task covers, so merge-default-restored gives nothing back"
  fi
fi

# The task's new branch in one of its projects names the task, as team-close holds a worktree's
# branch to, is a branch name git takes, and is not its branch there now.
if [[ $event == branch-renamed && -n ${seen[project]:-} && -n ${seen[branch]:-} ]]; then
  task_project "${seen[project]}"
  branch=${seen[branch]}
  task_events_once
  [[ $branch != "$(ledger_jq 'task_branch($project) // ""' -r --arg project "${seen[project]}" <<<"$TASK_EVENTS")" ]] ||
    die "$branch is already $task's branch for ${seen[project]}"
  [[ $branch =~ (^|[^[:alnum:]])$task($|[^[:digit:]]) ]] || die "$branch does not name $task, as a branch of its worktree must"
  git check-ref-format --branch "$branch" >/dev/null 2>&1 ||
    die "$branch is not a branch name git takes (git check-ref-format --branch)"
fi

# A review's finding counts, before and widening notes and guarded areas, as the reviewer's DONE gives them.
if [[ $event == review ]]; then
  problem=$(ledger_jq '
    def listed: (.[:-1] | join(", ")) + " and " + last;
    def lines: map("\n  " + .) | add;
    def numbered: map(tostring) | if length == 1 then first else listed end;
    def notes($n): "\($n) plain note\(if $n == 1 then "" else "s" end) on code the PR did not change";
    $line.findings as $f
    | $line.before as $b
    | $line.sent_back as $s
    | $line.guarded as $g
    | $line.widening as $w
    | (if ($f | type) == "object" then [$f | findings_problems] == [] else false end) as $f_ok
    | (if ($b | type) == "array" then [$b | before_problems] == [] else false end) as $b_ok
    | ($f | objects | [findings_problems] | select(. != [])
        | "findings holds the count of each finding kind, exactly \(finding_kinds | listed), each a whole number:" + lines),
      ($b | arrays | [before_problems] | select(. != [])
        | "before lists the numbers of the plain notes on code the PR did not change, each a whole number above 0, once:" + lines),
      (select($f_ok and $b == null and $f["note-before"] > 0)
        | "findings counts \(notes($f["note-before"])): before lists their numbers"),
      (select($f_ok and $b_ok and ($b | length) != $f["note-before"])
        | "before lists \($b | length) note\(if ($b | length) == 1 then "" else "s" end), but findings counts \(notes($f["note-before"]))"),
      (select($b_ok and ($s | type) == "array") | [$s[] | select(IN($b[]))] | unique | select(. != [])
        | "sent_back names note\(if length == 1 then "" else "s" end) \(numbered), which before lists as "
          + (if length == 1 then "a plain note" else "plain notes" end)
          + " on code the PR did not change: such a note is queued as a follow-up, never sent back"),
      ($w | arrays | [before_problems] | select(. != [])
        | "widening lists the numbers of the findings in what the last fix added, each a whole number above 0, once:" + lines),
      (select($b_ok and ($w | type) == "array") | [$w[] | select(IN($b[]))] | unique | select(. != [])
        | "widening names note\(if length == 1 then "" else "s" end) \(numbered), which before lists as on code the PR did not change"),
      ($g | arrays | [guarded_problems] | select(. != [])
        | "guarded lists the guarded areas the change touches, each one of \(guarded_areas | listed):" + lines)' \
    -nr --argjson line "$typed")
  [[ -z $problem ]] || die "$problem"
fi

# An ask that names a script binds Daniel's OK to its bytes (team-run-approved), which only a
# question that names its path and hash does: team-ask --script is the one writer of both.
if [[ $event == asked && ( -v seen[script] || -v seen[sha256] ) ]]; then
  die "an asked logs no script or sha256: team-ask $task ${seen[id]:-<id>} --file <question> --script <path> asks Daniel about a script, naming its path and hash in the question"
fi

# A retro-change links approved proposals: its retro is a retro task (an opened of path retro)
# whose proposals Daniel answered (an answered of id retro).
if [[ $event == retro-change && -n ${seen[retro]:-} ]]; then
  retro=${seen[retro]}
  opened='' answered=''
  json_vars opened='any(.[]; .event == "opened" and .path == "retro")' \
    answered='any(.[]; .event == "answered" and .id == "retro")' <<<"$(task_event_array "$retro")"
  [[ $opened == true ]] ||
    die "$retro is not a retro task: it has no opened event with the path retro, so retro-change links no retro's proposals"
  [[ $answered == true ]] ||
    die "$retro has no answered with id retro: Daniel has not answered its proposals, so none is approved to build"
fi

# A park logged after the fact says when it began: a UTC time between the task's latest event and now.
if [[ -n ${seen[since]:-} ]]; then
  case $event in waiting | blocked | paused | held) ;; *) die "since is taken only by a park (waiting, blocked, paused, held), not $event" ;; esac
  since=${seen[since]}
  jq -ne --arg t "$since" '$t | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$") and ((try fromdate catch null) | . != null and todate == $t)' >/dev/null ||
    die "since must be a UTC time like 2026-10-22T01:00:00Z, got '$since'"
  now=$(date -u +%FT%TZ)
  [[ ! $since > $now ]] || die "since $since is later than now ($now)"
  task_events_once
  latest=$(jq -r '[.[] | .ts | strings] | last // empty' <<<"$TASK_EVENTS")
  [[ -z $latest || ! $since < $latest ]] || die "since $since is earlier than $task's latest event, at $latest"
fi

}

# A gate run that re-gates a base merge, run to its end, is one the gated delivery brief asks for
# none of: logged all the same, with one line on stderr saying so, said only where it is logged.
# base_merge_note <line>.
base_merge_note() {
  jq -r --arg task "$task" 'select(.event == "gate-run" and .cause == "base-merge" and .outcome != "aborted")
    | "team-log: \($task) gate run \(.run) re-gates a base merge, which the gated delivery brief asks no gate run for: a merge of the base is re-reviewed and checked by CI"' <<<"$1" >&2
}

if [[ $1 != --* ]]; then
  check_event "$@"
  # Stamped now, after the checks, so a park's since is never later than its ts.
  ledger_append "$(stamped "$typed")"
  base_merge_note "$typed"
  ledger_push
  exit 0
fi

# A worker's message, read whole (bin/lib/messages.jq) into its events, each checked by
# check_event before any is logged.
message='' from='' sent_back='' relay='' print=''
declare -A given=()
while (($#)); do
  case $1 in
    --from-message | --from | --sent-back | --relay)
      [[ -z ${given[$1]:-} ]] || usage_error "$1 is given twice"
      case $1 in
        --from-message) what="a message" ;;
        --from) what="a session name or id" ;;
        --relay) what="a Discord message id" ;;
        *) what="a list" ;;
      esac
      [[ $# -ge 2 && -n $2 ]] || usage_error "$1 needs $what"
      given[$1]=1
      case $1 in
        --from-message) message=$2 ;;
        --from) from=$2 ;;
        --relay)
          [[ $2 =~ ^[1-9][0-9]{0,18}$ ]] || usage_error "--relay takes the Discord id of the relay's message, got '$2'"
          relay=$2
          ;;
        *) sent_back=$2 ;;
      esac
      shift 2
      ;;
    --print) print=1 && shift ;;
    *) usage_error "$usage" ;;
  esac
done
if [[ -z ${given[--from-message]:-} ]]; then
  for option in --from --sent-back --relay; do
    [[ -z ${given[$option]:-} ]] || usage_error "$option is taken only with --from-message"
  done
  usage_error "--print is taken only with --from-message"
fi

# The task's brief records, by brief name, for a review's head.
brief_records='{}'
shopt -s nullglob
files=("$TEAM_HOME/tasks/$task"/brief*.json)
shopt -u nullglob
if ((${#files[@]})); then
  brief_records=$(jq -n 'reduce inputs as $r ({}; .[input_filename | split("/") | last | rtrimstr(".json")] = $r)' "${files[@]}") ||
    die "cannot read $task's brief records: ${files[*]}"
fi

task_events_once
# A reviewer's verdict on a project whose agent-review the reviewer App posts is taken only from the
# session of the task's latest reviewer launch (message_app_sender in bin/lib/messages.jq): the
# first, when own_bar gives it the App, of the project of each of the task's pr events (by its
# project, else the registered project of its URL's repo), whose PR team-next posts the check
# for, and the project of that latest launch, which may name another project or none.
app=''
if [[ $message =~ ^[[:space:]]*T[0-9]+[[:space:]]+DONE[[:space:]]+(pass|findings)([[:space:]]|$) ]]; then
  while IFS= read -r reviewed_in; do
    if [[ $reviewed_in == repo:* ]]; then
      reviewed_in=$(team_project --find repo "${reviewed_in#repo:}") || exit 1
      reviewed_in=${reviewed_in%%$'\n'*}
    fi
    [[ -n $reviewed_in ]] || continue
    bar=$(own_bar "$reviewed_in") || exit 1
    if [[ $(jq -r '.app? // empty' <<<"$bar") ]]; then
      app=$reviewed_in
      break
    fi
  done < <(jq -r '(.[] | select(.event == "pr") | .project // (.url | strings
      | capture("^https://github\\.com/(?<repo>[^/]+/[^/]+)/pull/").repo | "repo:\(.)") // empty),
    (map(select(.event == "launch" and .role == "reviewer")) | last | .project // empty)' <<<"$TASK_EVENTS")
fi
parsed=$(jq -L "$TEAM_LIB" -c --arg task "$task" --arg message "$message" --arg from "$from" \
  --arg sent_back "$sent_back" --arg relay "$relay" --arg app "$app" --argjson records "$brief_records" \
  'include "messages"; include "ledger"; . as $events
    | $message | parse_message($task; $events; $records; $from; $sent_back; $app) | message_relay($task; $message; $relay)' <<<"$TASK_EVENTS")
problem=$(jq -r '.problems // empty | join("; ")' <<<"$parsed")
[[ -z $problem ]] || die "$problem"

# A PR's head, and its head branch against the task's in the PR's project: the pr event's head, and
# a branch-renamed when they differ (the gate moved the branch).
# github_pr <url>: sets pr_head, and renamed to "project=<p> branch=<b>" or ''.
github_pr() {
  local url=$1 repo number project='' p r view branch current names=()
  [[ $url =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+)/?$ ]]
  repo=${BASH_REMATCH[1]} number=${BASH_REMATCH[2]}
  while IFS= read -r p; do
    r=$(team_project "$p" repo) || exit 1
    names+=("$p ($r)")
    [[ ${r,,} != "${repo,,}" ]] || project=$p
  done < <(jq -r '.[] | select(.event == "opened" or .event == "worktree-added") | .project | strings' <<<"$TASK_EVENTS" | awk '!seen[$0]++')
  if [[ -z $project ]]; then
    ((${#names[@]})) || die "$url is in no repo of $task's projects: it has none"
    p=$(printf ', %s' "${names[@]}")
    die "$url is in no repo of $task's projects: ${p:2}"
  fi
  pr_head='' branch=''
  if ! view=$(gh pr view "$number" --repo "$repo" --json headRefOid,headRefName 2>&1) ||
    ! json_vars pr_head='.headRefOid | strings | select(test("^[0-9a-f]{7,40}$"))' \
      branch='.headRefName | strings | select(. != "")' <<<"$view" 2>/dev/null ||
    [[ -z $pr_head || -z $branch ]]; then
    die "cannot read $url on GitHub ($(head -n 1 <<<"$view")); log it by hand: team-log $task pr url=$url head=<full sha>"
  fi
  current=$(ledger_jq 'task_branch($project) // ""' -r --arg project "$project" <<<"$TASK_EVENTS")
  renamed=''
  [[ $branch == "$current" ]] || renamed="$project $branch"
}

# Each event as its kind, its GitHub url or nothing, its count of fields and its key=value fields,
# NUL-separated, read in one jq run.
lines=()
mapfile -d '' -t records < <(jq -j '.events[] | [.event, (.github // ""), (.fields | length | tostring),
  (.fields[] | "\(.[0])=\(.[1])")][] | . + "\u0000"' <<<"$parsed")
for ((i = 0; i < ${#records[@]}; i += 3 + n)); do
  kind=${records[i]} url=${records[i + 1]} n=${records[i + 2]}
  fields=("${records[@]:i+3:n}")
  renamed=''
  if [[ -n $url ]]; then
    github_pr "$url"
    fields+=("head=$pr_head")
  fi
  check_event "$kind" "${fields[@]}"
  lines+=("$typed")
  if [[ -n $renamed ]]; then
    check_event branch-renamed "project=${renamed%% *}" "branch=${renamed#* }"
    lines+=("$typed")
  fi
done

# Every event meets the contract before the first is logged, so a refusal logs nothing.
if ((${#lines[@]})); then
  problem=$(ledger_jq 'first(inputs | [append_problems($contract; "team-log")] | join("; ") | select(. != ""))' \
    -nr <<<"$(printf '%s\n' "${lines[@]}")")
  [[ -z $problem ]] || die "refusing a ledger event: $problem"
fi
for line in "${lines[@]}"; do
  line=$(stamped "$line")
  if [[ -n $print ]]; then
    printf '%s\n' "$line"
  else
    ledger_append "$line"
    base_merge_note "$line"
  fi
done
ledger_push
