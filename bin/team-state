#!/usr/bin/env bash
# Tell where a task stands, from its ledger events, the live session list and GitHub.
#
# Usage: team-state T<n> [--json]
# Prints one line: the task, its project and path, its phase, its live workers and its PR, as
#   T14 agent-team feature building | T14-builder idle | PR #5 a1b2c3d checks 2/2 agent-review missing
# With --json, the versioned state (schema team-state/1): task, title, project, path, phase,
# worktrees (returned or not), thread, workers (every launch, live when claude agents --json
# lists its session, with that session's status and state), last_event, pending_asks, and pr.
# Phase, first match wins: closed, merged, held or blocked (with no later resumed),
# awaiting-merge (the latest review of the ledger's PR head is a pass; that head is the latest pr
# or history-rewritten event's), in-review (a pr event), building (plan-approved), planning.
# Heads compare by the shorter one's prefix, at least 7 characters.
# pr is null without a pr event; otherwise it joins the latest pr event with GitHub (gh pr view,
# gh pr checks, gh pr checks --required): number, repo and project (from the event's project in
# projects.toml, else from the URL), state, base, the live head, the ledger head, head_moved,
# checks passed, failing and pending by name (a skipped check counts as passed, a cancelled one
# as failing), required (server-required plus the project's required_checks) and
# required_missing, agent_review (the agent-review check's state on the head, or missing), and
# merge_approved (a merge-approved event for this PR). When GitHub cannot be read, pr carries
# error instead of GitHub's facts, the text says "GitHub unavailable", and the exit is still 0.
# waiting is the task's latest waiting (on, reason, since) until a later launch or resumed, or
# null; the text form ends with "waiting on <on>: <reason>".
# Exit 1 for a task with no events, or when the live session list cannot be read.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-state T<n> [--json]"

task='' json=''
for arg in "$@"; do
  case $arg in
    --json) json=1 ;;
    -*) usage_error "$usage" ;;
    *)
      [[ -z $task ]] || usage_error "$usage"
      task=$arg
      ;;
  esac
done
[[ -n $task ]] || usage_error "$usage"
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"

events=$(task_events "$task" | jq -cs .)
[[ $events != '[]' ]] || die "unknown task $task: the ledger has no events for it"
state=$(task_state_json "$events") || exit 1

if [[ -n $json ]]; then
  jq . <<<"$state"
else
  ledger_jq 'state_line' -r <<<"$state"
fi
