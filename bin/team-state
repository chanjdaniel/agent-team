#!/usr/bin/env bash
# Tell where a task stands, from its ledger events, the live session list and GitHub.
#
# Usage: team-state T<n> [--json]
# Prints one line: the task, its project and path, its phase, its live workers and its PR, as
#   T14 agent-team feature building | T14-builder idle 302k | PR #5 a1b2c3d checks 2/2 agent-review missing
# each live worker with its status, its state unless working, and its context in thousands.
# With --json, the versioned state (schema team-state/1): task, title, project, path, phase,
# worktrees (returned or not), thread, workers (every launch, live when claude agents --json
# lists its session, with that session's status, state and context, the tokens its latest
# main-conversation reply read, from its transcript, or null), last_event, pending_asks, waiting,
# rehome_failures, and pr; pending_asks are the asks no later event settles, an answered with
# the ask's id or a merge-approved whose url its text names.
# Recorded worktree paths under another machine's home (/home/<name>, /Users/<name>) show as the
# same paths under this HOME.
# Phase, first match wins: closed, merged (every PR merged, and no held or blocked standing that
# was logged after the latest merged, a later part still to come), held (with no later resumed),
# blocked (with no later resumed or launch), awaiting-merge (every PR not merged has a pass as the latest
# review of its head), in-review (a pr event), building (plan-approved), planning. A task's PRs are the latest pr event
# in each repo; a PR's head is that event's, moved by each later history-rewritten from it (or from
# a head no PR has); a PR is merged by a merged event naming its URL (legacy: its number).
# Heads compare by the shorter one's prefix, at least 7 characters.
# pr is null without a pr event; otherwise it joins the latest pr event with GitHub (gh pr view,
# gh pr checks, gh pr checks --required): number, repo and project (from the event's project in
# projects.toml, else from the URL), state, base, the live head, the ledger head, head_moved,
# checks passed, failing and pending by name (a skipped check counts as passed, a cancelled one
# as failing), required (server-required plus the project's required_checks) and
# required_missing, agent_review (the agent-review check's state on the head, or missing), and
# merge_approved (a merge-approved event naming this PR's URL). When GitHub cannot be read, pr
# carries error instead of GitHub's facts, the text says "GitHub unavailable", and the exit is
# still 0.
# waiting is the task's latest waiting (on, reason, since) until a later launch or resumed, or
# null; the text form ends with "waiting on <on>: <reason>".
# rehome_failures are the worktrees team-resume could not re-home and nothing has made since: each
# project's latest rehome-failed, as {project, branch, machine, reason, since}, until a later
# opened, worktree-added, worktree-moved, rehomed or worktree-returned in that project; the text
# form says "not re-homed: <project> on <machine>: <reason>", before any waiting.
# Exit 1 for a task with no events, or when the live session list cannot be read.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-state T<n> [--json]"

task='' json=''
for arg in "$@"; do
  case $arg in
    --json) json=1 ;;
    -*) usage_error "$usage" ;;
    *)
      [[ -z $task ]] || usage_error "$usage"
      task=$arg
      ;;
  esac
done
[[ -n $task ]] || usage_error "$usage"
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"

events=$(known_task_events "$task")
state=$(task_state_json "$events") || exit 1

if [[ -n $json ]]; then
  jq . <<<"$state"
else
  ledger_jq 'state_line' -r <<<"$state"
fi
