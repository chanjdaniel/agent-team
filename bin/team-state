#!/usr/bin/env bash
# Tell where a task stands, from its ledger events, the live session list and GitHub.
#
# Usage: team-state T<n> [--json]
# Prints one line: the task, its project and path, its phase, its live workers, its progress and
# its PR, as
#   T14 agent-team feature building | T14-builder idle 302k on build-04 | tickets 3/7, graph stale | review 4 findings, sent back 5, 6 | PR #5 a1b2c3d 16 behind dev checks 2/2 agent-review missing
# each live worker with its status, its state unless working or unknown, its context in thousands
# and the brief its launch logged, less "brief-"; then "tickets <done>/<total>" ("tickets <done>
# done" while the total is unknown or 0, nothing with neither), with ", graph fresh" or ", graph
# stale" when the tickets have a graph, "review <count> <verdict>" with
# ", sent back <findings>" when the latest review sent any back (nothing before the first review),
# and in the PR part "<n> behind <base>" when the base has commits the head lacks.
# With --json, the versioned state (schema team-state/1): task, title, project, path, phase,
# worktrees (returned or not), thread, workers (every launch, live when claude agents --json
# lists its session, with that session's status, state and context, the tokens its latest
# main-conversation reply read, from its transcript, or null, and the brief its launch logged, or
# null), last_event, pending_asks, waiting, parks, stowing, walk, rehome_failures, checks_wait, pr,
# and progress;
# pending_asks are the asks no later event settles, an answered or a
# merge-preapproved with the ask's id or a merge-approved whose url its text names.
# progress is where the task is: tickets (done, the ticket numbers with a ticket-done, each once,
# total, the ticket files team-tickets T<n> --json lists, or null when it refuses them, and graph,
# the page team-tickets T<n> --graph wrote in the task directory of the first ticket listed, as
# {html, png, fresh}, png null without tickets.png and fresh true only while the page's digest is
# that of the --json list now, tickets.png exists and it is no older than tickets.html, or null
# with no tickets, no tickets.html or a refused set), on
# (each live worker's role, session and brief), and reviews (count, the task's review events, and
# the latest one's verdict, head and sent_back, each null when there is none).
# Recorded worktree paths under another machine's home (/home/<name>, /Users/<name>) show as the
# same paths under this HOME.
# Phase, from the ledger's lifecycle fold (bin/lib/ledger.jq, its table bin/lib/lifecycle.json),
# first match wins: closed, held (a held standing), blocked (a blocked standing), each wherever it
# was logged, a park standing until the fold ends it by its cause's rules (bin/lib/lifecycle.json's
# causes; team-log's header says what each resumed ends),
# else the work phase the task's events moved it to: planning, building, in-review, awaiting-merge,
# merged-part or merged. An opened starts a small or bug task in building and any other in planning;
# a plan-approved moves planning to building, and a plan-approval-withdrawn building back to
# planning; a builder's launch or a ticket-done moves planning, merged-part or merged to building,
# except while the plan approval is withdrawn; a builder's done reporting review-ready or merged
# moves building to in-review; a pr, and while building, in review or awaiting merge a review or
# (with a PR logged) a history-rewritten, makes it awaiting-merge when it has a PR not merged and
# each such PR's latest review on its head is a pass, else in-review; a merged that leaves no PR
# open makes it merged-part when it names phases_left (phases with a ticket not done), else merged.
# A task's PRs are the latest pr event in each repo; a PR's head is that event's, moved by each
# later history-rewritten from it (or from a head no PR has); a PR is merged by a merged event
# naming its URL (legacy: its number). Heads compare by the shorter one's prefix, at least 7
# characters.
# pr is null without a pr event; otherwise it joins the latest pr event with GitHub (gh pr view,
# gh pr checks, gh pr checks --required): number, repo and project (from the event's project in
# projects.toml, else from the URL), state, base, branch (the PR's head branch), the live head, the
# ledger head, head_moved, caught_up (true when the task's latest caught-up event of the PR's URL
# made the live head from the ledger head, team-catch-up's clean merge of the base, else false; the
# text says "(caught up cleanly with <base>)" for it where it says "(head moved)" for any other
# moved head), checks passed, failing and pending by name (a skipped check counts as passed, a
# cancelled one as failing), required (server-required plus the project's required_checks) and
# required_missing, agent_review (the agent-review check's state on the head, or missing),
# merge_approved (a merge-approved event naming this PR's URL), behind_by (the commits of the base
# the head lacks, from gh api's compare of the two for an open PR; null for a PR not open or when
# the compare cannot be read, which fails nothing else), and merge_authority. When GitHub cannot be
# read, pr carries error instead of GitHub's facts, the text says "GitHub unavailable", and the exit
# is still 0.
# merge_authority is the words the PR may merge on, as merge_authority in bin/lib/ledger.jq
# derives them for team-merge, team-sweep, team-next and team-inbox alike: null for a PR of no
# registered project, else {words, word}, words the per-head word and then the default word, each
# {word: "head" or "default", applies, holds, reasons, facts}, and word the first that holds, or
# null. It is read from the task's events, every task's merge-default-withdrawn and
# merge-default-restored, and whether the PR's project is the team's own (own_project in
# bin/lib/team.sh), on the head GitHub shows. Only while the phase is awaiting-merge and the
# default word holds on the ledger, the reasons team-merge would find in GitHub's view are added to
# it (GitHub unreadable, the PR from a branch not the task's, GitHub's list of the PR's files not
# read in full, a guarded path of bin/lib/guarded, a path outside the approved plan's scope), and
# its holds and the word follow them; Daniel's messages are not read back, the plan's files are
# not hashed and the checks are not judged. While awaiting merge with the plan approved
# (the default word applies), the text form says the first
# that holds of "default word covers it", "default word withdrawn" (the default withdrawn for the
# task, its project or every project) and "default word does not cover it: <the first reason>"
# (with " (and <n> more)" for more), before the walk and the parks.
# waiting is the task's latest standing waiting (on, reason, since), or null. parks are the task's standing parks (held, blocked, waiting, paused) in the order logged,
# each {id, kind, cause, on, reason, since, passed}: id <kind>-<n>, the park's ordinal among the
# task's events of its kind; cause the line's own, else for an old line the one bin/lib/ledger.jq's
# legacy_cause reads from its words; since its since, else its ts; passed, whether a launch since
# went past its ask (team-worker --past-ask names it), a typed ask's wait. The text form ends with "parks:
# <id> <cause> since <since>: <reason>" for each, joined by "; ", " (passed by a launch)" after a
# passed one, and has no parks part with none.
# stowing is the task's stow under way, {since, cause} of its stowing (team-stow --begin, or a
# team-stow run, logged it) until its stowed or stow-failed, or null; the text form says "stowing
# since <ts>" while one stands, after the walk and before the parks.
# walk is the task's manual QC walk (team-ui T<n> --walk), {"since": "<ts>"} while it is on, from
# its latest walk event's ts, and null while it is off or the task is closed; the text form says
# "walk on since <ts>" while it is on, before the parks, and nothing of it while it is off.
# rehome_failures are the worktrees team-resume could not re-home and nothing has made since: each
# project's latest rehome-failed, as {project, branch, machine, reason, since}, until a later
# opened, worktree-added, worktree-moved, rehomed or worktree-returned in that project; the text
# form says "not re-homed: <project> on <machine>: <reason>", before the parks.
# checks_wait is what the task's latest pass waits on, as checks_wait in bin/lib/ledger.jq reads it
# from the ledger alone: null unless the latest review is a pass on a PR not merged, else {url,
# reviewed, head, since, state, reruns}, state the outcome of the latest ci team-next T<n> --ci
# logged of head (passed, failed, infrastructure or pending), or waiting with none; the text form
# says "checks <state>" while one stands, after the PR part.
# Exit 1 for a task with no events, or when the live session list or the registry cannot be read.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-state T<n> [--json]"

task='' json=''
for arg in "$@"; do
  case $arg in
    --json) json=1 ;;
    -*) usage_error "$usage" ;;
    *)
      [[ -z $task ]] || usage_error "$usage"
      task=$arg
      ;;
  esac
done
[[ -n $task ]] || usage_error "$usage"
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"

events=$(known_task_events "$task")
state=$(task_state_json "$events") || exit 1

if [[ -n $json ]]; then
  jq . <<<"$state"
else
  ledger_jq 'state_line' -r <<<"$state"
fi
