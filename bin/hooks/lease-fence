#!/usr/bin/env bash
# PreToolUse hook that keeps a machine that lost the lease from acting: exit 2 blocks the tool
# call and shows stderr to the agent; anything else passes at once.
#
# Usage: lease-fence [--coordinator]   (the hook's input on stdin; --coordinator on its Bash)
#   Discord (the coordinator's reply, react and edit_message), and a Bash command of any role
#     that runs team-post, team-ask or team-inbox: blocked while this machine is fenced, or when the lease on origin is
#     not this machine's last write and names another holder or a higher epoch, so an old
#     coordinator or worker never posts in the channel the new one owns, even before its
#     heartbeat fences it (lease_refusal in bin/lib/team.sh, which team-post runs itself too:
#     origin asked at most once a minute; unreachable passes, since the heartbeat owns offline).
#   Bash, a command of any role that runs team-thread wait (an interview's read of Discord):
#     blocked as a post is, with what such a machine does instead.
#   Bash (workers): a command that runs git push is blocked while this machine is fenced; while
#     the team holds offline, one that runs git push, gh, gh-axi or team-thread wait is blocked
#     with the hold (offline_hold: "GitHub is unreachable (since 13:05); the team is holding:
#     ..."), so no worker retries or waits on.
#   Bash (the coordinator, --coordinator): a command that runs git push, team-merge, team-open
#     or team-close is blocked as a Discord post is, so a coordinator left running on a machine
#     that lost the lease merges, opens, closes and pushes nothing while the holder's does.
# Reads, in ~/.local/state/agent-team/: fenced (team-lease's), offline (team-timers run's,
# through offline_hold in bin/lib/team.sh), and what lease_refusal reads there.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/team.sh" "$@"

role=worker
case ${1:-} in
  '') ;;
  --coordinator) role=coordinator ;;
  # Exit 1, not 2: a hook's exit 2 would block every call it sees.
  *) echo "lease-fence: usage: lease-fence [--coordinator]" >&2 && exit 1 ;;
esac
input=$(cat)
tool=$(jq -r '.tool_name // empty' <<<"$input")
machine=$(machine_name 2>/dev/null) || machine="this machine"

# What a machine that may not post does not do, for lease_refusal.
POSTS="posts nothing to Discord; the coordinator on the holder answers there."
# What one that may not wait on an interview does not do, as team-thread wait says it.
WAITS="waits on no interview; stop, since the coordinator on the holder takes the task on."

block() {
  echo "Blocked: $1" >&2
  exit 2
}

case $tool in
  mcp__plugin_discord_discord__reply | mcp__plugin_discord_discord__react | mcp__plugin_discord_discord__edit_message)
    why=$(lease_refusal "$POSTS") && block "$why"
    ;;
  Bash)
    command=$(jq -r '.tool_input.command // empty' <<<"$input")
    push='(^|[^[:alnum:]_.-])git([[:space:]]+(-[Cc][[:space:]]+[^[:space:]]+|-[^[:space:]]+))*[[:space:]]+push([[:space:]]|$)'
    # gh or gh-axi where a command starts: at the start, after a separator or a line break, past
    # any variable assignments and a directory.
    gh=$'(^|[;&|(`\n])[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*([^[:space:];&|]*/)?gh(-axi)?([[:space:]]|$)'
    # The team commands that write to GitHub and the ledger, where a command starts, as gh.
    team_write=$'(^|[;&|(`\n])[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*([^[:space:];&|]*/)?team-(merge|open|close)([[:space:]]|$)'
    # team-post, team-ask, which posts through it, or team-inbox, which edits the Waiting on you
    # message, where a command starts, as gh: refused as the Discord tools are, for every role.
    post=$'(^|[;&|(`\n])[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*([^[:space:];&|]*/)?team-(post|ask|inbox)([[:space:]]|$)'
    # team-thread wait, the interview's blocking read of Discord, where a command starts, as gh.
    wait=$'(^|[;&|(`\n])[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*([^[:space:];&|]*/)?team-thread[[:space:]]+wait([[:space:]]|$)'
    if [[ $command =~ $post ]]; then
      why=$(lease_refusal "$POSTS") && block "$why"
    fi
    if [[ $command =~ $wait ]]; then
      why=$(lease_refusal "$WAITS") && block "$why"
    fi
    if [[ $role == coordinator ]]; then
      if [[ $command =~ $push || $command =~ $team_write ]]; then
        why=$(lease_refusal "pushes, merges, opens and closes nothing; the coordinator on the holder does.") && block "$why"
      fi
    elif why=$(fence_reason); then
      [[ ! $command =~ $push ]] ||
        block "$machine is $why: a fenced machine pushes nothing; commit locally and stop."
    elif hold=$(offline_hold); then
      if [[ $command =~ $push || $command =~ $gh || $command =~ $wait ]]; then
        block "$hold"
      fi
    fi
    ;;
esac
exit 0
