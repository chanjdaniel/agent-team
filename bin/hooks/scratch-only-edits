#!/usr/bin/env bash
# PreToolUse hook for planners and reviewers: file edits are allowed only inside the
# worktree's .scratch/ directory. Exit 2 blocks the tool call and shows stderr to the agent.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/team.sh" "$@"
input=$(cat)
path=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' <<<"$input")
cwd=$(jq -r '.cwd // empty' <<<"$input")
root=${CLAUDE_PROJECT_DIR:-${cwd:-$PWD}}
[[ -n $path ]] || exit 0
[[ $path == /* ]] || path="${cwd:-$PWD}/$path"
target=$(realpath -m -- "$path")
scratch=$(realpath -m -- "$root/.scratch")
# By text, not by identity (same_path): the file may not exist yet, and a path that names the
# scratch directory in another case is refused, the safe side for a guard.
if [[ $target == "$scratch" || $target == "$scratch"/* ]]; then
  exit 0
fi
echo "Blocked: this role may edit files only under $scratch (tried $target)." >&2
exit 2
