#!/usr/bin/env bash
# PreToolUse hook for planners and reviewers: they write files only inside the worktree's .scratch/
# directory. Exit 2 blocks the tool call and shows stderr to the agent.
#
# An Edit, Write, MultiEdit or NotebookEdit call is judged by its path, resolved with its symlinks.
#
# A Bash call is allowed unread when it holds no > and not the letters tee once every ', " and \
# is taken out of it (and every \ that ends a line, with its newline). Every other Bash command is
# read whole against the grammar below, and refused unread, with a message naming the form, at the
# first thing outside it; nothing is judged until the whole command is read.
#
# The grammar:
# - Words: unquoted text, '...', "..." (with the escapes \$ \` \" \\ and its expansions),
#   backslash escapes, line continuations (a \ ending a line, outside single quotes), comments (# at
#   a word's start, to the line's end), ANSI-C strings $'...' (to their unescaped '), and the
#   expansions $name, ${name}, the special parameters ($?, $#, $@, $1 and the rest), $( ), $(( ))
#   and ${ } with an operator.
# - ${ } with an operator: an optional # or !, a name, digits or a special parameter, an optional
#   subscript of letters, digits and _ @ * $ # + -, then } or one of the operators - = + ? (each
#   with or without :), # ## % %% / // /# /% ^ ^^ , ,, : (an offset) and @ with a letter but P;
#   its operand, on one line, holds literal text, backslash escapes and $name, ${name} or a
#   special parameter, and runs to the first unescaped } (a ), a # or a blank in it is text).
# - Arithmetic, $(( )), (( )) and for (( )): names, digits, blanks, newlines, the characters
#   + - * / % < > = ! & | ^ ~ ? : , . [ ] #, balanced ( ), $name, a special parameter, ${ } and
#   $( ), and in for (( )) the ; between its expressions, closing with )) at the level it opened.
# - Substitutions: a $( ), unquoted, in "..." or in an unquoted delimiter's here-document body, is
#   read as a command list by this same grammar, to the ) that closes it at its own level, so a
#   comment, a quoted ) and a here-document in it are read as bash 5.2 and later read them; so is
#   a process substitution <( ) or >( ), a whole word. Every command in one is judged, a relative
#   target from the directory the command holding it starts in; as a tee file or an output target,
#   a process substitution is its pipe, /dev/fd/N.
# - Simple commands: assignments, words and redirections in any order; an assignment name=( ) or
#   name+=( ) in assignment position is an array, whose words, across lines and comments, are read
#   as words.
# - Compound commands, each with its redirections after it: ( ), { }, if/then/elif/else/fi, while
#   and until loops, for name [in words] and for (( )) loops (then ; or newlines, do, done), case
#   with its word, in, each arm's optional (, patterns joined by | and ), its list and ;;, ;& or
#   ;;&, and esac; [[ ]] with words, && and ||, and < and > as comparisons, and the word after =~
#   read as a regular expression, its ( ) and | part of it and inside its ( ) its blanks and
#   ; & < > too; and (( )). A reserved word that ends a list may follow a compound command.
# - Function definitions: a plain name, ( ) and a compound command, its body.
# - Redirections: [n]>, [n]>>, [n]>|, &>, &>>, [n]<> and [n]>&word are output redirections, whose
#   target is judged, but a >& whose word's value is digits, - or digits and -, a duplication;
#   [n]<, [n]<&, a here-string <<< word and here-documents are read and not judged.
# - Here-documents: << or <<-, then a delimiter that is a plain word of letters, digits and _ . -,
#   unquoted, wholly in ' or ", or after one \. Its body runs from the next newline read in the same
#   substitution to the first line equal to the delimiter (its leading tabs stripped for <<-), the
#   bodies of a line's here-documents in the order they were read. A quoted delimiter's body is
#   text; an unquoted one's is read as the shell expands it, a \ escaping the next character, and
#   each $( ) in it read as above.
# - Lists and pipelines: ;, &, newlines, &&, ||, | and |&, and ! and time [-p [--]] before a
#   pipeline.
# - Wrappers: env, sudo, nohup, timeout and its duration (whatever its word), nice, stdbuf, command
#   (but -v and -V, which run nothing), exec, time and builtin, by any path, past their options,
#   those options' values and env's and sudo's assignments, so the command they run is the command
#   word.
# - A command word, a wrapper and tee are known by the word's text with its quotes and backslashes
#   removed; a word holding an expansion, a glob, a brace pair or an ANSI-C escape names no command
#   the hook knows.
#
# Refused unread, each naming its form: a backtick substitution, $[ ], $" ", an extended glob;
# select, coproc, the function keyword, and the alias, enable and hash builtins; a function named
# cd, pushd, popd, tee, mktemp, basename or a wrapper, and one whose name is not plain; a ${ }
# outside the forms above, a quote, a newline or an expansion but a variable in its operand, and
# the @P operator, which runs the substitutions in its value; arithmetic that does not close with
# )) or holds a quote, a backtick, a $(( )) or another character; a (, ), |, &, ; or newline in a
# [[ ]] outside its regular expression, or a newline or a process substitution inside that; a ( in
# a command but a function definition's or an array assignment's, an array assignment with text
# after its ), and a word after a compound command but its redirections; a set option other than
# the flags e, u, x, v, E and T after - or +, and -o or +o with errexit, nounset, xtrace,
# verbose, pipefail, errtrace or functrace (the words after --, - or the first word that is no
# option are its positional parameters), and any shopt option but -p and -q; the names IFS, CDPATH
# and POSIXLY_CORRECT anywhere in the command, but IFS= as the prefix assignment of a command that
# holds a word; a {name} file descriptor; a here-document delimiter other than those above, a
# here-document whose delimiter line is not found, a line ending in an odd number of backslashes in
# an unquoted delimiter's body, and, inside a $( ), a here-document whose $( ) closes before its
# body is read and a body line that starts with its delimiter and a ); a process substitution
# inside a longer word; on a bash older than 5.2, which finds a $( )'s close another way, a
# comment, a here-document or a case inside a substitution; and what bash refuses as a syntax error
# (an unclosed quote, substitution or compound command, a ( or ) or a reserved word out of place,
# an empty list in a compound command but a case arm's, a ;; or ;& outside a case, an operator
# with nothing after it, a redirection with no target).
#
# The judge: each output redirection target and each file a tee names (its words after the command
# word, but those starting with - before a --) is worked out from its words: quoted and unquoted
# text, ~ or ~/ at its start, $HOME, $TMPDIR (or the machine's /tmp) and $CLAUDE_JOB_DIR as the
# hook's own environment holds them, and $PWD (below). Those four are unknown in a command that
# holds an assignment to one of them (by a for loop too) or to an array element, an array
# assignment with a [subscript]= in it, an assigning builtin (declare, typeset, local, readonly,
# read, mapfile, readarray, getopts, unset, wait, export, printf -v) naming one or given an
# expansion, eval, source, ., trap, let, declare, typeset or local with an option holding i or n,
# mapfile or readarray with one holding C, a command word the hook cannot name, arithmetic or a
# ${ } offset or subscript that names a variable (a letter or a $ in it), a [[ ]] arithmetic
# comparison (-eq, -ne, -lt, -le, -gt, -ge), or a ${ } with = or :=.
#
# Following cd: the walk goes through the command in the order bash runs it, keeping the set of
# directories the shell may be in, which starts as the session's and may become unknown. Each
# command leaves one set for when it succeeds and one for when it fails: in a && b, b starts from
# a's success, in a || b from its failure, a ! swaps the two, and after a list the shell may be in
# any directory either leaves. A pipeline of more than one command, a ( ), a substitution and a
# list run with & each run in a copy, so nothing they do reaches the commands after them; after a
# { }, an if, a case or a loop, the shell may be in any directory a path through it leaves, the
# path that runs no branch included, and a case arm after ;& or ;;& may also start where the one
# before it ends. A command's redirections are made in the directory it starts in, before what it
# does, a compound command's before its body. A cd, the command word with no wrapper, with -L or
# -P (the last one counts), -- and at most one word whose values are all known, moves the shell on
# success to that word's directories, each relative one taken from every directory the shell may
# be in: -L and the default resolve .. by text, as bash's logical cd does, and also by the
# symlinks when the directory by text does not exist, as bash then does; -P resolves symlinks; cd
# alone goes to $HOME, and an empty word stays put. On failure it stays put. A cd -, a cd with an
# unknown word, more than one or another option, a cd behind a wrapper or by a path, pushd and
# popd make the directory unknown on success, and so does a relative cd whose word is neither . nor
# .. and starts with neither ./ nor ../ when the hook's environment sets CDPATH. eval, source, .,
# trap and a command word the hook cannot name make it unknown from there to the command's end,
# outside a ( ) or a substitution they are in, since a trap they set or a function they define may
# move it at any later point. A loop that holds a command that may move the shell, outside a ( )
# or a substitution in it, makes the directory unknown from its start, as its body may run again. A function's body is judged where
# it is defined, with the directory unknown when the command holds a command that may move the
# shell anywhere; one whose body holds such a command, outside a ( ) or a substitution, makes the
# directory unknown from the definition on, since a call may come anywhere after it. $PWD stands
# for each directory the shell may be in, and $OLDPWD is unknown. When the shell may be in more
# than 16 directories, the directory is unknown. A relative target is unknown
# when the directory is, and behind a wrapper option that holds a C or a D (env's -C, sudo's -D)
# or is --chdir, for a tee file; otherwise it is taken from each directory the shell may be in.
# The target, its symlinks resolved, must then lie under .scratch/ or under /tmp, $TMPDIR or
# $CLAUDE_JOB_DIR, or be, as written, /dev/null, /dev/stdout, /dev/stderr or /dev/fd/*; an empty
# one writes nothing. A target holding any other expansion (a $( ) among them), an unquoted brace,
# *, ?, [, a ~ after = or :, a ~user, an ANSI-C escape, or an unquoted variable whose value holds a
# blank or a glob character, is one the hook cannot work out, and is refused, never allowed.
# A refusal names each target outside as written, its . and .. resolved by text and its symlinks
# kept, and each target it cannot work out as the command spells it, with why; that one comes first.
# A relative target outside only from the directory a failed cd leaves, and inside from another,
# is one a cd before it may have failed.
#
# The hook never claims: a program that writes files itself (cp, mv, sed -i, git, an interpreter,
# sh -c, bash -c, ssh, xargs, find -exec, a tee named through an expansion, a glob or an escape);
# text run as shell code (eval, source, ., trap actions, and arithmetic over a variable whose value
# holds an array subscript with a substitution in it); or the session shell's own configuration
# (the functions, aliases and options its snapshot sets, which the hook takes to leave cd, tee and
# the wrappers as the commands they name, CDPATH as the hook's own environment holds it, and IFS
# at its default). It is a speed bump for the plain shell write, never a guarantee.
# Test seams: TEAM_SYSTEM_ROOT stands for / in /tmp, as in the library's tool_dirs, and
# TEAM_BASH_VERSION (major.minor) for the running bash's version.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/team.sh" "$@"
input=$(cat)
cwd=$(jq -r '.cwd // empty' <<<"$input")
cwd=${cwd:-$PWD}
root=${CLAUDE_PROJECT_DIR:-$cwd}
scratch=$(realpath -m -- "$root/.scratch")

# under <path> <dir>: whether the resolved path is the directory or inside it. By text, not by
# identity (same_path): the file may not exist yet, and a path that names the directory in another
# case is refused, the safe side for a guard.
under() {
  [[ $1 == "$2" || $1 == "$2"/* ]]
}

if [[ $(jq -r '.tool_name // empty' <<<"$input") != Bash ]]; then
  path=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' <<<"$input")
  [[ -n $path ]] || exit 0
  [[ $path == /* ]] || path="$cwd/$path"
  target=$(realpath -m -- "$path")
  under "$target" "$scratch" && exit 0
  echo "Blocked: this role may edit files only under $scratch (tried $target)." >&2
  exit 2
fi

command=$(jq -r '.tool_input.command // empty' <<<"$input")
# The fast path: every output redirection holds a >, and a tee command word is the letters tee
# once its quotes, backslashes and line continuations are taken out.
plain=${command//\\$'\n'/}
plain=${plain//[\'\"\\]/}
[[ $plain == *'>'* || $plain == *tee* ]] || exit 0

# unread <form>: refuse the command unread, naming the form the hook does not read.
unread() {
  echo "Blocked: this command holds $1, which this hook does not read, so it cannot tell where the command writes; rewrite it without that, or write files under $scratch with the Write tool." >&2
  exit 2
}

# Byte by byte: faster than by character, and a multibyte character is copied whole either way.
LC_ALL=C

# ---- The reader ----------------------------------------------------------------------------------
# It reads the command as an array of lines, with a cursor (L, C) in the current line ln of length
# ll, so its cost grows with the command's length. It turns the command into a flat list of events,
# EK[k] its kind:
#   P, p    a pipeline's start and end;  !  and T  a ! or a time before it;  |  a pipe
#   S, E    a simple command's start and end
#   A, W    an assignment before the command word, and any other word
#   R, I    an output redirection (EX[k] its operator) and an input one (EX[k] <, <&, <<, <<- or
#           <<<), with their target word (a here-document's delimiter, as written)
#   D, d    a substitution's start and end, EX[k] its kind: $( and <( or >( hold the events of the
#           command list in its body; << holds those of the $( )s in a here-document's body, read
#           where the body is, EA[k] the I event of its here-document
#   &&, ||  an and-or operator;  ;  and  &  a list separator (a newline is a ;)
#   C, c, Z a compound command's start, its body's end and its end past its redirections; EX[k]
#           its kind: (, {, if, while, until, for, for((, case, [[, (( or () for a function
#           definition, ER[k] its name, whose body is the compound command between its C and c
#   K       a reserved word or a case separator inside a compound command, EX[k] the word: then,
#           elif, else, fi, do, done, in, esac, }, ) after a case's patterns, ;;, ;& or ;;&
# A word event's parts are pk[EA[k]] to pk[EA[k]+EB[k]-1], with their texts in pt; ER[k] is the
# word as written. A part's kind is l (unquoted text), q (quoted text), a (an ANSI-C string's text
# as written), v or V (a variable, unquoted or in double quotes, pt its name), p (a process
# substitution, the whole word, pt as written) or x (any other expansion, pt as written).
# A substitution's events come before the word event that holds it, and its parts before that
# word's. A compound command's own words (for's name and words, case's word and patterns, [[ ]]'s
# words, an arithmetic command's text) are W events between its C and c, outside any S; its
# redirections are between its c and Z.
mapfile -t lines <<<"$command"
nl=${#lines[@]} L=0 C=0 ln=${lines[0]} ll=${#lines[0]}
pk=() pt=() EK=() EA=() EB=() ER=() EX=()
c='' c2='' wfirst=0 wcount=0 wraw='' raw='' pw='' listed=0
# assign_pos: 1 while the word read is in a simple command's assignment position, where name=( )
# is an array; rx: 1 while the word read is a [[ ]]'s regular expression, rxd its ( ) depth;
# vstop: 1 once the reader has read arithmetic that names a variable, an array's [subscript]=,
# a ${ } that may assign, or a [[ ]] arithmetic comparison, any of which may assign a variable.
assign_pos=0 rx=0 rxd=0 vstop=0
# The reserved words that end a compound command's list.
stop_words=' then elif else fi do done esac } '
meta=$' \t;&|()<>\\\'"`$'
dq_stop='\"$`'
# depth: how many substitutions the cursor is in. The here-documents read and not yet gathered:
# hq_d their delimiters, hq_q 1 when quoted, hq_s 1 for <<-, hq_e their I events, hq_l the depth
# they were read at, whose next newline gathers their bodies.
depth=0 hq_d=() hq_q=() hq_s=() hq_e=() hq_l=()
# Bash before 5.2 finds a $( )'s close by scanning its text, not by reading it as a command list,
# so a comment or a here-document in one may end it elsewhere. TEAM_BASH_VERSION (major.minor)
# stands for the running bash's version, as a test seam.
old_bash=1
if [[ ${TEAM_BASH_VERSION:-${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}} =~ ^([0-9]+)\.([0-9]+) ]]; then
  if ((BASH_REMATCH[1] > 5 || (BASH_REMATCH[1] == 5 && BASH_REMATCH[2] >= 2))); then old_bash=0; fi
fi

next_line() {
  L=$((L + 1)) C=0
  ln=${lines[L]}
  ll=${#ln}
}

# peek: set c to the character at the cursor, past line continuations: a newline at a line's end,
# '' at the command's end.
peek() {
  while ((C == ll - 1 && L < nl - 1)) && [[ ${ln:C:1} == \\ ]]; do next_line; done
  if ((C < ll)); then
    c=${ln:C:1}
  elif ((L < nl - 1)); then
    c=$'\n'
  else
    c=''
  fi
}

# adv: move past the character at the cursor, past the line continuations before it.
adv() {
  peek
  if ((C < ll)); then
    C=$((C + 1))
  elif ((L < nl - 1)); then
    next_line
  fi
}

# peek2: set c to the character at the cursor and c2 to the one after it, leaving the cursor on c.
peek2() {
  local first sL sC
  peek
  first=$c sL=$L sC=$C
  c2=''
  if [[ -n $c ]]; then
    adv
    peek
    c2=$c
  fi
  L=$sL C=$sC ln=${lines[sL]} ll=${#lines[sL]}
  c=$first
}

# skip_blanks: move past blanks and a comment.
skip_blanks() {
  while :; do
    peek
    case $c in
      ' ' | $'\t') C=$((C + 1)) ;;
      '#')
        ((depth && old_bash)) && unread 'a comment inside a substitution, on a bash older than 5.2'
        C=$ll
        ;;
      *) return 0 ;;
    esac
  done
}

# skip_newlines: move past blanks, comments and newlines.
skip_newlines() {
  while :; do
    skip_blanks
    [[ $c == $'\n' ]] || return 0
    newline
  done
}

# newline: move past the newline at the cursor, a token of the list, and gather the bodies of the
# here-documents read at this depth, in the order they were read. One read inside a substitution
# waits for a newline inside it, and one read outside it for a newline after it, as bash 5.2 reads
# them.
newline() {
  local i todo=()
  adv
  for i in "${!hq_d[@]}"; do
    if ((hq_l[i] == depth)); then todo+=("$i"); fi
  done
  for i in "${todo[@]}"; do
    gather "${hq_d[i]}" "${hq_q[i]}" "${hq_s[i]}" "${hq_e[i]}"
    unset 'hq_d[i]' 'hq_q[i]' 'hq_s[i]' 'hq_e[i]' 'hq_l[i]'
  done
}

# gather <delimiter> <quoted> <strip> <event>: read the here-document body at the cursor, a line's
# start, to the line equal to its delimiter, and move past that line. An unquoted delimiter's body
# is scanned for its expansions, as the shell expands them, and each $( ) in it read as a command
# list.
gather() {
  local start=$L k line cmp rest end=-1 keep=$nl run
  for ((k = L; k < nl; k++)); do
    line=${lines[k]}
    cmp=$line
    if (($3)); then
      while [[ $cmp == $'\t'* ]]; do cmp=${cmp:1}; done
    fi
    if [[ $cmp == "$1" ]]; then
      end=$k
      break
    fi
    if ((depth)) && [[ $cmp == "$1"* ]]; then
      rest=${cmp#"$1"}
      rest=${rest#"${rest%%[! $'\t']*}"}
      [[ $rest == ')'* ]] && unread 'a here-document line inside $( ) that starts with its delimiter and a )'
    fi
    if ((!$2)) && [[ $line == *\\ ]]; then
      rest=${line%"${line##*[!\\]}"}
      (((${#line} - ${#rest}) % 2)) && unread 'a line ending in a backslash in a here-document whose delimiter is not quoted'
    fi
  done
  ((end >= 0)) || unread 'a here-document whose delimiter line is not found'
  emit D "$4" 0 '' '<<'
  if ((!$2 && end > start)); then
    # The body alone is the text a $( ) in it may read.
    nl=$end
    depth=$((depth + 1))
    C=0
    while :; do
      rest=${ln:C}
      run=${rest%%[\$\`\\]*}
      if [[ $run == "$rest" ]]; then
        ((L < nl - 1)) || break
        next_line
        continue
      fi
      C=$((C + ${#run}))
      case ${ln:C:1} in
        \\) C=$((C + 2)) ;;
        \`) unread 'a backtick substitution' ;;
        *)
          case ${ln:C+1:1} in
            '(' | '{' | '[')
              wfirst=${#pk[@]}
              dollar d
              ;;
            *) C=$((C + 1)) ;;
          esac
          ;;
      esac
    done
    depth=$((depth - 1))
    nl=$keep
  fi
  emit d
  # Past the delimiter line: to the next line's start, or the command's end.
  if ((end < nl - 1)); then
    L=$((end + 1)) C=0
  else
    L=$end C=${#lines[end]}
  fi
  ln=${lines[L]} ll=${#ln}
}

emit() {
  EK+=("$1") EA+=("${2:-0}") EB+=("${3:-0}") ER+=("${4:-}") EX+=("${5:-}")
}

# add <kind> <text>: add a part to the word being read, merging text into a part of its kind.
add() {
  local last=$((${#pk[@]} - 1))
  if ((last >= wfirst)) && [[ ${pk[last]} == "$1" && $1 == [lq] ]]; then
    pt[last]+=$2
  else
    pk+=("$1") pt+=("$2")
  fi
}

# raw_text <L0> <C0> <L1> <C1>: set raw to the command's text between the two cursors.
raw_text() {
  local l=$1
  if (($1 == $3)); then
    raw=${lines[l]:$2:$4-$2}
    return 0
  fi
  raw=${lines[l]:$2}
  for ((l = $1 + 1; l < $3; l++)); do raw+=$'\n'${lines[l]}; done
  raw+=$'\n'${lines[$3]:0:$4}
}

single_quote() {
  local rest
  C=$((C + 1))
  add q ''
  while :; do
    rest=${ln:C}
    if [[ $rest == *\'* ]]; then
      rest=${rest%%\'*}
      add q "$rest"
      C=$((C + ${#rest} + 1))
      return 0
    fi
    ((L < nl - 1)) || unread 'an unclosed quote'
    add q "$rest"$'\n'
    next_line
  done
}

double_quote() {
  local rest run next
  C=$((C + 1))
  add q ''
  while :; do
    peek
    case $c in
      '') unread 'an unclosed quote' ;;
      \")
        C=$((C + 1))
        return 0
        ;;
      $'\n')
        add q $'\n'
        next_line
        ;;
      \\)
        ((C + 1 < ll)) || unread 'an unclosed quote'
        next=${ln:C+1:1}
        case $next in
          '$' | '`' | '"' | \\) add q "$next" ;;
          *) add q "\\$next" ;;
        esac
        C=$((C + 2))
        ;;
      \`) unread 'a backtick substitution' ;;
      '$') dollar d ;;
      *)
        rest=${ln:C}
        run=${rest%%["$dq_stop"]*}
        add q "$run"
        C=$((C + ${#run}))
        ;;
    esac
  done
}

# ansi_c: read an ANSI-C string, the cursor on its opening ', to its unescaped '.
ansi_c() {
  local text='' ch
  C=$((C + 1))
  while :; do
    if ((C >= ll)); then
      ((L < nl - 1)) || unread 'an unclosed quote'
      text+=$'\n'
      next_line
      continue
    fi
    ch=${ln:C:1}
    if [[ $ch == \' ]]; then
      C=$((C + 1))
      add a "$text"
      return 0
    elif [[ $ch == \\ ]]; then
      if ((C + 1 < ll)); then
        text+=${ln:C:2}
        C=$((C + 2))
      else
        ((L < nl - 1)) || unread 'an unclosed quote'
        text+=$'\\\n'
        next_line
      fi
      continue
    fi
    text+=$ch
    C=$((C + 1))
  done
}

# name_chars: set name to the name characters at the cursor, moving past them.
name_chars() {
  name=''
  while :; do
    peek
    [[ $c == [A-Za-z0-9_] ]] || return 0
    name+=$c
    C=$((C + 1))
  done
}

# dollar <n|d>: read what a $ at the cursor starts, unquoted (n) or in double quotes (d).
dollar() {
  local name quoted=v literal=l L0=$L C0=$C
  [[ $1 == d ]] && quoted=V literal=q
  adv
  peek
  case $c in
    '(')
      peek2
      if [[ $c2 == '(' ]]; then
        adv
        adv
        arith '' 'an arithmetic expansion that does not close with ))'
      else
        substitution '$(' "$L0" "$C0"
      fi
      raw_text "$L0" "$C0" "$L" "$C"
      add x "$raw"
      ;;
    '{')
      adv
      parameter "$quoted"
      ;;
    '[') unread 'a $[ ] arithmetic expansion' ;;
    \')
      if [[ $1 == n ]]; then
        ansi_c
      else
        add q '$'
      fi
      ;;
    \")
      [[ $1 == n ]] && unread 'a $" " string'
      add q '$'
      ;;
    [A-Za-z_])
      name_chars
      add "$quoted" "$name"
      ;;
    [0-9?#@*\$\!-])
      add x "\$$c"
      C=$((C + 1))
      ;;
    *) add "$literal" '$' ;;
  esac
}

# substitution <kind> <L0> <C0>: read a $( ), <( ) or >( ) whose text starts at L0, C0, the cursor
# on its (, as a command list to the ) that closes it at its own level, and set raw to its text.
# The parts of the word being read move past the body's, so they stay together.
substitution() {
  local held_k=("${pk[@]:wfirst}") held_t=("${pt[@]:wfirst}") k i held_rx=$rx held_rxd=$rxd
  # Its body is a command list, whatever word holds it.
  rx=0 rxd=0 assign_pos=0
  for ((k = ${#pk[@]} - 1; k >= wfirst; k--)); do unset 'pk[k]' 'pt[k]'; done
  adv
  emit D 0 0 '' "$1"
  depth=$((depth + 1))
  parse_list ')'
  if [[ $c != ')' ]]; then
    [[ $1 == '$(' ]] && unread 'a $( ) that does not close'
    unread 'a process substitution that does not close'
  fi
  for i in "${!hq_d[@]}"; do
    ((hq_l[i] == depth)) && unread "a here-document inside $1 ) that closes before its body is read"
  done
  depth=$((depth - 1))
  C=$((C + 1))
  rx=$held_rx rxd=$held_rxd
  emit d
  wfirst=${#pk[@]}
  pk+=("${held_k[@]}") pt+=("${held_t[@]}")
  raw_text "$2" "$3" "$L" "$C"
}

# parameter <v|V>: read a ${ }, the cursor past its {, to the first unescaped }: ${name}, unquoted
# (v) or in double quotes (V), or any other one as an x part. Its head is an optional # or !, a
# name, digits or a special parameter, and an optional subscript; then } or an operator and an
# operand of literal text, backslash escapes and $name, ${name} or a special parameter, all on one
# line.
re_head='^([#!]?)([A-Za-z_][A-Za-z0-9_]*|[0-9]+|[?#@*$!-])(\[[A-Za-z0-9_@*$#+-]*\])?'
re_op='^(:[-=+?]|[-=+?]|##|#|%%|%|//|/#|/%|/|\^\^|\^|,,|,|:|@[A-Za-z])'
re_operand_var='^\$\{([A-Za-z_][A-Za-z0-9_]*|[0-9]+|[?#@*$!-])\}'
parameter() {
  local rest head prefix pname sub op k ch next
  rest=${ln:C}
  [[ $rest =~ $re_head ]] || unread 'a ${ } this hook does not read'
  head=${BASH_REMATCH[0]} prefix=${BASH_REMATCH[1]} pname=${BASH_REMATCH[2]} sub=${BASH_REMATCH[3]}
  # An indexed array's subscript is arithmetic.
  [[ $sub == *[A-Za-z_\$]* ]] && vstop=1
  rest=${rest:${#head}}
  if [[ $rest == '}'* ]]; then
    C=$((C + ${#head} + 1))
    if [[ -z $prefix$sub && $pname == [A-Za-z_]* ]]; then
      add "$1" "$pname"
    else
      add x "\${$head}"
    fi
    return 0
  fi
  [[ $rest =~ $re_op ]] || unread 'a ${ } this hook does not read'
  op=${BASH_REMATCH[0]}
  case $op in
    # A prompt expansion runs the substitutions in the value.
    @P) unread 'the ${ } operator @P' ;;
    @?) [[ ${rest:2:1} == '}' ]] || unread 'a ${ } this hook does not read' ;;
    = | :=) vstop=1 ;;
  esac
  k=$((C + ${#head} + ${#op}))
  while :; do
    ch=${ln:k:1}
    case $ch in
      '')
        ((L < nl - 1)) && unread 'a newline inside a ${ } operand'
        unread 'a ${ } that does not close'
        ;;
      '}') break ;;
      \\)
        ((k + 1 < ll)) || unread 'a newline inside a ${ } operand'
        k=$((k + 2))
        ;;
      \' | \") unread 'a quote inside a ${ } operand' ;;
      \`) unread 'a backtick substitution' ;;
      '$')
        next=${ln:k+1:1}
        if [[ $next == [A-Za-z_] ]]; then
          rest=${ln:k+1}
          rest=${rest%%[!A-Za-z0-9_]*}
          k=$((k + 1 + ${#rest}))
        elif [[ $next == [0-9?#@*\$\!-] ]]; then
          k=$((k + 2))
        elif [[ ${ln:k} =~ $re_operand_var ]]; then
          k=$((k + ${#BASH_REMATCH[0]}))
        elif [[ $next == [\'\"] ]]; then
          unread 'a quote inside a ${ } operand'
        elif [[ $next == [\(\{\[] ]]; then
          unread 'an expansion inside a ${ } operand other than a variable'
        else
          k=$((k + 1))
        fi
        ;;
      *)
        rest=${ln:k}
        rest=${rest%%[\}\\\'\"\`\$]*}
        k=$((k + ${#rest}))
        ;;
    esac
  done
  # An offset is arithmetic.
  if [[ $op == : ]] && [[ ${ln:C+${#head}+1:k-C-${#head}-1} == *[A-Za-z_\$]* ]]; then vstop=1; fi
  add x "\${${ln:C:k-C+1}"
  C=$((k + 1))
}

# arith <for> <form>: read arithmetic to the )) that closes it at its own level, the cursor past its
# ((, refusing the form when it ends another way: names, digits, blanks, newlines, the operator
# characters, balanced ( ), $name, a special parameter, a ${ } and a $( ), read as a command list;
# with for, a ; at its own level separates its expressions. Sets raw to its text past the ((.
ar_ok="[!]A-Za-z0-9_ "$'\t'"+*/%<>=!&|^~?:,.#[-]"
arith() {
  local d=0 L0=$L C0=$C rest run
  while :; do
    peek
    case $c in
      '') unread "$2" ;;
      '(')
        d=$((d + 1))
        adv
        ;;
      ')')
        adv
        if ((d)); then
          d=$((d - 1))
          continue
        fi
        peek
        [[ $c == ')' ]] || unread "$2"
        adv
        break
        ;;
      '$') arith_dollar ;;
      \' | \") unread 'a quote inside arithmetic' ;;
      \`) unread 'a backtick substitution' ;;
      ';')
        if [[ -z $1 ]] || ((d)); then unread 'a ; inside arithmetic'; fi
        adv
        ;;
      $'\n') adv ;;
      *)
        rest=${ln:C}
        # shellcheck disable=SC2295 # ar_ok is a pattern
        run=${rest%%$ar_ok*}
        [[ -n $run ]] || unread "a $c inside arithmetic"
        C=$((C + ${#run}))
        ;;
    esac
  done
  raw_text "$L0" "$C0" "$L" "$C"
  [[ ${raw%))} == *[A-Za-z_\$]* ]] && vstop=1
  return 0
}

# arith_dollar: read the expansion a $ in arithmetic starts. A ${ } adds no part: the arithmetic is
# one x part.
arith_dollar() {
  local L0=$L C0=$C name
  adv
  peek2
  case $c in
    '(')
      [[ $c2 == '(' ]] && unread 'an arithmetic expansion inside arithmetic'
      substitution '$(' "$L0" "$C0"
      ;;
    '{')
      adv
      parameter v
      unset 'pk[-1]' 'pt[-1]'
      ;;
    [A-Za-z_]) name_chars ;;
    [0-9?#@*\$\!-]) C=$((C + 1)) ;;
    \' | \") unread 'a quote inside arithmetic' ;;
    '[') unread 'a $[ ] arithmetic expansion' ;;
    *) unread 'a $ inside arithmetic' ;;
  esac
}

# read_word: read the word at the cursor, setting wfirst and wcount to its parts and wraw to its
# text as written; wcount is 0 when no word starts there.
read_word() {
  local L0=$L C0=$C rest run prev=''
  wfirst=${#pk[@]}
  while :; do
    peek
    if ((rx)); then
      # A [[ ]]'s regular expression: ( ) and | are part of it, and inside its ( ) so are blanks
      # and ; & < >.
      case $c in
        '(')
          rxd=$((rxd + 1))
          add l '('
          C=$((C + 1))
          continue
          ;;
        ')')
          if ((rxd)); then
            rxd=$((rxd - 1))
            add l ')'
            C=$((C + 1))
            continue
          fi
          ;;
        '|' | ' ' | $'\t' | ';' | '&' | '<' | '>')
          if [[ $c == [\<\>] ]] && ((rxd)); then
            peek2
            [[ $c2 == '(' ]] && unread 'a process substitution inside a [[ ]] regular expression'
          fi
          if [[ $c == '|' ]] || ((rxd)); then
            add l "$c"
            C=$((C + 1))
            continue
          fi
          ;;
        $'\n') ((rxd)) && unread 'a newline inside [[ ]]' ;;
      esac
    fi
    case $c in
      '' | ' ' | $'\t' | $'\n' | ';' | '&' | '|' | '<' | '>' | ')') break ;;
      '(')
        [[ $prev == [@\!+*?] ]] && unread 'an extended glob'
        if ((assign_pos && ${#pk[@]} - wfirst == 1)) && [[ ${pk[wfirst]} == l && ${pt[wfirst]} =~ ^[A-Za-z_][A-Za-z0-9_]*\+?=$ ]]; then
          array
          peek
          case $c in
            '' | ' ' | $'\t' | $'\n' | ';' | '&' | '|' | '<' | '>' | ')') ;;
            *) unread 'an array assignment with text after its )' ;;
          esac
        fi
        break
        ;;
      \\)
        if ((C + 1 < ll)); then
          add q "${ln:C+1:1}"
          C=$((C + 2))
        else
          add q "\\"
          C=$((C + 1))
        fi
        prev=''
        ;;
      \')
        single_quote
        prev=''
        ;;
      \")
        double_quote
        prev=''
        ;;
      \`) unread 'a backtick substitution' ;;
      '$')
        dollar n
        prev=''
        ;;
      *)
        rest=${ln:C}
        run=${rest%%["$meta"]*}
        add l "$run"
        prev=${run: -1}
        C=$((C + ${#run}))
        ;;
    esac
  done
  wcount=$((${#pk[@]} - wfirst))
  raw_text "$L0" "$C0" "$L" "$C"
  wraw=$raw
}

# array: read an array assignment's ( ), the cursor on its (, its words read as words; the parts
# of the word being read (its name=) move past theirs, with the ( ) as one x part.
array() {
  local held_k=("${pk[@]:wfirst}") held_t=("${pt[@]:wfirst}") L0=$L C0=$C
  assign_pos=0
  adv
  while :; do
    skip_newlines
    case $c in
      ')')
        adv
        break
        ;;
      '') unread 'an array assignment that does not close' ;;
    esac
    read_word
    ((wcount)) || unread "a $c out of place"
    # An element's [subscript]= is arithmetic.
    [[ ${pk[wfirst]} == l && ${pt[wfirst]} == '['* ]] && vstop=1
  done
  wfirst=${#pk[@]}
  pk+=("${held_k[@]}") pt+=("${held_t[@]}")
  raw_text "$L0" "$C0" "$L" "$C"
  add x "$raw"
}

# procsub_word: read the process substitution at the cursor as a whole word, setting wfirst, wcount
# and wraw as read_word does.
procsub_word() {
  local L0=$L C0=$C kind
  peek
  kind=$c'('
  adv
  wfirst=${#pk[@]}
  substitution "$kind" "$L0" "$C0"
  peek2
  case $c in
    '' | ' ' | $'\t' | $'\n' | ';' | '&' | '|' | ')') ;;
    '<' | '>') [[ $c2 == '(' ]] && unread 'a process substitution inside a word' ;;
    *) unread 'a process substitution inside a word' ;;
  esac
  add p "$raw"
  wcount=1 wraw=$raw
}

# heredoc: read a here-document's operator past its <<, and its delimiter, a plain word quoted whole
# or not; its body is gathered at the next newline read at this depth.
heredoc() {
  local op='<<' strip=0 quoted=1 delim
  peek
  if [[ $c == - ]]; then
    adv
    op='<<-' strip=1
  fi
  ((depth && old_bash)) && unread 'a here-document inside a substitution, on a bash older than 5.2'
  skip_blanks
  read_word
  if [[ $wraw =~ ^[A-Za-z0-9_.-]+$ ]]; then
    quoted=0 delim=$wraw
  elif [[ $wraw =~ ^\'([A-Za-z0-9_.-]+)\'$ || $wraw =~ ^\"([A-Za-z0-9_.-]+)\"$ || $wraw =~ ^\\([A-Za-z0-9_.-]+)$ ]]; then
    delim=${BASH_REMATCH[1]}
  else
    unread 'a here-document delimiter other than a plain word, quoted whole or not'
  fi
  emit I "$wfirst" "$wcount" "$wraw" "$op"
  hq_d+=("$delim") hq_q+=("$quoted") hq_s+=("$strip") hq_e+=("$((${#EK[@]} - 1))") hq_l+=("$depth")
}

# parse_redir: read the redirection at the cursor and its target.
parse_redir() {
  local op
  peek
  case $c in
    '<')
      adv
      peek
      case $c in
        '<')
          adv
          peek
          if [[ $c != '<' ]]; then
            heredoc
            return 0
          fi
          adv
          op='<<<'
          ;;
        '&') adv && op='<&' ;;
        '>') adv && op='<>' ;;
        *) op='<' ;;
      esac
      ;;
    '>')
      adv
      peek
      case $c in
        '>') adv && op='>>' ;;
        '|') adv && op='>|' ;;
        '&') adv && op='>&' ;;
        *) op='>' ;;
      esac
      ;;
    '&')
      adv
      adv
      peek
      op='&>'
      [[ $c == '>' ]] && adv && op='&>>'
      ;;
  esac
  skip_blanks
  peek2
  if [[ $c == [\<\>] && $c2 == '(' ]]; then
    procsub_word
  else
    read_word
  fi
  ((wcount)) || unread 'a redirection with no target'
  if [[ $op == '<' || $op == '<&' || $op == '<<<' ]]; then
    emit I "$wfirst" "$wcount" "$wraw" "$op"
  else
    emit R "$wfirst" "$wcount" "$wraw" "$op"
  fi
}

parse_simple() {
  local first=1 assigning=1 words=0 others=0
  emit S
  while :; do
    skip_blanks
    peek2
    case $c in
      '' | $'\n' | ';' | '|' | ')') break ;;
      '&')
        [[ $c2 == '>' ]] || break
        parse_redir
        others=$((others + 1)) first=0
        continue
        ;;
      '<' | '>')
        if [[ $c2 == '(' ]]; then
          procsub_word
          first=0 words=$((words + 1)) assigning=0
          emit W "$wfirst" "$wcount" "$wraw"
          continue
        fi
        parse_redir
        others=$((others + 1)) first=0
        continue
        ;;
      '(')
        if ((words == 1 && others == 0)) && [[ ${EK[-1]} == W ]]; then
          function_def "${ER[-1]}"
          return 0
        fi
        unread 'a ( inside a command'
        ;;
    esac
    assign_pos=$assigning
    read_word
    assign_pos=0
    peek2
    [[ $c == [\<\>] && $c2 == '(' ]] && unread 'a process substitution inside a word'
    if [[ $c == [\<\>] ]] && ((wcount == 1)) && [[ ${pk[wfirst]} == l ]]; then
      if [[ ${pt[wfirst]} =~ ^[0-9]+$ ]]; then
        # A file descriptor number, right before its redirection.
        parse_redir
        others=$((others + 1)) first=0
        continue
      fi
      [[ ${pt[wfirst]} =~ ^\{[A-Za-z_][A-Za-z0-9_]*\}$ ]] && unread 'a {name} file descriptor'
    fi
    first=0 words=$((words + 1))
    if ((assigning)) && [[ ${pk[wfirst]} == l && ${pt[wfirst]} =~ ^[A-Za-z_][A-Za-z0-9_]*(\[|\+?=) ]]; then
      emit A "$wfirst" "$wcount" "$wraw"
    else
      assigning=0
      emit W "$wfirst" "$wcount" "$wraw"
    fi
  done
  emit E
}

# function_def <name>: read a function definition, the cursor on the ( after its name as written,
# whose S and W events give way to its C: a name() and a compound command, its body.
function_def() {
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_.:-]*$ ]] || unread 'a function name other than a plain name'
  case $1 in
    cd | pushd | popd | tee | mktemp | basename | env | sudo | nohup | timeout | nice | stdbuf | command | exec | time | builtin)
      unread "a function named $1"
      ;;
  esac
  unset 'EK[-1]' 'EA[-1]' 'EB[-1]' 'ER[-1]' 'EX[-1]'
  unset 'EK[-1]' 'EA[-1]' 'EB[-1]' 'ER[-1]' 'EX[-1]'
  adv
  skip_blanks
  peek
  [[ $c == ')' ]] || unread 'a ( inside a command'
  adv
  emit C 0 0 "$1" '()'
  skip_newlines
  compound_command || unread 'a function body that is not a compound command'
  emit c
  emit Z
}

# word_at: set pw to the unquoted word of at most 8 characters at the cursor when it ends where a
# word ends, or to '', and pe to the character after it; a lookahead that moves nothing.
word_at() {
  local sL=$L sC=$C rest
  # Most often the word and what ends it are on the cursor's line, with no line continuation.
  rest=${ln:C:10}
  pw=${rest%%[$' \t;&|()<>\\\'"`$']*}
  pe=${rest:${#pw}:1}
  case $pe in
    ' ' | $'\t' | ';' | '&' | '|' | ')' | '(' | '<' | '>') return 0 ;;
    '')
      if ((${#pw} < 10)); then
        pe=$'\n'
        ((L < nl - 1)) || pe=''
        return 0
      fi
      ;;
  esac
  pw=''
  while peek && [[ -n $c && $c != $'\n' && $meta != *"$c"* ]] && ((${#pw} <= 8)); do
    pw+=$c
    C=$((C + 1))
  done
  pe=$c
  case $c in
    '' | ' ' | $'\t' | $'\n' | ';' | '&' | '|' | ')' | '(' | '<' | '>') ((${#pw} <= 8)) || pw='' ;;
    *) pw='' ;;
  esac
  L=$sL C=$sC ln=${lines[sL]} ll=${#lines[sL]}
}

# keyword <word>: move past the reserved word at the cursor, emitting it.
keyword() {
  plain "$1"
  emit K 0 0 '' "$1"
}

# expect <word> <form>: move past the reserved word at the cursor, refusing the form when the
# command ends first and naming what is there instead otherwise.
expect() {
  word_at
  if [[ $pw != "$1" ]]; then
    [[ -n $c ]] || unread "$2"
    unread "a ${pw:-$c} out of place"
  fi
  keyword "$1"
}

# body <stops> <form> [empty]: read a compound command's list up to one of the reserved words in
# stops, refusing the form when the command ends first, and a list with nothing in it unless empty
# is given; pw is the word it stops at.
body() {
  parse_list '' " $1 "
  peek
  [[ -n $c ]] || unread "$2"
  word_at
  if ((listed == 0)) && [[ -z ${3:-} ]]; then unread "a ${pw:-$c} out of place"; fi
  return 0
}

# compound_redirs: read the redirections after a compound command, to what ends it: an operator, a
# ), the command's end, or a reserved word that ends the list around it.
compound_redirs() {
  while :; do
    skip_blanks
    peek2
    case $c in
      '' | $'\n' | ';' | '|' | ')') return 0 ;;
      '&') [[ $c2 == '>' ]] || return 0 ;;
      '<' | '>') [[ $c2 == '(' ]] && unread 'a word after a compound command' ;;
      *)
        word_at
        [[ -n $pw && $stop_words == *" $pw "* ]] && return 0
        read_word
        peek
        if ! [[ $c == [\<\>] ]] || ((wcount != 1)) || [[ ${pk[wfirst]} != l || ! ${pt[wfirst]} =~ ^[0-9]+$ ]]; then
          ((wcount == 1)) && [[ ${pk[wfirst]} == l && ${pt[wfirst]} =~ ^\{[A-Za-z_][A-Za-z0-9_]*\}$ && $c == [\<\>] ]] && unread 'a {name} file descriptor'
          unread 'a word after a compound command'
        fi
        ;;
    esac
    parse_redir
  done
}

# compound_end: close the compound command whose body has been read, with its redirections.
compound_end() {
  emit c
  compound_redirs
  emit Z
}

subshell() {
  adv
  emit C 0 0 '' '('
  parse_list ')'
  [[ $c == ')' ]] || unread 'a ( ) subshell that does not close'
  ((listed)) || unread 'a ) out of place'
  adv
  compound_end
}

arith_command() {
  local L0=$L C0=$C
  adv
  adv
  emit C 0 0 '' '(('
  wfirst=${#pk[@]}
  arith '' 'an arithmetic command that does not close with ))'
  raw_text "$L0" "$C0" "$L" "$C"
  add x "$raw"
  emit W "$wfirst" "$((${#pk[@]} - wfirst))" "$raw"
  compound_end
}

# for_loop: read a for loop past its for: for name [in words], or for (( )), then do, its list
# and done.
for_loop() {
  local f='a for loop that does not close' L0 C0
  skip_blanks
  peek2
  if [[ $c == '(' && $c2 == '(' ]]; then
    L0=$L C0=$C
    adv
    adv
    emit C 0 0 '' 'for(('
    wfirst=${#pk[@]}
    arith for 'a for (( )) loop that does not close with ))'
    raw_text "$L0" "$C0" "$L" "$C"
    add x "$raw"
    emit W "$wfirst" "$((${#pk[@]} - wfirst))" "$raw"
  else
    emit C 0 0 '' for
    word_at
    [[ $pw =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || unread 'a for loop whose variable is not a name'
    read_word
    emit W "$wfirst" "$wcount" "$wraw"
    skip_blanks
    word_at
    if [[ $pw == in ]]; then
      keyword in
      while :; do
        skip_blanks
        peek
        case $c in
          '' | ';' | $'\n') break ;;
          '&' | '|' | '<' | '>' | '(' | ')') unread "a $c out of place" ;;
        esac
        read_word
        emit W "$wfirst" "$wcount" "$wraw"
      done
    fi
  fi
  skip_blanks
  peek
  [[ $c == ';' ]] && adv
  skip_newlines
  expect 'do' "$f"
  body 'done' "$f"
  keyword 'done'
}

# case_command: read a case command past its case: its word, in, each arm's ( and patterns
# joined by |, its ), its list and its ;;, ;& or ;;&, then esac.
case_command() {
  local f='a case command that does not close' op
  ((depth && old_bash)) && unread 'a case command inside a substitution, on a bash older than 5.2'
  emit C 0 0 '' case
  skip_blanks
  read_word
  if ((wcount == 0)); then
    [[ -n $c ]] || unread "$f"
    unread "a $c out of place"
  fi
  emit W "$wfirst" "$wcount" "$wraw"
  skip_newlines
  expect in "$f"
  while :; do
    skip_newlines
    word_at
    if [[ $pw == 'esac' ]]; then
      keyword 'esac'
      return 0
    fi
    [[ -n $c ]] || unread "$f"
    [[ $c == '(' ]] && adv
    while :; do
      skip_blanks
      read_word
      if ((wcount == 0)); then
        [[ -n $c ]] || unread "$f"
        unread "a $c out of place"
      fi
      emit W "$wfirst" "$wcount" "$wraw"
      skip_blanks
      peek
      case $c in
        '|') adv ;;
        ')')
          adv
          break
          ;;
        '') unread "$f" ;;
        *) unread "a $c out of place" ;;
      esac
    done
    emit K 0 0 '' ')'
    parse_list '' ' esac ;; '
    peek2
    case $c in
      '') unread "$f" ;;
      ';')
        op=";$c2"
        adv
        adv
        if [[ $op == ';;' ]]; then
          peek
          if [[ $c == '&' ]]; then
            adv
            op=';;&'
          fi
        fi
        emit K 0 0 '' "$op"
        ;;
    esac
  done
}

# test_command: read a [[ ]] past its [[: words, && and ||, and < and > as comparisons, with the
# word after =~ read as a regular expression, to its ]].
test_command() {
  emit C 0 0 '' '[['
  while :; do
    skip_blanks
    peek2
    case $c in
      '') unread 'a [[ ]] test that does not close' ;;
      $'\n') unread 'a newline inside [[ ]]' ;;
      '(' | ')' | ';') unread "a $c inside [[ ]]" ;;
      '&' | '|')
        [[ $c2 == "$c" ]] || unread "a $c inside [[ ]]"
        adv
        adv
        continue
        ;;
      '<' | '>')
        wfirst=${#pk[@]}
        add l "$c"
        adv
        emit W "$wfirst" 1 "$c"
        continue
        ;;
    esac
    word_at
    if [[ $pw == ']]' ]]; then
      plain ']]'
      return 0
    fi
    read_word
    emit W "$wfirst" "$wcount" "$wraw"
    # An arithmetic comparison evaluates its words as arithmetic.
    [[ $wraw =~ ^-(eq|ne|lt|le|gt|ge)$ ]] && vstop=1
    if [[ $wraw == '=~' ]]; then
      skip_blanks
      rx=1 rxd=0
      read_word
      rx=0
      emit W "$wfirst" "$wcount" "$wraw"
    fi
  done
}

# compound <word>: read the compound command its reserved word starts.
compound() {
  local f
  plain "$1"
  case $1 in
    '{')
      emit C 0 0 '' '{'
      body '}' 'a { } group that does not close'
      keyword '}'
      ;;
    if)
      f='an if command that does not close'
      emit C 0 0 '' if
      body 'then' "$f"
      keyword 'then'
      while :; do
        body 'elif else fi' "$f"
        case $pw in
          elif)
            keyword elif
            body 'then' "$f"
            keyword 'then'
            ;;
          else)
            keyword else
            body 'fi' "$f"
            keyword 'fi'
            break
            ;;
          *)
            keyword 'fi'
            break
            ;;
        esac
      done
      ;;
    while | until)
      f="a $1 loop that does not close"
      [[ $1 == until ]] && f='an until loop that does not close'
      emit C 0 0 '' "$1"
      body 'do' "$f"
      keyword 'do'
      body 'done' "$f"
      keyword 'done'
      ;;
    for) for_loop ;;
    case) case_command ;;
    '[[') test_command ;;
  esac
  compound_end
}

# compound_command: read the compound command at the cursor, or return 1 when none starts there.
compound_command() {
  peek2
  if [[ $c == '(' ]]; then
    if [[ $c2 == '(' ]]; then arith_command; else subshell; fi
    return 0
  fi
  word_at
  case $pw in
    '{' | if | while | until | for | case | '[[') compound "$pw" ;;
    *) return 1 ;;
  esac
}

parse_command() {
  skip_blanks
  peek2
  case $c in
    '') unread 'an operator with no command after it' ;;
    $'\n') unread 'a newline out of place' ;;
    ';' | '|' | ')') unread "a $c out of place" ;;
    '&') [[ $c2 == '>' ]] || unread 'a & out of place' ;;
  esac
  compound_command && return 0
  # A reserved word that starts no command here, but ! and time, which a pipeline's start reads.
  case $pw in
    select) unread 'a select command' ;;
    coproc) unread 'a coproc command' ;;
    function) unread 'the function keyword' ;;
    '!' | 'then' | 'elif' | 'else' | 'fi' | 'do' | 'done' | 'esac' | '}' | in | ']]') unread "a $pw out of place" ;;
  esac
  parse_simple
}

# plain <text>: move past the word at the cursor when it is the unquoted text, ending where a word
# ends but before a (; a lookahead that reads no parts and emits nothing.
plain() {
  local i
  word_at
  [[ $pw == "$1" && $pe != '(' ]] || return 1
  for ((i = 0; i < ${#1}; i++)); do adv; done
}

parse_pipeline() {
  local prefixed=0
  emit P
  while :; do
    skip_blanks
    if plain '!'; then
      emit '!'
    elif plain time; then
      emit T
      skip_blanks
      if plain -p; then
        skip_blanks
        plain -- || :
      fi
    else
      break
    fi
    prefixed=1
  done
  skip_blanks
  peek2
  if ((prefixed)) && [[ -z $c || $c == [$'\n'\;\)] || ($c == '&' && $c2 != [\&\>]) ]]; then
    emit p
    return 0
  fi
  parse_command
  while :; do
    skip_blanks
    peek2
    [[ $c == '|' && $c2 != '|' ]] || break
    adv
    [[ $c2 == '&' ]] && adv
    emit '|'
    skip_newlines
    parse_command
  done
  emit p
}

parse_andor() {
  local op
  parse_pipeline
  while :; do
    skip_blanks
    peek2
    op=$c$c2
    [[ $op == '&&' || $op == '||' ]] || return 0
    adv
    adv
    emit "$op"
    skip_newlines
    parse_pipeline
  done
}

# parse_list [close] [stops]: read a command list to the command's end, to the close at its own
# level (the ) of a substitution or a subshell), or to a reserved word in stops (" then " and the
# like) at a command's start, leaving the cursor on it; with ;; in stops, a case arm's list, which
# ;;, ;& and ;;& end too. Sets listed to the number of and-or lists read.
parse_list() {
  local close=${1:-} stops=${2:-} n=0
  skip_newlines
  while :; do
    peek2
    [[ -z $c || (-n $close && $c == "$close") ]] && break
    [[ $stops == *' ;; '* && $c == ';' && $c2 == [\;\&] ]] && break
    if [[ -n $stops ]]; then
      word_at
      [[ -n $pw && $stops == *" $pw "* ]] && break
    fi
    parse_andor
    n=$((n + 1))
    skip_blanks
    peek2
    case $c in
      '') break ;;
      ';')
        if [[ $c2 == [\;\&] ]]; then
          [[ $stops == *' ;; '* ]] && break
          unread "a ;$c2 out of place"
        fi
        adv
        emit ';'
        ;;
      '&')
        adv
        emit '&'
        ;;
      $'\n')
        emit ';'
        newline
        ;;
      *)
        [[ -n $close && $c == "$close" ]] && break
        # After a compound command, a reserved word may end the list with no ; before it.
        word_at
        [[ -n $pw && $stops == *" $pw "* ]] && break
        unread "a ${pw:-$c} out of place"
        ;;
    esac
    skip_newlines
  done
  listed=$n
}

parse_list
((${#hq_d[@]} == 0)) || unread 'a here-document whose delimiter line is not found'

# ---- The commands --------------------------------------------------------------------------------
tmp_root=${TEAM_SYSTEM_ROOT:-}/tmp

# name_of <first> <count>: set nm to the word's text with its quotes and backslashes removed, and nu
# to 1 when it holds an expansion, a glob or an ANSI-C escape, so it names no command the hook knows.
name_of() {
  local k=$1 end=$(($1 + $2)) text
  nm='' nu=0
  for ((; k < end; k++)); do
    text=${pt[k]}
    case ${pk[k]} in
      l)
        if [[ $text == *[\*\?]* || $text == *\[*\]* || $text == *\{*\}* ]]; then nu=1; fi
        nm+=$text
        ;;
      q) nm+=$text ;;
      a)
        if [[ $text == *\\* ]]; then nu=1; fi
        nm+=$text
        ;;
      *) nu=1 ;;
    esac
  done
}

# takes_of <wrapper>: set takes to the wrapper's options that take the next word as their value,
# as tests/helpers/common.bash's unwrapped models them for the deny rules, with stdbuf's, BSD env's
# -P and GNU time's -f and -o.
takes_of() {
  case $1 in
    env) takes=' -u -C -P --unset --chdir ' ;;
    sudo) takes=' -u -g -U -C -D -h -p -r -R -t -T -a --user --group --other-user --close-from --chdir --host --prompt --role --chroot --type --command-timeout --auth-type ' ;;
    timeout) takes=' -k -s --kill-after --signal ' ;;
    nice) takes=' -n --adjustment ' ;;
    stdbuf) takes=' -i -o -e ' ;;
    exec) takes=' -a ' ;;
    time) takes=' -f -o --format --output ' ;;
    *) takes='' ;;
  esac
}

# resolve <S>: find the command word of the simple command whose S event is at the index given,
# past its assignments and wrappers: cw its event (-1 for none), cn its name, cu 1 when it names
# no command the hook knows, chd 1 when a wrapper's -C, --chdir or -D moves the command it runs,
# words 1 when the command holds any word but its assignments, wrapped 1 when a wrapper runs it.
resolve() {
  local e wrapper='' options=0 valued=0 timed=0 takes=''
  cw=-1 cn='' cu=0 chd=0 words=0 wrapped=0
  for e in ${OWN[$1]}; do
    [[ ${EK[e]} == W ]] || continue
    words=1
    name_of "${EA[e]}" "${EB[e]}"
    if ((valued)); then
      valued=0
      continue
    fi
    if [[ -n $wrapper ]]; then
      if ((options && !nu)) && [[ $nm == -?* ]]; then
        if [[ $nm == -- ]]; then
          options=0
        elif [[ $wrapper == command && ($nm == -v || $nm == -V) ]]; then
          # A lookup, which runs nothing.
          return 0
        else
          if [[ $nm == --chdir* || ($nm == -[!-]* && $nm == *[CD]*) ]]; then chd=1; fi
          if [[ $takes == *" $nm "* ]]; then valued=1; fi
        fi
        continue
      fi
      if [[ ($wrapper == env || $wrapper == sudo) && ${pk[EA[e]]} == l && ${pt[EA[e]]} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
        continue
      fi
      if ((timed)); then
        # timeout's duration, whatever the word.
        timed=0 options=0
        continue
      fi
    fi
    if ((!nu)); then
      case ${nm##*/} in
        env | sudo | nohup | timeout | nice | stdbuf | command | exec | time | builtin)
          wrapper=${nm##*/} options=1 timed=0
          [[ $wrapper == timeout ]] && timed=1
          takes_of "$wrapper"
          continue
          ;;
      esac
    fi
    cw=$e cn=$nm cu=$nu
    [[ -z $wrapper ]] || wrapped=1
    return 0
  done
}

# The command's simple and compound commands, by the index of their S and C events, in the order
# read (a compound command before the commands in it), and OWN[s] the events of each one's own
# words and redirections, not those of the commands and substitutions in it. For the walk:
# MATCH[k] the event that ends the pipeline, command or substitution starting at k (its p, E, Z or
# d), CEND[k] a compound command's c, PIPED[k] 1 for a pipeline of more than one command, and
# HD[k] the D event of the body of the here-document whose I event is k.
starts=() OWN=() MATCH=() CEND=() PIPED=() HD=() open=()
for ((e = 0; e < ${#EK[@]}; e++)); do
  case ${EK[e]} in
    S | C)
      starts+=("$e") open+=("$e")
      OWN[e]=''
      ;;
    P) open+=("$e") ;;
    D)
      open+=("$e")
      if [[ ${EX[e]} == '<<' ]]; then HD[EA[e]]=$e; fi
      ;;
    E | d | Z | p)
      MATCH[open[-1]]=$e
      unset 'open[-1]'
      ;;
    c) CEND[open[-1]]=$e ;;
    '|') PIPED[open[-1]]=1 ;;
    A | W | R | I) OWN[open[-1]]+=" $e" ;;
  esac
done

# The first pass, before anything is judged: each command's command word, the forms refused by
# what a command runs, whether HOME, TMPDIR and CLAUDE_JOB_DIR keep the hook's values and $PWD
# stands for the directory, and which commands may move the shell: TRIG[s] 1 for each, CD[s] 1 for
# a cd the walk follows, the command word cd itself, with no wrapper, and DEAD[s] 1 for one that
# may move it at any later point too (eval, source, ., trap, a command word the hook cannot name),
# by a trap it sets or a function it defines.
CW=() CN=() CU=() CH=() TRIG=() CD=() DEAD=()
stop=$vstop ifs_prefixes=0 trig=0
three='(^|[^A-Za-z0-9_])(HOME|TMPDIR|CLAUDE_JOB_DIR|PWD)([^A-Za-z0-9_]|$)'

# args_of <S>: set args to the events of the command's words after its command word.
args_of() {
  local e
  args=()
  for e in ${OWN[$1]}; do
    if ((e > CW[$1])) && [[ ${EK[e]} == W ]]; then args+=("$e"); fi
  done
}

check_set() {
  local k=0 e ended=0 name
  args_of "$1"
  while ((k < ${#args[@]})); do
    e=${args[k]}
    k=$((k + 1))
    ((ended)) && continue
    name_of "${EA[e]}" "${EB[e]}"
    ((nu)) && unread "the set option ${ER[e]}"
    if [[ $nm == -- || $nm == - ]]; then
      ended=1
    elif [[ $nm =~ ^[-+][euxvETo]+$ ]]; then
      name=${nm//[!o]/}
      while [[ -n $name ]]; do
        name=${name:1}
        ((k < ${#args[@]})) || break
        name_of "${EA[args[k]]}" "${EB[args[k]]}"
        if ((nu)) || [[ ! $nm =~ ^(errexit|nounset|xtrace|verbose|pipefail|errtrace|functrace)$ ]]; then
          unread "the set option -o ${ER[args[k]]}"
        fi
        k=$((k + 1))
      done
    elif [[ $nm == [-+]* ]]; then
      unread "the set option $nm"
    else
      ended=1
    fi
  done
}

check_shopt() {
  local e
  args_of "$1"
  for e in "${args[@]}"; do
    name_of "${EA[e]}" "${EB[e]}"
    ((nu)) && unread "the shopt option ${ER[e]}"
    if [[ $nm == -* && ! $nm =~ ^-[pq]+$ ]]; then unread "the shopt option $nm"; fi
  done
}

# check_assigning <S> <builtin>: stop following the three variables when the builtin may assign one.
check_assigning() {
  local e
  args_of "$1"
  if [[ $2 == printf ]]; then
    # printf assigns only through a -v, which only its first word can be.
    ((${#args[@]})) || return 0
    name_of "${EA[args[0]]}" "${EB[args[0]]}"
    if ((nu)) || [[ $nm == -v* ]]; then stop=1; fi
    return 0
  fi
  for e in "${args[@]}"; do
    name_of "${EA[e]}" "${EB[e]}"
    if ((nu)) || [[ $nm =~ $three ]]; then stop=1; fi
    case $2 in
      declare | typeset | local) if [[ $nm == [-+]*[in]* ]]; then stop=1; fi ;;
      mapfile | readarray) if [[ $nm == -*C* ]]; then stop=1; fi ;;
    esac
  done
}

for s in "${starts[@]}"; do
  if [[ ${EK[s]} == C ]]; then
    CW[s]=-1
    # A for loop assigns its variable, the word after its for.
    if [[ ${EX[s]} == for && ${ER[s + 1]} =~ ^(HOME|TMPDIR|CLAUDE_JOB_DIR|PWD)$ ]]; then stop=1; fi
    continue
  fi
  resolve "$s"
  CW[s]=$cw CN[s]=$cn CU[s]=$cu CH[s]=$chd TRIG[s]=0 CD[s]=0 DEAD[s]=0
  # A command that may move the shell.
  if ((cw >= 0)) && { ((cu)) || [[ ${cn##*/} == @(cd|pushd|popd) || $cn == @(eval|source|.|trap) ]]; }; then
    TRIG[s]=1 trig=1
    if ((!cu && !wrapped)) && [[ $cn == cd ]]; then CD[s]=1; fi
    if ((cu)) || [[ $cn == @(eval|source|.|trap) ]]; then DEAD[s]=1; fi
  fi
  for e in ${OWN[s]}; do
    [[ ${EK[e]} == A ]] || continue
    text=${pt[EA[e]]}
    if [[ $text =~ ^(HOME|TMPDIR|CLAUDE_JOB_DIR|PWD)(\[|\+?=) || $text =~ ^[A-Za-z_][A-Za-z0-9_]*\[ ]]; then stop=1; fi
    if ((words)) && [[ $text =~ ^IFS\+?= ]]; then ifs_prefixes=$((ifs_prefixes + 1)); fi
  done
  ((cw >= 0)) || continue
  if ((cu)); then
    stop=1
    continue
  fi
  case $cn in
    alias | enable | hash) unread "the $cn builtin" ;;
    set) check_set "$s" ;;
    shopt) check_shopt "$s" ;;
    eval | source | . | trap | let) stop=1 ;;
    declare | typeset | local | readonly | read | mapfile | readarray | getopts | unset | wait | export | printf)
      check_assigning "$s" "$cn"
      ;;
  esac
done

# The names that change how bash splits words or finds a cd's directory, anywhere in the text, but
# IFS as the prefix assignment of a command that runs one.
for name in CDPATH POSIXLY_CORRECT; do
  [[ $command =~ (^|[^A-Za-z0-9_])$name([^A-Za-z0-9_]|$) ]] && unread "the name $name"
done
if [[ $command == *IFS* ]]; then
  text=$command count=0
  while [[ $text =~ (^|[^A-Za-z0-9_])IFS([^A-Za-z0-9_]|$) ]]; do
    count=$((count + 1))
    text=${text#*"${BASH_REMATCH[0]}"}
  done
  ((count <= ifs_prefixes)) || unread 'the name IFS'
fi

# ---- The walk ------------------------------------------------------------------------------------
declare -A known=()
if ((!stop)); then
  known[HOME]=$HOME
  known[TMPDIR]=${TMPDIR:-$tmp_root}
  [[ -z ${CLAUDE_JOB_DIR:-} ]] || known[CLAUDE_JOB_DIR]=$CLAUDE_JOB_DIR
fi
allowed=("$scratch")
for dir in "$tmp_root" "${TMPDIR:-}" "${CLAUDE_JOB_DIR:-}"; do
  [[ -z $dir ]] || allowed+=("$(realpath -m -- "$dir")")
done

# The walk's environment is the set of directories the shell may be in, ? when it may be in any:
# one line per directory, a flag and its absolute path, the flag 1 when the shell is there only
# because a cd may have failed, else 0. The empty set is a point the shell never reaches. A set of
# more than max_dirs directories is ?, so a command of many cds that may fail costs no more.
max_dirs=16

# env_union <a> <b>: set un to the union of the two; a directory in both keeps the flag 1 only when
# both give it.
env_union() {
  if [[ $1 == '?' || $2 == '?' ]]; then
    un='?'
    return 0
  fi
  if [[ -z $1 || $1 == "$2" ]]; then
    un=$2
    return 0
  fi
  if [[ -z $2 ]]; then
    un=$1
    return 0
  fi
  local rest=$1$'\n'$2 x d order=()
  local -A flag=()
  while [[ -n $rest ]]; do
    x=${rest%%$'\n'*}
    rest=${rest:${#x}+1}
    d=${x:1}
    if [[ -z ${flag[$d]+set} ]]; then
      order+=("$d")
      flag[$d]=${x:0:1}
    elif [[ ${x:0:1} == 0 ]]; then
      flag[$d]=0
    fi
  done
  if ((${#order[@]} > max_dirs)); then
    un='?'
    return 0
  fi
  un=''
  for d in "${order[@]}"; do un+=${flag[$d]}$d$'\n'; done
  un=${un%$'\n'}
}

# env_fail <env>: set fl to the environment with every directory flagged, where a failed cd leaves
# the shell.
env_fail() {
  fl=$1
  [[ $1 == '?' || -z $1 ]] && return 0
  fl=$'\n'$1
  fl=${fl//$'\n'0/$'\n'1}
  fl=${fl:1}
}

# env_dirs <env>: set dl to its directories and df to their flags, or dunk to 1 when it is ?.
env_dirs() {
  local rest=$1 x
  dl=() df=() dunk=0
  if [[ $1 == '?' ]]; then
    dunk=1
    return 0
  fi
  while [[ -n $rest ]]; do
    x=${rest%%$'\n'*}
    rest=${rest:${#x}+1}
    df+=("${x:0:1}") dl+=("${x:1}")
  done
}

# canon <absolute path>: set cp to the path with its . and .. resolved by text and its slashes
# single, as bash's logical cd does.
canon() {
  local rest=${1#/} part out=() IFS=/
  while :; do
    part=${rest%%/*}
    case $part in
      '' | .) ;;
      ..) if ((${#out[@]})); then unset 'out[-1]'; fi ;;
      *) out+=("$part") ;;
    esac
    [[ $rest == */* ]] || break
    rest=${rest#*/}
  done
  cp=/${out[*]}
}

# word_values <first> <count>: set vals to every value the word may have, in the directories dl
# that env_dirs set, and vdir to the index in dl of the directory each value's $PWD stands for (-1
# for none); or why to the reason it cannot be worked out (expansion, or cd for a $PWD with the
# directory unknown).
word_values() {
  local k=$1 end=$(($1 + $2)) text i j nv nd
  vals=('') vdir=(-1) why=''
  for ((; k < end; k++)); do
    text=${pt[k]}
    case ${pk[k]} in
      l)
        if [[ $text == *[\*\?\[\{\}]* || $text == *[=:]\~* ]]; then
          why=expansion
          return 0
        fi
        if ((k == $1)) && [[ $text == \~* ]]; then
          # ~ alone or before a /, the whole word or before an unquoted /; a ~user is unknown.
          if [[ -z ${known[HOME]+set} ]] || ! [[ $text == \~/* || ($text == \~ && $((k + 1)) == "$end") ]]; then
            why=expansion
            return 0
          fi
          text=${known[HOME]}${text:1}
        fi
        ;;
      q) ;;
      a)
        if [[ $text == *\\* ]]; then
          why=expansion
          return 0
        fi
        ;;
      v | V)
        if [[ $text == PWD ]] && ((!stop)); then
          # Each directory the shell may be in.
          if ((dunk)); then
            why='cd'
            return 0
          fi
          nv=() nd=()
          for i in "${!vals[@]}"; do
            if ((vdir[i] >= 0)); then
              nv+=("${vals[i]}${dl[vdir[i]]}") nd+=("${vdir[i]}")
            else
              for j in "${!dl[@]}"; do nv+=("${vals[i]}${dl[j]}") nd+=("$j"); done
            fi
          done
          if [[ ${pk[k]} == v ]]; then
            for j in "${dl[@]}"; do
              if [[ $j == *[$' \t\n*?[']* ]]; then
                why=expansion
                return 0
              fi
            done
          fi
          vals=("${nv[@]}") vdir=("${nd[@]}")
          continue
        fi
        if [[ -z ${known[$text]+set} ]]; then
          why=expansion
          return 0
        fi
        if [[ ${pk[k]} == v && ${known[$text]} == *[$' \t\n*?[']* ]]; then
          why=expansion
          return 0
        fi
        text=${known[$text]}
        ;;
      # A process substitution, a whole word, is the pipe to it.
      p) text=/dev/fd/63 ;;
      *)
        why=expansion
        return 0
        ;;
    esac
    for i in "${!vals[@]}"; do vals[i]+=$text; done
  done
}

# The targets judged, in the order the walk meets them: tw each one as written, tr why it cannot be
# worked out ('' when it can); paths their absolute values, pf the flag of the directory each was
# taken from (1 when only a failed cd leaves the shell there) and pi the target each belongs to.
tw=() tr=() paths=() pf=() pi=()

# reason <why>: set rs to the reason's words.
reason() {
  case $1 in
    expansion) rs='it holds an expansion this hook does not follow' ;;
    cd) rs='a cd before it may have left any directory' ;;
    failed) rs='a cd before it may have failed; join them with &&' ;;
  esac
}

# judge <event> <dup> <moved>: work out the target word of the event in the environment cur,
# taking a relative value from each directory the shell may be in: with dup, a value that is
# digits, - or digits and - is a duplication, no file; with moved, a relative value is unknown.
judge() {
  local e=$1 v i d id=${#tw[@]} fp=() ff=()
  tw+=("${ER[e]}") tr+=('')
  env_dirs "$cur"
  word_values "${EA[e]}" "${EB[e]}"
  if [[ -n $why ]]; then
    reason "$why"
    tr[id]=$rs
    return 0
  fi
  for i in "${!vals[@]}"; do
    v=${vals[i]} d=${vdir[i]}
    [[ -n $v ]] || continue
    if (($2)) && [[ $v =~ ^([0-9]+-?|-)$ ]]; then continue; fi
    if [[ $v == /* ]]; then
      fp+=("$v")
      if ((d >= 0)); then ff+=("${df[d]}"); else ff+=(0); fi
      continue
    fi
    if (($3)) || ((d < 0 && dunk)); then
      reason cd
      tr[id]=$rs
      return 0
    fi
    if ((d >= 0)); then
      fp+=("${dl[d]}/$v") ff+=("${df[d]}")
      continue
    fi
    for d in "${!dl[@]}"; do fp+=("${dl[d]}/$v") ff+=("${df[d]}"); done
  done
  paths+=("${fp[@]}") pf+=("${ff[@]}")
  for v in "${fp[@]}"; do pi+=("$id"); done
}

# cd_env <S>: set ok and ko to the environments a cd leaves when it succeeds and when it fails,
# from cur: -L (the default) resolves .. by text, -P by the symlinks; a cd it cannot follow leaves
# ok unknown.
cd_env() {
  local e n=0 word=-1 phys=0 opts=1 i v d cands=() results=()
  env_fail "$cur"
  ko=$fl ok='?'
  args_of "$1"
  for e in "${args[@]}"; do
    name_of "${EA[e]}" "${EB[e]}"
    if ((opts && !nu)) && [[ $nm == -?* ]]; then
      if [[ $nm == -- ]]; then
        opts=0
      elif [[ $nm =~ ^-[LP]+$ ]]; then
        phys=0
        [[ $nm == *P ]] && phys=1
      else
        # -e, -@ or an option cd does not take.
        return 0
      fi
      continue
    fi
    opts=0 n=$((n + 1)) word=$e
  done
  ((n <= 1)) || return 0
  env_dirs "$cur"
  if ((n == 0)); then
    [[ -n ${known[HOME]:-} ]] || return 0
    vals=("${known[HOME]}") vdir=(-1)
  else
    word_values "${EA[word]}" "${EB[word]}"
    [[ -z $why ]] || return 0
  fi
  for i in "${!vals[@]}"; do
    v=${vals[i]} d=${vdir[i]}
    [[ $v != - && $v != *$'\n'* ]] || return 0
    if [[ -z $v ]]; then
      # bash refuses a null directory, and other shells stay put.
      ((!dunk)) || return 0
      cands+=("${dl[@]}")
      continue
    fi
    if [[ $v == /* ]]; then
      cands+=("$v")
      continue
    fi
    # bash searches CDPATH for a name other than . and .. that starts with neither ./ nor ../.
    if [[ -n ${CDPATH:-} && ! ($v == . || $v == .. || $v == ./* || $v == ../*) ]]; then return 0; fi
    if ((d >= 0)); then
      cands+=("${dl[d]}/$v")
    else
      ((!dunk)) || return 0
      for d in "${dl[@]}"; do cands+=("$d/$v"); done
    fi
  done
  ok=''
  ((${#cands[@]})) || return 0
  if ((phys)); then
    mapfile -d '' -t results < <(realpath -m -z -- "${cands[@]}")
  else
    for v in "${cands[@]}"; do
      canon "$v"
      results+=("$cp")
      # bash's logical cd goes by the path's symlinks when the directory by text does not exist.
      if [[ $v/ == */../* && ! -d $cp ]]; then results+=("$(realpath -m -- "$v")"); fi
    done
  fi
  ok=$'\n' n=0
  for v in "${results[@]}"; do
    [[ $ok == *$'\n'0$v$'\n'* ]] || ok+=0$v$'\n' n=$((n + 1))
  done
  if ((n > max_dirs)); then
    ok='?'
    return 0
  fi
  ok=${ok:1}
  ok=${ok%$'\n'}
}

# Which compound commands a command that may move the shell is in, in the shell they run in (not
# through a ( ) or a substitution): LOOPMOVE[k] 1 for such a loop, FMOVE[k] for such a function;
# LOOPDEAD[k] and FDEAD[k] the same for a command that may move it at any later point.
LOOPMOVE=() FMOVE=() LOOPDEAD=() FDEAD=() open=()
for ((e = 0; e < ${#EK[@]}; e++)); do
  case ${EK[e]} in
    P | C | D) open+=("$e") ;;
    S)
      open+=("$e")
      ((TRIG[e])) || continue
      for ((k = ${#open[@]} - 2; k >= 0; k--)); do
        t=${open[k]}
        [[ ${EK[t]} == D || (${EK[t]} == C && ${EX[t]} == '(') ]] && break
        if [[ ${EK[t]} == C ]]; then
          case ${EX[t]} in
            while | until | for | 'for((')
              LOOPMOVE[t]=1
              ((!DEAD[e])) || LOOPDEAD[t]=1
              ;;
            '()')
              FMOVE[t]=1
              ((!DEAD[e])) || FDEAD[t]=1
              ;;
          esac
        fi
      done
      ;;
    E | d | Z | p) unset 'open[-1]' ;;
  esac
done

# The walker goes through the events in the order bash runs them, from the cursor w, with the
# environment cur a command starts in; a command or list sets ok and ko, the environments it leaves
# when it succeeds and when it fails. Once dead is 1, after a command that may move the shell at
# any later point, every command leaves it in any directory.
dead=0

# skip_bodies: move past the here-document bodies at the cursor, each walked at its here-document.
skip_bodies() {
  while ((w < ne)) && [[ ${EK[w]} == D && ${EX[w]} == '<<' ]]; do w=$((MATCH[w] + 1)); done
}

# walk_region <D>: walk the substitution or here-document body starting at the D event, in a copy
# of the environment: nothing it changes reaches the commands after it.
walk_region() {
  local w=$(($1 + 1)) cur=$cur ok ko dead=$dead
  if [[ ${EX[$1]} == '<<' ]]; then
    while ((w < MATCH[$1])); do walk_region "$w"; w=$((MATCH[w] + 1)); done
  else
    walk_list
  fi
}

# walk_inner <from> <to>: walk the substitutions of the words between the two events, and the body
# of each here-document there.
walk_inner() {
  local k=$1
  while ((k < $2)); do
    case ${EK[k]} in
      D)
        [[ ${EX[k]} == '<<' ]] || walk_region "$k"
        k=$((MATCH[k] + 1))
        continue
        ;;
      I) if [[ -n ${HD[k]:-} ]]; then walk_region "${HD[k]}"; fi ;;
    esac
    k=$((k + 1))
  done
}

# judge_redirs <command> <after>: judge the command's output redirections, those after the event
# given.
judge_redirs() {
  local e
  for e in ${OWN[$1]}; do
    ((e > $2)) && [[ ${EK[e]} == R ]] || continue
    if [[ ${EX[e]} == '>&' ]]; then judge "$e" 1 0; else judge "$e" 0 0; fi
  done
}

walk_simple() {
  local s=$w e options=1
  walk_inner $((s + 1)) "${MATCH[s]}"
  # Its redirections are made before it runs, a tee's files opened as it starts.
  judge_redirs "$s" "$s"
  ok=$cur ko=$cur
  w=$((MATCH[s] + 1))
  ((CW[s] >= 0)) || return 0
  if ((!CU[s])) && [[ ${CN[s]##*/} == tee ]]; then
    args_of "$s"
    for e in "${args[@]}"; do
      name_of "${EA[e]}" "${EB[e]}"
      if ((options && !nu)) && [[ $nm == -- ]]; then
        options=0
      elif ((options && !nu)) && [[ $nm == -?* ]]; then
        :
      else
        judge "$e" 0 "${CH[s]}"
      fi
    done
  fi
  if ((DEAD[s])); then dead=1; fi
  if ((dead)); then
    ok='?' ko='?'
  elif ((CD[s])); then
    cd_env "$s"
  elif ((TRIG[s])); then
    # A cd it cannot follow, pushd or popd stays put when it fails; eval and the rest may do
    # anything.
    ok='?' ko='?'
    if ((!CU[s])) && [[ ${CN[s]##*/} == @(cd|pushd|popd) ]]; then
      env_fail "$cur"
      ko=$fl
    fi
  fi
}

walk_compound() {
  local s=$w z=${MATCH[w]} cend=${CEND[w]} start=$cur ends='' held cok cko sep k
  walk_inner $((cend + 1)) "$z"
  judge_redirs "$s" "$cend"
  case ${EX[s]} in
    '(')
      held=$dead
      w=$((s + 1))
      walk_list
      ok=$start ko=$start dead=$held
      ;;
    '{')
      w=$((s + 1))
      walk_list
      ;;
    if)
      # Each branch starts from its condition's success, the next condition from its failure.
      w=$((s + 1))
      walk_list
      while :; do
        case ${EX[w]} in
          then)
            w=$((w + 1)) held=$ko cur=$ok
            walk_list
            env_union "$ends" "$ok"
            env_union "$un" "$ko"
            ends=$un ko=$held
            ;;
          elif)
            w=$((w + 1)) cur=$ko
            walk_list
            ;;
          else)
            w=$((w + 1)) cur=$ko
            walk_list
            env_union "$ends" "$ok"
            env_union "$un" "$ko"
            ends=$un ko=''
            ;;
          fi)
            # The path where no branch runs.
            env_union "$ends" "$ko"
            ends=$un
            break
            ;;
        esac
      done
      ;;
    while | until)
      if ((${LOOPDEAD[s]:-0})); then dead=1; fi
      if ((${LOOPMOVE[s]:-0})); then start='?'; fi
      w=$((s + 1)) cur=$start
      walk_list
      cok=$ok cko=$ko
      w=$((w + 1))
      if [[ ${EX[s]} == while ]]; then cur=$cok; else cur=$cko; fi
      walk_list
      env_union "$start" "$cok"
      env_union "$un" "$cko"
      env_union "$un" "$ok"
      env_union "$un" "$ko"
      ends=$un
      ;;
    for | 'for((')
      # Its words are expanded once, before it runs.
      k=$((s + 1))
      while ! [[ ${EK[k]} == K && ${EX[k]} == 'do' ]]; do
        if [[ ${EK[k]} == D ]]; then
          [[ ${EX[k]} == '<<' ]] || walk_region "$k"
          k=$((MATCH[k] + 1))
        else
          k=$((k + 1))
        fi
      done
      if ((${LOOPDEAD[s]:-0})); then dead=1; fi
      if ((${LOOPMOVE[s]:-0})); then start='?'; fi
      w=$((k + 1)) cur=$start
      walk_list
      env_union "$start" "$ok"
      env_union "$un" "$ko"
      ends=$un
      ;;
    case)
      # Each arm starts where the case does, or where the arm before it ends after a ;& or ;;&.
      k=$((s + 1)) held=$start ends=$start
      while :; do
        case ${EK[k]} in
          D)
            [[ ${EX[k]} == '<<' ]] || walk_region "$k"
            k=$((MATCH[k] + 1))
            ;;
          K)
            case ${EX[k]} in
              ')')
                w=$((k + 1)) cur=$held
                walk_list
                env_union "$ok" "$ko"
                sep=$un
                env_union "$ends" "$sep"
                ends=$un held=$start
                k=$w
                if [[ ${EX[k]} == ';&' || ${EX[k]} == ';;&' ]]; then
                  env_union "$start" "$sep"
                  held=$un
                fi
                [[ ${EX[k]} == 'esac' ]] || k=$((k + 1))
                ;;
              'esac') break ;;
              *) k=$((k + 1)) ;;
            esac
            ;;
          *) k=$((k + 1)) ;;
        esac
      done
      ;;
    '[[' | '((')
      walk_inner $((s + 1)) "$cend"
      ok=$start ko=$start
      ;;
    '()')
      # The body is judged where the function is defined, in any directory once the command holds
      # a command that may move the shell; one that moves it makes the directory unknown from here.
      if ((trig)); then cur='?'; fi
      w=$((s + 1))
      walk_compound
      ok=$start ko=$start
      if ((${FMOVE[s]:-0})); then ok='?' ko='?'; fi
      if ((${FDEAD[s]:-0})); then dead=1; fi
      ;;
  esac
  case ${EX[s]} in
    if | while | until | for | 'for((' | case) ok=$ends ko=$ends ;;
  esac
  cur=$start
  w=$((z + 1))
}

walk_command() {
  if [[ ${EK[w]} == S ]]; then walk_simple; else walk_compound; fi
}

# walk_pipeline: a ! swaps its success and failure; the commands of a pipeline of more than one
# each run in a copy of the environment.
walk_pipeline() {
  local neg=0 start=$cur piped=${PIPED[w]:-0} t
  w=$((w + 1))
  while [[ ${EK[w]} == '!' || ${EK[w]} == T ]]; do
    [[ ${EK[w]} == T ]] || neg=$((1 - neg))
    w=$((w + 1))
  done
  ok=$cur ko=$cur
  if [[ ${EK[w]} != p ]]; then
    if ((piped)); then
      while :; do
        cur=$start
        walk_command
        [[ ${EK[w]} == '|' ]] || break
        w=$((w + 1))
        skip_bodies
      done
      ok=$start ko=$start cur=$start
    else
      walk_command
    fi
  fi
  w=$((w + 1))
  if ((neg)); then t=$ok ok=$ko ko=$t; fi
}

# walk_andor: in a && b, b starts from a's success; in a || b, from its failure.
walk_andor() {
  local op held
  walk_pipeline
  while [[ ${EK[w]:-} == '&&' || ${EK[w]:-} == '||' ]]; do
    op=${EK[w]}
    w=$((w + 1))
    skip_bodies
    if [[ $op == '&&' ]]; then
      held=$ko cur=$ok
      walk_pipeline
      env_union "$held" "$ko"
      ko=$un
    else
      held=$ok cur=$ko
      walk_pipeline
      env_union "$held" "$ok"
      ok=$un
    fi
  done
}

# walk_list: walk the list at the cursor to the reserved word, the body's end or the substitution's
# end that closes it; each and-or list starts from the union of the ways the one before it can end,
# and one run in the background in a copy.
walk_list() {
  local before
  ok=$cur ko=$cur
  while ((w < ne)); do
    case ${EK[w]} in
      K | c | d) return 0 ;;
      ';' | '&')
        w=$((w + 1))
        continue
        ;;
      # A here-document's body, walked at its here-document.
      D)
        w=$((MATCH[w] + 1))
        continue
        ;;
    esac
    before=$cur
    walk_andor
    if [[ ${EK[w]:-} == '&' ]]; then
      ok=$before ko=$before
    fi
    env_union "$ok" "$ko"
    cur=$un
  done
}

ne=${#EK[@]} w=0
canon "$cwd"
cur=0$cp
walk_list

# Each value as written, its . and .. resolved but its symlinks kept, is the name the refusal says
# (on macOS /home itself resolves to /System/Volumes/Data/home); the resolved one is judged. A
# target is named when a value of it lies outside from a directory the shell reaches, or from one
# only a failed cd leaves it in with no value inside; it may have failed when every value outside
# comes from such a directory and another lies inside.
declare -A out0=() out1=() inside=() named=()
isout=()
if ((${#paths[@]})); then
  mapfile -d '' -t written < <(realpath -m -s -z -- "${paths[@]}")
  mapfile -d '' -t resolved < <(realpath -m -z -- "${paths[@]}")
  for k in "${!paths[@]}"; do
    case ${written[k]} in
      /dev/null | /dev/stdout | /dev/stderr | /dev/fd/*) continue ;;
    esac
    for dir in "${allowed[@]}"; do
      if under "${resolved[k]}" "$dir"; then
        inside[${pi[k]}]=1
        continue 2
      fi
    done
    isout[k]=1
    if ((pf[k])); then out1[${pi[k]}]=1; else out0[${pi[k]}]=1; fi
  done
fi
unknown=() outside=()
reason failed
for id in "${!tw[@]}"; do
  if [[ -n ${tr[id]} ]]; then
    unknown+=("${tw[id]} (${tr[id]})")
  elif [[ -n ${out1[$id]:-} && -z ${out0[$id]:-} && -n ${inside[$id]:-} ]]; then
    unknown+=("${tw[id]} ($rs)")
    tr[id]=$rs
  fi
done
for k in "${!isout[@]}"; do
  id=${pi[k]}
  [[ -z ${tr[id]} && -z ${named[$id:${written[k]}]:-} ]] || continue
  named[$id:${written[k]}]=1
  outside+=("${written[k]}")
done

((${#unknown[@]} + ${#outside[@]})) || exit 0
if ((${#unknown[@]})); then
  list=$(printf '%s, ' "${unknown[@]}")
  echo "Blocked: this hook cannot tell where these targets point: ${list%, }; spell each path out, or write files under $scratch with the Write tool." >&2
fi
if ((${#outside[@]})); then
  list=$(printf '%s, ' "${outside[@]}")
  echo "Blocked: this role may write files only under $scratch; write there with the Write tool, not a shell redirection or tee (tried ${list%, })." >&2
fi
exit 2
