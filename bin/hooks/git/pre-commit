#!/usr/bin/env bash
# Git's pre-commit hook for the team home, with core.hooksPath set to bin/hooks/git: on dev it
# refuses a commit that touches anything but records (bin/lib/records), naming each such path; on
# main it refuses every commit, since a release reaches main by fast-forward from dev. Any other
# branch, and a detached HEAD (a rebase replaying commits), commits freely.
# pre-merge-commit runs it for a merge commit, which is judged by what it brings in.
# Exit 0 the commit may go ahead, 1 refused with the reason on stderr.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../../lib/team.sh" "$@"

case $(git symbolic-ref --short -q HEAD || true) in
  main) die "refused: nothing is committed on main; a release reaches it by fast-forward from dev" ;;
  dev)
    others=$(git diff --cached --name-only --no-renames -z | non_records)
    [[ -n $others ]] || exit 0
    die "refused: a direct commit on dev may touch records only ($(records_list)); commit these on \
a task branch and open a PR to dev:
  ${others//$'\n'/$'\n'  }"
    ;;
esac
