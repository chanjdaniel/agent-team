#!/usr/bin/env bash
# SessionStart hook for the coordinator: on start, resume, clear or compaction, print the team
# snapshot (team-snapshot's text form, ending with the current items of tasks/current.md, so what
# the conversation held and no ledger event records survives a compaction), then the instruction
# to reconcile it before taking new work, so a restarted coordinator rebuilds its picture before
# anything else. Claude Code adds what it prints to the session's context.
# When the snapshot fails it prints the error and what to do by hand instead. Either way it ends
# with the two standing watches to arm with Bash run_in_background, each only if it is not
# already running (Claude Code lists the running background commands, after a compaction too),
# with their exact commands: the sweep watch (team-sweep --wait), which ends once a new finding
# has stood for three minutes, and the offline watch (team-timers watch --once), which ends when
# the hold starts or ends. Each wakes the coordinator once, even while idle, and is re-armed in
# the turn it ends. Exit 0 either way.
# Wired only in coordinator.settings.json.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/team.sh" "$@"

errors=$(mktemp)
trap 'rm -f "$errors"' EXIT

watch_lines() {
  local bin
  bin=$(dirname "$TEAM_LIB")
  echo "Arm each standing watch with Bash run_in_background unless it is already running (Claude" \
    "Code lists the background commands that run), and re-arm it in the turn it ends, after acting" \
    "on what it printed ($(dirname "$bin")/roles/coordinator.md, Watching workers and Machines):"
  echo "  sweep watch, ends once a new finding has stood for three minutes: \"$bin/team-sweep\" --wait"
  echo "  offline watch, ends when the hold starts or ends: \"$bin/team-timers\" watch --once"
}

status=0
snapshot=$(TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-snapshot" --json </dev/null 2>"$errors") ||
  status=$?
if [[ $status -ne 0 ]] || ! jq -e '.schema == "team-snapshot/1"' >/dev/null 2>&1 <<<"$snapshot"; then
  echo "team-snapshot failed (exit $status), so there is no digest:"
  if [[ -s $errors ]]; then cat "$errors"; else echo "it printed no snapshot and no error"; fi
  echo "Reconcile by hand before taking new work (team-sweep, team-state T<n>, claude agents," \
    "tasks/current.md)."
  watch_lines
  exit 0
fi

ledger_jq 'snapshot_text,
  "",
  "Reconcile these before taking new work: log what the ledger is missing with team-log,"
    + " act on what team-sweep finds (stray sessions, and tasks with no live worker that are not"
    + " held, blocked, awaiting merge, asking, paused or waiting), and chase the pending asks and"
    + " the current items."' -r <<<"$snapshot" ||
  echo "The digest could not be printed; run team-snapshot by hand before taking new work."
watch_lines
