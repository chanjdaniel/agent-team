#!/usr/bin/env bash
# Keep this machine's Claude user config and the team home's machine/claude/ in step, by copies.
#
# machine/claude/ in the team home (a record, like the ledger) holds what every machine shares:
#   CLAUDE.md, AGENTS.md, settings.json  ~/.claude/ files of the same names
#   skills/<name>/                        ~/.claude/skills/<name>/: every user skill but synced/
#                                         (claude.ai's, downloaded after login); a skill that is a
#                                         symlink here is compared, captured and backed up as the
#                                         folder it points at
#   skill-lock.json                       ~/.agents/.skill-lock.json, the skills CLI's record of
#                                         where each skill came from: diffed and captured, never
#                                         applied, since the skills it names are vendored above
#   plugins.txt                           `marketplace <source>` and `plugin <id>` lines (# starts
#                                         a comment): user-scope plugins and their marketplaces,
#                                         read against `claude plugin list --json` and
#                                         `claude plugin marketplace list --json`; installed by
#                                         the bootstrap, not by apply
#
# Usage: team-config diff [--full] [--json] | apply | capture
#   diff     One line per difference, and exit 1 when there is any:
#              settings.json differs           (or missing here, or local only)
#              skill tdd missing               (or differs, or local only)
#              skill-lock.json differs
#              marketplace anthropics/claude-plugins-official not added
#              plugin mongodb-atlas@claude-plugins-official not installed
#              plugin X@Y not in plugins.txt   (installed here only)
#              plugins unreadable              (`claude plugin list` failed)
#            --full adds a unified diff, the team home's side first, under each text that differs;
#            --json prints one array of {item, state} instead of the lines.
#   apply    Installs a copy of each file and skill that differs or is missing here, first moving
#            whatever it replaces to ~/.claude/backups/team-config-<UTC time>/ (made only when
#            something is replaced). A skill that exists only here is left alone (diff lists it).
#            Applying twice changes nothing the second time.
#   capture  Copies into machine/claude/ each file and skill that differs here or exists only
#            here, and adds to plugins.txt the user-scope plugins and marketplaces it lacks; one
#            line per change. Nothing is removed, and committing is the caller's.
# Nothing else of ~/.claude is read or copied: not ~/.claude.json, the credentials file, the
# channels' tokens, the transcripts or the projects.
# Exit 0 done (diff: no difference), 1 a difference or a refusal, 2 usage error.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-config diff [--full] [--json] | apply | capture"
[[ $# -ge 1 ]] || usage_error "$usage"
command=$1
shift
full=0 json=0
case $command in
  diff)
    for arg in "$@"; do
      case $arg in
        --full) full=1 ;;
        --json) json=1 ;;
        *) usage_error "$usage" ;;
      esac
    done
    ;;
  apply | capture) [[ $# -eq 0 ]] || usage_error "$usage" ;;
  *) usage_error "$usage" ;;
esac

shared=$TEAM_HOME/machine/claude
claude_dir=$HOME/.claude
lock=$HOME/.agents/.skill-lock.json
FILES=(CLAUDE.md AGENTS.md settings.json)
if [[ $command != capture && ! -d $shared ]]; then
  die "no machine/claude/ in $TEAM_HOME; run team-config capture on the machine whose config the team shares"
fi

# The state of a file or folder here against the team home's: same, differs, missing (here) or
# local only, or nothing when neither exists: compare <team home's> <here>
compare() {
  if [[ -e $1 && -e $2 ]]; then
    if diff -rq -- "$1" "$2" >/dev/null 2>&1; then echo same; else echo differs; fi
  elif [[ -e $1 ]]; then
    echo missing
  elif [[ -e $2 ]]; then
    echo local only
  fi
}

# The skills of a folder, one name per line: every folder (or symlink to one) but synced/ and
# hidden ones: skills_in <dir>
skills_in() {
  local path name
  for path in "$1"/*; do
    name=${path##*/}
    [[ -d $path && $name != synced ]] || continue
    printf '%s\n' "$name"
  done
}

# The plugins.txt lines of one kind, one value per line: listed <marketplace|plugin>
listed() {
  [[ -f $shared/plugins.txt ]] || return 0
  awk -v kind="$1" '!/^[[:space:]]*(#|$)/ && $1 == kind { print $2 }' "$shared/plugins.txt"
}

# Ask claude for the user-scope plugins and the marketplaces, one per line in $installed and
# $marketplaces; false when it does not answer.
read_plugins() {
  local out
  out=$(claude plugin list --json 2>/dev/null </dev/null) &&
    installed=$(jq -r '.[] | select(.scope == "user") | .id' <<<"$out" 2>/dev/null) &&
    out=$(claude plugin marketplace list --json 2>/dev/null </dev/null) &&
    marketplaces=$(jq -r '.[] | .repo // .url // .path // .name' <<<"$out" 2>/dev/null)
}

# Every difference as "<item>\t<state>", one per line, in a fixed order.
differences() {
  local name state
  for name in "${FILES[@]}"; do
    state=$(compare "$shared/$name" "$claude_dir/$name")
    [[ -z $state || $state == same ]] || printf '%s\t%s\n' "$name" "$state"
  done
  while IFS= read -r name; do
    state=$(compare "$shared/skills/$name" "$claude_dir/skills/$name")
    [[ $state == same ]] || printf 'skill %s\t%s\n' "$name" "$state"
  done < <({ skills_in "$shared/skills"; skills_in "$claude_dir/skills"; } | LC_ALL=C sort -u)
  # The lock is provenance: only a lock here that is not the team home's is a difference.
  state=$(compare "$shared/skill-lock.json" "$lock")
  [[ $state != differs && $state != 'local only' ]] || printf 'skill-lock.json\t%s\n' "$state"

  local installed='' marketplaces=''
  if ! read_plugins; then
    printf 'plugins\tunreadable\n'
    return 0
  fi
  while IFS= read -r name; do
    grep -qxF -- "$name" <<<"$marketplaces" || printf 'marketplace %s\tnot added\n' "$name"
  done < <(listed marketplace)
  while IFS= read -r name; do
    grep -qxF -- "$name" <<<"$installed" || printf 'plugin %s\tnot installed\n' "$name"
  done < <(listed plugin)
  while IFS= read -r name; do
    [[ -z $name ]] || listed marketplace | grep -qxF -- "$name" ||
      printf 'marketplace %s\tnot in plugins.txt\n' "$name"
  done <<<"$marketplaces"
  while IFS= read -r name; do
    [[ -z $name ]] || listed plugin | grep -qxF -- "$name" || printf 'plugin %s\tnot in plugins.txt\n' "$name"
  done <<<"$installed"
}

# The team home's path and this machine's path of a file item: paths_of <item>
paths_of() {
  case $1 in
    skill-lock.json) printf '%s\n' "$shared/skill-lock.json" "$lock" ;;
    'skill '*) printf '%s\n' "$shared/skills/${1#skill }" "$claude_dir/skills/${1#skill }" ;;
    *) printf '%s\n' "$shared/$1" "$claude_dir/$1" ;;
  esac
}

do_diff() {
  local list item state ours theirs
  list=$(differences)
  if ((json)); then
    jq -Rn '[inputs | select(length > 0) | split("\t") | {item: .[0], state: .[1]}]' <<<"$list"
  else
    while IFS=$'\t' read -r item state; do
      [[ -n $item ]] || continue
      printf '%s %s\n' "$item" "$state"
      if ((full)) && [[ $state == differs ]]; then
        { read -r ours; read -r theirs; } < <(paths_of "$item")
        diff -ruN -- "$ours" "$theirs" || true
      fi
    done <<<"$list"
  fi
  [[ -z $list ]]
}

do_apply() {
  local item state ours theirs backup='' stamp n=1 changed=0
  while IFS=$'\t' read -r item state; do
    [[ $state == differs || $state == missing ]] || continue
    case $item in skill-lock.json | plugin* | marketplace*) continue ;; esac
    { read -r ours; read -r theirs; } < <(paths_of "$item")
    if [[ -e $theirs ]]; then
      if [[ -z $backup ]]; then
        stamp=$(date -u +%Y%m%dT%H%M%SZ)
        backup=$claude_dir/backups/team-config-$stamp
        while [[ -e $backup ]]; do backup=$claude_dir/backups/team-config-$stamp-$((++n)); done
      fi
      mkdir -p "$(dirname "$backup/${theirs#"$claude_dir"/}")"
      cp -RL -- "$theirs" "$backup/${theirs#"$claude_dir"/}"
    fi
    rm -rf -- "$theirs"
    mkdir -p "$(dirname "$theirs")"
    cp -R -- "$ours" "$theirs"
    if [[ $state == missing ]]; then echo "installed $item"; else echo "replaced $item"; fi
    changed=1
  done < <(differences)
  if ((!changed)); then
    echo "nothing to apply"
  elif [[ -n $backup ]]; then
    echo "what it replaced is in ${backup/#"$HOME"/\~}/"
  fi
}

do_capture() {
  local item state ours theirs changed=0 failed=0
  local -a marketplaces plugins
  mkdir -p "$shared/skills"
  mapfile -t marketplaces < <(listed marketplace)
  mapfile -t plugins < <(listed plugin)
  while IFS=$'\t' read -r item state; do
    case $item in
      plugins)
        echo "team-config: \`claude plugin list\` did not answer, so plugins.txt is unchanged" >&2
        failed=1
        ;;
      'marketplace '* | 'plugin '*)
        [[ $state == 'not in plugins.txt' ]] || continue
        if [[ $item == marketplace* ]]; then
          marketplaces+=("${item#marketplace }")
        else
          plugins+=("${item#plugin }")
        fi
        echo "captured $item"
        changed=2
        ;;
      *)
        [[ $state == differs || $state == 'local only' ]] || continue
        { read -r ours; read -r theirs; } < <(paths_of "$item")
        rm -rf -- "$ours"
        cp -RL -- "$theirs" "$ours"
        if [[ $state == differs ]]; then echo "captured $item"; else echo "captured $item (new)"; fi
        changed=1
        ;;
    esac
  done < <(differences)
  if ((changed == 2)); then
    {
      echo "# User-scope plugins every machine installs, and their marketplaces (team-config)."
      ((${#marketplaces[@]} == 0)) || printf 'marketplace %s\n' "${marketplaces[@]}"
      ((${#plugins[@]} == 0)) || printf 'plugin %s\n' "${plugins[@]}"
    } >"$shared/plugins.txt"
  fi
  ((changed)) || echo "nothing to capture"
  return "$failed"
}

"do_$command"
