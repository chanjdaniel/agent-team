#!/usr/bin/env bash
# Close a task: once its worktrees have landed and no worker is busy, stop its sessions, archive
# its task directories, remove its sessions, return its worktrees and append closed.
#
# Usage: team-close T<n> [--keep-worktree] [--stop-busy] [--worktree <path>]...
# Checks first, changing nothing: the task has events and no closed; each of its open worktrees
# (opened and added, minus returned) has landed after git fetch --prune origin; no live session of its
# launch events is busy. Landed means no changes to tracked files and no untracked files (ignored
# files are fine), and the head on a remote-tracking branch of origin (not wip/* or salvage/*,
# which a project whose origin is the team home's fetches, holding work that has not landed) or
# the head of a merged PR of the branch in the project's repo (gh); a worktree with no commits of
# its own has landed.
# Any failure is exit 1 with every reason. --keep-worktree keeps unlanded worktrees instead of
# refusing, and --stop-busy stops busy sessions instead of refusing.
# Then, in order: claude stop <id> for each live session of the task's launch events (by id,
# never another task's), then, when any was stopped, the landed check again for each worktree to
# return (one that no longer has landed is kept with --keep-worktree, else exit 1 with the task
# half closed); team-stack down --worktree <path> for each worktree to return whose project has a
# stack block, so nothing of it is left running (its logs, saved in the task directory, stay out
# of the archive; a kept worktree keeps its stack; a failed teardown stops the close with the
# reason, the task half closed); tasks/T<n>/ui/, the
# task's UI captures (team-ui), removed, since they stay on this machine and are never archived;
# each worktree's task directory mirrored to tasks/T<n>/scratch/ (the opened project) or
# tasks/T<n>/scratch-<project>/ (an added one), less what archive_left_out (bin/lib/team.sh)
# leaves out, each named on stderr, a missing or empty one reported on stderr; claude rm <id>
# for each of the task's sessions; each landed worktree returned through its pool (git: git
# worktree remove, never --force; treehouse: its task directory emptied, then the project's
# return command run from the primary checkout with the path), each return appending
# worktree-returned; the task's
# wip/<project>/T<n> (team-checkpoint's snapshots) deleted on the team home's origin, and its
# copy refs/remotes/team-home/wip/<project>/T<n> (team-open --resume's) in the project's primary
# checkout, one that cannot be deleted reported on stderr with the command that deletes it; and
# closed with archive, returned and kept. Prints {task, stopped, removed, archive, returned, kept}.
# Last, team-inbox takes the task's asks, PRs and interview out of the Waiting on you message;
# when that fails, a line on stderr says so, and the task stays closed.
# A legacy task (events but no opened) has no worktrees in the ledger: its sessions are stopped
# and removed and closed carries the note legacy. --worktree names a slot it still holds; the
# path must be a trusted slot of a project in projects.toml, appear in one of the task's launch
# events (a path recorded under another machine's home counting as the same path under this
# HOME, as for every recorded worktree) and be on a branch naming the task, else exit 1. The first named slot archives to
# scratch/, others to scratch-<project>/, one slot per project.
# A failure after the checks leaves the task half closed: fix the cause and run team-close again.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-close T<n> [--keep-worktree] [--stop-busy] [--worktree <path>]..."

task='' keep='' stop_busy='' named=()
while (($#)); do
  case $1 in
    --keep-worktree) keep=1 ;;
    --stop-busy) stop_busy=1 ;;
    --worktree)
      [[ $# -ge 2 && -n $2 ]] || usage_error "$usage"
      named+=("$2")
      shift
      ;;
    -*) usage_error "$usage" ;;
    *)
      [[ -z $task ]] || usage_error "$usage"
      task=$1
      ;;
  esac
  shift
done
[[ -n $task ]] || usage_error "$usage"
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"

events=$(known_task_events "$task")
[[ $(task_status "$events") != closed ]] || die "$task is already closed"
opened_project=$(jq -r 'map(select(.event == "opened")) | first | .project // empty' <<<"$events")
if [[ -n $opened_project && ${#named[@]} -gt 0 ]]; then
  usage_error "--worktree is for a legacy task (one with no opened event); $task's worktrees are in the ledger"
fi

# The worktrees to close, one compact {project, branch, worktree, archive} per entry, the
# archive being the directory under tasks/T<n>/ its task directory is mirrored to.
worktrees=()
if [[ -n $opened_project ]]; then
  mapfile -t worktrees < <(ledger_jq 'archived_worktrees($home) | {project, branch, worktree, archive}' -c <<<"$events")
else
  # A legacy task names its slots: never inferred, since slots were shared and reused.
  mapfile -t launched < <(ledger_jq '.[] | select(.event == "launch") | local_worktree($home) | .worktree // empty' -r <<<"$events")
  for path in "${named[@]}"; do
    slot=$(realpath -m -- "$path")
    project=$(team_project --find pool.slots "$slot")
    [[ -n $project ]] || die "$path is not a trusted slot of any project in projects.toml"
    found=''
    for wt in "${launched[@]}"; do
      if same_path "$wt" "$slot"; then found=1; fi
    done
    [[ -n $found ]] || die "$path appears in none of $task's launch events"
    branch=$(git -C "$slot" symbolic-ref -q --short HEAD 2>/dev/null) ||
      die "$path is not on a branch, so it cannot be $task's"
    [[ $branch =~ (^|[^[:alnum:]])$task($|[^[:digit:]]) ]] || die "$path is on $branch, which does not name $task"
    for wt in "${worktrees[@]}"; do
      [[ $(jq -r .project <<<"$wt") != "$project" ]] || die "$task names two slots of $project; close one per project"
    done
    archive=scratch
    ((${#worktrees[@]} == 0)) || archive=scratch-$project
    worktrees+=("$(jq -cn --arg p "$project" --arg b "$branch" --arg wt "$slot" --arg a "$archive" \
      '{project: $p, branch: $b, worktree: $wt, archive: $a}')")
  done
fi

# One field of a worktree's JSON, empty when null: field <name> <json>
field() { jq -r --arg f "$1" '.[$f] // ""' <<<"$2"; }

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# Why the worktree <wt> of <project> on <branch> has not landed, or nothing when it has.
unlanded() {
  local wt=$1 project=$2 branch=$3 head ahead repo found=()
  git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "it is not a git worktree"
    return
  }
  # --prune: a branch deleted on origin must not count through a stale remote-tracking ref.
  git -C "$wt" fetch -q --prune origin 2>/dev/null || {
    echo "cannot fetch origin"
    return
  }
  mapfile -t found < <(worktree_changes "$wt")
  head=$(git -C "$wt" rev-parse HEAD)
  # A snapshot's wip/* or a salvage/* on origin (a project whose origin is the team home's) holds
  # work that never landed, so neither counts.
  ahead=$(git -C "$wt" rev-list --count "$head" --not --exclude='origin/wip/*' --exclude='origin/salvage/*' --remotes=origin)
  if ((ahead > 0)); then
    # Not on origin: a squash or rebase merge leaves the head only as a merged PR's head.
    repo=$(team_project "$project" repo) || {
      echo "cannot read $project's repo from projects.toml"
      return
    }
    if [[ -z $branch ]]; then
      found+=("head ${head:0:7} is on no branch of origin (detached HEAD, so no PR to look for)")
    elif ! github "$scratch" prs pr list --repo "$repo" --head "$branch" --state merged --json number,headRefOid; then
      found+=("head ${head:0:7} is on no branch of origin, and GitHub cannot tell whether a PR merged it ($(<"$scratch/error"))")
    elif ! jq -e --arg head "$head" 'any(.[]; .headRefOid == $head)' "$scratch/prs" >/dev/null; then
      ((ahead == 1)) && ahead="1 commit" || ahead="$ahead commits"
      found+=("head ${head:0:7} is on no branch of origin ($ahead not pushed) and is not the head of a merged PR")
    fi
  fi
  if ((${#found[@]})); then printf '%s; ' "${found[@]}" | sed 's/; $//'; fi
}

# Sort the worktrees given into returning (landed) and kept (not landed, with --keep-worktree);
# each other one adds why it has not landed <since> to problems: sort_landed <since> <wt>...
sort_landed() {
  local since=$1 wt project branch path reason
  shift
  returning=()
  for wt in "$@"; do
    project=$(field project "$wt") branch=$(field branch "$wt") path=$(field worktree "$wt")
    reason=$(unlanded "$path" "$project" "$branch")
    if [[ -z $reason ]]; then
      returning+=("$wt")
    elif [[ -n $keep ]]; then
      kept+=("$wt")
    else
      problems+=("$path ($project, ${branch:-detached HEAD}) has not landed$since: $reason")
      unlanded_count=$((unlanded_count + 1))
    fi
  done
}

# The read-only checks: every reason the task cannot close, collected before anything changes.
problems=() returning=() kept=() unlanded_count=0 busy_count=0
sort_landed "" "${worktrees[@]}"

live_sessions
sessions=$(ledger_jq 'reduce (.[] | select(.event == "launch") | .session | select(type == "string" and . != "")) as $s
    ([]; if IN(.[]; $s) then . else . + [$s] end)
  | map(. as $s | live_session($s; $sessions) as $live
    | {session: $s, name: $live.name, live: ($live != null), busy: ($live.status == "busy")})' \
  -c --argjson sessions "$LIVE_SESSIONS" <<<"$events")
if [[ -z $stop_busy ]]; then
  while IFS= read -r line; do
    problems+=("$line is busy")
    busy_count=$((busy_count + 1))
  done < <(jq -r '.[] | select(.busy) | "\(.name // "session") \(.session)"' <<<"$sessions")
fi

if ((${#problems[@]})); then
  {
    echo "team-close: $task cannot close, so nothing changed:"
    printf '  %s\n' "${problems[@]}"
    ((unlanded_count == 0)) || echo "  (--keep-worktree closes the task and keeps unlanded worktrees as they are)"
    ((busy_count == 0)) || echo "  (--stop-busy stops busy sessions)"
  } >&2
  exit 1
fi

trap 'status=$?; rm -rf "$scratch"; ((status == 0)) || echo "team-close: $task is half closed; fix the cause above and run team-close $task again" >&2' EXIT

# Stop the task's live sessions, by the ids its launch events recorded.
stopped=()
while IFS= read -r id; do
  claude stop "$id" >&2 || die "cannot stop session $id"
  stopped+=("$id")
done < <(jq -r '.[] | select(.live) | .session' <<<"$sessions")

# A worker may have committed between the checks and its stop: what is to be returned must still
# have landed.
if ((${#stopped[@]})); then
  sort_landed " since its sessions were stopped" "${returning[@]}"
  if ((${#problems[@]})); then
    printf 'team-close: %s\n' "${problems[@]}" >&2
    exit 1
  fi
fi

# Take down the stack of each worktree to be returned whose project has a stack block, before the
# archive, so nothing of it is left running; its logs land in the worktree's task directory, which
# the archive leaves them out of (archive_left_out); a kept worktree keeps its stack.
teardown_stacks() {
  local wt project path
  for wt in "${returning[@]}"; do
    project=$(field project "$wt") path=$(field worktree "$wt")
    team_project "$project" >"$scratch/project.json" || exit 1
    jq -e 'has("stack")' "$scratch/project.json" >/dev/null || continue
    TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-stack" down --worktree "$path" </dev/null >&2 ||
      die "cannot take down the stack of $path ($project); its reason is above"
  done
}
teardown_stacks

# The task's UI captures (team-ui) stay on this machine and go with the task, before the archive.
if [[ -e $TEAM_HOME/tasks/$task/ui ]]; then
  rm -rf -- "$TEAM_HOME/tasks/$task/ui"
  echo "team-close: removed tasks/$task/ui/, the task's UI captures" >&2
fi

# Mirror each worktree's task directory into tasks/T<n>/.
archived=()
for wt in "${worktrees[@]}"; do
  project=$(field project "$wt") path=$(field worktree "$wt") archive=$(field archive "$wt")
  task_dir=$path/$(team_project "$project" task_dir)
  if archive_task_dir "$task_dir" "$project" "tasks/$task/$archive"; then archived+=("tasks/$task/$archive"); fi
done

# Remove every session of the task, live or not, now that the archive is made.
removed=()
while IFS= read -r id; do
  if claude rm "$id" >&2; then
    removed+=("$id")
  else
    echo "team-close: claude rm $id failed; remove it by hand if it still exists" >&2
  fi
done < <(jq -r '.[].session' <<<"$sessions")

# Return each landed worktree through its project's pool.
returned=()
for wt in "${returning[@]}"; do
  project=$(field project "$wt") branch=$(field branch "$wt") path=$(field worktree "$wt")
  facts=$(team_project "$project")
  primary=$(jq -r .path <<<"$facts")
  case $(jq -r .pool.provider <<<"$facts") in
    git)
      git -C "$primary" worktree remove -- "$path" || die "cannot remove the worktree $path"
      ;;
    treehouse)
      return_cmd=$(jq -r .pool.return <<<"$facts")
      task_dir=$path/$(jq -r .task_dir <<<"$facts")
      [[ ! -d $task_dir ]] || find "$task_dir" -mindepth 1 -delete
      (cd "$primary" && "$return_cmd" "$path") </dev/null >&2 || die "$return_cmd failed for $path"
      # A treehouse return of a slot it finds dirty asks, and with no terminal leaves it leased.
      ! git -C "$path" symbolic-ref -q HEAD >/dev/null || die "$return_cmd did not return $path: it is still on a branch"
      ;;
    *) die "team-close does not return worktrees to a $(jq -r .pool.provider <<<"$facts") pool" ;;
  esac
  ledger_append "$(jq -cn --arg task "$task" --arg project "$project" --arg worktree "$path" --arg branch "$branch" \
    '{ts: (now | todate), task: $task, event: "worktree-returned", project: $project, worktree: $worktree}
      + if $branch == "" then {} else {branch: $branch} end')"
  returned+=("$path")
done

# Delete the task's work-in-progress snapshots, team-checkpoint's wip/<project>/T<n> on the team
# home's origin and team-open --resume's copy of it in the primary checkout, now that nothing is
# left to recover from them; a project without one is fine, and one that cannot be deleted is
# reported and left.
declare -A seen=()
for wt in "${worktrees[@]}"; do
  project=$(field project "$wt")
  [[ -z ${seen[$project]:-} ]] || continue
  seen[$project]=1
  wip=wip/$project/$task
  primary=$(team_project "$project" | jq -r .path)
  if git -C "$primary" rev-parse -q --verify "refs/remotes/team-home/$wip" >/dev/null &&
    ! git -C "$primary" update-ref -d "refs/remotes/team-home/$wip" 2>"$scratch/error"; then
    echo "team-close: cannot delete team-home/$wip in $primary ($(grep -m1 . "$scratch/error" || echo "no reason given")); delete it by hand: git -C $primary update-ref -d refs/remotes/team-home/$wip" >&2
  fi
  if ! refs=$(GIT_TERMINAL_PROMPT=0 git -C "$TEAM_HOME" ls-remote origin "refs/heads/$wip" 2>"$scratch/error") ||
    { [[ -n $refs ]] && ! GIT_TERMINAL_PROMPT=0 git -C "$TEAM_HOME" push -q origin --delete "$wip" 2>"$scratch/error"; }; then
    echo "team-close: cannot delete $wip on the team home's origin ($(grep -m1 . "$scratch/error" || echo "no reason given")); delete it by hand: git -C $TEAM_HOME push origin --delete $wip" >&2
  fi
done

# The arguments as a JSON list.
json_list() { jq -cn '$ARGS.positional' --args "$@"; }
kept_paths=()
for wt in "${kept[@]}"; do kept_paths+=("$(jq -r .worktree <<<"$wt")"); done
note=''
[[ -n $opened_project ]] || note=legacy
ledger_append "$(jq -cn --arg task "$task" --argjson archive "$(json_list "${archived[@]}")" \
  --argjson returned "$(json_list "${returned[@]}")" --argjson kept "$(json_list "${kept_paths[@]}")" --arg note "$note" \
  '{ts: (now | todate), task: $task, event: "closed", archive: $archive, returned: $returned, kept: $kept}
    + if $note == "" then {} else {note: $note} end')"

jq -n --arg task "$task" --argjson stopped "$(json_list "${stopped[@]}")" --argjson removed "$(json_list "${removed[@]}")" \
  --argjson archive "$(json_list "${archived[@]}")" --argjson returned "$(json_list "${returned[@]}")" \
  --argjson kept "$(json_list "${kept_paths[@]}")" \
  '{task: $task, stopped: $stopped, removed: $removed, archive: $archive, returned: $returned, kept: $kept}'
refresh_inbox
