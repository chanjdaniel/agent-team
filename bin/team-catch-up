#!/usr/bin/env bash
# Catch a task's reviewed, green PR up with its base by a clean merge, made and pushed with no
# worktree touched and no builder or rereview: a conflicted merge stays the holder's
# (builder-merge-base) and a rereview's.
#
# Usage: team-catch-up T<n> [--pr <url>]
# The PR is the task's latest pr event, or --pr, which must be one of the task's pr events; its
# repo must be a project in projects.toml. Checks first, changing nothing, each failure a reason,
# every one given at once (exit 1):
#   the PR is open and targets the project's base;
#   the task's latest review event has verdict pass and names the PR's head now (by the shorter
#   prefix), or the head an earlier team-catch-up made it from (reviewed_head in bin/lib/ledger.jq,
#   when no review names the head itself);
#   every required check (the base branch's protection, gh pr checks --required and the
#   project's required_checks) is present on the head and passed (a skipped one passes), and no
#   check on the head is failing or pending.
# Then it fetches the PR's branch and the base into the project's primary checkout, as team-merge
# does, and refuses a fetched tip that is not the head GitHub showed (the head moved: run it
# again). A head an earlier team-catch-up made must add only clean merges of the base to the
# reviewed head (clean_base_merges in bin/lib/team.sh), else it is refused naming the first that is
# not. A head that holds the base already prints "nothing to merge", exit 0, logging nothing.
# A merge that conflicts (git merge-tree, base_merge in bin/lib/team.sh) makes nothing and names
# the conflicted files and the holder's builder-merge-base step, exit 1. A clean one is made with
# git commit-tree in the primary checkout, under its git identity, with the head and origin's base
# as parents and git's own message, "Merge remote-tracking branch 'origin/<base>' into
# <branch>", touching no worktree, index or branch, and pushed to origin's branch, never forced
# and through the checkout's hooks; a push origin refuses because the branch moved meanwhile is
# exit 1, nothing logged: run it again.
# Then agent-review is set to success on the merge through team-review-status, its description
# "clean merge of <base> <short base> onto <short head>, reviewed", once GitHub shows the merge as
# the PR's head (waited on for up to TEAM_CATCH_UP_WAIT seconds, default 30), and caught-up is
# logged with url (the PR's), from (the reviewed head, the same through each catch-up of it), head
# (the merge) and base (the base's commit merged), all full shas. A status that cannot be set is
# said on stderr with the command to set it; the merge is pushed and logged all the same, exit 1.
# Prints what it merged, the merge's full sha, and last the next step: arm team-next T<n> --ci,
# the checks wait on the merge, which then prints the merge ask at the reviewed head (or the
# default word's merge, when it covers it).
# The coordinator runs it; lease-fence blocks it on a machine that lost the lease, as its git push
# and team-merge.
# Refused, exit 1, before it reads or changes anything: a worker session (an AGENT_TEAM_ROLE but
# coordinator; worker_refusal in bin/lib/team.sh), in every form; --help still answers.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
why=$(worker_refusal "" "catches no branch up") && die "$why"

usage="usage: team-catch-up T<n> [--pr <url>]"

task='' url=''
while (($#)); do
  case $1 in
    --pr)
      [[ $# -ge 2 && -n $2 ]] || usage_error "$usage"
      url=${2%/}
      shift
      ;;
    -*) usage_error "$usage" ;;
    *)
      [[ -z $task ]] || usage_error "$usage"
      task=$1
      ;;
  esac
  shift
done
[[ -n $task ]] || usage_error "$usage"
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"
wait_for=${TEAM_CATCH_UP_WAIT:-30}
[[ $wait_for =~ ^[0-9]+$ ]] || usage_error "TEAM_CATCH_UP_WAIT is a number of seconds, got '$wait_for'"

events=$(known_task_events "$task")
jq -e 'any(.[]; .event == "pr")' <<<"$events" >/dev/null || die "$task has no pr event, so there is no PR to catch up"
if [[ -z $url ]]; then
  pr=$(jq -c 'map(select(.event == "pr")) | last' <<<"$events")
else
  pr=$(jq -c --arg url "$url" 'map(select(.event == "pr" and (.url | rtrimstr("/")) == $url)) | last' <<<"$events")
  [[ $pr != null ]] ||
    die "$url is not one of $task's pr events:"$'\n'"$(jq -r '.[] | select(.event == "pr") | "  \(.url)"' <<<"$events")"
fi

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# The PR as team-state sees it: the repo, the project, the head, its branch, the checks by bucket.
facts=$(pr_part "$events" "$pr" "$scratch") || exit 1
url=$(jq -r .url <<<"$facts")
url=${url%/}
[[ $(jq -r '.number // empty' <<<"$facts") ]] || die "$(jq -r .error <<<"$facts")"
number=$(jq -r .number <<<"$facts") repo=$(jq -r .repo <<<"$facts") project=$(jq -r '.project // empty' <<<"$facts")
[[ -n $project ]] || die "PR #$number is in $repo, which is not a project in projects.toml, so it has no base"
base=$(team_project "$project" base)
jq -e 'has("error") | not' <<<"$facts" >/dev/null || die "GitHub cannot be read: $(jq -r .error <<<"$facts")"
github "$scratch" branch api "repos/$repo/branches/$base" || die "GitHub cannot be read: $(<"$scratch/error")"
head=$(jq -r .head <<<"$facts") branch=$(jq -r .headRefName "$scratch/view")
# The head whose review stands for the PR's: the head, or the one an earlier catch-up made it from.
reviewed=$(ledger_jq 'reviewed_head($head)' -r --arg head "$head" <<<"$events") || exit 1

reasons=()
state=$(jq -r .state <<<"$facts")
[[ $state == open ]] || reasons+=("PR #$number is $state, not open")
[[ $(jq -r .base <<<"$facts") == "$base" ]] || reasons+=("PR #$number targets $(jq -r .base <<<"$facts"), not $project's base $base")
while IFS= read -r line; do if [[ -n $line ]]; then reasons+=("$line"); fi; done < <(ledger_jq '
  map(select(.event == "review")) | last
  | if . == null then "no review of \($task) is logged: review the head first"
    elif .verdict != "pass" then "the latest review of \($task) (of \(.head[:7])) found something, not a pass: fix and review it first"
    elif same_head(.head; $reviewed) | not then
      "the latest review of \($task) passed on \(.head[:7]), not on the head \($head[:7])\(
        if same_head($reviewed; $head) then "" else " or \($reviewed[:7]), which team-catch-up made it from" end): review the head first"
    else empty end' -r --arg task "$task" --arg head "$head" --arg reviewed "$reviewed" <<<"$events")
while IFS= read -r line; do if [[ -n $line ]]; then reasons+=("$line"); fi; done < <(jq -r --slurpfile branch "$scratch/branch" '
  ((.required + ($branch[0].protection.required_status_checks.contexts // [])) | unique) as $required
  | (.checks.passed + .checks.failing + .checks.pending) as $present
  | ($required[] | select(IN($present[]) | not) | "required check \(.) is missing on the head"),
    ([$required[] | select(IN($present[]))] - .checks.passed | .[] | "required check \(.) has not passed on the head"),
    (.checks.failing | select(length > 0) | "checks failing on the head: \(join(", "))"),
    (.checks.pending | select(length > 0) | "checks pending on the head: \(join(", "))")' <<<"$facts")
if ((${#reasons[@]})); then
  {
    echo "team-catch-up: $task cannot catch up PR #$number, so nothing changed:"
    printf '  %s\n' "${reasons[@]}"
  } >&2
  exit 1
fi

# The PR's branch and the base, fetched into the primary checkout as team-merge fetches them.
primary=$(team_project "$project" path)
git -C "$primary" fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" \
  "+refs/heads/$base:refs/remotes/origin/$base" 2>"$scratch/fetch-error" ||
  die "the PR's branch $branch and $base cannot be fetched into $primary: $(grep -m1 . "$scratch/fetch-error" || echo "git fetch failed")"
fetched=$(git -C "$primary" rev-parse "refs/remotes/origin/$branch")
[[ $fetched == "$head" ]] ||
  die "origin's $branch is at ${fetched:0:7}, not at the head ${head:0:7} GitHub showed: the head moved; run it again"
onto=$(git -C "$primary" rev-parse "refs/remotes/origin/$base")
if [[ $reviewed != "$head" ]]; then
  unclean=$(clean_base_merges "$primary" "$reviewed" "$head" "origin/$base") ||
    die "the head ${head:0:7} does not stand on the review of ${reviewed:0:7}, which team-catch-up made it from: $unclean"
fi
if git -C "$primary" merge-base --is-ancestor "$onto" "$head"; then
  echo "team-catch-up: $url holds $base already; nothing to merge"
  exit 0
fi

rc=0
tree=$(base_merge "$primary" "$head" "$onto") || rc=$?
if ((rc == 1)); then
  die "$url conflicts with $base on $(paste -sd, <<<"$tree" | sed 's/,/, /g'): the holder merges it (builder-merge-base), then a rereview"
elif ((rc)); then
  die "$url cannot be merged with $base in $primary: $tree"
fi
merge=$(git -C "$primary" commit-tree "$tree" -p "$head" -p "$onto" \
  -m "Merge remote-tracking branch 'origin/$base' into $branch")

# Pushed as a fast-forward only: a branch that moved on origin since the fetch refuses it.
if ! git -C "$primary" push -q origin "$merge:refs/heads/$branch" 2>"$scratch/push-error"; then
  now=$(git -C "$primary" ls-remote origin "refs/heads/$branch" 2>/dev/null | cut -f1) || now=''
  if [[ -n $now && $now != "$head" ]]; then
    die "$branch moved on origin while the merge was made; nothing pushed: run it again"
  fi
  die "the push of ${merge:0:7} to $branch failed, so nothing was logged: $(grep -m1 . "$scratch/push-error" || echo "git push failed")"
fi
trap 'status=$?; rm -rf "$scratch"; ((status == 0)) || echo "team-catch-up: ${merge:0:7} is pushed to $branch, but its caught-up event was not logged" >&2' EXIT

# agent-review on the merge, once GitHub shows it as the PR's head.
description="clean merge of $base ${onto:0:7} onto ${head:0:7}, reviewed"
unset_status=''
shown=$head
for ((waited = 0; ; waited++)); do
  shown=$(gh pr view "$number" --repo "$repo" --json headRefOid --jq .headRefOid 2>/dev/null) || shown=''
  if [[ $shown == "$merge" ]] || ((waited >= wait_for)); then break; fi
  sleep 1
done
if [[ $shown != "$merge" ]]; then
  unset_status="GitHub still shows ${shown:0:7} as the head of $url after ${wait_for}s"
  [[ -n $shown ]] || unset_status="GitHub's head of $url cannot be read after ${wait_for}s"
elif ! TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-review-status" "$url" "$merge" success "$description" \
  >&2 2>"$scratch/status-error"; then
  unset_status=$(grep . "$scratch/status-error" | tail -n 1)
  unset_status=${unset_status:-team-review-status failed}
fi

ledger_append "$(jq -cn --arg task "$task" --arg url "$url" --arg from "$reviewed" --arg merge "$merge" --arg base "$onto" \
  '{ts: (now | todate), task: $task, event: "caught-up", url: $url, from: $from, head: $merge, base: $base}')"
trap 'rm -rf "$scratch"' EXIT

if [[ -n $unset_status ]]; then
  {
    echo "team-catch-up: pushed ${merge:0:7} to $branch, but agent-review could not be set on it: $unset_status"
    echo "  run: team-review-status $url $merge success '$description'"
  } >&2
  exit 1
fi
echo "team-catch-up: merged $base ${onto:0:7} cleanly onto ${head:0:7} as ${merge:0:7} and pushed it to $branch"
echo "$merge"
echo "next: arm team-next $task --ci with Bash run_in_background: it waits on the checks of the merge ${merge:0:7} and prints the merge ask at ${reviewed:0:7}, whose word holds through this merge"
