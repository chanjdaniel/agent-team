#!/usr/bin/env bash
# Say the machine's task slots: how many tasks may hold a worktree at once on this machine,
# across every project, how many of them are kept for the reserved project, and which tasks hold
# them.
#
# Usage: team-slots [status] [--json]
#        team-slots check <project> [--lock <fd> --label <text>]
#
# status    The default. One summary line ("home-pc: 7 of 10 task slots held, 1 kept for
#           agent-team (agent-team holds 1); effective 10"), then the cap, where it came from and
#           the effective cap's reason, then one line per held slot: its task, project and
#           worktree (~ for the home directory), "(half open)" when it is. Without a machine name
#           (~/.config/agent-team/machine) it says "this machine". It reads only the settings,
#           the machine's name, the registry, the ledger, git (each primary checkout's worktree
#           list) and the stored readings: never Docker or the session list.
#           With --json, one object: {schema: "team-slots/1", machine (null without a name),
#           settings (every key below, and from: each key's source, "slots.json" or "default"),
#           reserved_project (null with none), effective: {cap, lowered_by (null, "memory" or
#           "cpu"), reason, readings (the window's, oldest first)}, held: [{task, project,
#           worktree, half_open}], counts: {held, reserved_held, others_held}, room: {reserved
#           (null with no reserved project), others}, stale (true with no reading, or the newest
#           more than 15 minutes old)}.
# check     Whether the registered project <project>'s task may take a new slot, by the room
#           below: exit 0 with room, saying nothing; else exit 75 with the refusal on stderr: why
#           ("no task slot for conventioner on home-pc: 9 of 10 held, and the last one is kept for
#           agent-team (reserved 1)"), the cap line as status says it, then "the slots:" and one
#           line per held slot. An unregistered project is a usage error.
#           With --lock, it first takes the machine's slot lock, an exclusive flock on the
#           descriptor <fd>, which the caller opened read-write on
#           ~/.local/state/agent-team/slots.lock, so the lock outlasts the check until the caller
#           closes it (team-open holds it until the slot it takes holds the task's branch, so two
#           runs never take the last slot), and writes "<text> since <YYYY-MM-DD HH:MM:SS +zzzz>"
#           into that file as its holder's line (team-open's text is "team-open T<n> <project>
#           (pid <pid>)"). While another run holds it, it says once that it waits and for whom,
#           waits up to wait_minutes, then exits 75 naming the holder ("another run" before it
#           wrote its line).
#
# The machine's settings, ~/.config/agent-team/slots.json, beside stack.json: one JSON object
# whose keys are all optional:
#   cap             a whole number of 1 or more, default 6: the most task slots held at once
#   reserved        a whole number of 0 or more, less than cap, default 1: the slots kept for
#                   the reserved project
#   dynamic         true or false, default true: whether the readings may lower the cap
#   task_gib        a number above 0, default 1.25: the memory one more task needs
#   reserve_gib     a number of 0 or more, default 6: the memory kept free beyond the tasks
#   task_cores      a number above 0, default 0.5: the CPU one more task needs, in cores
#   reserve_cores   a number of 0 or more, default 2: the cores kept free beyond the tasks
#   window_minutes  a whole number of 1 or more, default 15: how far back readings count
#   wait_minutes    a number of 0 or more, default 15: how long team-open waits for another
#                   run's slot lock
# A file that is not one JSON object, a key of the wrong kind, an unknown key and a reserved not
# less than cap are refused, naming each.
#
# The reserved project is the registered project whose primary checkout is this code checkout,
# or the primary checkout of the one it is a linked worktree of (team-project --find path),
# agent-team on Daniel's team; with none, reserved is ignored, and the summary says so.
# A slot is held by each open worktree in the ledger (opened or added, not returned, of a task
# not closed), across every project and wherever its path was recorded, and by each half-open
# one: a registered worktree of a registered project's primary checkout, but the checkout
# itself, whose branch names a task (<type>/T<n>-<slug>) that has no closed event and no open
# worktree of that project in the ledger. So a failed open counts until it is finished, and a
# closed task's kept worktree does not; a task in two projects holds two.
# The readings of the machine's load are the lines of
# ~/.local/state/agent-team/slots/readings.jsonl, one JSON object each: {at (UTC,
# YYYY-MM-DDTHH:MM:SSZ), memory: {total, others, ...} in bytes, cpu: {cpus, others, ...} in cores
# busy, or null when the CPU was not read}; a test writes the file to simulate them. A broken
# line is skipped, and said once on stderr.
# The effective cap: a reading's fit is how many tasks the machine carries beside the other
# programs, the lower of memory's floor((total - others - reserve_gib) / task_gib) and, when the
# CPU was read, the CPU's floor((cpus - others - reserve_cores) / task_cores), never below 0. Its
# confirmed fit is the higher of its fit and the previous reading's (the one before the window
# for the window's first, and none for the first reading ever), so a lower number holds only once
# two readings in a row show it. The effective cap is the lowest confirmed fit of the readings in
# the last window_minutes, at most cap and never below the slots kept for the reserved project,
# its reason saying what lowered it ("lowered by memory: other programs use 18.2 GiB of 30.6 GiB,
# leaving room for 6 tasks of 1.25 GiB after 6 GiB kept (the readings of 13:05 and 13:10)", in
# local time) or what the latest reading saw. With dynamic false, or no reading in the window, it
# is cap. So one reading never lowers it, two in a row lower it at once, and it rises back once
# that pair is older than the window.
# The room, with E the effective cap, R the reserved count, H every slot held and O those held by
# projects other than the reserved one: the reserved project's task may take a slot while H < E,
# and any other project's while H < E and O < E - R. So the reserved project always has R slots,
# held or free, its held ones counting toward them; room.reserved is E - H, room.others the lower
# of that and E - R - O, neither below 0.
#
# Exit 0 done (check: there is room), 1 refused (a malformed slots.json, with the reason, or a
# registry team-project refuses), 2 usage error, 75 check: no task slot, or the slot lock still
# held after wait_minutes.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

USAGE="usage: team-slots [status] [--json] | team-slots check <project> [--lock <fd> --label <text>]"
SETTINGS=$HOME/.config/agent-team/slots.json
LOCK=$HOME/.local/state/agent-team/slots.lock
READINGS=$HOME/.local/state/agent-team/slots/readings.jsonl
# The code checkout, or the primary checkout of the one it is a linked worktree of.
CODE=$(dirname "$(dirname "$TEAM_LIB")")
if common=$(git -C "$CODE" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) &&
  [[ $(basename "$common") == .git ]]; then
  CODE=$(dirname "$common")
fi

json='' check='' lock_fd='' label=''
if [[ ${1:-} == check ]]; then
  [[ $# -ge 2 && $2 != -* ]] || usage_error "$USAGE"
  check=$2
  shift 2
  while (($#)); do
    case $1 in
      --lock)
        [[ ${2:-} =~ ^[0-9]+$ ]] || usage_error "--lock takes a file descriptor; $USAGE"
        lock_fd=$2
        shift 2
        ;;
      --label)
        [[ -n ${2:-} ]] || usage_error "--label takes a text; $USAGE"
        label=$2
        shift 2
        ;;
      *) usage_error "$USAGE" ;;
    esac
  done
  [[ -n $lock_fd || -z $label ]] || usage_error "--label goes with --lock; $USAGE"
  [[ -z $lock_fd || -n $label ]] || usage_error "--lock needs --label, its holder's line; $USAGE"
  [[ -z $lock_fd || /dev/fd/$lock_fd -ef $LOCK ]] ||
    usage_error "--lock takes a descriptor open on $LOCK, and $lock_fd is not"
else
  [[ ${1:-} != status ]] || shift
  for arg; do
    case $arg in
      --json) json=1 ;;
      *) usage_error "$USAGE" ;;
    esac
  done
fi

# slots.json's values (jq -s), [] with no file; a malformed one is refused with the reason.
given='[]'
if [[ -e $SETTINGS ]]; then
  given=$(jq -s . "$SETTINGS" 2>&1) || die "$SETTINGS is not JSON: $(grep . <<<"$given" | tail -n 1)"
  problems=$(jq -r -L "$TEAM_LIB" 'include "slots"; slots_problems' <<<"$given")
  [[ -z $problems ]] || die "$SETTINGS$problems"
fi

machine=$(machine_name 2>/dev/null) || machine=''
projects=$(team_project --list)
[[ -z $check ]] || grep -qxF -- "$check" <<<"$projects" ||
  usage_error "unknown project '$check'; known: $(jq -Rnr '[inputs] | join(", ")' <<<"$projects")"

# The machine's slot lock, on the caller's descriptor, before the count.
if [[ -n $lock_fd ]]; then
  holder() {
    local line=''
    [[ ! -s $LOCK ]] || IFS= read -r line <"$LOCK" || true
    echo "${line:-another run}"
  }
  if ! flock -n -x "$lock_fd"; then
    read -r wait seconds < <(jq -r -L "$TEAM_LIB" 'include "slots"; slots_settings.wait_minutes | "\(.) \(. * 60)"' <<<"$given")
    [[ $seconds != 0 ]] || { echo "${0##*/}: the machine's slot lock is held by $(holder)" >&2 && exit 75; }
    echo "${0##*/}: waiting up to $wait minutes for the machine's slot lock, held by $(holder)" >&2
    flock -w "$seconds" -x "$lock_fd" || {
      echo "${0##*/}: the machine's slot lock is still held after $wait minutes, by $(holder)" >&2
      exit 75
    }
  fi
  printf '%s since %(%F %T %z)T\n' "$label" -1 >"$LOCK"
fi
reserved_project=''
[[ -z $projects ]] || reserved_project=$(team_project --find path "$CODE" | head -n 1)

# Every registered project's linked worktrees, but its primary checkout, each {project, branch,
# worktree} (branch "" when detached), from its git worktree list; a primary checkout that is
# not a git checkout has none.
worktrees=$(
  while IFS= read -r project; do
    [[ -n $project ]] || continue
    primary=$(team_project "$project" path)
    git -C "$primary" worktree list --porcelain 2>/dev/null | awk -v project="$project" '
      function out() { if (n++ > 0) printf "%s\t%s\t%s\n", project, branch, path }
      /^worktree / { if (path != "") out(); path = substr($0, 10); branch = "" }
      /^branch refs\/heads\// { branch = substr($0, 19) }
      END { if (path != "") out() }' || true
  done <<<"$projects" | jq -Rn '[inputs | split("\t") | {project: .[0], branch: .[1], worktree: .[2]}]'
)

# The stored readings of the machine's load, a broken line skipped and said once.
readings_file=$READINGS
[[ -e $readings_file ]] || readings_file=/dev/null
readings=$(jq -Rnc -L "$TEAM_LIB" 'include "slots"; [inputs] | slots_readings' "$readings_file")
broken=$(jq .broken <<<"$readings")
((broken == 0)) || echo "${0##*/}: skipped $broken broken line$( ((broken == 1)) || echo s) of ${READINGS/#"$HOME"/\~}" >&2

ledger=$TEAM_HOME/ledger.jsonl
[[ -e $ledger ]] || ledger=/dev/null
status=$(jq -nR -L "$TEAM_LIB" --arg home "$HOME" --argjson given "$given" --arg machine "$machine" \
  --arg project "$reserved_project" --argjson worktrees "$worktrees" --slurpfile readings <(jq .readings <<<"$readings") \
  'include "ledger"; include "slots";
  slots_status({given: $given, machine: ($machine | select(. != "") // null),
    reserved_project: ($project | select(. != "") // null), held: held_slots(ledger_events; $worktrees; $home),
    readings: $readings[0]})' "$ledger")

if [[ -n $check ]]; then
  room=$(jq -r --arg project "$check" -L "$TEAM_LIB" 'include "slots"; room_for($project)' <<<"$status")
  ((room > 0)) && exit 0
  jq -r -L "$TEAM_LIB" --arg project "$check" --arg home "$HOME" 'include "slots"; refusal_text($project; $home)
    | if startswith(" ") then . else "team-slots: " + . end' <<<"$status" >&2
  exit 75
elif [[ -n $json ]]; then
  jq . <<<"$status"
else
  jq -r -L "$TEAM_LIB" --arg home "$HOME" --arg code "$CODE" 'include "slots"; status_text($home; $code)' <<<"$status"
fi
