#!/usr/bin/env bash
# Hold the team's work in one systemd user slice, each task's in a slice of its own inside it, so
# the kernel can measure and limit it, and read what the team's work uses and costs on this
# machine (sops/resources.md), and admit each launch, stack and heavy run that fits the level's
# budget. team-level sets the level's limits on the slice.
#
# Usage: team-capacity install
#        team-capacity place [--quiet] [<session id>...]
#        team-capacity check [--json] [--holding] [--heartbeat enabled|disabled]
#        team-capacity sample
#        team-capacity status [--json] [--stored]
#        team-capacity costs [--json]
#        team-capacity admit --kind <kind> [--task T<n>] [--seed-bytes <n>]
#
# install  Daniel's yes, as team-timers enable is. On Linux writes the team's slice,
#          ~/.config/systemd/user/agent-team.slice (a description, no limits), and for each gate
#          daemon unit no-mistakes wrote there, no-mistakes-daemon-<hash>.service, a drop-in
#          no-mistakes-daemon-<hash>.service.d/agent-team.conf holding Slice=agent-team.slice, so
#          every gate run is the team's; then systemctl --user daemon-reload when it wrote
#          anything. A gate daemon that runs (ActiveState active) outside the slice is restarted
#          with `no-mistakes daemon restart`, never --force, which refuses while a pipeline runs:
#          then the daemon is left as it is, and it says why and that a later install restarts
#          it. Each file written, the reload and each restart is one line; with nothing to do it
#          says so. Idempotent. Exit 1 when the user manager does not answer the reload.
# place    On Linux, adopts each live team session (claude agents --json: every session named
#          T<n>-<role> whose process runs, never the coordinator, an unnamed one or a load
#          check's T0; with ids, only those, each an 8-hex session id, and an id that is no live
#          team session, or whose process is gone, is a failure) into the
#          transient scope agent-team-T<n>-<id>.scope in the slice agent-team-T<n>.slice, which
#          systemd nests under agent-team.slice by its name: the session's process, its parent
#          when that is the claude daemon's bg-pty-host, and every descendant, but those already
#          in a cgroup under agent-team.slice (a heavy run's scope). It asks the user manager
#          through busctl --user call org.freedesktop.systemd1 ... StartTransientUnit with the
#          PIDs, and once more with a fresh tree when that call fails (a process that ended
#          meanwhile). A session already in its scope is left. Each placed and left session is
#          one line on stdout (with --quiet, the heartbeat's, only each placed one), each one it
#          cannot place one line on stderr, and the others are still placed; exit 1 when any
#          failed.
# check    What the doctor's resources line says, as {os, verdict (PASS, WARN or FAIL), reason,
#          fix, problems: [{verdict, reason, fix}]} with --json, else the line "<verdict>
#          <reason>" and "; fix: <fix>" when there is one, exiting 1 unless it passes. Its reason
#          starts with the level's words (team-level status --json --stored's says: "manual,
#          minor (30%): 9.2 GiB and 3.6 cores for the team; 6.1 GiB reserved"). On any OS it
#          FAILs on a capacity.json or a level.jsonl line that is malformed, naming it. On Linux
#          it FAILs, since the level's limits need the slice, when systemctl --user does not
#          answer or the user manager's cgroup.controllers lacks cpu or memory; it WARNs when
#          agent-team.slice is not installed as install writes it, a gate daemon unit lacks its
#          drop-in (both fixed by team-capacity install, Daniel's yes), a running gate daemon is
#          outside the slice (its restart waits on its pipeline), the session list cannot be
#          read, a live team session runs outside its task's slice (fixed by team-capacity
#          place), or, with the slice installed, the limits team-level last applied
#          (~/.local/state/agent-team/level/applied.json) are missing or another mode and level's
#          than the record's, or the slice's CPUQuota is not theirs (each fixed by team-level
#          apply). On any OS, with --holding (this machine holds the lease, whose heartbeat takes
#          a reading every 5 minutes): WARN when the newest reading is more than 15 minutes old,
#          or there is none, its fix the heartbeat log's capacity lines, or team-timers enable
#          with --heartbeat disabled. The passing reason names the slice and how many live team
#          sessions are in it.
# sample   Takes one reading of the machine's load with the team's use per task and appends it to
#          ~/.local/state/agent-team/capacity/readings.jsonl, kept to the last 24 hours (the
#          heartbeat's capacity step runs it every 5 minutes), printing nothing; within 60
#          seconds of the newest reading it appends nothing. The machine's part is team-slots
#          sample's reading, by the same code (bin/lib/reading.sh), against a CPU snapshot of its
#          own, ~/.local/state/agent-team/capacity/procs.tsv; a reading it cannot take is its
#          reason on stderr, exit 1, with nothing written. It adds:
#            systemd   on Linux whether the user manager answered (systemctl --user show of the
#                      units below), else null
#            sessions  whether the session list (claude agents --json) could be read
#            tasks     per task with work here (a held worktree, a live team session, a running
#                      team stack or a process in its slice), by number: {task, memory (bytes),
#                      cpu (cores busy since the snapshot, null without one), cpu_nsec (its slice's
#                      CPUUsageNSec, null off Linux or with no slice), sessions: [{id, role,
#                      memory, peak, cpu_seconds}], stacks: [{name, memory, cpu}]}. On Linux its
#                      slice's MemoryCurrent and CPUUsageNSec (the CPU against the newest stored
#                      reading's), plus the team processes outside the team's slice that are the
#                      task's, plus its running team stacks (their task label); elsewhere, or with
#                      no slice, every process that is the task's. A process is the task's when its
#                      working directory is that task's held worktree or below it, or it descends
#                      from one that is. A session's use is its scope's
#                      (agent-team-T<n>-<id>.scope's MemoryCurrent, MemoryPeak and CPUUsageNSec) on
#                      Linux, else its process tree's resident memory and CPU seconds, but the
#                      team-heavy that holds the heavy-run lock (its holder line's pid) and what it
#                      runs, whose cost is heavy:<kind>'s.
#            stacks    each running team or gate stack: {name, class, task, project (the
#                      registered project of the held worktree it runs for, null for a gate's),
#                      memory, cpu (cores), limits (team-stack ls --json's memory_limit_bytes)}
#            heavy     the running heavy run, while a team-heavy holds the heavy-run lock: {pid (its
#                      team-heavy's), memory (on Linux its scope's, agent-team-heavy-<pid>.scope's,
#                      MemoryCurrent, else its tree's resident memory)}, else null
#            gate      {running (a process works in a gate worktree, ~/.no-mistakes/worktrees/...),
#                      memory, cpu_seconds}: on Linux the gate daemon unit's MemoryCurrent and
#                      CPUUsageNSec, else the processes in ~/.no-mistakes and their descendants
#          Then the cost samples: what it saw running is kept in
#          ~/.local/state/agent-team/capacity/live.json, and each item that ended appends one line
#          {at, kind, peak_bytes, cpu_seconds, seconds} to costs.jsonl beside it: a session
#          (session:<role>) the session list no longer has, its peak the highest MemoryPeak (or
#          tree) the readings saw and its CPU the last; a stack of a registered project
#          (stack:<project>) Docker no longer runs, its peak the highest memory the readings saw;
#          the gate (gate) once no pipeline runs, its peak the highest memory seen while one ran,
#          its CPU the daemon's since the first reading that saw it run. seconds runs from the
#          first reading that saw it to the last. A session list or Docker that did not answer
#          ends nothing.
# status   The newest reading: a line with what other programs and the team use, then one per
#          task with its use, its sessions and its stacks, and the gate while it runs a pipeline.
#          With no reading of the last 10 minutes (no heartbeat takes them) it first takes one as
#          sample does, a reading it cannot take said on stderr; with --stored never, so it
#          writes nothing. With --json one object: {schema: "team-capacity/1", machine (null
#          without a name), settings (every key below, and from: each key's source,
#          "capacity.json" or "default"), stale (true with no reading, or the newest more than 15
#          minutes old), reading (the newest, as sample writes it, or null), reserved: {bytes (the
#          total), items: [{kind, task, name, estimate_bytes, use_bytes, bytes}]}, room: {mode,
#          level (the team home's level.jsonl's, manual full with none), share, budget_bytes (the
#          memory budget, as team-level says it), bytes (the budget less what is reserved, below 0
#          when over it); both null with no reading}}. What is reserved, each item at the larger
#          of its kind's estimate (costs) and its use: each live team session and each running team
#          or gate stack of the newest reading, the gate while it runs a pipeline, the running
#          heavy run while a team-heavy holds the lock (kind and estimate its admission's, use the
#          reading's when the reading saw it, named by its holder line's label), and each admission
#          of the last 10 minutes but a heavy run's, at its estimate then (no use yet, and its
#          time as admitted), since a new session or stack has not grown yet.
# costs    Each kind of work's estimate, one line each ("session:builder: 0.6 GiB, learned from 7
#          samples, 0.4 GiB to 0.6 GiB"): a session by role (each role in roles/ but the
#          coordinator's), a stack by registered project with a stack block, the gate, then every
#          other kind costs.jsonl has (heavy:<kind>, which team-heavy writes). From 5 samples the
#          estimate is the 90th percentile (nearest rank) of the peaks of the last 20, plus 10%;
#          before that the seed: session_gib, heavy_gib or gate_gib, and for a stack the sum of its
#          services' mem_limits as the readings last saw it running (none before). With --json
#          {schema: "team-capacity-costs/1", costs: [{kind, estimate_bytes (null with no seed),
#          source ("learned", "seed" or "none"), samples, range ({min, max} of the last 20 peaks,
#          or null), says}]}.
# admit    Admits one item of work of <kind>, session:<role> (team-worker), stack:<project>
#          (team-stack up), heavy:<kind> (team-heavy run) or gate, for the task --task names, when
#          it fits the level's memory budget beside what is reserved: under an exclusive flock on
#          ~/.local/state/agent-team/capacity.lock, it takes a reading first when the newest is
#          over 10 minutes old, as status does, then reads what is reserved as status --json says
#          it (for a heavy run, without the running heavy run, which is the asker itself, holding
#          the lock), and the kind's estimate: costs' when it has one, else --seed-bytes (team-stack
#          gives the sum of the stack's mem_limits), else heavy_gib or session_gib, else 0. When the
#          reserved memory plus the estimate is at most the budget it exits 0, saying so on
#          stdout, and keeps the admission in ~/.local/state/agent-team/capacity/admitted.json
#          ({at, kind, task, bytes, pid (a heavy run's team-heavy, the lock's holder)}), which
#          reserves it for 10 minutes (a heavy run's while its team-heavy holds the lock); else it
#          exits 75 with the reason on stderr, "no room for session:reviewer at minor (30%): 8.9
#          GiB of 9.2 GiB reserved, a reviewer needs 0.5 GiB", and at level none "the team is at
#          level none: nothing starts". CPU is never admitted: the slice's quota holds it. Above
#          none, with no reading to size the budget by, exit 1 with the reason.
#
# The machine's settings, ~/.config/agent-team/capacity.json, beside stack.json: one JSON object
# whose keys are all optional:
#   full_share       above 0 and at most 1, default 0.9: full's share of memory and CPU
#   minor_share      above 0 and at most 1, default 0.3: minor's share
#   reserve_gib      0 or more, default 4: memory kept free beyond the other programs' use
#   reserve_cores    0 or more, default 1: cores kept free beyond their use
#   auto_full_free   0 to 1, default 0.5: auto picks full while the others leave this much free
#   auto_none_below  0 to 1, default 0.15: auto picks none while they leave less than this
#   rise_minutes     0 or more, default 15: how long every reading must allow a higher level
#   session_gib      above 0, default 0.5: a session's seed cost, until learned
#   heavy_gib        above 0, default 5: a heavy run's seed cost, until learned
#   gate_gib         above 0, default 2.2: a gate run's seed cost, until learned
#   min_cores        above 0, default 1: the CPU quota's floor
#   min_gib          above 0, default 2: the slice's MemoryHigh floor
# A file that is not one JSON object, a key of the wrong kind and an unknown key are refused by
# sample, status and costs, naming each (exit 1).
#
# On macOS, which has no cgroups, install and place change nothing and say so once on stderr,
# check passes with "no hard limits on macOS: admission and stow only", and sample reads each
# task's use by the working-directory rule alone.
# Test seams: TEAM_CGROUP_ROOT stands for / where the user manager's cgroup.controllers and /proc
# are read by place and check, so the tests run on a tree of their own; sample reads the machine
# through team-slots's seams (TEAM_MEMINFO, TEAM_SLOTS_PROCS, whose lines may carry a sixth
# column, the process's cgroup v2 path, TEAM_SLOTS_CPUS and TEAM_SLOTS_DOCKER_SECONDS).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

# shellcheck source=bin/lib/reading.sh
source "$TEAM_LIB/reading.sh"

USAGE="usage: team-capacity install | place [--quiet] [<session id>...] | check [--json] [--holding] [--heartbeat enabled|disabled] | sample | status [--json] [--stored] | costs [--json] | admit --kind <kind> [--task T<n>] [--seed-bytes <n>]"
[[ $# -ge 1 ]] || usage_error "$USAGE"
command=$1
shift
json=0 ids=() quiet=0 holding=0 heartbeat=enabled stored=0 kind='' task='' seed=null
case $command in
  install | sample) [[ $# -eq 0 ]] || usage_error "unexpected argument '$1'" ;;
  place)
    if [[ ${1:-} == --quiet ]]; then
      quiet=1
      shift
    fi
    for id; do [[ $id =~ ^[0-9a-f]{8}$ ]] || usage_error "a session id is 8 hex digits, got '$id'"; done
    ids=("$@")
    ;;
  check | status | costs)
    while [[ $# -gt 0 ]]; do
      case $command:$1 in
        *:--json) json=1 ;;
        check:--holding) holding=1 ;;
        check:--heartbeat)
          [[ ${2:-} == enabled || ${2:-} == disabled ]] || usage_error "--heartbeat takes enabled or disabled"
          heartbeat=$2
          shift
          ;;
        status:--stored) stored=1 ;;
        *) usage_error "unexpected argument '$1'" ;;
      esac
      shift
    done
    ;;
  admit)
    while [[ $# -gt 0 ]]; do
      case $1 in
        --kind)
          [[ ${2:-} =~ ^(session:[a-z]+|stack:[A-Za-z0-9._-]+|heavy:[^[:space:]]+|gate)$ ]] ||
            usage_error "--kind takes session:<role>, stack:<project>, heavy:<kind> or gate"
          kind=$2
          ;;
        --task)
          [[ ${2:-} =~ ^T[0-9]+$ ]] || usage_error "--task takes a task, T<n>"
          task=$2
          ;;
        --seed-bytes)
          [[ ${2:-} =~ ^[0-9]+$ ]] || usage_error "--seed-bytes takes a whole number of bytes"
          seed=$2
          ;;
        *) usage_error "unexpected argument '$1'" ;;
      esac
      shift 2
    done
    [[ -n $kind ]] || usage_error "admit needs --kind <kind>"
    ;;
  *) usage_error "unknown subcommand '$command'; $USAGE" ;;
esac

ROOT=${TEAM_CGROUP_ROOT:-}
UNITS=$HOME/.config/systemd/user
SETTINGS=$HOME/.config/agent-team/capacity.json
STATE=$HOME/.local/state/agent-team/capacity
READINGS=$STATE/readings.jsonl
ADMITTED=$STATE/admitted.json
ADMIT_LOCK=$HOME/.local/state/agent-team/capacity.lock
RECORD=$TEAM_HOME/level.jsonl
HEAVY_LOCK=$HOME/.local/state/agent-team/heavy.lock
# team-heavy's HOLDER_FORM: a holder line of its own form, its label, pid and task.
HEAVY_HOLDER_FORM='^(.*) \(pid ([0-9]+)(, (T[0-9]+))?\) since '
SLICE=agent-team.slice
DROP_IN=agent-team.conf
uid=$(id -u)

case $(uname -s) in
  Linux) os=linux ;;
  Darwin) os=macos ;;
  *) die "no resource levels on $(uname -s)" ;;
esac

# A path under HOME as ~/ says it.
tilde() {
  printf '%s\n' "${1/#"$HOME"\//\~/}"
}

# The team's slice unit, as install writes it.
slice_unit() {
  printf '%s\n' '[Unit]' "Description=Daniel's agent team: every worker session, heavy run and gate run (team-capacity)" \
    '' '[Slice]'
}

# A gate daemon's drop-in, as install writes it.
drop_in() {
  printf '%s\n' '# team-capacity install: every gate run in the team'\''s slice.' '[Service]' "Slice=$SLICE"
}

# The gate daemon units no-mistakes wrote, one name per line, sorted.
gate_units() {
  local file
  for file in "$UNITS"/no-mistakes-daemon-*.service; do
    [[ -f $file ]] && basename "$file"
  done | sort
}

# A unit's property, as the user manager says it: unit_property <unit> <property>
unit_property() {
  systemctl --user show -P "$2" "$1" 2>/dev/null
}

# Whether the cgroup path <path> is inside the team's slice.
in_team_slice() {
  [[ $1 == */agent.slice/$SLICE/* ]]
}

# Whether the gate daemon <unit> runs outside the team's slice.
daemon_outside() {
  [[ $(unit_property "$1" ActiveState) == active ]] && ! in_team_slice "$(unit_property "$1" ControlGroup)/"
}

# Write <file> with stdin's content when it differs, saying so; returns 1 when nothing changed.
write_if_changed() {
  local file=$1 content
  content=$(cat)
  if [[ -f $file && $(cat "$file") == "$content" ]]; then return 1; fi
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$content" >"$file.new"
  mv "$file.new" "$file"
  echo "wrote $(tilde "$file")"
}

install() {
  local changed=0 unit out rc cgroup did=0
  if [[ $os == macos ]]; then
    echo "team-capacity: no cgroups on macOS: nothing to install" >&2
    return 0
  fi
  if slice_unit | write_if_changed "$UNITS/$SLICE"; then changed=1; fi
  while IFS= read -r unit; do
    [[ -n $unit ]] || continue
    if drop_in | write_if_changed "$UNITS/$unit.d/$DROP_IN"; then changed=1; fi
  done < <(gate_units)
  if ((changed)); then
    out=$(systemctl --user daemon-reload 2>&1) ||
      die "the user's systemd does not answer (systemctl --user daemon-reload: $(grep -m1 . <<<"$out" || echo "no reason given"))"
    echo "reloaded the user manager"
    did=1
  fi
  while IFS= read -r unit; do
    if [[ -z $unit ]] || ! daemon_outside "$unit"; then continue; fi
    did=1 rc=0
    out=$(no-mistakes daemon restart 2>&1 </dev/null) || rc=$?
    if ((rc)); then
      echo "the gate's daemon $unit runs a pipeline (no-mistakes daemon restart: $(grep -m1 . <<<"$out" || echo "exit $rc")), so it stays outside $SLICE until it restarts: once no gate runs, run team-capacity install again"
    elif cgroup=$(unit_property "$unit" ControlGroup) && in_team_slice "$cgroup/"; then
      echo "restarted the gate's daemon $unit into $SLICE (no pipeline was running)"
    else
      echo "the gate's daemon $unit still runs outside $SLICE after no-mistakes daemon restart ($cgroup); run team-capacity install again once no gate runs"
    fi
  done < <(gate_units)
  ((did)) || echo "$SLICE and the gate's drop-ins are installed, and the gate's daemon runs in the slice: nothing to do"
}

# The processes under ROOT's /proc, one "<pid> <ppid>" per line.
process_table() {
  local file
  for file in "$ROOT"/proc/[0-9]*/status; do
    [[ -f $file ]] && printf '%s\n' "$file"
  done | xargs -r awk '$1 == "PPid:" { pid = FILENAME; sub(/\/status$/, "", pid); sub(/.*\//, "", pid); print pid, $2; nextfile }' 2>/dev/null || true
}

# The cgroup the process <pid> is in, its cgroup v2 line's path; empty when it is gone.
cgroup_of() {
  sed -n 's/^0:://p' "$ROOT/proc/$1/cgroup" 2>/dev/null || true
}

# Whether the process <pid> is the claude daemon's pty host for a session.
pty_host() {
  { tr '\0' '\n' <"$ROOT/proc/$1/cmdline"; } 2>/dev/null | grep -qxE -- '(--)?bg-pty-host'
}

# The PIDs to adopt for the session process <pid>: itself, its pty host parent, and every
# descendant not already in the team's slice, one per line.
session_pids() {
  local pid=$1 table parent
  table=$(process_table)
  echo "$pid"
  parent=$(awk -v pid="$pid" '$1 == pid { print $2 }' <<<"$table")
  if [[ -n $parent ]] && pty_host "$parent" && ! in_team_slice "$(cgroup_of "$parent")"; then echo "$parent"; fi
  awk -v root="$pid" '{ kids[$2] = kids[$2] " " $1 }
    END { queue[1] = root; n = 1
      for (i = 1; i <= n; i++) { m = split(kids[queue[i]], k, " "); for (j = 1; j <= m; j++) { queue[++n] = k[j]; print k[j] } } }' <<<"$table" |
    sort -n | while IFS= read -r child; do
      in_team_slice "$(cgroup_of "$child")" || echo "$child"
    done
}

# Ask the user manager to adopt <pid>... into <scope> in <slice>: start_scope <scope> <slice> <pid>...
start_scope() {
  local scope=$1 slice=$2
  shift 2
  busctl --user call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager \
    StartTransientUnit 'ssa(sv)a(sa(sv))' "$scope" fail 3 \
    PIDs au $# "$@" Slice s "$slice" Description s "agent-team session ${scope#agent-team-}" 0
}

# Place one live team session <id> <name> <pid>; returns 1 when it could not.
place_one() {
  local id=$1 name=$2 pid=$3 task scope slice pids out
  task=${name%%-*}
  scope=agent-team-$task-$id.scope slice=agent-team-$task.slice
  if [[ ! $pid =~ ^[0-9]+$ || ! -d $ROOT/proc/$pid ]]; then
    # A listed session whose process is gone is no live one: only one named by id fails.
    ((${#ids[@]} == 0)) && return 0
    echo "team-capacity: could not place $name $id: its process ${pid:-(none listed)} is gone" >&2
    return 1
  fi
  if [[ $(cgroup_of "$pid") == */$slice/$scope ]]; then
    ((quiet)) || echo "left $name $id: already in $scope"
    return 0
  fi
  for _ in once again; do
    mapfile -t pids < <(session_pids "$pid")
    if out=$(start_scope "$scope" "$slice" "${pids[@]}" 2>&1); then
      echo "placed $name $id in $scope (${#pids[@]} process$( ((${#pids[@]} == 1)) || echo es))"
      return 0
    fi
    [[ -d $ROOT/proc/$pid ]] || break
  done
  echo "team-capacity: could not place $name $id (pid $pid) in $slice: $(grep -m1 . <<<"$out" || echo "busctl failed")" >&2
  return 1
}

# The live team sessions, one "<id><TAB><name><TAB><pid>" per line, or with ids "-<TAB><reason>"
# for each id that is no live team session.
team_sessions() {
  jq -r --args '[.[] | {id: (.id // (.sessionId // "" | .[:8])), name: (.name // ""), pid: (.pid // "" | tostring)}] as $live
    | def team: .name | test("^T[1-9][0-9]*-[a-z]+$");
    if $ARGS.positional == [] then $live[] | select(team) | [.id, .name, .pid] | @tsv
    else $ARGS.positional[] as $id | ($live | map(select(.id == $id)) | first) as $s
      | if $s == null then ["-", "\($id): no live session has that id"]
        elif ($s | team | not) then ["-", "\($id): it is no team session (named \(if $s.name == "" then "nothing" else $s.name end), not T<n>-<role>)"]
        else [$s.id, $s.name, $s.pid] end | @tsv end' "${ids[@]}" <<<"$LIVE_SESSIONS"
}

place() {
  local failed=0 id name pid
  if [[ $os == macos ]]; then
    echo "team-capacity: no cgroups on macOS: no session is placed" >&2
    return 0
  fi
  live_sessions
  while IFS=$'\t' read -r id name pid; do
    if [[ $id == - ]]; then
      echo "team-capacity: could not place $name" >&2
      failed=1
    elif ! place_one "$id" "$name" "$pid"; then
      failed=1
    fi
  done < <(team_sessions)
  return "$failed"
}

# The doctor's resources line, as the header's check says.
check() {
  local problems=() out controllers file unit placed=0 id name pid cgroup manager=1
  problem() { problems+=("$(jq -cn --arg v "$1" --arg r "$2" --arg f "${3:-}" '{verdict: $v, reason: $r, fix: $f}')"); }
  if [[ $os == linux ]]; then
    if ! out=$(systemctl --user show -P Version 2>&1); then
      manager=0
      problem FAIL "the user's systemd does not answer (systemctl --user: $(grep -m1 . <<<"$out" || echo "no reason given")), so no work goes in the team's slice and the level's limits hold nothing" \
        "log in so the user's systemd runs, then run team-doctor again"
    fi
    file=$ROOT/sys/fs/cgroup/user.slice/user-$uid.slice/user@$uid.service/cgroup.controllers
    controllers=$(cat "$file" 2>/dev/null) || controllers=''
    if [[ " $controllers " != *" cpu "* || " $controllers " != *" memory "* ]]; then
      problem FAIL "the user manager's cgroup does not delegate the cpu and memory controllers (cgroup.controllers: ${controllers:-none}), so the team's slice cannot measure or limit its work" \
        "Daniel delegates them (Delegate=cpu memory pids in a drop-in for user@.service, which needs sudo), then logs in again"
    fi
    if [[ ! -f $UNITS/$SLICE || $(cat "$UNITS/$SLICE") != "$(slice_unit)" ]]; then
      problem WARN "$SLICE is not installed" "team-capacity install (Daniel's yes)"
    fi
    while IFS= read -r unit; do
      [[ -n $unit ]] || continue
      if [[ ! -f $UNITS/$unit.d/$DROP_IN || $(cat "$UNITS/$unit.d/$DROP_IN") != "$(drop_in)" ]]; then
        problem WARN "the gate's daemon $unit has no drop-in putting it in $SLICE" "team-capacity install (Daniel's yes)"
      elif ((manager)) && daemon_outside "$unit"; then
        problem WARN "the gate's daemon $unit still runs outside $SLICE, its restart waiting" "team-capacity install once no gate runs"
      fi
    done < <(gate_units)
    if ! LIVE_SESSIONS=$(claude agents --json 2>/dev/null | jq -ce 'select(type == "array")' 2>/dev/null); then
      problem WARN "cannot read the live session list (claude agents --json), so no session's placement was checked" "run team-doctor again"
    else
      while IFS=$'\t' read -r id name pid; do
        cgroup=$(cgroup_of "$pid")
        [[ -n $cgroup ]] || continue
        if [[ $cgroup == */agent-team-${name%%-*}.slice/* ]]; then
          placed=$((placed + 1))
        else
          problem WARN "$name $id runs outside agent-team-${name%%-*}.slice" "team-capacity place"
        fi
      done < <(team_sessions)
    fi
  fi
  level_problems "$manager"
  if ((holding)) && ! newest_reading_within 900; then
    if [[ $heartbeat == enabled ]]; then
      problem WARN "no reading of the machine's load in the last 15 minutes, though this machine holds the lease, whose heartbeat takes one every 5" \
        "the capacity step's lines in ~/.local/state/agent-team/heartbeat.log say why it takes none"
    else
      problem WARN "no reading of the machine's load in the last 15 minutes, though this machine holds the lease, whose heartbeat takes one every 5" \
        "team-timers enable"
    fi
  fi
  printf '%s\n' "${problems[@]}" | jq -sc --arg os "$os" --argjson placed "$placed" --arg level "$LEVEL_SAYS" '
    map(select(. != null)) as $p
    | {os: $os,
       verdict: (if any($p[]; .verdict == "FAIL") then "FAIL" elif $p != [] then "WARN" else "PASS" end),
       reason: ((if $level == "" then [] else [$level] end)
         + if $p != [] then $p | map(.reason)
           elif $os == "macos" then ["no hard limits on macOS: admission and stow only"]
           else ["agent-team.slice holds the team, \($placed) live team session\(if $placed == 1 then "" else "s" end) in it"] end
         | join("; ")),
       fix: ($p | map(.fix | select(. != "")) | unique | join("; ")),
       problems: $p}' >"$work/check.json"
  if ((json)); then
    cat "$work/check.json"
  else
    jq -r '"\(.verdict) \(.reason)" + (if .fix == "" then "" else "; fix: \(.fix)" end)' "$work/check.json"
    [[ $(jq -r .verdict "$work/check.json") == PASS ]] || return 1
  fi
}

# The slice's CPU quota as a whole percentage, from systemd's CPUQuotaPerSecUSec ("3.600000s",
# "500ms"), or "none" for infinity or no answer.
slice_quota() {
  local value
  value=$(unit_property "$SLICE" CPUQuotaPerSecUSec) || value=''
  if [[ -z $value || $value == infinity ]]; then
    echo none
    return 0
  fi
  jq -rn --arg v "$value" '[$v | scan("([0-9.]+)(min|ms|us|s)") | (.[0] | tonumber) * {min: 60e6, s: 1e6, ms: 1e3, us: 1}[.[1]]]
    | if . == [] then "none" else add / 1e4 | round end'
}

# The level's problems for the doctor, and its words into LEVEL_SAYS: capacity.json and
# level.jsonl must be well formed (each a FAIL naming its problem), and on Linux, with the user
# manager answering (<manager> 1) and the slice installed, the limits team-level last applied
# (~/.local/state/agent-team/level/applied.json) must be the recorded level's and the slice's CPU
# quota theirs (each a WARN, fixed by team-level apply).
level_problems() {
  local manager=$1 out state applied quota want
  LEVEL_SAYS=''
  if ! out=$(read_settings 2>&1); then
    problem FAIL "${out#"${0##*/}: "}" "fix or remove $(tilde "$SETTINGS"), then run team-doctor again"
    return 0
  fi
  if ! state=$(TEAM_HOME=$TEAM_HOME "$(dirname "${BASH_SOURCE[0]}")/team-level" status --json --stored 2>"$work/err"); then
    out=$(grep -m1 . "$work/err" || echo "team-level status failed")
    out=${out#team-level: }
    # team-level names its fix with its reason, as for a malformed record.
    if [[ $out == *"; fix or remove"* ]]; then
      problem FAIL "${out%%; fix or remove*}" "fix or remove${out#*; fix or remove}"
    else
      problem FAIL "team-level status: $out" "fix what it names, then run team-doctor again"
    fi
    return 0
  fi
  LEVEL_SAYS=$(jq -r .says <<<"$state")
  [[ $os == linux && $manager == 1 && -f $UNITS/$SLICE ]] || return 0
  applied=$(jq -c 'select(type == "object")' "$HOME/.local/state/agent-team/level/applied.json" 2>/dev/null) || applied=''
  if [[ -z $applied ]]; then
    problem WARN "the level's limits were never applied on this machine" "team-level apply"
  elif [[ $(jq -r '"\(.mode) \(.level)"' <<<"$applied") != "$(jq -r '"\(.mode) \(.level)"' <<<"$state")" ]]; then
    problem WARN "the limits applied are $(jq -r '"\(.mode) \(.level)"' <<<"$applied")'s, not the recorded $(jq -r '"\(.mode) \(.level)"' <<<"$state")'s" "team-level apply"
  else
    quota=$(slice_quota)
    want=$(jq -r .cpu_quota_percent <<<"$applied")
    [[ $quota == "$want" ]] ||
      problem WARN "$SLICE's CPU quota is $([[ $quota == none ]] && echo none || echo "$quota%"), not the level's $want%" "team-level apply"
  fi
}

# Whether the newest stored reading is at most <seconds> old.
newest_reading_within() {
  [[ -e $READINGS ]] && jq -Rne -L "$TEAM_LIB" --argjson seconds "$1" 'include "capacity"; include "stack";
    [inputs] | stored_readings | .readings[-1].at // empty | fromdateiso8601 >= now - $seconds' "$READINGS" >/dev/null
}

# capacity.json's values (jq -s) into GIVEN, [] with no file; a malformed one is refused with the
# reason.
read_settings() {
  local problems
  GIVEN='[]'
  [[ -e $SETTINGS ]] || return 0
  GIVEN=$(jq -s . "$SETTINGS" 2>&1) || die "$SETTINGS is not JSON: $(grep . <<<"$GIVEN" | tail -n 1)"
  problems=$(jq -r -L "$TEAM_LIB" 'include "capacity"; include "stack"; capacity_problems' <<<"$GIVEN")
  [[ -z $problems ]] || die "$SETTINGS$problems"
}

# The units' properties systemd reports, {"<unit>": {MemoryCurrent, MemoryPeak, CPUUsageNSec}},
# each a number or null (systemd's "[not set]"), from systemctl show's blocks on stdin.
unit_values() {
  jq -Rn 'reduce inputs as $line ([{}]; if $line == "" then . + [{}] else .[-1] += {($line | sub("=.*$"; "")): ($line | sub("^[^=]*="; ""))} end)
    | map(select(.Id != null and .Id != "")
          | {key: .Id, value: {MemoryCurrent, MemoryPeak, CPUUsageNSec}
              | map_values(if . != null and test("^[0-9]+$") then tonumber else null end)})
    | from_entries'
}

# The heavy-run lock now, as {held, pid, label, task}: whether a run holds it, and from its holder
# line the pid of its team-heavy (null while the lock is free, since the line stays after a run
# ends, or held in another form, such as Conventioner's), its label (the whole line in another
# form) and its task (or null). The lock test and the form are team-heavy's own.
heavy_holder() {
  local fd line='' held=false pid=null label='' task=''
  if [[ -e $HEAVY_LOCK ]]; then
    exec {fd}<"$HEAVY_LOCK"
    flock -n -s "$fd" || held=true
    exec {fd}<&-
  fi
  if [[ $held == true ]]; then
    IFS= read -r line <"$HEAVY_LOCK" || true
    label=$line
    if [[ $line =~ $HEAVY_HOLDER_FORM ]]; then
      label=${BASH_REMATCH[1]} pid=${BASH_REMATCH[2]} task=${BASH_REMATCH[4]}
    fi
  fi
  jq -cn --argjson held "$held" --argjson pid "$pid" --arg label "$label" --arg task "$task" \
    '{held: $held, pid: $pid, label: ($label | select(. != "") // null), task: ($task | select(. != "") // null)}'
}

# The pid of the team-heavy that holds the heavy-run lock, or null (heavy_holder's). Its tree is its
# own cost, never a session's.
heavy_pid() {
  heavy_holder | jq -r '.pid'
}

# The capacity reading's line from take_reading's input (bin/lib/reading.sh), then the cost
# samples of what it ended, as the header's sample says.
capacity_line() {
  local sessions=null units=null prior=null heavy=null out line track
  local -a names=() gates=()
  if out=$(claude agents --json 2>/dev/null | jq -ce 'select(type == "array")
      | [.[] | {id: (.id // (.sessionId // "" | .[:8])), name: (.name // ""), pid}]' 2>/dev/null); then
    sessions=$out
  fi
  mapfile -t gates < <(gate_units)
  heavy=$(heavy_pid)
  jq -c --argjson sessions "$sessions" --slurpfile held "$work/held.json" --arg gate_root "$HOME/.no-mistakes" \
    --argjson heavy "$heavy" \
    '. + {sessions: $sessions, held: $held[0], gate_root: $gate_root, gate_units: $ARGS.positional, heavy: $heavy}' \
    "$work/in.json" --args ${gates[@]+"${gates[@]}"} >"$work/capacity-in.json" || die "could not read the reading's input"
  if [[ $os == linux ]]; then
    out=$(jq -r -L "$TEAM_LIB" 'include "capacity"; include "stack"; capacity_units(.)[]' "$work/capacity-in.json") ||
      die "could not list the units to read"
    mapfile -t names < <(grep . <<<"$out" || true)
    if ((${#names[@]} == 0)); then
      units='{}'
    elif out=$(systemctl --user show -p Id,MemoryCurrent,MemoryPeak,CPUUsageNSec "${names[@]}" 2>/dev/null); then
      units=$(unit_values <<<"$out")
    fi
  fi
  if [[ -e $READINGS ]]; then
    prior=$(jq -Rnc -L "$TEAM_LIB" 'include "capacity"; include "stack"; [inputs] | stored_readings | .readings[-1] // null' "$READINGS") ||
      die "could not read $READINGS"
  fi
  line=$(jq -c -L "$TEAM_LIB" --argjson units "$units" --argjson prior "$prior" \
    'include "capacity"; include "stack"; capacity_reading(. + {units: $units, prior: $prior})' "$work/capacity-in.json") ||
    die "could not make the reading"
  track=$(jq -c -L "$TEAM_LIB" --argjson reading "$line" --slurpfile live <(cat "$STATE/live.json" 2>/dev/null || echo null) \
    'include "capacity"; include "stack"; capacity_track($live[0]; $reading)' -n) ||
    die "could not read $STATE/live.json against the reading"
  jq -c '.live' <<<"$track" >"$STATE/live.json.$$"
  mv -f "$STATE/live.json.$$" "$STATE/live.json"
  jq -c '.costs[]' <<<"$track" >>"$STATE/costs.jsonl"
  printf '%s\n' "$line"
}

sample() {
  read_settings
  reading_context
  take_reading "$STATE" capacity_line
}

# Take a reading first when the newest is over 10 minutes old, as status and admit do; a reading it
# cannot take is said on stderr, and the stored ones serve.
fresh_reading() {
  local err
  newest_reading_within 600 && return 0
  err=$(TEAM_HOME=$TEAM_HOME "${BASH_SOURCE[0]}" sample 2>&1 >/dev/null) ||
    echo "${0##*/}: took no reading of the machine's load: $(grep -m1 . <<<"$err" | sed 's/^team-capacity: //')" >&2
}

# The current mode and level ({mode, level}, level_current's) into $work/level.json, refusing a
# level.jsonl with a line that is no level record, as team-level does.
read_level() {
  { cat "$RECORD" 2>/dev/null || true; } | jq -Rn -L "$TEAM_LIB" --arg path "$RECORD" '
    include "capacity"; include "stack";
    [inputs] | level_records | if .broken != [] then level_broken_text($path; .broken) | halt_error(1) else level_current end' \
    >"$work/level.json" 2>"$work/level.err" || die "$(grep -m1 . "$work/level.err" || echo "could not read $RECORD")"
}

# Every admission still kept (admission_kept) into $work/admitted.json, [] with none; an
# admitted.json that is not a JSON array is read as none.
read_admitted() {
  { jq -c 'select(type == "array")' "$ADMITTED" 2>/dev/null || true; } | jq -s -L "$TEAM_LIB" --slurpfile heavy "$work/heavy.json" '
    include "capacity"; include "stack";
    (.[0] // []) | map(select(type == "object" and (try (.at | fromdateiso8601) catch null) != null
                              and (.kind | type == "string") and (.bytes | type == "number")
                              and admission_kept($heavy[0]; now)))' >"$work/admitted.json" ||
    die "could not read $ADMITTED"
}

# status --json's object into $work/status.json, for the asker of <kind> ("" for none): the
# settings, the newest reading, and what is reserved and the room at the level.
status_json() {
  local machine
  machine=$(machine_name 2>/dev/null) || machine=''
  read_level
  costs_json
  heavy_holder >"$work/heavy.json"
  read_admitted
  { cat "$READINGS" 2>/dev/null || true; } | jq -Rn -L "$TEAM_LIB" --argjson given "$GIVEN" --arg machine "$machine" \
    --slurpfile level "$work/level.json" --slurpfile costs "$work/costs.json" --slurpfile heavy "$work/heavy.json" \
    --slurpfile admitted "$work/admitted.json" --arg asking "$1" '
    include "capacity"; include "stack";
    ([inputs] | stored_readings | .readings[-1] // null) as $r
    | ($given | capacity_settings) as $s
    | capacity_reservations({reading: $r, costs: $costs[0].costs, settings: $s, heavy: $heavy[0],
                             admitted: $admitted[0], now: now, asking: ($asking | select(. != "") // null)}) as $items
    | ([$items[].bytes] | add // 0) as $reserved
    | {schema: "team-capacity/1", machine: ($machine | select(. != "") // null), settings: $s,
       stale: ($r == null or ($r.at | fromdateiso8601) < now - 900), reading: $r,
       reserved: {bytes: $reserved, items: $items}, room: capacity_room($s; $level[0]; $r; $reserved)}' >"$work/status.json"
}

status() {
  read_settings
  ((stored)) || fresh_reading
  status_json ''
  if ((json)); then
    cat "$work/status.json"
  else
    jq -r -L "$TEAM_LIB" 'include "capacity"; include "stack"; capacity_status_text' "$work/status.json"
  fi
}

# The estimates, team-capacity-costs/1, into $work/costs.json.
costs_json() {
  local project roles stack_projects=() file
  roles=$(for file in "$(dirname "$TEAM_LIB")"/../roles/*.md; do
    if [[ -f $file ]]; then basename "$file" .md; fi
  done | { grep -vx coordinator || true; } | jq -Rn '[inputs]')
  while IFS= read -r project; do
    [[ -n $project ]] || continue
    if team_project "$project" | jq -e '.stack != null' >/dev/null; then stack_projects+=("$project"); fi
  done < <(team_project --list)
  { cat "$STATE/costs.jsonl" 2>/dev/null || true; } | jq -Rn -L "$TEAM_LIB" --argjson given "$GIVEN" --argjson roles "$roles" \
    --slurpfile live <(cat "$STATE/live.json" 2>/dev/null || echo null) --args '
    include "capacity"; include "stack";
    {schema: "team-capacity-costs/1",
     costs: capacity_costs({settings: ($given | capacity_settings), roles: $roles, stack_projects: $ARGS.positional,
       limits: ($live[0].limits // {}),
       costs: [inputs | select(test("\\S")) | try fromjson catch null | select(well_formed_cost)]})}' \
    ${stack_projects[@]+"${stack_projects[@]}"} >"$work/costs.json"
}

costs() {
  read_settings
  costs_json
  if ((json)); then
    cat "$work/costs.json"
  else
    jq -r -L "$TEAM_LIB" 'include "capacity"; include "stack"; .costs | costs_text' "$work/costs.json"
  fi
}

# Admit one item of <kind>, as the header's admit says.
admit() {
  local fd estimate
  read_settings
  mkdir -p "$STATE"
  exec {fd}>>"$ADMIT_LOCK"
  flock -w 120 -x "$fd" || die "another admission still holds $(tilde "$ADMIT_LOCK") after 2 minutes"
  fresh_reading {fd}>&-
  status_json "$kind"
  estimate=$(jq -c -L "$TEAM_LIB" --arg kind "$kind" --argjson seed "$seed" --slurpfile costs "$work/costs.json" '
    include "capacity"; include "stack"; kind_estimate($costs[0].costs; .settings; $kind; $seed)' "$work/status.json")
  [[ $(jq -r '.room.budget_bytes' "$work/status.json") != null || $(jq -r '.room.level' "$work/status.json") == none ]] ||
    die "no reading of the machine's load, so no budget to admit $kind by: team-capacity sample says why it takes none"
  jq -c -L "$TEAM_LIB" --arg kind "$kind" --argjson estimate "$estimate" \
    'include "capacity"; include "stack"; capacity_admit(.; $kind; $estimate.bytes)' "$work/status.json" >"$work/admit.json"
  if [[ $(jq -r .admitted "$work/admit.json") != true ]]; then
    jq -r .says "$work/admit.json" >&2
    return 75
  fi
  jq -c --arg kind "$kind" --arg task "$task" --argjson bytes "$(jq .bytes <<<"$estimate")" --slurpfile heavy "$work/heavy.json" '
    . + [{at: (now | floor | todate), kind: $kind, task: ($task | select(. != "") // null), bytes: $bytes,
          pid: (if $kind | startswith("heavy:") then $heavy[0].pid else null end)}]' "$work/admitted.json" >"$ADMITTED.$$"
  mv -f "$ADMITTED.$$" "$ADMITTED"
  jq -r .says "$work/admit.json"
}

case $command in
  install) install ;;
  place) place ;;
  sample) sample ;;
  status | costs | admit | check)
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    "$command"
    ;;
esac
