#!/usr/bin/env bash
# Hand the team off to another machine: run on the machine being left, once its workers have
# stowed (the coordinator's handoff skill sends each live worker T<n> STOW first).
#
# Usage: team-handoff [--check | --json | --retire]
# One line per step; each step is idempotent, so a run interrupted anywhere, run again, finishes
# the handoff. In order:
#   1. lease       This machine holds the lease, confirmed against origin (team-lease check), or
#                  exit 1 (75 when GitHub is unreachable) with nothing changed. --check is this
#                  step alone.
#   2. sessions    claude stop, then claude rm, for every live session named T<n>-<role> (their
#                  worktrees stay on disk), their names kept in handoff.json first: a worker that
#                  has not stowed stops here, so nothing changes its worktree after the checkpoint.
#                  An ops session (T<n>-ops) is never carried over: team-ops-end T<n> ends it,
#                  deleting its transcript and answer file, and one it cannot end refuses the
#                  handoff, naming it. The coordinator's own session is --retire's.
#   3. checkpoint  team-checkpoint --force: task directories archived, wip/<project>/T<n>
#                  snapshots pushed to the team home's origin, the records committed and pushed. Once per handoff: a run again skips it, so
#                  the stowed events land in the handoff's own commit.
#   4. branches    Each open worktree's task branch pushed to its project's origin when it is
#                  strictly ahead of origin's (a plain push). A branch that has diverged from
#                  origin's refuses the handoff, naming the task, before anything is pushed; it is
#                  checked once before step 2 too, so it refuses while its worker still runs.
#   5. stowed      One stowed per open task: this machine, each open worktree's
#                  {project, branch, head} with the head origin has, roles, the task's unfinished
#                  work (each role launched since its last stowed whose latest launch no done,
#                  review, ticket-done or, for a builder, pr ended), which the other machine
#                  relaunches, and sessions, the roles of the task's T<n>-<role> sessions step 2
#                  stopped, for the record; ops never in either. A worktree with uncommitted
#                  changes is said and gets uncommitted: true, so team-open --resume applies the
#                  checkpoint's wip/<project>/T<n> on the other machine (else the changes are
#                  said and noted as staying here); untracked files the snapshot leaves out as
#                  possible secrets are said and noted as staying here. None when the task's
#                  latest machine event (stowed, launch, worktree-moved) is already a stowed from
#                  this machine with the same worktrees.
#   6. config      team-config capture, each captured item listed; a capture that fails or refuses
#                  is said, and the handoff goes on.
#   7. commit      team-tokens export --through-now first, so today's usage is in too (its lines
#                  prefixed "usage: "; a failed export is said, and the handoff goes on); then
#                  machine/, memory/, tasks/, usage/, ledger.jsonl and level.jsonl committed on
#                  the team home's branch as "chore: handoff from <machine>" and pushed (as
#                  team-checkpoint commits).
#   8. heartbeat   team-timers disable.
#   9. release     team-lease release.
#  10. The message: "Released at 14:05 from home-pc. The `team-resume --wait` started on the other
#      machine takes the team now; with none running there, run `team-resume` there.",
#      then "Config captured: CLAUDE.md (new), skills/stow (changed)." naming what step 6 captured,
#      or "Config captured: nothing.", then a line for each thing it did not capture ("Config:
#      settings.json left to Daniel: it has an env key, which may hold a secret.").
#      --json prints {machine, epoch, released_at, message, captured, tasks} instead, captured
#      being the message's config lines, tasks each open task's latest stowed from this machine as
#      {task, worktrees, roles, sessions}, and the step lines go to stderr. A machine whose lease its
#      handoff already released prints the message again.
# --retire, once the message is posted: refuses while this machine holds the lease, then starts a
# detached process (its own session) that, a few seconds after the call returns, runs claude stop
# and claude rm for each live session named coordinator, logging to retire.log.
# In ~/.local/state/agent-team/: handoff.json, this handoff's progress (the lease's epoch and
# taken_at, the last step done, the worker sessions step 2 stopped and what step 6 captured);
# handoff.lock, one handoff at a time; retire.log.
# TEAM_HANDOFF_STOP_AFTER=<n> (the tests' seam) exits 1 right after step n, as an interruption.
# Exit 0 done, 1 refused or a step failed, 2 usage error, 75 GitHub unreachable or another
# handoff running.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

# Seconds: the most one call to an origin may take, and the coordinator's retirement delay.
NET_TIMEOUT=60
RETIRE_SECONDS=3
# What the handoff's team-home commit holds.
RECORDS=(ledger.jsonl level.jsonl tasks memory machine usage)

usage="usage: team-handoff [--check | --json | --retire]"
mode=run
if (($# > 1)); then usage_error "$usage"; fi
case ${1:-} in
  '') ;;
  --check) mode=check ;;
  --json) mode=json ;;
  --retire) mode=retire ;;
  *) usage_error "$usage" ;;
esac

machine=$(machine_name) || exit 1
bin=$(dirname "$TEAM_LIB")
state=$HOME/.local/state/agent-team
progress=$state/handoff.json
record=$state/lease.json
mkdir -p "$state"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
NET_ERR=$scratch/net-err
err=$scratch/err

# The first line of a sibling's stderr, without its "<script>: " prefix.
first_error() {
  grep -m1 . "$err" | sed -E 's/^team-[a-z-]+: //' || true
}

# Each line of stdin as "<step>: <line>": prefixed <step>
prefixed() {
  local line
  while IFS= read -r line; do printf '%s: %s\n' "$1" "$line"; done
}

# The live session list, claude agents --json.
read_sessions() {
  claude agents --json 2>"$err" | jq -ce 'select(type == "array")' 2>/dev/null ||
    die "cannot read the live session list (claude agents --json)"
}

# shellcheck source=bin/lib/stow.sh
source "$TEAM_LIB/stow.sh"
STOW_UNDONE='; nothing was pushed or released'
STOW_ELSEWHERE=' on the other machine'

# The task branches of every open task (stow_branches), with nothing printed but a refusal when
# <quiet> is 1; a branch that is neither here nor on origin, or has diverged from origin's,
# refuses the handoff before anything is pushed. check_branches [quiet]
check_branches() {
  stow_branches "${1:-0}"
  if ((${#STOW_PROBLEMS[@]})); then
    {
      echo "team-handoff: the handoff stops here, before anything is pushed or released:"
      printf '  %s\n' "${STOW_PROBLEMS[@]}"
      echo "  (bring each branch level with origin, then run team-handoff again)"
    } >&2
    exit 1
  fi
}

if [[ $mode == retire ]]; then
  if jq -e --arg machine "$machine" '.holder == $machine and .state == "held"' "$record" >/dev/null 2>&1; then
    die "$machine still holds the lease; run team-handoff first"
  fi
  sessions=$(read_sessions)
  mapfile -t ids < <(jq -r '.[] | select(.name == "coordinator") | .id // ((.sessionId // "")[:8])' <<<"$sessions")
  ((${#ids[@]})) || die "no live session is named coordinator"
  # The detached process: its own session, so stopping the coordinator's process tree spares it,
# and no descriptor of the caller's but the log, so nothing waits on it.
  # shellcheck disable=SC2016 # the script runs in the detached bash
  python3 -c 'import os, sys
if os.fork() == 0:
    os.setsid()
    os.closerange(3, 1024)
    os.execvp(sys.argv[1], sys.argv[1:])' bash -c '
    sleep "$1"
    shift
    for id; do
      echo "$(date -u +%FT%TZ) retiring $id"
      claude stop "$id" || echo "$(date -u +%FT%TZ) claude stop $id failed"
      claude rm "$id" || echo "$(date -u +%FT%TZ) claude rm $id failed"
    done' team-handoff-retire "$RETIRE_SECONDS" "${ids[@]}" </dev/null >>"$state/retire.log" 2>&1 ||
    die "cannot start the process that retires the coordinator"
  echo "the coordinator (${ids[*]}) is stopped and removed in ${RETIRE_SECONDS}s; see ~/.local/state/agent-team/retire.log"
  exit 0
fi

exec {lock_fd}>>"$state/handoff.lock"
if ! flock -n "$lock_fd"; then
  echo "team-handoff: another handoff is running" >&2
  exit 75
fi

# With --json, the step lines go to stderr and the JSON to the real stdout.
if [[ $mode == json ]]; then exec {json_fd}>&1 1>&2; fi

# A sibling command of this checkout, with TEAM_HOME passed and the lock closed for it.
team() {
  TEAM_HOME=$TEAM_HOME "$bin/$1" "${@:2}" {lock_fd}>&-
}

# Write this handoff's progress: the last step done, the worker sessions step 2 stopped and what
# step 6 captured.
save_progress() {
  jq -n --argjson epoch "$epoch" --arg taken "$taken_at" --argjson n "$done_before" \
    --argjson workers "$workers" --argjson config "$config" \
    '{epoch: $epoch, taken_at: $taken, done: $n, workers: $workers, config: $config}' >"$progress.$$"
  mv -f "$progress.$$" "$progress"
}

# Record step <n> as done in this handoff, and stop there when the test seam says so.
step_done() {
  ((done_before >= $1)) || done_before=$1
  save_progress
  if [[ ${TEAM_HANDOFF_STOP_AFTER:-} == "$1" ]]; then
    echo "team-handoff: stopped after step $1 (TEAM_HANDOFF_STOP_AFTER)" >&2
    exit 1
  fi
}

# 1. The lease: held here, or released by this very handoff.
held_rc=0
team team-lease check >/dev/null 2>"$err" || held_rc=$?
if ((held_rc == 75)); then
  echo "team-handoff: GitHub unreachable; no handoff while offline ($(first_error))" >&2
  exit 75
fi
held_why=$(first_error)
rc=0
lease=$(team team-lease status --json 2>"$err") || rc=$?
if ((rc == 75)); then
  echo "team-handoff: GitHub unreachable; no handoff while offline ($(first_error))" >&2
  exit 75
elif ((rc)); then
  die "cannot read the lease: $(first_error)"
fi
epoch=$(jq -r .epoch <<<"$lease") taken_at=$(jq -r '.taken_at // ""' <<<"$lease")
saved=$(jq -c --argjson epoch "$epoch" --arg taken "$taken_at" \
  'select(.epoch == $epoch and .taken_at == $taken)' "$progress" 2>/dev/null) || saved=''
[[ -n $saved ]] || saved='{}'
done_before=$(jq -r '.done' <<<"$saved")
[[ $done_before =~ ^[0-9]+$ ]] || done_before=0
workers=$(jq -c '.workers | arrays' <<<"$saved")
[[ -n $workers ]] || workers='[]'
config=$(jq -c '.config | objects' <<<"$saved")
[[ -n $config ]] || config=null
finished=''
if ((held_rc)); then
  if jq -e --arg machine "$machine" '.state == "released" and .holder == $machine' <<<"$lease" >/dev/null &&
    ((done_before >= 8)); then
    finished=1
    echo "lease: released by this handoff already, epoch $epoch"
  else
    die "${held_why:-this machine does not hold the lease}; nothing changed"
  fi
else
  echo "lease: $machine holds the lease, epoch $epoch"
fi
[[ $mode != check ]] || exit 0

if [[ -z $finished ]]; then
  step_done 1

  # Each open task and its open worktrees, in task number order (STOW_OPEN).
  # shellcheck disable=SC2119 # every open task
  stow_open
  # Before any worker stops: a branch that refuses the handoff is still its builder's to fix.
  ((done_before >= 2)) || check_branches 1

  # 2. The workers' sessions: their names kept, then stopped and removed, so nothing changes a
  # worktree after the checkpoint.
  if ((done_before >= 2)); then
    echo "sessions: stopped earlier in this handoff"
  else
    # shellcheck disable=SC2119 # every task's sessions
    stow_live
    # An ops session holds production query results: ended, never stowed.
    stow_end_ops
    for reason in "${STOW_REFUSED[@]}"; do
      die "sessions: $reason; end it, then run team-handoff again; nothing was released"
    done
    workers=$(jq -c --argjson live "$STOW_LIVE" '. + [$live[].name] | unique' <<<"$workers")
    save_progress
    stow_stop
    [[ $STOW_LIVE != '[]' ]] || ((STOW_ENDED)) || echo "sessions: no worker session was live"
    ((${#STOW_REFUSED[@]} == 0)) || die "sessions: $(printf '%s; ' "${STOW_REFUSED[@]}" | sed 's/; $//'); nothing was released"
  fi
  step_done 2

  # 3. The checkpoint, once per handoff.
  if ((done_before >= 3)); then
    echo "checkpoint: made earlier in this handoff"
  else
    rc=0
    out=$(team team-checkpoint --force 2>"$err") || rc=$?
    [[ -z $out ]] || prefixed checkpoint <<<"$out"
    ((rc)) || cat "$err" >&2
    if ((rc == 75)); then
      echo "team-handoff: checkpoint: $(first_error)" >&2
      exit 75
    elif ((rc)); then
      die "checkpoint: $(first_error); fix it and run team-handoff again"
    fi
  fi
  step_done 3

  # 4. The task branches: checked again, then pushed.
  check_branches
  stow_push
  for task in "${!STOW_REFUSED[@]}"; do
    die "$task: ${STOW_REFUSED[$task]}; nothing was released"
  done
  step_done 4

  # 5. One stowed per open task.
  for entry in "${STOW_OPEN[@]}"; do
    stow_record "$(jq -r .task <<<"$entry")" "$workers"
  done
  step_done 5

  # 6. This machine's Claude config, captured for the team, and what was captured kept for the
  # message.
  if ((done_before >= 6)); then
    echo "config: captured earlier in this handoff"
  else
    rc=0
    out=$(team team-config capture 2>"$err") || rc=$?
    [[ -z $out ]] || prefixed config <<<"$out"
    refused=$(grep . "$err" | sed -E 's/^team-config: //') || refused=''
    if ((rc)); then
      echo "team-handoff: config: team-config capture did not capture everything; the handoff goes on" >&2
      [[ -z $refused ]] || prefixed "team-handoff: config" <<<"$refused" >&2
    fi
    config=$(jq -nc --arg out "$out" --arg refused "$refused" \
      '{captured: [$out | splits("\n") | select(startswith("captured ")) | ltrimstr("captured ")],
        refused: [$refused | splits("\n") | select(. != "")]}')
  fi
  step_done 6

  # 7. The records, in the handoff's own commit, with this machine's usage to now.
  rc=0
  out=$(team team-tokens export --through-now 2>"$err") || rc=$?
  [[ -z $out ]] || prefixed usage <<<"$out"
  ((rc == 0)) || echo "team-handoff: usage: $(first_error); the handoff goes on" >&2
  commit_records "chore: handoff from $machine" "${RECORDS[@]}" || die "commit: the records are not on origin; nothing was released"
  step_done 7

  # 8. The heartbeat.
  out=$(team team-timers disable 2>"$err") || die "heartbeat: $(first_error); nothing was released"
  echo "heartbeat: $out"
  step_done 8

  # 9. The lease.
  rc=0
  out=$(team team-lease release 2>"$err") || rc=$?
  if ((rc == 75)); then
    echo "team-handoff: release: GitHub unreachable ($(first_error)); run team-handoff again" >&2
    exit 75
  fi
  ((rc == 0)) || die "release: $(first_error)"
  echo "lease: $out"
  step_done 9
fi

# 10. The message.
released_at=$(jq -r '.written_at // empty' "$record" 2>/dev/null) || released_at=''
[[ -n $released_at ]] || released_at=$(date -u +%FT%TZ)
message="Released at $(date -d "$released_at" +%H:%M) from $machine. The \`team-resume --wait\` started on the other machine takes the team now; with none running there, run \`team-resume\` there."
# What step 6 captured and what it refused, as the message's config lines.
captured=$(jq -c '[if . == null then "Config captured: unknown (no record of this handoff'"'"'s capture)."
  else "Config captured: \(.captured | if . == [] then "nothing" else join(", ") end).",
    (.refused[] | "Config: \(.).") end]' <<<"$config")
if [[ $mode == json ]]; then
  ledger_jq 'ledger_events | by_task | . as $tasks | [open_tasks[] | . as $task
      | $tasks[$task] | map(select(.event == "stowed" and .machine == $machine)) | last
      | select(. != null) | {task: $task, worktrees, roles, sessions}]
    | {machine: $machine, epoch: $epoch, released_at: $released, message: $message, captured: $captured,
      tasks: .}' \
    -nR --arg machine "$machine" --argjson epoch "$epoch" --arg released "$released_at" --arg message "$message" \
    --argjson captured "$captured" "$TEAM_HOME/ledger.jsonl" >&"$json_fd"
else
  echo "$message"
  jq -r '.[]' <<<"$captured"
fi
