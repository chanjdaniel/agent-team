    },
    {
      "id": "docker-prune",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "docker system prune --help",
      "expect": "rule",
      "family": "docker-prune"
    },
    {
      "id": "one-password",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "op --version",
      "expect": "rule",
      "family": "one-password"
    },
    {
      "id": "sudo",
      "roles": ["planner", "builder", "reviewer"],
