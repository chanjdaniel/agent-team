      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "gh pr merge --help",
      "expect": "rule",
      "family": "merge"
    },
    {
      "id": "refs-api",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "gh api --method GET repos/octocat/Hello-World/git/refs/heads/master",
      "expect": "rule",
