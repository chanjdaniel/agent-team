      "expect": "hook",
      "marker": "this role may edit files only under"
    },
    {
      "id": "redirect-outside",
      "roles": ["planner", "reviewer"],
      "tool": "Bash",
      "input": "echo probe > outside-bash.txt",
      "expect": "hook",
      "marker": "this role may write files only under"
    },
    {
      "id": "ops-launch",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "bin/team-worker --help ops",
      "expect": "hook",
      "marker": "Blocked by command-guard"
    },
    {
