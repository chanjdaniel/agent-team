      "input": "sudo --version",
      "expect": "rule",
      "family": "sudo"
    },
    {
      "id": "vercel",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "vercel --version",
      "expect": "rule",
      "family": "vercel"
    },
    {
      "id": "production",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "echo mongodb+srv://probe.invalid",
      "expect": "rule",
      "family": "production"
    },
    {
      "id": "force-push",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "git push --force --dry-run .scratch/probe.git HEAD:refs/heads/probe",
      "expect": "rule",
      "family": "push"
    },
    {
      "id": "protected-push",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "git push origin HEAD:dev --dry-run",
      "expect": "rule",
      "family": "push"
    },
    {
      "id": "lease-push",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "git push .scratch/probe.git HEAD:lease --dry-run",
      "expect": "rule",
      "family": "push"
    },
    {
      "id": "steal",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "team-lease --help --steal",
      "expect": "rule",
      "family": "steal"
    },
    {
      "id": "no-mistakes",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "git push --dry-run .scratch/probe.git --delete no-mistakes",
      "expect": "rule",
      "family": "no-mistakes"
    },
    {
      "id": "skip-hooks",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "git commit -n --allow-empty -m probe",
      "expect": "rule",
      "family": "skip-hooks"
    },
    {
      "id": "hard-reset",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "git reset --hard HEAD",
      "expect": "rule",
      "family": "reset"
    },
    {
      "id": "gate-lane",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "team-clean-messages --help --clear-gate-lane",
      "expect": "rule",
      "family": "gate-lane"
    },
    {
      "id": "daniels-channel",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "team-ask --help",
      "expect": "rule",
      "family": "daniels-channel"
    },
    {
      "id": "mcp-launcher",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "./probe-start-server.mjs",
      "expect": "rule",
      "family": "mcp-launchers"
    },
    {
      "id": "proc",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Read",
      "input": "/proc/self/status",
      "expect": "rule",
      "family": "proc"
    },
    {
      "id": "channels",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Read",
      "input": "@HOME@/.claude/channels/load-check-probe-absent",
      "expect": "rule",
      "family": "channels"
    },
    {
      "id": "devtools-port",
      "roles": ["planner", "builder", "reviewer"],
      "tool": "Bash",
      "input": "curl -sS --max-time 5 -o /dev/null http://127.0.0.1:9222/json/version",
      "expect": "rule",
      "family": "devtools-port"
    },
    {
      "id": "post-coordinator",
      "roles": ["planner"],
      "tool": "Bash",
      "input": "team-post --coordinator --help",
      "expect": "rule",
      "family": "posts"
    },
    {
      "id": "post",
      "roles": ["builder", "reviewer"],
      "tool": "Bash",
      "input": "team-post --help",
      "expect": "rule",
      "family": "posts"
    },
    {
      "id": "thread-wait",
      "roles": ["builder", "reviewer"],
      "tool": "Bash",
      "input": "team-thread wait --help",
      "expect": "rule",
      "family": "posts"
    },
    {
      "id": "undo-ready",
      "roles": ["builder"],
      "tool": "Bash",
      "input": "gh pr ready 1 --undo --help",
      "expect": "rule",
      "family": "undo-ready"
    }
  ],
  "families": [
    {
      "family": "channels",
      "rules": "^(Read|Bash)\\(.*\\.claude/channels"
    },
    {
      "family": "daniels-channel",
      "rules": "team-(ask|answer|inbox|run-approved)|team-thread T"
    },
    {
      "family": "denied-tools",
      "rules": "^[A-Za-z][A-Za-z0-9_]*$",
      "unprobed": "a denied tool is not offered to the session, so it has no call to make"
    },
    {
      "family": "devtools-port",
      "rules": "9222|CHROME_DEVTOOLS_AXI_BROWSER_URL"
    },
    {
      "family": "docker-prune",
      "rules": "^Bash\\((\\*/)?docker .*prune\\*\\)$"
    },
    {
      "family": "edit-paths",
      "rules": "^Edit\\(",
      "unprobed": "an allowed write would land in Daniel's own directories"
    },
    {
      "family": "gate-lane",
      "rules": "--clear-gate-lane"
    },
    {
      "family": "hooks-path",
      "rules": "^Bash\\((git (-C \\* )?(config|-c) |\\*GIT_CONFIG_)",
      "unprobed": "every form the rules match and git accepts writes the code checkout's shared config, so no stand-in is harmless"
    },
    {
      "family": "mcp-launchers",
      "rules": "start-server\\.mjs|mongodb-mcp|vercel-mcp|--plugin-dir|--mcp-config"
    },
    {
      "family": "merge",
      "rules": "^Bash\\((gh|gh-axi) (pr merge|api\\*pulls/)"
    },
    {
      "family": "no-mistakes",
      "rules": "^Bash\\(.*no-mistakes"
    },
    {
      "family": "one-password",
      "rules": "^Bash\\((\\*&& |\\*\\|\\| |\\*\\| |\\*\\$\\(|\\*/bin/|env |command |exec )?op( \\*)?\\)$"
    },
    {
      "family": "posts",
      "rules": "team-(post|thread wait)"
    },
    {
      "family": "proc",
      "rules": "/proc/"
    },
    {
      "family": "production",
      "rules": "mongodb\\+srv://|migrate_user_emails"
    },
    {
      "family": "push",
      "rules": "^Bash\\(git (-C \\* )?push "
    },
    {
      "family": "refs-api",
      "rules": "^Bash\\(gh api\\*.*git/refs"
    },
    {
      "family": "reset",
      "rules": "^Bash\\(git (reset|clean|branch -D)"
    },
    {
      "family": "sessions",
      "rules": "^Bash\\((\\*/)?claude "
    },
    {
      "family": "skip-hooks",
      "rules": "^Bash\\(git (\\* --no-verify|commit )"
    },
    {
      "family": "steal",
      "rules": "^Bash\\(\\*team-(lease|resume)\\*--steal\\*\\)$"
    },
    {
      "family": "sudo",
      "rules": "^Bash\\(sudo( \\*)?\\)$"
    },
    {
      "family": "undo-ready",
      "rules": "--undo"
    },
    {
      "family": "vercel",
      "rules": "^Bash\\(vercel\\*\\)$"
    }
  ],
  "hooks": [
    {
      "hook": "command-guard"
    },
    {
      "hook": "lease-fence",
      "unprobed": "it blocks only on a fenced or offline machine; the steal drill is its live proof"
    },
    {
      "hook": "scratch-only-edits"
    }
  ]
}
