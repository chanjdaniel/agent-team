ci (.*/)?\.circleci/.*
ci (.*/)?\.gitlab-ci\.ya?ml
ci (.*/)?\.no-mistakes\.ya?ml
ci (.*/)?\.pre-commit-config\.ya?ml
ci (.*/)?\.githooks/.*
ci (.*/)?release-please-config\.json
ci (.*/)?\.release-please-manifest\.json
ci (.*/)?scripts/.*
ci (.*/)?\.husky/.*
ci (.*/)?lefthook(-local)?\.ya?ml
ci (.*/)?(makefile|justfile)
ci (.*/)?real_data_[^/]*
ci (.*/)?((eslint|stylelint|prettier|vite|vitest|jest|playwright|cypress|webpack|rollup)\.config\.[^/]*|\.eslintrc[^/]*|tsconfig[^/]*\.json|pytest\.ini|tox\.ini|conftest\.py|\.gitattributes)
