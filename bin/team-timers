#!/usr/bin/env bash
# Run the heartbeat on the lease holder: one job every 5 minutes running `team-timers run`.
#
# The job is generated from one definition here, written under the user's own unit directories,
# and runs this checkout's bin/team-timers run with the TEAM_HOME and PATH enable ran with:
#   Linux  systemd user units ~/.config/systemd/user/agent-team-heartbeat.{service,timer}, the
#          timer at OnCalendar=*:0/5 with Persistent=true, so a run missed in sleep or power-off
#          happens on wake or boot.
#   macOS  LaunchAgents in ~/Library/LaunchAgents: agent-team.heartbeat, at minutes 0, 5, ..., 55
#          of every hour (StartCalendarInterval, which launchd runs on wake when missed in sleep),
#          with TEAM_HEARTBEAT_JOB=agent-team.heartbeat beside TEAM_HOME and PATH, which marks a
#          process as running inside the job, and agent-team.caffeinate, `caffeinate -i` kept
#          alive, so this Mac does not idle-sleep while the heartbeat is enabled. A launchctl
#          bootout of a job stops its running process (systemd's disable --now of the timer leaves
#          a running service alone), so nothing boots the heartbeat job out while a run is in
#          progress: disable, enable and run below say how.
#
# Usage: team-timers enable | disable | status [--json] | health [--json] | run | watch [--once]
#   enable   Installs the job and starts it (and caffeinate on macOS). A job already installed
#            as defined and running is left alone; one that differs is rewritten and reloaded.
#            On macOS a loaded heartbeat job that must be reloaded (its plist changed, or missing
#            while it is loaded) waits first for the run's lock (heartbeat.lock) for up to 60 s,
#            then is booted out and bootstrapped while the lock is held; past the wait it is
#            reloaded anyway, saying "team-timers: a heartbeat run still held its lock after 60 s,
#            so the job was reloaded under it" on stderr. Only on the machine that holds the
#            lease, and only with Daniel's yes.
#   disable  Stops and removes the job (and caffeinate). Nothing installed is fine. On macOS, in
#            this order: both plists are removed, so nothing loads them at the next login;
#            caffeinate is booted out; and the heartbeat job, when loaded, is booted out at once
#            while disable holds the run's lock, taken without waiting, or left loaded when a run
#            holds the lock or disable runs inside the job (the fence of a heartbeat run), that
#            run unloading it as its last act. It says "the heartbeat is disabled:
#            agent-team.heartbeat, agent-team.caffeinate stopped and removed", or, with the job
#            left loaded, "the heartbeat is disabled: agent-team.caffeinate stopped and both
#            removed; agent-team.heartbeat unloads itself when its run in progress ends".
#   status   installed, enabled (every job of this OS loaded and running), current (whether the
#            installed job is what enable would write from this checkout, the PATH it was enabled
#            with aside; null when nothing is installed), the last run, the time of the heartbeat
#            log's last line, the last good run, the start of the last run that ended 0 as holder
#            (from the health record), and health, the plain health line (null off the lease);
#            --json prints them as one object (last_run, last_good_run, health), and the text
#            form's installed line says when the job is installed but not as this checkout
#            defines it.
#   health   The health view, from the health record, the lease record and the fence file (never
#            the network or a service manager), read-only: one line per problem, or the plain
#            healthy line, exit 0 healthy and 1 with any problem. --json prints team-health/1:
#            {schema, machine, holding, ok, line (Discord's markup), text (plain, UTC times and
#            ages in minutes), problems, each {key, since, text, alerting, sweep}}. A machine
#            that does not hold the lease (its lease record names another, or none, or it is
#            fenced) has holding false, no problems and a null line (exit 0); on the holder, no
#            record or one that cannot be read is "**Health**: unknown - <why>" (exit 1). The
#            problems, in order (bin/lib/health.jq defines each rule and threshold once):
#              heartbeat  the later of the last run's start and the lease record's write is over
#                     15 minutes old ("a heartbeat run started <t> has not ended" while the
#                     record's last run, one begun since the lease's taken_at, has no end, else
#                     "the heartbeat last ran <t>"); alerting; sweep checkpoint-stale.
#              offline, login-refused  the heartbeat's own flags; login-refused alerting, sweep
#                     health; offline neither, since the coordinator's offline watch tells it.
#              checkpoint  the checkpoint step failing, or the last good checkpoint over 15
#                     minutes old, with the reason (an earlier step's failing one, or "the
#                     checkpoint step did not run"); alerting after 2 runs in a row or once
#                     stale; sweep checkpoint-stale; not raised beside the three above, nor
#                     while the record was written before this holding began (the lease
#                     record's taken_at: a take or a steal whose first run is not due yet; a
#                     renewal keeps it).
#              coordinator  no session named coordinator, as the coordinator step last saw the
#                     session list ("no coordinator session since <t>"); alerting on the second
#                     run in a row; no sweep kind, since it is about the coordinator itself; not
#                     raised while the record was written before this holding began.
#              unattended  sweep findings the coordinator step has seen at every look for 60
#                     minutes, with no ledger event but a denied logged since it first saw each
#                     ("the coordinator has left <n> findings unattended since <t>"); alerting by
#                     definition; no sweep kind; not raised beside the coordinator or heartbeat
#                     problem, when the last run made no look, nor while the record was written
#                     before this holding began.
#              ledger  lines of ledger.jsonl no reader can parse, with their count and line
#                     numbers; alerting; sweep health.
#              step-<name>  any other step failing (the usage export as step-usage, a session
#                     list the coordinator step cannot read as step-coordinator), alerting after 12
#                     runs in a row; sweep health.
#            Each reason in the line is cut at 150 characters and the line at 500.
#   run      What the job runs, each step one line in the heartbeat log (and on stdout):
#              fence  On a fenced machine, team-timers disable, and nothing else.
#              probe  git ls-remote of origin's lease branch, at most 20 s. A network failure
#                     (name resolution, connect, timeout, TLS, HTTP 5xx) is tried again once
#                     after 60 s; a second one is offline. GitHub refusing the login (HTTP 401
#                     or 403, a credential it cannot ask for, an ssh key it denies, a repository
#                     it will not show) is not offline: it is logged, posted once to
#                     #coordinator ("GitHub refuses home-pc's login ...") and the run exits 1.
#                     Offline on the machine whose record says it holds the lease: the offline
#                     flag is written with the first failure's time, and one post is tried
#                     ("GitHub unreachable since 13:05 on home-pc; holding the team"); while the
#                     flag stays, a run only logs, and the lease is not touched (exit 75).
#              back   The first probe that answers while the flag exists: team-lease renew at
#                     once; renewed, the flag goes and #coordinator is told "GitHub back at
#                     13:40 (unreachable from 13:05); resuming T5, T8" (the tasks with a live
#                     worker, from claude agents --json, 30 s and killed 10 s later, or "the live
#                     session list could not be read"), after the outage post when that one
#                     failed; a machine another took the lease from meanwhile is fenced by the
#                     renew instead, and posts nothing.
#              lease  team-lease status; on the holder, team-lease renew once the last renewal is
#                     15 minutes old (less a minute for the timer's slack); on a machine that lost
#                     the lease, team-lease renew at once, which fences it (stops its team
#                     sessions and disables this heartbeat); otherwise nothing.
#              checkpoint  On the holder, right after the lease or back step, so no slower step
#                     widens the window of records not yet on origin: team-checkpoint, which
#                     makes one once the last is 5 minutes old (less the same minute), so each run
#                     makes one. Each of its stderr lines, problems only, is logged: a warning as
#                     "checkpoint: warning: <part>: <reason>", any other line as "checkpoint:
#                     failed: <line>", at most 20 and a count of the rest. It is stopped after
#                     300 s with the commands it runs, killed 10 s later ("checkpoint: failed:
#                     timed out after 300 s"; a git call of its own with its own 60 s limit ends by
#                     that; given --deadline 120, it begins no worktree past 120 s, so its records
#                     commit begins inside the limit), and a checkpoint that fails, times out or
#                     exits 75 (GitHub unreachable, or another checkpoint still running) is a
#                     failed step.
#              ledger  On the holder, after the checkpoint step: one pass over ledger.jsonl that
#                     counts its lines that are not JSON objects, by line number, and reads the
#                     time of its last event that is not a denied, for the health record; a line
#                     no reader can parse fails the step ("ledger: failed: 2 lines are not JSON
#                     objects: line 3, 7").
#              coordinator  On the holder, after the ledger step: one read of the live session list
#                     (claude agents --json, 30 s and killed 10 s later) for a session named
#                     coordinator, the test claude-coordinator makes before it launches one, so a
#                     worker whose name merely holds the word is none. It logs nothing while one is
#                     live, and each run with none "coordinator: no session named coordinator is
#                     live; claude-coordinator starts one", the health record keeping since when. A
#                     list that cannot be read is the step failing ("coordinator: failed: cannot
#                     read the live session list (claude agents --json): <why>"), which concludes
#                     nothing about the coordinator, so an open coordinator alert stays open and one
#                     failing 12 runs in a row is its own alert. With the list read, one team-sweep
#                     --json (60 s, killed 10 s later): each finding, keyed by its task, kind and
#                     session as the sweep watch keys it, is kept in the health record with the time
#                     of the first look that saw it and dropped once a look does not hold it, so one
#                     that clears and comes back is dated from its return; one seen at every look
#                     for 60 minutes with nothing but denied events logged since is the unattended
#                     problem. A sweep that cannot run (no JSON list on stdout, or timed out) is the
#                     step failing ("coordinator: failed: cannot run the sweep (team-sweep --json):
#                     <its last line on stderr>"), the findings kept but no longer aged: after a
#                     run with no look, or a run that starts over 15 minutes after the last one
#                     ended (the machine slept), the next look dates every finding again. It
#                     fails no run, and the
#                     heartbeat never starts or restarts a coordinator, however long one is missing
#                     or leaves its findings: that launches a session in bypass mode, which is
#                     Daniel's to decide. The health record is written next.
#              alert  On the holder, after that write of the record, so before the inbox step and
#                     the janitor's, and again at the run's end (a run its time limit stopped
#                     included), never on a run that went offline, was refused its login, is
#                     fenced or does not hold the lease, nor while the view's heartbeat problem
#                     stands (a run that has outlasted its 15 minutes), so an open alert waits
#                     for the next holder run: each alerting problem of the health view that has
#                     an alert (bin/lib/health.jq's health_alert_plan) is posted once to
#                     #coordinator, mentioning no one whatever its text holds, and the message is
#                     kept in the health record; nothing more is posted while it stands,
#                     whatever its reason becomes. A post Discord refuses is logged and tried
#                     again at the next judging, with that run's text. Once the problem ends, the
#                     message is edited to end with a line "-# Resolved at <HH:MM>." (Discord
#                     tells no one of an edit) and the alert is closed, an edit that fails (the
#                     message is gone) closing it all the same; a later incident posts a new
#                     message. Each post, failed post and edit is a log line ("alert:
#                     checkpoint: posted to #coordinator (message <id>)"), a failed one a problem
#                     line too, and none fails the run. The heartbeat, offline and login-refused
#                     problems post none here (the probe posts the last two). The alerts, each
#                     text cut to 1978 characters, so with its resolved line it fits Discord's
#                     2000:
#                       checkpoint  failing 2 runs in a row, or the last good checkpoint over 15
#                         minutes old: "Checkpoints are failing on <machine> since <HH:MM> (<n>
#                         runs): <first failure line>[, and <n> more]. Work since the last good
#                         one (<HH:MM>) is on this machine only."; with no failure, "No good
#                         checkpoint on <machine> since <HH:MM> (<n> minutes): <why>."
#                       coordinator  no coordinator session on the second run in a row: "No
#                         coordinator session is live on <machine> since <HH:MM>: workers' reports
#                         and your messages go unread until one runs. Start it with
#                         claude-coordinator."
#                       unattended  a sweep finding seen at every look for 60 minutes with
#                         nothing logged since: "The coordinator on <machine> has left <n>
#                         finding(s) unattended for over an hour, with nothing logged since <HH:MM>
#                         (the ledger's last event but a denied, or the first look's time with
#                         none): <the first finding's text>[; and <n> more]. It may be stalled: look
#                         at its session, and restart it with claude-coordinator if it is."
#                       ledger  a line no reader can parse, at once: "ledger.jsonl on <machine>
#                         holds <n> lines no reader can parse (line <n>, <n>), so every reader
#                         skips them: team-log --check names them."
#                       step-<name>  any other step failing 12 runs in a row: "The heartbeat's
#                         <name> step has failed <n> runs in a row on <machine>, since <HH:MM>:
#                         <reason>."
#              inbox  On the holder, after the alert step: team-inbox, which writes the team
#                     home's waiting.md, so what waits on Daniel is there within five minutes
#                     whatever changed it. It logs only the one edit that retires the message
#                     team-inbox kept in #coordinator before waiting.md ("retired <link>"), a
#                     waiting.json it could not read and numbered afresh ("numbers the list afresh,
#                     since waiting.json cannot be read: <why>"), and a failure, and a failure
#                     never fails the run.
#              finished  On the holder, after the inbox step, every run, whatever the level and
#                     budget: claude stop (30 s, killed 10 s later) of each finished session of
#                     every open task, the idle live session of a launch whose work is handed on
#                     (plan_tasks' finished in bin/lib/ledger.jq, the predicate team-worker and the
#                     level step's stow plan share), so a finished session stops holding memory
#                     within a run of its done. It leaves a busy session, one waiting for input, one
#                     whose status is not idle, an ops session, a builder with no later builder
#                     launch on its worktree (one whose pr is out included, since a review round may
#                     go back to it), a planner of a task with no plan-approved (a refusal of its
#                     tickets goes back to it), and every session of a task with no handing-on
#                     event. It logs each stop ("stopped T9-reviewer 33333333: its work is handed
#                     on"); a stop that fails, a session list that cannot be read (claude agents
#                     --json, 30 s and killed 10 s later) and the sessions left once no stop may
#                     start (90 s into the step) are each a warning line, and none fails the run.
#              capacity  On the holder, after the finished step, every run: team-capacity sample,
#                     which takes one reading of the machine's load with the team's use per task
#                     and writes the cost samples of what ended, then team-capacity place
#                     --quiet, which puts each live team session in its task's slice again (one
#                     the claude daemon restarted, say) and logs only those it placed.
#              level  On the holder, after the capacity step, every run: team-level tick, which in
#                     automatic mode picks the level from the readings, records and posts each
#                     change (logged as its post's line), and in either mode applies the level's
#                     limits again and, once the team is over its budget, stops its finished
#                     sessions and idle stacks; it logs only a change, a stale reading and each
#                     stop.
#              stacks On the holder, after the level step, when heartbeat_sweep is true in
#                     ~/.config/agent-team/stack.json (team-stack's settings, off by default):
#                     team-stack sweep, which stops the team's idle stacks.
#              pack   On the holder, after the stacks step, once the team home has PACK_LOOSE (200,
#                     bin/lib/team.sh) loose objects: git gc in it, then one line, "packed 213
#                     loose objects; 0 left loose, 38.40 MiB in packs". So the team home stays
#                     packed wherever the lease goes, with no scheduler entry of git's own.
#              janitor  On the holder, after the pack step, when heartbeat_janitor is true there
#                     and no janitor report of today's local date is there yet
#                     (~/.local/state/agent-team/janitor/<date>.md; a dry run's is none):
#                     team-janitor, the daily Docker reap, report and alerts. A run of it that
#                     failed still wrote the day's report, so it runs again the next day.
#            The checkpoint, capacity, level, stacks and janitor steps log one line per line their
#            command prints (a good capacity step prints only the sessions it placed, and a level
#            step only a change); a step that is off logs nothing. A checkpoint, ledger, capacity,
#            level, stacks, pack or janitor step that fails (a level step's post that Discord
#            refused, kept for its next run, too), or whose stack.json (capacity.json for the
#            capacity and level steps) is malformed, is logged as "<step>: failed: <reason>", the
#            steps after it still run (the capacity step's place after its sample too), and the run
#            exits 1 at its end. A hung GitHub or Docker never holds the run's lock for good: the
#            checkpoint is stopped after 300 s, each reading and the place after 60 s, the level
#            step, the sweep and the pack after 300 s and the janitor after 1200 s, each logged as
#            "<step>: failed: timed out after <n> s" (a janitor stopped so wrote no report, so the
#            next run starts it again), and a whole run, on Linux and macOS alike, after 70 minutes,
#            with everything it started, logged as "run: failed: timed out after 4200 s" (exit 1),
#            so the next run takes the lock; the systemd service's TimeoutStartSec=4500 stands
#            behind that. The sweep, the janitor and the level step need docker on the PATH enable
#            captured (the sweep and the capacity step claude too), and the reading counts the
#            team's stacks as other programs without it: run enable again once it is there. A run
#            that finds another still going skips. Posts go through discord_api; times in them are
#            this machine's local time. On macOS, inside the job (TEAM_HEARTBEAT_JOB is
#            agent-team.heartbeat) with the heartbeat's plist gone, the job was disabled while
#            loaded: a run that starts so says "team-timers: the heartbeat was disabled, so this
#            run unloads its job and does nothing else" on stderr, boots its job out and exits 0,
#            before the lock or any step, with no log line or record; a run whose plist went while
#            it ran (its own fence, or a handoff's disable) boots its job out as its very last act,
#            after its log line, record and alerts, on the normal and the timed-out end alike (the
#            timed-out end takes the lock back the moment the stopped run lets it go, and holds it
#            to the end, so no disable from outside reads the run as over meanwhile). Outside the
#            job, or with the plist there, a run is as above.
#   watch    A stream for anyone watching the hold: checks the offline flag every 60 s until
#            killed, and prints one line when it appears (at once if it is there) and one when it
#            goes:
#              GitHub unreachable since 2026-10-23T13:05:00Z; the team is holding
#              GitHub answers again (unreachable from 2026-10-23T13:05:00Z); the hold is over
#            --once is the coordinator's offline watch, run with Bash run_in_background, which has
#            no expiry and wakes it once, when the command ends: the flag as it finds it is no
#            change (team-lease status shows a hold already on), and it prints the first change,
#            the same line, and exits 0. Re-arm it after acting on that line.
# In ~/.local/state/agent-team/: health.json (the health record, team-health/1, written whole by the
# run alone, after the coordinator step, before the inbox step, and when the run ends, however it
# ends, a run its time limit stopped as timed-out: the last run, its start, end, how it ended (ok,
# failed, offline, login-refused, not-holder, fenced or timed-out) and whether it held the lease;
# the last good run; the lease's last renewal; the last good checkpoint; each step failing now,
# since when, for how many runs in a row and its latest reason, counted once a run, a step that did
# not run keeping its entry; the ledger step's count of lines that are not JSON objects, by line
# number, with the time of its last event that is not a denied; whether the coordinator step last
# saw a session named coordinator, and since which run it has not; the sweep findings it last saw,
# each with the time of the first look that saw it, and the time of the run's look, none when
# the run made none; and the open alerts, each with
# since when, its text, when it was posted and its message), heartbeat.log ("<UTC time> <step>:
# <what happened>", kept to its last 1000 lines once it passes 2000), heartbeat-failures.log (each
# of its lines that reports a problem, the same line: a failed step, a warning, a failed or refused
# probe and each run's line of an outage, a lease not checked or not renewed, a failed post, a
# skipped or timed-out run; kept 30 days, the older lines dropped once a run), heartbeat.lock (one
# run at a time), offline ({since, posted}: GitHub unreachable since the UTC time, and whether
# #coordinator was told; read by team-lease status, the fence hook and the doctor), login-refused
# ({since, reason}: the refusal was posted), and on macOS heartbeat.err, the job's stderr (systemd
# keeps it in the journal).
# TEAM_TIMERS_CHECKPOINT_SECONDS, TEAM_TIMERS_FINISHED_SECONDS, TEAM_TIMERS_FINISHED_CALL_SECONDS,
# TEAM_TIMERS_COORDINATOR_SWEEP_SECONDS, TEAM_TIMERS_CAPACITY_SECONDS, TEAM_TIMERS_LEVEL_SECONDS,
# TEAM_TIMERS_SWEEP_SECONDS, TEAM_TIMERS_JANITOR_SECONDS, TEAM_TIMERS_RUN_SECONDS,
# TEAM_TIMERS_LOCK_SECONDS and TEAM_TIMERS_KILL_SECONDS replace the checkpoint step's 300 s, the
# finished step's 90 s after which no stop starts, its 30 s for each call (the back step's and the
# coordinator step's session lists' too), the coordinator step's 60 s for its sweep, the capacity
# step's 60 s for each of its commands, the level step's 300 s, the sweep's 300 s, the janitor's
# 1200 s, the run's 4200 s, enable's 60 s wait for the run's lock and the 10 s after a time limit at
# which a command still running is killed, TEAM_TIMERS_FAILURES_DAYS the failures log's 30 days, and
# TEAM_TIMERS_HEALTH_RUNS, TEAM_TIMERS_HEALTH_STALE_MINUTES, TEAM_TIMERS_HEALTH_STEP_RUNS and
# TEAM_TIMERS_HEALTH_UNATTENDED_MINUTES the health view's and the alerts' 2 runs, 15 minutes, 12
# runs and 60 minutes (the tests' seams).
# Exit 0 done, 1 refused or a step failed, 2 usage error, 75 GitHub unreachable.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

# The one definition: every INTERVAL minutes, run this checkout's team-timers run.
INTERVAL=5
RENEW_MINUTES=15
# The timer may start a run up to a minute after its mark (systemd's AccuracySec).
SLACK_SECONDS=60
# Seconds: the most one probe of origin may take, the wait before trying a failed one again, and
# the most one Discord post may take.
PROBE_TIMEOUT=20
RETRY_SECONDS=60
POST_TIMEOUT=20
# Seconds: the most team-inbox may take (its lock's wait and two calls).
INBOX_TIMEOUT=120
# Seconds: the most each step after the lease step may take on the holder, each command stopped then
# and killed KILL_SECONDS later: the checkpoint 300 (CHECKPOINT_TIMEOUT), the coordinator step's
# session list 30 (FINISHED_CALL_TIMEOUT) and sweep 60 (COORDINATOR_SWEEP_TIMEOUT), the inbox step
# 120 (INBOX_TIMEOUT above), the finished step 120 (its session list and each stop 30 s,
# FINISHED_CALL_TIMEOUT, and no stop started once FINISHED_TIMEOUT has passed, so at most 90 s and
# one last stop's 30), the capacity step's sample and place 60 each, the level step 300, the sweep
# 300, the pack 300 and the janitor 1200. That is 2850 s in all, 2960 s with the kills (10 s each
# for the other steps' ten commands and the finished step's last stop), about 49 minutes. The lease
# step leaves a lease unrenewed only under 14 minutes old, so a run that hits every limit ends with
# it about 63 minutes old, past the lease's hour (team-lease's TTL_MINUTES), and the next run starts
# at the next mark, up to INTERVAL minutes and SLACK_SECONDS later, and renews behind its read of
# origin. A lease past its ttl is stale, which changes only what team-lease take says on another
# machine (stale, not fresh): the holder still holds it, and the renewal makes it fresh again.
# RUN_TIMEOUT, 70 minutes, stops a run that outlasts all of that (a hang before the steps, or in a
# command no step's limit reaches), so one hang never ends the renewals and checkpoints for good;
# the systemd service's START_TIMEOUT, 75 minutes, is the backstop behind it.
CHECKPOINT_TIMEOUT=${TEAM_TIMERS_CHECKPOINT_SECONDS:-300}
# Seconds past which the checkpoint begins no worktree, two fifths of its limit (120 of 300): one
# begun by then makes at most two origin calls of 60 s, so its records commit begins in the limit.
CHECKPOINT_DEADLINE=$((CHECKPOINT_TIMEOUT * 2 / 5))
FINISHED_TIMEOUT=${TEAM_TIMERS_FINISHED_SECONDS:-90}
FINISHED_CALL_TIMEOUT=${TEAM_TIMERS_FINISHED_CALL_SECONDS:-30}
COORDINATOR_SWEEP_TIMEOUT=${TEAM_TIMERS_COORDINATOR_SWEEP_SECONDS:-60}
CAPACITY_TIMEOUT=${TEAM_TIMERS_CAPACITY_SECONDS:-60}
LEVEL_TIMEOUT=${TEAM_TIMERS_LEVEL_SECONDS:-300}
SWEEP_TIMEOUT=${TEAM_TIMERS_SWEEP_SECONDS:-300}
JANITOR_TIMEOUT=${TEAM_TIMERS_JANITOR_SECONDS:-1200}
# Seconds: how long after its time limit's SIGTERM a command still running is killed.
KILL_SECONDS=${TEAM_TIMERS_KILL_SECONDS:-10}
RUN_TIMEOUT=${TEAM_TIMERS_RUN_SECONDS:-4200}
# Seconds: the most enable waits for a run in progress before it reloads the launchd job under it,
# kept under the Bash tool's 120 s, since team-resume may run enable in a session.
LOCK_SECONDS=${TEAM_TIMERS_LOCK_SECONDS:-60}
START_TIMEOUT=4500
PACK_TIMEOUT=300
# The most of a checkpoint's problem lines (its stderr) one run logs; a count stands for the rest.
CHECKPOINT_PROBLEM_LINES=20
# Seconds between the watch's looks at the offline flag.
WATCH_SECONDS=60
LOG_KEEP=1000
LOG_MAX=2000
# Days: how long the failures log keeps a line.
FAILURES_DAYS=${TEAM_TIMERS_FAILURES_DAYS:-30}
SERVICE=agent-team-heartbeat
HEARTBEAT_LABEL=agent-team.heartbeat
CAFFEINATE_LABEL=agent-team.caffeinate

usage="usage: team-timers enable | disable | status [--json] | health [--json] | run | watch [--once]"
command=${1:-} json=0 once=0
case $command in
  enable | disable | run) [[ $# -eq 1 ]] || usage_error "$usage" ;;
  status | health) [[ $# -eq 1 || ($# -eq 2 && $2 == --json) ]] || usage_error "$usage" ;;
  watch) [[ $# -eq 1 || ($# -eq 2 && $2 == --once) ]] || usage_error "$usage" ;;
  *) usage_error "$usage" ;;
esac
[[ ${2:-} != --json ]] || json=1
[[ ${2:-} != --once ]] || once=1

bin=$(dirname "$TEAM_LIB")
program=$bin/team-timers
# The PATH the job runs with: this shell's for enable, the installed job's own for status.
job_path=$PATH
state=$HOME/.local/state/agent-team
log=$state/heartbeat.log
failures=$state/heartbeat-failures.log
offline=$state/offline
refused=$state/login-refused
health=$state/health.json
units=$HOME/.config/systemd/user
agents=$HOME/Library/LaunchAgents
domain=gui/$(id -u)
err=$(mktemp)
# The run's results for the health record, one JSON object a line (step_ok, step_fail, run_fact),
# written by the run and read by bounded_run too; and bounded_run's mark that the run timed out.
results=$(mktemp)
fired=$err.fired
trap 'rm -f "$err" "$results"' EXIT

# The service manager of this OS: systemd or launchd.
manager() {
  local kernel
  kernel=$(uname -s)
  case $kernel in
    Linux) echo systemd ;;
    Darwin) echo launchd ;;
    *) die "$kernel has neither systemd nor launchd; the heartbeat runs on Linux or macOS" ;;
  esac
}

# Refuse values a unit or plist would need escaped, so what is written is what runs: every value
# the job carries is checked before it is generated.
check_plain() {
  local value
  for value in "$@"; do
    [[ $value != *[%\"\\\&\<\>$'\n']* ]] ||
      die "cannot write the heartbeat's job: '$value' holds one of % \" \\ & < > or a newline"
  done
}

systemd_service() {
  cat <<EOF
# Written by team-timers enable; team-timers disable removes it.
[Unit]
Description=agent-team heartbeat (team-timers run)

[Service]
Type=oneshot
Environment="TEAM_HOME=$TEAM_HOME"
Environment="PATH=$job_path"
ExecStart="$program" run
TimeoutStartSec=$START_TIMEOUT
EOF
}

systemd_timer() {
  cat <<EOF
# Written by team-timers enable; team-timers disable removes it.
[Unit]
Description=agent-team heartbeat every $INTERVAL minutes

[Timer]
OnCalendar=*:0/$INTERVAL
Persistent=true

[Install]
WantedBy=timers.target
EOF
}

# The start of a plist for <label>, up to its Label.
plist_head() {
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by team-timers enable; team-timers disable removes it. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$1</string>
EOF
}

heartbeat_plist() {
  local minute
  plist_head "$HEARTBEAT_LABEL"
  cat <<EOF
  <key>ProgramArguments</key>
  <array>
    <string>$program</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TEAM_HOME</key>
    <string>$TEAM_HOME</string>
    <key>PATH</key>
    <string>$job_path</string>
    <key>TEAM_HEARTBEAT_JOB</key>
    <string>$HEARTBEAT_LABEL</string>
  </dict>
  <key>StandardErrorPath</key>
  <string>$state/heartbeat.err</string>
  <key>StartCalendarInterval</key>
  <array>
EOF
  for ((minute = 0; minute < 60; minute += INTERVAL)); do
    printf '    <dict>\n      <key>Minute</key>\n      <integer>%s</integer>\n    </dict>\n' "$minute"
  done
  printf '  </array>\n</dict>\n</plist>\n'
}

caffeinate_plist() {
  plist_head "$CAFFEINATE_LABEL"
  cat <<'EOF'
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
EOF
}

# The plist of <label>.
plist_of() {
  case $1 in
    "$HEARTBEAT_LABEL") heartbeat_plist ;;
    "$CAFFEINATE_LABEL") caffeinate_plist ;;
  esac
}

# Write <content> to <file> unless it already holds exactly that; fails (1) when it did.
write_if_changed() {
  if [[ -f $2 ]] && [[ $(cat "$2") == "$1" ]]; then return 1; fi
  mkdir -p "${2%/*}"
  printf '%s\n' "$1" >"$2.$$"
  mv -f "$2.$$" "$2"
}

timer_running() {
  systemctl --user is-enabled --quiet "$SERVICE.timer" 2>/dev/null &&
    systemctl --user is-active --quiet "$SERVICE.timer" 2>/dev/null
}

loaded() {
  launchctl print "$domain/$1" >/dev/null 2>&1
}

# Whether this process runs inside the launchd heartbeat job, whose plist sets TEAM_HEARTBEAT_JOB.
inside_job() {
  [[ ${TEAM_HEARTBEAT_JOB:-} == "$HEARTBEAT_LABEL" ]]
}

# Whether this is a run of the launchd heartbeat job that a disable left loaded with no plist,
# which must unload its own job: a bootout stops the job's running process, so no other process
# may boot it out while a run is in progress.
disabled_job() {
  inside_job && [[ $(uname -s) == Darwin && ! -e $agents/$HEARTBEAT_LABEL.plist ]]
}

# Boot the heartbeat job out from inside it, its last act: launchd stops this process with it.
unload_self() {
  rm -f "$err" "$results"
  launchctl bootout "$domain/$HEARTBEAT_LABEL" ||
    die "launchctl bootout $domain/$HEARTBEAT_LABEL failed"
}

enable_systemd() {
  local changed=0 running=0
  write_if_changed "$(systemd_service)" "$units/$SERVICE.service" && changed=1
  write_if_changed "$(systemd_timer)" "$units/$SERVICE.timer" && changed=1
  ! timer_running || running=1
  if ((!changed && running)); then
    echo "the heartbeat is already enabled: $SERVICE.timer"
    return
  fi
  ((!changed)) || systemctl --user daemon-reload
  systemctl --user enable --now "$SERVICE.timer"
  # A running timer keeps its old schedule until it is restarted.
  ((!changed || !running)) || systemctl --user restart "$SERVICE.timer"
  echo "the heartbeat is enabled: $SERVICE.timer runs $program run every $INTERVAL minutes"
}

enable_launchd() {
  local label plist changed lock_fd done=()
  for label in "$HEARTBEAT_LABEL" "$CAFFEINATE_LABEL"; do
    plist=$agents/$label.plist changed=0
    write_if_changed "$(plist_of "$label")" "$plist" && changed=1
    if loaded "$label"; then
      ((changed)) || continue
      if [[ $label == "$HEARTBEAT_LABEL" ]]; then
        # A bootout stops a run in progress, so the reload waits for the run's lock a while.
        exec {lock_fd}>>"$state/heartbeat.lock"
        flock -w "$LOCK_SECONDS" "$lock_fd" ||
          echo "team-timers: a heartbeat run still held its lock after $LOCK_SECONDS s, so the job was reloaded under it" >&2
        # A run that ended meanwhile may have unloaded its job itself.
        ! loaded "$label" || launchctl bootout "$domain/$label"
        launchctl bootstrap "$domain" "$plist"
        exec {lock_fd}>&-
        done+=("$label")
        continue
      fi
      launchctl bootout "$domain/$label"
    fi
    launchctl bootstrap "$domain" "$plist"
    done+=("$label")
  done
  if ((${#done[@]} == 0)); then
    echo "the heartbeat is already enabled: $HEARTBEAT_LABEL, $CAFFEINATE_LABEL"
    return
  fi
  echo "the heartbeat is enabled: $HEARTBEAT_LABEL runs $program run every $INTERVAL minutes," \
    "and $CAFFEINATE_LABEL keeps this Mac awake while it is enabled"
}

disable_systemd() {
  if [[ ! -f $units/$SERVICE.timer && ! -f $units/$SERVICE.service ]]; then
    echo "the heartbeat is not installed; nothing to disable"
    return
  fi
  [[ ! -f $units/$SERVICE.timer ]] || systemctl --user disable --now "$SERVICE.timer"
  rm -f "$units/$SERVICE.timer" "$units/$SERVICE.service"
  systemctl --user daemon-reload
  echo "the heartbeat is disabled: $SERVICE.timer stopped and removed"
}

# The plists go first, so nothing loads them at the next login whatever happens next, then
# caffeinate, then the heartbeat job, which is booted out only when no run is in progress, since a
# bootout stops the job's running process: inside the job, or while a run holds its lock, the job
# stays loaded and its run unloads it as its last act (bounded_run).
disable_launchd() {
  local label found=0 left=0 lock_fd
  for label in "$HEARTBEAT_LABEL" "$CAFFEINATE_LABEL"; do
    [[ ! -f $agents/$label.plist ]] || { rm -f "$agents/$label.plist"; found=1; }
  done
  if loaded "$CAFFEINATE_LABEL"; then
    launchctl bootout "$domain/$CAFFEINATE_LABEL"
    found=1
  fi
  if loaded "$HEARTBEAT_LABEL"; then
    found=1
    if inside_job; then
      left=1
    else
      mkdir -p "$state"
      exec {lock_fd}>>"$state/heartbeat.lock"
      if flock -n "$lock_fd"; then
        # A run that ended meanwhile may have unloaded its job itself.
        ! loaded "$HEARTBEAT_LABEL" || launchctl bootout "$domain/$HEARTBEAT_LABEL"
      else
        left=1
      fi
      exec {lock_fd}>&-
    fi
  fi
  if ((left)); then
    echo "the heartbeat is disabled: $CAFFEINATE_LABEL stopped and both removed;" \
      "$HEARTBEAT_LABEL unloads itself when its run in progress ends"
  elif ((found)); then
    echo "the heartbeat is disabled: $HEARTBEAT_LABEL, $CAFFEINATE_LABEL stopped and removed"
  else
    echo "the heartbeat is not installed; nothing to disable"
  fi
}

# Whether the installed job is what enable would write from this checkout, given the PATH it was
# enabled with: true, false (a file missing or not as written), or null when nothing is installed.
current() {
  local first second same
  if [[ $mgr == systemd ]]; then
    first=$units/$SERVICE.service second=$units/$SERVICE.timer
  else
    first=$agents/$HEARTBEAT_LABEL.plist second=$agents/$CAFFEINATE_LABEL.plist
  fi
  if [[ ! -e $first && ! -e $second ]]; then
    echo null
    return
  fi
  if [[ ! -f $first || ! -f $second ]]; then
    echo false
    return
  fi
  if [[ $mgr == systemd ]]; then
    job_path=$(sed -n 's/^Environment="PATH=\(.*\)"$/\1/p' "$first" | head -n 1)
    [[ $(cat "$first") == "$(systemd_service)" && $(cat "$second") == "$(systemd_timer)" ]] && same=true || same=false
  else
    job_path=$(sed -n '/^    <key>PATH<\/key>$/{n;s/^    <string>\(.*\)<\/string>$/\1/p;}' "$first" | head -n 1)
    [[ $(cat "$first") == "$(heartbeat_plist)" && $(cat "$second") == "$(caffeinate_plist)" ]] && same=true || same=false
  fi
  echo "$same"
}

status() {
  local installed=false enabled=false last=null line current installed_text good name view plain
  if [[ $mgr == systemd ]]; then
    [[ ! -f $units/$SERVICE.service || ! -f $units/$SERVICE.timer ]] || installed=true
    ! timer_running || enabled=true
  else
    [[ ! -f $agents/$HEARTBEAT_LABEL.plist || ! -f $agents/$CAFFEINATE_LABEL.plist ]] || installed=true
    ! { loaded "$HEARTBEAT_LABEL" && loaded "$CAFFEINATE_LABEL"; } || enabled=true
  fi
  if [[ -s $log ]]; then
    line=$(tail -n 1 "$log")
    [[ ! ${line%% *} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$ ]] || last=\"${line%% *}\"
  fi
  current=$(current)
  good=$(jq -c '.last_good_run // null' "$health" 2>/dev/null) || good=null
  [[ -n $good ]] || good=null
  # The plain health line, null on a machine with no name or that does not hold the lease.
  if name=$(machine_name 2>/dev/null) && view=$(health_view "$name" 2>/dev/null); then
    plain=$(jq -c .text <<<"$view")
  else
    plain=null
  fi
  if ((json)); then
    jq -n --argjson installed "$installed" --argjson enabled "$enabled" --argjson current "$current" \
      --argjson last "$last" --argjson good "$good" --argjson health "$plain" \
      '{installed: $installed, enabled: $enabled, current: $current, last_run: $last, last_good_run: $good, health: $health}'
  else
    installed_text=$(yes_no "$installed")
    [[ $installed-$current != true-false ]] ||
      installed_text+=", but not as this checkout defines it (team-timers enable rewrites it)"
    printf 'installed: %s\nenabled: %s\nlast run: %s\nlast good run: %s\nhealth: %s\n' "$installed_text" \
      "$(yes_no "$enabled")" "$(jq -r '. // "never"' <<<"$last")" "$(jq -r '. // "never"' <<<"$good")" \
      "$(jq -r '. // "none kept here, since this machine does not hold the lease" | ltrimstr("Health: ")' <<<"$plain")"
  fi
}

# The health thresholds' seams, from the environment, for health_limits in bin/lib/health.jq.
health_seams() {
  jq -cn --arg runs "${TEAM_TIMERS_HEALTH_RUNS:-}" --arg stale "${TEAM_TIMERS_HEALTH_STALE_MINUTES:-}" \
    --arg step "${TEAM_TIMERS_HEALTH_STEP_RUNS:-}" --arg unattended "${TEAM_TIMERS_HEALTH_UNATTENDED_MINUTES:-}" \
    '{runs: $runs, stale_minutes: $stale, step_runs: $step, unattended_minutes: $unattended}'
}

# The health view of the machine <name>, from the health record, the lease record and the fence
# file, never the network or a service manager: health_view <name>
health_view() {
  local raw=(--argjson raw null) lease='' fenced=false
  [[ ! -f $health ]] || raw=(--rawfile raw "$health")
  [[ ! -f $state/lease.json ]] || lease=$(jq -c 'objects' "$state/lease.json" 2>/dev/null) || lease=''
  [[ ! -e $state/fenced ]] || fenced=true
  jq -n -L "$TEAM_LIB" "${raw[@]}" --argjson lease "${lease:-null}" --argjson fenced "$fenced" --arg machine "$1" \
    --argjson seams "$(health_seams)" \
    'include "health"; health_view($raw; $lease; $fenced; $machine; now; health_limits($seams))'
}

# The health command: the view as JSON, or one line per problem (the plain healthy line when there
# is none); exits 1 with any problem.
health_command() {
  local name view
  name=$(machine_name) || exit 1
  view=$(health_view "$name") || die "cannot read the health record $health"
  if ((json)); then
    printf '%s\n' "$view"
  else
    jq -r 'if .holding | not then "\(.machine) does not hold the lease, so it keeps no health"
      elif .ok then .text else .problems[].text end' <<<"$view"
  fi
  jq -e .ok <<<"$view" >/dev/null || exit 1
}

yes_no() {
  if [[ $1 == true ]]; then echo yes; else echo no; fi
}

# One line of the heartbeat log, also on stdout, and in each <other log> given:
# log <step> <what happened> [<other log>...]
log() {
  local line file
  line="$(date -u +%FT%TZ) $1: $2"
  for file in "$log" "${@:3}"; do printf '%s\n' "$line" >>"$file"; done
  printf '%s\n' "$line"
}

# A line that reports a problem: logged, and the same line, its time included, in the failures
# log. Each caller decides it as it logs it, never by the text: problem <step> <what happened>
problem() {
  log "$1" "$2" "$failures"
}

# Drop the failures log's lines whose leading UTC time is more than FAILURES_DAYS days old, the
# file written whole and moved into place.
trim_failures() {
  local cutoff
  [[ -f $failures ]] || return 0
  cutoff=$(date -u -d "-$FAILURES_DAYS days" +%FT%TZ)
  awk -v cutoff="$cutoff" '!($1 ~ /^[0-9][0-9][0-9][0-9]-/ && $1 < cutoff)' "$failures" >"$failures.$$"
  mv -f "$failures.$$" "$failures"
}

# The first line a sibling command wrote to stderr (in $err), without its "<script>: " prefix.
first_error() {
  local line
  line=$(grep -m1 . "$err" || true)
  printf '%s\n' "${line#team-*: }"
}

# A sibling command of this checkout, with TEAM_HOME passed and the run's lock closed for it.
team() {
  TEAM_HOME=$TEAM_HOME "$bin/$1" "${@:2}" {run_fd}>&-
}

# The fence step: a fenced machine turns its heartbeat off and does nothing else; fails when it
# is not fenced.
fence_step() {
  local why rc=0 out
  why=$(fence_reason) || return 1
  out=$(team team-timers disable 2>"$err") || rc=$?
  if ((rc == 0)); then
    log lease "$machine is $why; $out"
  else
    problem lease "$machine is $why; the heartbeat could not be disabled: $(first_error)"
  fi
  exit "$rc"
}

# Ask origin for its lease branch once: 0 it answered; 1 a network failure, 2 GitHub refused the
# login, 3 anything else, each with the reason in PROBE_REASON (credentials in a URL cut out).
probe_once() {
  local rc=0
  GIT_TERMINAL_PROMPT=0 timeout "$PROBE_TIMEOUT" git -C "$TEAM_HOME" ls-remote origin refs/heads/lease \
    >/dev/null 2>"$err" </dev/null {run_fd}>&- || rc=$?
  ((rc)) || return 0
  PROBE_REASON=$(grep -v '^[[:space:]]*$' "$err" | tail -n 1 | sed -E 's/^(fatal|error|remote): //; s#//[^/@[:space:]]*@#//#g')
  if ((rc == 124)); then
    PROBE_REASON="no answer in ${PROBE_TIMEOUT}s"
    return 1
  fi
  [[ -n $PROBE_REASON ]] || PROBE_REASON="git ls-remote exited $rc"
  if grep -qiE 'authentication failed|could not read (username|password)|invalid username or password|permission denied \(publickey|returned error: 40[13]|repository not found|access denied|403 forbidden' "$err"; then
    return 2
  fi
  if grep -qiE 'could not resolve|name resolution|name or service not known|failed to connect|connect(ion)? (refused|timed out)|connection (reset|closed)|timed out|network is unreachable|no route to host|ssl|tls|gnutls|certificate|handshake|returned error: 5[0-9][0-9]|kex_exchange_identification|hung up unexpectedly|early eof|rpc failed' "$err"; then
    return 1
  fi
  return 3
}

# The probe step: whether GitHub answers, tried again once after RETRY_SECONDS on a network
# failure unless the team already holds. Returns when it answers; exits 75 offline, 1 otherwise.
probe_step() {
  local first rc=0
  first=$(date -u +%FT%TZ)
  probe_once || rc=$?
  if ((rc == 1)) && [[ ! -e $offline ]]; then
    problem probe "GitHub unreachable ($PROBE_REASON); trying again in ${RETRY_SECONDS}s"
    sleep "$RETRY_SECONDS"
    rc=0
    probe_once || rc=$?
    ((rc)) || log probe "GitHub answered the second try"
  fi
  case $rc in
    0)
      step_ok probe
      if [[ -e $refused ]]; then
        rm -f "$refused"
        log probe "GitHub accepts $machine's login again"
      fi
      ;;
    1) go_offline "$first" ;;
    2) login_refused ;;
    *)
      problem probe "cannot ask GitHub: $PROBE_REASON"
      step_fail probe "cannot ask GitHub: $PROBE_REASON"
      exit 1
      ;;
  esac
}

# Hold the team from <since>: write the offline flag and tell #coordinator once, on the machine
# whose record says it holds the lease. Exits 75.
go_offline() {
  local since post
  RUN_ENDED=offline
  if [[ -e $offline ]]; then
    since=$(jq -r '.since // empty' "$offline" 2>/dev/null) || since=''
    problem probe "GitHub unreachable since ${since:-an unknown time} ($PROBE_REASON); the team is still holding"
    exit 75
  fi
  if ! jq -e --arg machine "$machine" '.holder == $machine and .state == "held"' "$state/lease.json" >/dev/null 2>&1; then
    problem probe "GitHub unreachable ($PROBE_REASON); $machine does not hold the lease, so there is no team to hold"
    exit 75
  fi
  jq -n --arg since "$1" '{since: $since, posted: false}' >"$offline.$$"
  mv -f "$offline.$$" "$offline"
  if post "$(outage_text "$1")"; then
    jq -n --arg since "$1" '{since: $since, posted: true}' >"$offline.$$"
    mv -f "$offline.$$" "$offline"
    post=" #coordinator is told"
  else
    post=" the post to #coordinator failed ($POST_ERROR); it goes with the back message"
  fi
  problem probe "GitHub unreachable since $1 ($PROBE_REASON); the team is holding;$post"
  exit 75
}

# GitHub refuses this machine's login: logged each run, posted once until it answers again.
# Exits 1.
login_refused() {
  local post=''
  RUN_ENDED=login-refused
  if [[ ! -e $refused ]]; then
    jq -n --arg since "$(date -u +%FT%TZ)" --arg reason "$PROBE_REASON" '{since: $since, reason: $reason}' >"$refused"
    if post "GitHub refuses $machine's login ($PROBE_REASON); the heartbeat cannot renew the lease until it is fixed there (team-doctor)"; then
      post="; #coordinator is told"
    else
      post="; the post to #coordinator failed ($POST_ERROR)"
    fi
  fi
  problem probe "GitHub refuses $machine's login ($PROBE_REASON); not offline$post"
  exit 1
}

# The back step, on the first probe that answers while offline: renew at once; renewed, clear
# the flag and tell #coordinator; a machine that lost the lease meanwhile is fenced by the renew.
back_step() {
  local since back rc=0 out text posted
  read -r since posted < <(jq -r '"\(.since // "") \(.posted // false)"' "$offline" 2>/dev/null) || since='' posted=false
  out=$(team team-lease renew 2>"$err") || rc=$?
  case $rc in
    0) ;;
    75)
      problem back "GitHub answers, but the renew did not: $(first_error); the team is still holding"
      step_fail lease "GitHub answers, but the renew did not: $(first_error)"
      exit 75
      ;;
    *)
      rm -f "$offline"
      if [[ -e $state/fenced ]]; then
        log back "$(first_error)"
        return
      fi
      problem back "GitHub answers; not renewed: $(first_error)"
      step_fail lease "not renewed: $(first_error)"
      exit 1
      ;;
  esac
  rm -f "$offline"
  back=$(date -u +%FT%TZ)
  step_ok lease
  run_fact "$(jq -cn --arg at "$back" '{lease_renewed: $at}')"
  text="GitHub back at $(clock "$back") (unreachable from $(clock "$since")); $(held_tasks)"
  [[ $posted == true ]] || text="$(outage_text "$since")"$'\n'"$text"
  if post "$text"; then
    log back "$out; GitHub back at $back (unreachable from $since); #coordinator is told"
  else
    problem back "$out; GitHub back at $back (unreachable from $since); the post to #coordinator failed ($POST_ERROR)"
  fi
  holding=1
}

# What the outage post says: outage_text <since>
outage_text() {
  printf 'GitHub unreachable since %s on %s; holding the team' "$(clock "$1")" "$machine"
}

# A UTC time as this machine's local hours and minutes, or "an unknown time": clock <time>
clock() {
  date -d "$1" +%H:%M 2>/dev/null || echo "an unknown time"
}

# What the back post says of the tasks: those with a live worker (T<n>-<role>) resume, from a
# session list read as the finished step reads it, at most FINISHED_CALL_TIMEOUT.
held_tasks() {
  local tasks
  if ! tasks=$(timeout --kill-after="$KILL_SECONDS" "$FINISHED_CALL_TIMEOUT" claude agents --json 2>/dev/null </dev/null {run_fd}>&- | jq -er '
      [.[] | .name // "" | capture("^T(?<n>[0-9]+)-[a-z][a-z0-9-]*$") | .n | tonumber] | unique
      | map("T\(.)") | join(", ")' 2>/dev/null); then
    echo "resuming the held tasks (the live session list could not be read)"
  elif [[ -z $tasks ]]; then
    echo "no worker was live, so none was held"
  else
    echo "resuming $tasks"
  fi
}

# Post <text> to #coordinator; fails with the reason in POST_ERROR.
post() {
  local body
  body=$(jq -cn --arg content "$1" '{content: $content}')
  if discord_api "channels/$COORDINATOR_CHANNEL/messages" -X POST -H "Content-Type: application/json" \
    --max-time "$POST_TIMEOUT" -d "$body" >/dev/null 2>"$err" {run_fd}>&-; then
    return 0
  fi
  POST_ERROR=$(grep -m1 . "$err" || echo "no reason given")
  return 1
}

# Post <text> to #coordinator as an alert, mentioning no one whatever the text holds; the new
# message's id in ALERT_ID (empty when Discord gave none), or fails with the reason in POST_ERROR.
alert_post() {
  local body reply
  ALERT_ID=''
  body=$(jq -cn --arg content "$1" '{content: $content, allowed_mentions: {parse: []}}')
  if reply=$(discord_api "channels/$COORDINATOR_CHANNEL/messages" -X POST -H "Content-Type: application/json" \
    --max-time "$POST_TIMEOUT" -d "$body" 2>"$err" {run_fd}>&-); then
    ALERT_ID=$(jq -r '.id // empty | strings' <<<"$reply" 2>/dev/null) || ALERT_ID=''
    return 0
  fi
  POST_ERROR=$(grep -m1 . "$err" || echo "no reason given")
  return 1
}

# Edit the alert message <message> to <text>, mentioning no one; fails with the reason in
# POST_ERROR: alert_edit <message> <text>
alert_edit() {
  local body
  body=$(jq -cn --arg content "$2" '{content: $content, allowed_mentions: {parse: []}}')
  if discord_api "channels/$COORDINATOR_CHANNEL/messages/$1" -X PATCH -H "Content-Type: application/json" \
    --max-time "$POST_TIMEOUT" -d "$body" >/dev/null 2>"$err" {run_fd}>&-; then
    return 0
  fi
  POST_ERROR=$(grep -m1 . "$err" || echo "no reason given")
  return 1
}

# Set the open alert <key> in the health record to <json>, or drop it when <json> is null, the
# record written whole and moved into place: set_alert <key> <json>
set_alert() {
  if jq --arg key "$1" --argjson alert "$2" \
    'if $alert == null then del(.alerts[$key]) else .alerts[$key] = $alert end' "$health" >"$health.$$" 2>/dev/null; then
    mv -f "$health.$$" "$health"
  else
    rm -f "$health.$$"
    problem alert "$1: cannot write the health record $health, so this alert is judged again next run"
  fi
}

# The alerts, judged on the holder after the record's write before the inbox step and again at the
# run's end, by bin/lib/health.jq's health_alert_plan: each alert called for with none open is
# posted once to #coordinator, one Discord refused is tried again at the next judging, and one
# whose problem has ended has its message edited to end with "-# Resolved at <HH:MM>." and is
# closed, an edit that fails closing it all the same. Each post, failed post and edit is a log
# line, a failed one in the failures log too. Fails nothing.
alerts_step() {
  local plan alert key text posted message id now fenced=false lease
  [[ -f $health && -f $state/lease.json ]] || return 0
  lease=$(jq -c 'objects' "$state/lease.json" 2>/dev/null) || lease=''
  [[ ! -e $state/fenced ]] || fenced=true
  if ! plan=$(jq -c -L "$TEAM_LIB" --argjson lease "${lease:-null}" --argjson fenced "$fenced" --arg machine "$machine" \
    --argjson seams "$(health_seams)" \
    'include "health"; health_alert_plan($lease; $fenced; $machine; now; health_limits($seams))' "$health" 2>"$err"); then
    problem alert "cannot judge the alerts from $health: $(first_error)"
    return 0
  fi
  while IFS= read -r alert; do
    [[ -n $alert ]] || continue
    key=$(jq -r .key <<<"$alert") text=$(jq -r .text <<<"$alert")
    now=$(date -u +%FT%TZ)
    if alert_post "$text"; then
      id=$ALERT_ID
      set_alert "$key" "$(jq -c --arg posted "$now" --arg id "$id" \
        '{since, text, posted: $posted, message: (if $id == "" then null else $id end)}' <<<"$alert")"
      if [[ -n $id ]]; then
        log alert "$key: posted to #coordinator (message $id)"
      else
        problem alert "$key: posted to #coordinator, but Discord gave no message id, so it cannot be marked resolved"
      fi
    else
      set_alert "$key" "$(jq -c '{since, text, posted: null, message: null}' <<<"$alert")"
      problem alert "$key: the post to #coordinator failed ($POST_ERROR); it is tried again next run"
    fi
  done < <(jq -c '.post[]' <<<"$plan")
  while IFS= read -r alert; do
    [[ -n $alert ]] || continue
    key=$(jq -r .key <<<"$alert") posted=$(jq -r '.posted // empty' <<<"$alert")
    message=$(jq -r '.message // empty' <<<"$alert") text=$(jq -r .text <<<"$alert")
    if [[ -z $posted ]]; then
      log alert "$key: ended before its post went through; closed"
    elif [[ -z $message ]]; then
      log alert "$key: ended; closed, but its message is unknown, so it is not marked resolved"
    elif alert_edit "$message" "$text"$'\n'"-# Resolved at $(date +%H:%M)."; then
      log alert "$key: resolved (message $message edited)"
    else
      problem alert "$key: ended, but message $message could not be marked resolved ($POST_ERROR); closed all the same"
    fi
    set_alert "$key" null
  done < <(jq -c '.resolve[]' <<<"$plan")
}

# The lease step: renew on the holder once the last renewal is RENEW_MINUTES old, and at once on
# a machine that lost the lease, which renew fences.
lease_step() {
  local desc rc=0 holder epoch age
  desc=$(team team-lease status --json 2>"$err") || rc=$?
  case $rc in
    0) ;;
    75)
      problem lease "not checked: $(first_error)"
      step_fail lease "not checked: $(first_error)"
      exit 75
      ;;
    *)
      problem lease "not checked: $(first_error)"
      step_fail lease "not checked: $(first_error)"
      exit 1
      ;;
  esac
  read -r holder epoch < <(jq -r '"\(.holder // "-") \(.epoch)"' <<<"$desc")
  if jq -e '.lost' <<<"$desc" >/dev/null; then
    renew
  elif jq -e '.state == "released"' <<<"$desc" >/dev/null; then
    log lease "the lease is released (epoch $epoch); nothing to do"
    step_ok lease
  elif jq -e '.mine | not' <<<"$desc" >/dev/null; then
    log lease "$holder holds the lease (epoch $epoch); nothing to do"
    step_ok lease
  else
    age=$(jq -r 'now - (.renewed_at | fromdateiso8601) | floor' <<<"$desc")
    if ((age < RENEW_MINUTES * 60 - SLACK_SECONDS)); then
      log lease "$machine holds the lease, epoch $epoch, renewed $((age / 60)) minutes ago; no renewal due"
      step_ok lease
      run_fact "$(jq -c '{lease_renewed: .renewed_at}' <<<"$desc")"
      holding=1
      return
    fi
    renew
    [[ -e $state/fenced ]] || holding=1
  fi
}

# The checkpoint step, on the holder right after the lease or back step: team-checkpoint, which
# says when none is due yet, stopped (with its process group) after CHECKPOINT_TIMEOUT. Each stdout
# line is logged, then each stderr line, which holds problems only: a warning as "checkpoint:
# warning: <part>: <reason>", any other line as "checkpoint: failed: <line>", each without its
# "team-checkpoint: " prefix, at most CHECKPOINT_PROBLEM_LINES of them and a count of the rest. A
# checkpoint that fails, times out or exits 75 is a failed step: the steps after it still run.
checkpoint_step() {
  local rc=0 out line kind shown=0 total=0 first='' fails=0 usage=''
  out=$(TEAM_HOME=$TEAM_HOME timeout --kill-after="$KILL_SECONDS" "$CHECKPOINT_TIMEOUT" "$bin/team-checkpoint" \
    --deadline "$CHECKPOINT_DEADLINE" 2>"$err" {run_fd}>&-) || rc=$?
  while IFS= read -r line; do
    [[ -z $line ]] || log checkpoint "$line"
  done <<<"$out"
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    total=$((total + 1))
    line=${line#team-checkpoint: }
    if [[ $line == "warning: usage: "* ]]; then
      [[ -n $usage ]] || usage=${line#warning: usage: }
    elif [[ $line != "warning: "* ]]; then
      fails=$((fails + 1))
      [[ -n $first ]] || first=$line
    fi
    ((shown < CHECKPOINT_PROBLEM_LINES)) || continue
    shown=$((shown + 1))
    if [[ $line == "warning: "* ]]; then problem checkpoint "$line"; else problem checkpoint "failed: $line"; fi
  done <"$err"
  if ((total > shown)); then
    kind=warning
    ((rc == 0)) || kind=failed
    problem checkpoint "$kind: and $((total - shown)) more problem lines"
  fi
  case $rc in
    0) step_ok checkpoint ;;
    124 | 137) step_failed checkpoint "timed out after $CHECKPOINT_TIMEOUT s" ;;
    *)
      failed=1
      ((total)) || problem checkpoint "failed: team-checkpoint exited $rc with no reason on stderr"
      step_fail checkpoint "${first:-team-checkpoint exited $rc with no reason on stderr}" "$((fails > 1 ? fails - 1 : 0))"
      ;;
  esac
  # The usage export: its warning fails the usage step; a checkpoint made with none passed it.
  if [[ -n $usage ]]; then
    step_fail usage "$usage"
  elif ((rc == 0)) && [[ $out != "not due: "* ]]; then
    step_ok usage
  fi
}

# The inbox step, on the holder after the alert step: team-inbox, logged only when it retired the
# message it kept in #coordinator before waiting.md, numbered the list afresh (which no later run
# would show), or failed, and never failing the run, since the next run writes the list again.
inbox_step() {
  local rc=0 out why line
  out=$(TEAM_HOME=$TEAM_HOME timeout --kill-after="$KILL_SECONDS" "$INBOX_TIMEOUT" "$bin/team-inbox" 2>"$err" {run_fd}>&-) || rc=$?
  case $rc in
    0)
      while IFS= read -r line; do
        [[ $line != retired* ]] || log inbox "$line"
      done <<<"$out"
      while IFS= read -r line; do
        log inbox "${line#team-inbox: }"
      done < <(grep '^team-inbox: numbers the list afresh' "$err" || true)
      step_ok inbox
      ;;
    124 | 137)
      problem inbox "failed: timed out after $INBOX_TIMEOUT s"
      step_fail inbox "timed out after $INBOX_TIMEOUT s"
      ;;
    *)
      why=$(grep -q . "$err" && first_error || echo "team-inbox exited $rc")
      problem inbox "failed: $why"
      step_fail inbox "$why"
      ;;
  esac
}

# The finished step, on the holder after the inbox step, every run, whatever the level and budget:
# claude stop of each finished session of every open task but a planner whose plan is not approved
# yet, as the header's finished says, each call killed 10 s after its time limit, as run_step's
# are. Never fails the run: a stop that fails, a session list or ledger that cannot be read, and
# the sessions left once FINISHED_TIMEOUT has passed are each a warning line.
finished_step() {
  local ledger=$TEAM_HOME/ledger.jsonl sessions finished task role session out start=$SECONDS left=0
  [[ -e $ledger ]] || ledger=/dev/null
  step_ok finished
  if ! sessions=$(timeout --kill-after="$KILL_SECONDS" "$FINISHED_CALL_TIMEOUT" claude agents --json 2>/dev/null </dev/null {run_fd}>&- |
    jq -ce 'select(type == "array")' 2>/dev/null); then
    finished_warning "cannot read the live session list (claude agents --json), so no finished session was stopped"
    return 0
  fi
  if ! finished=$(ledger_jq 'ledger_events | by_task as $tasks | plan_tasks($sessions)[] | .task as $task | .finished[]
      | select(.role != "planner" or any($tasks[$task][]; .event == "plan-approved")) | [$task, .role, .session] | @tsv' \
    -nRr --argjson sessions "$sessions" "$ledger" 2>"$err"); then
    finished_warning "cannot read $ledger ($(first_error)), so no finished session was stopped"
    return 0
  fi
  while IFS=$'\t' read -r task role session; do
    [[ -n $session ]] || continue
    if ((SECONDS - start >= FINISHED_TIMEOUT)); then
      left=$((left + 1))
    elif out=$(timeout --kill-after="$KILL_SECONDS" "$FINISHED_CALL_TIMEOUT" claude stop "$session" 2>&1 </dev/null {run_fd}>&-); then
      log finished "stopped $task-$role $session: its work is handed on"
    else
      finished_warning "could not stop $task-$role $session ($(grep -m1 . <<<"$out" || echo "claude stop failed with no reason given"))"
    fi
  done <<<"$finished"
  ((left == 0)) || finished_warning "$left finished $( ((left == 1)) && echo session || echo sessions) left for the next run: no stop starts $FINISHED_TIMEOUT s into the step"
}

# A warning of the finished step: its line, and the step failing in the health record, never the
# run: finished_warning <what>
finished_warning() {
  problem finished "warning: $1"
  step_fail finished "$1"
}

# The capacity step, on the holder after the finished step: team-capacity sample, then
# team-capacity place --quiet, every run, each with its own time limit.
capacity_step() {
  run_step capacity "$CAPACITY_TIMEOUT" team-capacity sample
  run_step capacity "$CAPACITY_TIMEOUT" team-capacity place --quiet
}

# The level step, on the holder after the capacity step: team-level tick, every run.
level_step() {
  run_step level "$LEVEL_TIMEOUT" team-level tick
}

# The stacks step, on the holder after the level step: team-stack sweep, when heartbeat_sweep is
# on.
stacks_step() {
  step_on stacks heartbeat_sweep || return 0
  run_step stacks "$SWEEP_TIMEOUT" team-stack sweep
}

# The pack step, on the holder after the stacks step: once the team home has PACK_LOOSE loose
# objects, git gc, which refuses while another gc runs.
pack_step() {
  local loose rc=0
  if ! loose=$(loose_objects 2>"$err"); then
    step_failed pack "cannot count the team home's loose objects: $(first_error)"
    return 0
  fi
  if ((loose < PACK_LOOSE)); then
    step_ok pack
    return 0
  fi
  timeout --kill-after="$KILL_SECONDS" "$PACK_TIMEOUT" git -C "$TEAM_HOME" gc --quiet 2>"$err" {run_fd}>&- || rc=$?
  case $rc in
    0) ;;
    124 | 137) step_failed pack "timed out after $PACK_TIMEOUT s" && return 0 ;;
    *) step_failed pack "$(grep -q . "$err" && first_error || echo "git gc exited $rc")" && return 0 ;;
  esac
  log pack "packed $loose loose objects; $(loose_objects) left loose, $(pack_size) in packs"
  step_ok pack
}

# The janitor step, on the holder after the pack step: team-janitor, when heartbeat_janitor is
# on and no report of today's local date is there yet (a dry run's is none).
janitor_step() {
  step_on janitor heartbeat_janitor || return 0
  [[ ! -e $state/janitor/$(date +%F).md ]] || return 0
  run_step janitor "$JANITOR_TIMEOUT" team-janitor
}

# Whether the step <step>'s key <key> is true in the machine's stack settings, read as team-stack
# reads them (bin/lib/stack.jq); a malformed file fails the step, logged with the reason.
step_on() {
  local file=$HOME/.config/agent-team/stack.json given='[]' problems
  if [[ -e $file ]]; then
    if ! given=$(jq -s . "$file" 2>"$err"); then
      step_failed "$1" "$file is not JSON: $(grep . "$err" | tail -n 1 || echo "jq could not read it")"
      return 1
    fi
    problems=$(jq -r -L "$TEAM_LIB" 'include "stack"; settings_problems(settings_kinds)' <<<"$given")
    if [[ -n $problems ]]; then
      step_failed "$1" "$file$problems"
      return 1
    fi
  fi
  jq -e -L "$TEAM_LIB" --arg key "$2" 'include "stack"; settings[$key]' <<<"$given" >/dev/null && return 0
  # A step that is off has nothing failing.
  step_ok "$1"
  return 1
}

# Run the step <step>'s sibling command, stopped (with all it started) after <seconds>:
# run_step <step> <seconds> <command> [<argument>...]; one log line per line it prints, and a
# failure logged with its first error.
run_step() {
  local rc=0 out line
  out=$(TEAM_HOME=$TEAM_HOME timeout --kill-after="$KILL_SECONDS" "$2" "$bin/$3" "${@:4}" 2>"$err" {run_fd}>&-) || rc=$?
  while IFS= read -r line; do
    [[ -z $line ]] || log "$1" "$line"
  done <<<"$out"
  case $rc in
    0) step_ok "$1" ;;
    124 | 137) step_failed "$1" "timed out after $2 s" ;;
    *) step_failed "$1" "$(grep -q . "$err" && first_error || echo "$3 exited $rc")" ;;
  esac
}

# A step that failed, logged as "<step>: failed: <reason>": the steps after it still run, and the
# run exits 1 at its end.
step_failed() {
  problem "$1" "failed: $2"
  step_fail "$1" "$2"
  failed=1
}

# The run's results for the health record (bin/lib/health.jq's health_fold): a step that went
# well, a step that failed with its reason (and how many more failure lines it gave), and a fact
# of the run as one JSON object. A step with no result in a run did not run, and keeps its entry.
step_ok() {
  jq -cn --arg step "$1" '{step: $step, reason: null}' >>"$results"
}

step_fail() {
  jq -cn --arg step "$1" --arg reason "$2" --argjson more "${3:-0}" '{step: $step, reason: $reason, more: $more}' >>"$results"
}

run_fact() {
  printf '%s\n' "$1" >>"$results"
}

# Write the health record, folding this run's results into it, written whole and moved into place:
# write_record <how the run ended> (empty while it goes on). A record it cannot write is a problem
# line and fails nothing.
write_record() {
  local now last_checkpoint='' offline_json=null refused_json=null since prev=(--argjson prev null)
  now=$(date -u +%FT%TZ)
  [[ ! -e $state/last-checkpoint ]] || last_checkpoint=$(date -u -r "$state/last-checkpoint" +%FT%TZ)
  since=$(offline_since) || since=''
  [[ -z $since ]] || offline_json=$(jq -cn --arg since "$since" '{since: $since}')
  if [[ -e $refused ]]; then
    refused_json=$(jq -c 'select(type == "object" and (.since | type) == "string") | {since, reason}' "$refused" 2>/dev/null) || refused_json=''
    [[ -n $refused_json ]] ||
      refused_json=$(jq -cn --arg since "$(date -u -r "$refused" +%FT%TZ)" '{since: $since, reason: null}')
  fi
  [[ ! -f $health ]] || prev=(--rawfile prev "$health")
  if jq -n -L "$TEAM_LIB" "${prev[@]}" --slurpfile results "$results" --arg machine "${machine:-}" \
    --arg start "$run_start" --arg id "$run_id" --arg now "$now" --arg ended "$1" --arg last_checkpoint "$last_checkpoint" \
    --argjson offline "$offline_json" --argjson login_refused "$refused_json" --argjson seams "$(health_seams)" '
      include "health";
      def given: if . == "" then null else . end;
      $prev | (if type == "string" then try fromjson catch null else . end)
      | health_fold({machine: ($machine | given), id: $id, start: $start, now: $now, ended: ($ended | given),
          last_checkpoint: ($last_checkpoint | given), offline: $offline, login_refused: $login_refused}; $results;
          health_limits($seams))' \
    >"$health.$$" 2>"$health.$$.err"; then
    mv -f "$health.$$" "$health"
  else
    problem run "cannot write the health record $health: $(grep -m1 . "$health.$$.err" || echo "jq failed")"
    rm -f "$health.$$"
  fi
  rm -f "$health.$$.err"
}

# The run's end, however it ends (its EXIT trap): the health record written with how it ended,
# unless it never took the lock or the run's time limit stopped it (bounded_run writes that one).
run_ended() {
  local rc=$? ended
  ((recording)) || return 0
  [[ ! -e $fired ]] || return 0
  if [[ -n $RUN_ENDED ]]; then
    ended=$RUN_ENDED
  elif [[ -e $state/fenced ]]; then
    ended=fenced
  elif ((rc == 0 && holding)); then
    ended=ok
  elif ((rc == 0)); then
    ended=not-holder
  else
    ended=failed
  fi
  write_record "$ended"
  # The alerts are judged again at the end only of a run that held the lease: one that went
  # offline, was refused its login or was fenced never got that far.
  if ((holding)); then alerts_step || true; fi
}

# The ledger step, on the holder after the checkpoint step: one pass over ledger.jsonl that counts
# the lines that are not JSON objects, by line number, and reads the time of its last event that is
# not a denied; a line no reader can parse fails the step.
ledger_step() {
  local file=$TEAM_HOME/ledger.jsonl scan
  [[ -e $file ]] || file=/dev/null
  if ! scan=$(jq -nRc -L "$TEAM_LIB" 'include "health"; ledger_scan' "$file" 2>"$err"); then
    step_failed ledger "cannot read $file: $(first_error)"
    return 0
  fi
  run_fact "{\"ledger\": $scan}"
  if jq -e '.count > 0' <<<"$scan" >/dev/null; then
    step_failed ledger "$(jq -r -L "$TEAM_LIB" 'include "health"; ledger_reason' <<<"$scan")"
  else
    step_ok ledger
  fi
}

# The coordinator step, on the holder after the ledger step: one read of the live session list
# (claude agents --json, FINISHED_CALL_TIMEOUT and killed KILL_SECONDS later) for a session named
# coordinator, claude-coordinator's own test before it launches one. Logs nothing while one is
# live, and a problem line each run with none, the health record keeping since when; a list that
# cannot be read is the step failing with that reason, concluding nothing about the coordinator.
# Never fails the run, and never starts a coordinator: that launches a session in bypass mode,
# which is Daniel's to decide.
coordinator_step() {
  local rc=0 out why=''
  out=$(timeout --kill-after="$KILL_SECONDS" "$FINISHED_CALL_TIMEOUT" claude agents --json 2>"$err" </dev/null {run_fd}>&-) || rc=$?
  case $rc in
    0) jq -e 'type == "array"' <<<"$out" >/dev/null 2>&1 || why="it printed no JSON list" ;;
    124 | 137) why="timed out after $FINISHED_CALL_TIMEOUT s" ;;
    *) why=$(grep -q . "$err" && first_error || echo "claude agents exited $rc") ;;
  esac
  if [[ -n $why ]]; then
    problem coordinator "failed: cannot read the live session list (claude agents --json): $why"
    step_fail coordinator "cannot read the live session list (claude agents --json): $why"
    return 0
  fi
  step_ok coordinator
  if jq -e 'any(.[]; type == "object" and .name == "coordinator")' <<<"$out" >/dev/null; then
    run_fact '{"coordinator_live": true}'
  else
    run_fact '{"coordinator_live": false}'
    problem coordinator "no session named coordinator is live; claude-coordinator starts one"
  fi
  sweep_findings
}

# The coordinator step's look at the sweep: team-sweep --json (COORDINATOR_SWEEP_TIMEOUT, killed
# KILL_SECONDS later), which exits 0 with [] and 1 with its findings, both a JSON list on stdout,
# and 1 with nothing on stdout and the reason on stderr when it cannot look. The findings, dated at
# the look, go to the health record; a sweep that cannot run is the step failing with its reason,
# and the record keeps the findings it holds.
sweep_findings() {
  local rc=0 out why='' at line
  at=$(date -u +%FT%TZ)
  out=$(TEAM_HOME=$TEAM_HOME timeout --kill-after="$KILL_SECONDS" "$COORDINATOR_SWEEP_TIMEOUT" "$bin/team-sweep" --json \
    2>"$err" </dev/null {run_fd}>&-) || rc=$?
  case $rc in
    0 | 1)
      if ! jq -e 'type == "array"' <<<"$out" >/dev/null 2>&1; then
        line=$(grep . "$err" | tail -n 1 || true)
        if [[ -n $line ]]; then
          why=${line#team-*: }
        elif ((rc == 0)); then
          why="it printed no JSON list"
        else
          why="team-sweep exited 1 with no JSON list"
        fi
      fi
      ;;
    124 | 137) why="timed out after $COORDINATOR_SWEEP_TIMEOUT s" ;;
    *) why=$(grep -q . "$err" && first_error || echo "team-sweep exited $rc") ;;
  esac
  if [[ -n $why ]]; then
    problem coordinator "failed: cannot run the sweep (team-sweep --json): $why"
    step_fail coordinator "cannot run the sweep (team-sweep --json): $why"
    return 0
  fi
  run_fact "$(jq -c --arg at "$at" '{findings: {at: $at, list: [.[] | objects | {task, kind, session, text}]}}' <<<"$out")"
}

# team-lease renew, logged; a renew that fenced this machine did its job.
renew() {
  local rc=0 out
  out=$(team team-lease renew 2>"$err") || rc=$?
  case $rc in
    0)
      log lease "$out"
      step_ok lease
      run_fact "$(jq -cn '{lease_renewed: (now | floor | todate)}')"
      ;;
    75)
      problem lease "not renewed: $(first_error)"
      step_fail lease "not renewed: $(first_error)"
      exit 75
      ;;
    *)
      if [[ -e $state/fenced ]]; then
        log lease "$(first_error)"
        return
      fi
      problem lease "not renewed: $(first_error)"
      step_fail lease "not renewed: $(first_error)"
      exit 1
      ;;
  esac
}

run_heartbeat() {
  recording=0
  mkdir -p "$state"
  exec {run_fd}>>"$state/heartbeat.lock"
  if ! flock -n "$run_fd"; then
    problem run "another run is still going; skipped"
    return
  fi
  if [[ -f $log ]] && (($(wc -l <"$log") > LOG_MAX)); then
    tail -n "$LOG_KEEP" "$log" >"$log.$$"
    mv -f "$log.$$" "$log"
  fi
  trim_failures
  holding=0 failed=0 RUN_ENDED='' machine=''
  run_start=$(date -u +%FT%TZ) run_id=$(date +%s%N)-$BASHPID
  run_fact "$(jq -cn --arg start "$run_start" --arg id "$run_id" '{start: $start, id: $id}')"
  recording=1
  trap run_ended EXIT
  if ! machine=$(machine_name 2>"$err"); then
    machine=''
    problem run "$(first_error)"
    step_fail run "$(first_error)"
    exit 1
  fi
  step_ok run
  fence_step || true
  probe_step
  if [[ -e $offline ]]; then back_step; else lease_step; fi
  ((!holding)) || run_fact '{"holding": true}'
  if ((holding)); then
    checkpoint_step
    ledger_step
    coordinator_step
    write_record ''
    alerts_step
    inbox_step
    finished_step
    capacity_step
    level_step
    stacks_step
    pack_step
    janitor_step
  fi
  ((!failed)) || exit 1
}

# The process <pid> and every process it started that is still running, read from ps's parent ids
# while <pid> lives, as "<pid> <start time>" lines, so a process is told from a later one that took
# its id: process_tree <pid>
process_tree() {
  local pids
  pids=$(ps -A -o pid=,ppid= | awk -v root="$1" '
    { kids[$2] = kids[$2] " " $1 }
    END {
      queue = root
      while (queue != "") {
        n = split(queue, now, " ")
        queue = ""
        for (i = 1; i <= n; i++) { print now[i]; if (now[i] in kids) queue = queue kids[now[i]] }
      }
    }' | paste -sd, -)
  [[ -z $pids ]] || ps -o pid=,lstart= -p "$pids" 2>/dev/null || true
}

# Stop the process <pid> with every process it started: SIGTERM to each, then SIGKILL to each still
# running KILL_SECONDS later (the system's own sleep, as bounded_run's timer): stop_tree <pid>
stop_tree() {
  local tree pid start now
  tree=$(process_tree "$1")
  [[ -n $tree ]] || return 0
  while read -r pid _; do kill -TERM "$pid" 2>/dev/null || true; done <<<"$tree"
  command -p sleep "$KILL_SECONDS"
  while read -r pid start; do
    # Only the very process seen above: the same id with the same start.
    now=$(ps -o lstart= -p "$pid" 2>/dev/null) || continue
    read -r now <<<"$now"
    [[ $now != "$start" ]] || kill -KILL "$pid" 2>/dev/null || true
  done <<<"$tree"
}

# The run's own time limit, on Linux and macOS alike. The timer, the system's own sleep (never one
# a PATH puts first, a test's stub of the probe's wait), is bounded_run's own child; the run is a
# background group that runs run_heartbeat in a subshell of its own, which takes the lock, then
# kills the timer by its id and exits with the run's code. bounded_run waits on the timer, its
# unreaped child until that wait returns, so the run's kill never reaches a process that took its
# id, and no process list is read to stop it. A timer that ran out means RUN_TIMEOUT has passed:
# stop the run with everything it started (each step's timeout runs its command in a process
# group of its own, which no signal to one group reaches), take its lock back as it lets it go,
# log it under that lock and exit 1. Otherwise exit with the run's own code.
bounded_run() {
  local run timer holder locked=0 rc=0
  if disabled_job; then
    echo "team-timers: the heartbeat was disabled, so this run unloads its job and does nothing else" >&2
    unload_self
    exit 0
  fi
  mkdir -p "$state"
  command -p sleep "$RUN_TIMEOUT" </dev/null >/dev/null 2>&1 &
  timer=$!
  {
    # The run's wait, not the run, is in the || list, so errexit still holds inside the run.
    (run_heartbeat) &
    wait "$!" || rc=$?
    kill -TERM "$timer" 2>/dev/null || true
    exit "$rc"
  } &
  run=$!
  if wait "$timer"; then
    : >"$fired"
    # The lock taken back the moment the stopped run lets it go, by a waiter on this process's own
    # open file, which keeps it once the waiter ends: held through the log line, the record, the
    # alerts and unload_self, so no disable reads the run as over and boots its job out meanwhile.
    exec {run_fd}>>"$state/heartbeat.lock"
    flock -w "$((KILL_SECONDS + 10))" "$run_fd" &
    holder=$!
    stop_tree "$run"
    wait "$run" 2>/dev/null || true
    wait "$holder" && locked=1
    rm -f "$fired"
    problem run "failed: timed out after $RUN_TIMEOUT s"
    # The record of a run the limit stopped, from the results it left.
    read -r run_start run_id < <(jq -r 'select(.start) | "\(.start) \(.id)"' "$results" | head -n 1) || true
    if [[ -n $run_start ]]; then
      machine=$(machine_name 2>/dev/null) || machine=''
      step_fail run "timed out after $RUN_TIMEOUT s"
      write_record timed-out
      # Its alerts judged as at any run's end, under the lock taken back above.
      if ((locked)) && jq -se 'any(.[]; .holding == true)' "$results" >/dev/null 2>&1; then
        alerts_step || true
      fi
    fi
    ! disabled_job || unload_self
    exit 1
  fi
  wait "$run" || rc=$?
  rm -f "$fired"
  ! disabled_job || unload_self
  exit "$rc"
}

# The watch: a line each time the offline flag appears or goes, until killed; with --once, the
# first change from the flag as it finds it, and then it ends.
watch() {
  local seen='' since
  if ((once)); then
    seen=$(offline_since) || seen=''
    sleep "$WATCH_SECONDS"
  fi
  while :; do
    since=$(offline_since) || since=''
    if [[ $since != "$seen" ]]; then
      if [[ -n $since ]]; then
        echo "GitHub unreachable since $since; the team is holding"
      else
        echo "GitHub answers again (unreachable from $seen); the hold is over"
      fi
      ((!once)) || return 0
      seen=$since
    fi
    sleep "$WATCH_SECONDS"
  done
}

case $command in
  enable)
    mgr=$(manager) || exit 1
    check_plain "$TEAM_HOME" "$PATH" "$program" "$state"
    mkdir -p "$state"
    "enable_$mgr"
    ;;
  disable)
    mgr=$(manager) || exit 1
    "disable_$mgr"
    ;;
  status)
    mgr=$(manager) || exit 1
    status
    ;;
  health) health_command ;;
  run) bounded_run ;;
  watch) watch ;;
esac
