#!/usr/bin/env bash
# Open a task: its number, plan, worktree from the project's pool, Discord thread and ledger entry.
#
# Usage: team-open [--task T<n>] [--story E<nn>/F<nn>/S<nn>] <project> <path> <type> <slug> <title...>
#        team-open [--task T<n>] [--story E<nn>/F<nn>/S<nn>] --queued <file> [<project> <path> <type> <slug> <title...>]
#        team-open --task T<n> --add <project> <type> <slug>
#        team-open --task T<n> --resume <project> [--ticket <NN>]
#        team-open --task T<n> --ticket <NN>
#   project  a project in projects.toml (team-project --list)
#   path     feature | bug | small | research | retro (retro marks a retro task for team-retro)
#   type     the branch prefix: feat | fix | docs | chore | build | ci | test | refactor | perf | research
#   slug     lower-case kebab case, at most 40 characters; the branch is <type>/T<n>-<slug>
# Without --task, claims the next task number by creating tasks/T<n>/. With --task, opens that
# task, keeping an existing tasks/T<n>/plan.md, and refuses a task that already has an opened
# event; after a failure, re-running with --task finishes the half-open task in the slot that
# holds its branch.
# Fetches the base in the primary checkout and puts a trusted slot on the branch from origin/<base>
# (no upstream). Before taking a slot, in every form, the primary checkout follows the base, so the
# lease and return commands run from it are current: on the base, with no local changes to tracked
# files and no commits origin's lacks, it is fast-forwarded to origin's (untracked files aside,
# unless in the way), said on one line (nothing is said when it is level already); else it is left
# as it is, with the reason on one line. A primary checkout that is the team home is left to the
# next records push, said on one line. A git pool adds its first registered slot that is free,
# else the lowest free <primary>/.claude/worktrees/<n> from 1, made on demand, so it is never full;
# free is no worktree of the primary checkout and missing or empty, and a folder in the way that
# holds files is skipped, said on one line. A git pool trusts each such numbered worktree as it
# does a registered slot. The pick and the add are made under the pool's lock (team-open-pool.lock
# in the primary checkout's git directory; pool_add_worktree in bin/lib/team.sh), so two runs at
# once take two worktrees, and a run that waits on it 10 minutes (TEAM_OPEN_POOL_WAIT_SECONDS,
# default 600) exits 75. A treehouse pool is read first (`treehouse
# status --json` in the primary checkout, refused when it does not answer): a slot an earlier run
# left leased to the task is taken again; else the project's lease command runs from the primary
# checkout with the task as the holder, and the path it prints is taken. A treehouse pool's trusted
# slots are the registry's and each other numbered one in their pool's folder (<pool>/<n>/<folder>,
# which treehouse may make past an empty folder). A path that is not a trusted slot, or no worktree
# of the primary checkout, or a slot with changes to tracked files, untracked files or a non-empty
# task directory, is refused, naming them, and handed back through the return command: with --force
# --if-lease-holder T<n> when this run leased it and the pool did not report it dirty before, so
# what the lease's own pre-warm changed is discarded and the lease always ends; else without, so a
# slot with changes stays leased, for Daniel to look at (a slot dirty before its lease, or leased by
# an earlier run, may hold someone's work). Then makes the task directory (refused, and the slot
# removed or returned again, unless git ignores it), writes tasks/T<n>/plan.md from
# templates/plan.md, opens the thread (team-thread) and appends opened.
# --queued opens the task that builds the queued item tasks/queued/<file>. Before anything is taken
# it reads the item through team-queue list --json and refuses one that is not ready: not queued,
# unranked, opened, taken, or waiting ("<file> waits for <reasons>; open it without --queued and
# link it with team-queue take when that is meant"), and refuses a <project> given that is not the
# item's. With the file alone, the project is the item's, the path small for size S and feature for
# M and L, the type fix for small and feat for feature, the slug the file name less .md, cut to 40
# characters at its last "-" within them, or at 40 when a "-" follows them (a slug that is still no
# valid one is refused, naming the form with every argument), and the title the item's, else its
# summary; given, every argument is taken as given. Once the task is open, the plan gets the line
# "From the queue: `tasks/queued/<file>`: <summary>" below its "## Why" comment, and team-queue take
# T<n> <file> links the item; a take that fails is one line on stderr naming the command to run, and
# the open still succeeds, since the heartbeat's queue step links an item a plan cites.
# --story names the backlog story the task builds, whose file must be in the team home's
# projects/<project>/backlog/ (story_file in bin/lib/team.sh; refused before anything is taken
# otherwise): opened and the printed facts carry it as story, and team-merge marks it done.
# Prints the task's facts as JSON; the project's other open tasks go to stderr, each with the files
# its branch changes against the base (git diff --name-only origin/<base>...<branch>, origin's
# branch when pushed, else the local one), or "no branch yet". Exit 75 when a new task has no room
# (below), when the pool's lock stays held (a git pool's only exit 75 is its lock), or when the
# lease command fails (a treehouse pool, whose own max_trees caps it), listing the slots and who
# holds them (a lease holder, else the task its branch names).
# The level bounds the open tasks, the pool listing no bound but a treehouse pool's own max_trees:
# a new task (the form with a path, type, slug and title, with or without --task) first runs its
# own checkout's team-capacity admit --kind session:builder --dry-run, after the arguments and the
# registry are read and before the number is claimed or anything is taken, since every task soon
# launches a builder, the largest worker it starts. With no room it exits 75,
# "team-open: no room to open a task: <team-capacity's reason>", naming the level, and memory
# when that is short; when team-capacity cannot tell (no reading to size the budget by), exit 1,
# "team-open: cannot tell whether a task fits: <its reason>"; either way nothing is claimed. It
# is skipped when a worktree already holds the task's branch (finishing a half-open task), and
# never runs for --add, --ticket or --resume, whose task is open already. Each launch is still
# admitted on its own by team-worker, so two opens at once may both pass the check while only one
# of their builders fits.
# With --add, gives the open task T<n> a worktree in another project, on <type>/T<n>-<slug>: the
# same pool steps, then worktree-added, with no plan, thread or opened. Refused for a task with
# no opened event or with a closed one, and for a project the task already has an open worktree in.
# With --resume, makes this machine's worktree for the open task T<n>'s open worktree in <project>,
# as the machine taking the team over does: a worktree of the primary checkout already holding the
# task's branch (the recorded one, re-rooted to this HOME, first, then one the pool trusts), else
# the recorded path when the pool trusts it and it is free (a git pool: an on-demand one is made
# again at the same path), else one from the pool as above. The branch is made equal to origin's:
# created from it, or fast-forwarded to it (refused when the worktree holding it has
# uncommitted changes); a branch here with commits origin's lacks is refused, with the command
# that pushes them to the team home's origin (never the project's) as
# salvage/<project>/T<n>-<machine>. Then the task's archive (tasks/T<n>/scratch, or
# scratch-<project> for an added project) replaces the task directory, but for what no archive
# holds (what archive_left_out in bin/lib/team.sh leaves out), which stays as it is;
# worktree-moved is appended when the worktree is not the recorded one, else rehomed while a
# rehome-failed of the task in <project> stands (team-resume's, which either clears), and the
# worktree's facts are printed as JSON. For a
# worktree that resumes from a snapshot (the task crashed: its latest stowed, stow-failed, launch or
# worktree-moved is a launch on another machine than this one, or on none named, so that machine
# stopped without a handoff, while one last launched here is no crash, its worktree live here; or
# its latest stowed recorded the worktree with uncommitted changes, which the handoff's checkpoint
# kept), or a branch on neither origin nor here, the last checkpoint's wip/<project>/T<n> is fetched
# from the team home's origin into refs/remotes/team-home/ (so nothing counts it as on the project's
# origin): the branch head it holds (a clean checkpoint's head, or a snapshot's parent) is the
# branch's when origin has no branch or it is behind that head. For a worktree that resumes from a
# snapshot, the snapshot's diff against its parent is then applied to the worktree as uncommitted
# changes, when that parent is the branch's head and the worktree has no other uncommitted changes;
# else it is skipped with the reason. Its facts are the JSON's snapshot, {ref, commit, parent, at,
# applied, reason}, parent null for a clean checkpoint's head, null for a worktree that does not
# resume from one.
# Needs this machine's name; refused for a task that is not open or has no open worktree in
# <project>; re-running after a failure finishes it.
# With --resume and --ticket NN (either side of --resume <project>), the same for ticket NN's open
# ticket worktree in <project>, whose branch, never pushed, is kept only as wip/<project>/T<n>--NN
# on the team home's origin, by the checkpoint: that ref is always fetched, and refused when it is
# missing; the ticket branch goes to its head (a clean checkpoint's head, or a snapshot's parent),
# but a branch here that holds that head is kept, said on stderr, and one with commits it lacks is
# refused with the push of it as salvage/<project>/T<n>--NN-<machine>. A snapshot is applied as
# above when the task crashed or its latest stowed recorded that ticket worktree with uncommitted
# changes (snapshot_due by project and ticket). The archive is the ticket worktree's,
# tasks/T<n>/scratch--NN (scratch-<project>--NN for an added project); worktree-moved and rehomed
# (while a rehome-failed of that ticket stands) carry ticket, and the JSON gains ticket.
# With --ticket, gives ticket NN of the open task T<n> a ticket worktree of its own, in the project
# of the task directory team-tickets T<n> --json reads the ticket from, for a phase whose tickets
# build in parallel: refused for a task with no opened event or with a closed one, for an NN that
# is none of the task's tickets, and for a ticket whose project has no open worktree of the task
# here (the task worktree, whose branch is the task branch). An open ticket worktree of NN already
# is printed as below, and said on stderr ("T<n>'s ticket NN already has its worktree <path>"),
# exit 0. Else the pool steps above, a treehouse lease's holder T<n>--NN, with the start the task
# branch's local tip (refs/heads/<task branch>) and the branch the ticket branch <task branch>--NN,
# never pushed; it fetches nothing and the primary checkout does not follow the base, so it runs
# offline. A ticket branch that exists already (an unintegrated ticket worktree returned at a
# close) is moved to the task branch's tip when the tip holds its head, said on stderr, and
# refused when it has commits the task branch lacks. Then the task directory, refused as above
# when git does not ignore it, takes a copy of the task worktree's spec.md, scope.txt, tickets/
# and build-notes/ (each that exists), and worktree-added is appended with ticket, base the task
# branch and base_sha the tip the branch was cut from. Prints {task, project, branch, base,
# base_sha, worktree, task_dir, ticket} as JSON; a half-open run is finished by running it again.
# Refused, exit 1, before it reads or changes anything: a worker session (an AGENT_TEAM_ROLE but
# coordinator; worker_refusal in bin/lib/team.sh), in every form; --help still answers.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
why=$(worker_refusal "" "opens no task") && die "$why"

bin=$(dirname "$TEAM_LIB")
templates=$(dirname "$bin")/templates
ledger=$TEAM_HOME/ledger.jsonl
usage="usage: team-open [--task T<n>] [--story E<nn>/F<nn>/S<nn>] <project> <path> <type> <slug> <title...>"
add_usage="usage: team-open --task T<n> --add <project> <type> <slug>"
resume_usage="usage: team-open --task T<n> --resume <project> [--ticket <NN>]"
ticket_usage="usage: team-open --task T<n> --ticket <NN>"
queued_usage="usage: team-open [--task T<n>] [--story E<nn>/F<nn>/S<nn>] --queued <file> [<project> <path> <type> <slug> <title...>]"

task='' add='' resume='' story='' ticket='' queued_file='' queued_given=''
while [[ ${1:-} == --task || ${1:-} == --story || ${1:-} == --add || ${1:-} == --resume || ${1:-} == --ticket ||
  ${1:-} == --queued ]]; do
  case $1 in
    --add) add=1 && shift && continue ;;
    --resume) resume=1 && shift && continue ;;
  esac
  [[ $# -ge 2 ]] || usage_error "$usage"
  if [[ $1 == --ticket ]]; then
    ticket=$2
    shift 2
    [[ $ticket =~ ^[0-9]{2}$ ]] || usage_error "ticket must be a two-digit number like 03, got '$ticket'"
    continue
  fi
  if [[ $1 == --queued ]]; then
    [[ -z $queued_given ]] || usage_error "$queued_usage"
    queued_given=1 queued_file=$2
    shift 2
    continue
  fi
  if [[ $1 == --story ]]; then
    story=$2
    shift 2
    [[ $story =~ ^E[0-9]+/F[0-9]+/S[0-9]+$ ]] || usage_error "story must look like E<nn>/F<nn>/S<nn>, got '$story'"
    continue
  fi
  task=$2
  shift 2
  [[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"
done
[[ -z $add || -z $resume ]] || usage_error "--add and --resume do not go together"
[[ -z $story || (-z $add && -z $resume) ]] || usage_error "--story goes only with a new task, not with --add or --resume"
[[ -z $ticket || (-z $add && -z $story) ]] || usage_error "--ticket goes only with --task or --resume, not with --add or --story"
[[ -z $queued_given || (-z $add && -z $resume && -z $ticket) ]] ||
  usage_error "--queued goes only with a new task, not with --add, --resume or --ticket"
if [[ -n $ticket && -z $resume ]]; then
  [[ -n $task ]] || usage_error "--ticket needs --task T<n>, the open task whose ticket to give a worktree"
  [[ $# -eq 0 ]] || usage_error "$ticket_usage"
  path='' type='' slug='' title=''
  # The task must be open, and NN one of its tickets, whose project is the ticket's.
  events=$(open_task_events "$task")
  tickets=$(TEAM_HOME=$TEAM_HOME "$bin/team-tickets" "$task" --json) || exit 1
  project=$(jq -r --arg n "$ticket" 'map(select(.ticket == $n)) | first | .project // empty' <<<"$tickets")
  [[ -n $project ]] || die "$task has no ticket $ticket; its tickets: $(jq -r 'map(.ticket) | join(", ") | if . == "" then "none" else . end' <<<"$tickets")"
elif [[ -n $resume ]]; then
  [[ -n $task ]] || usage_error "--resume needs --task T<n>, the open task whose worktree to make here"
  if [[ $# -eq 3 && $2 == --ticket && -z $ticket ]]; then
    ticket=$3
    [[ $ticket =~ ^[0-9]{2}$ ]] || usage_error "ticket must be a two-digit number like 03, got '$ticket'"
    set -- "$1"
  fi
  [[ $# -eq 1 ]] || usage_error "$resume_usage"
  project=$1 path='' type='' slug='' title=''
elif [[ -n $add ]]; then
  [[ -n $task ]] || usage_error "--add needs --task T<n>, the open task to add a worktree to"
  [[ $# -eq 3 ]] || usage_error "$add_usage"
  project=$1 path='' type=$2 slug=$3 title=''
elif [[ -n $queued_given && $# -eq 0 ]]; then
  # The short form: every argument comes from the item, below.
  project='' path='' type='' slug='' title=''
else
  [[ $# -ge 5 ]] || usage_error "$(if [[ -n $queued_given ]]; then echo "$queued_usage"; else echo "$usage"; fi)"
  project=$1 path=$2 type=$3 slug=$4
  shift 4
  title="$*"
  [[ $path =~ ^(feature|bug|small|research|retro)$ ]] ||
    usage_error "path must be feature, bug, small, research or retro, got '$path'"
  [[ $title =~ [^[:space:]] ]] || usage_error "$usage"
fi
# A queued item: read through team-queue list before anything is taken, and refused unless it is
# ready; the short form's arguments are derived from it.
if [[ -n $queued_given ]]; then
  queue_err=$(mktemp)
  queue=$(TEAM_HOME=$TEAM_HOME "$bin/team-queue" list --json </dev/null 2>"$queue_err") || {
    why=$(grep . "$queue_err" | tail -n 1) || why="team-queue list failed with no reason given"
    rm -f "$queue_err"
    die "cannot read the queue: ${why#team-queue: }"
  }
  rm -f "$queue_err"
  is_queued=false
  [[ ! $queued_file =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.md$ || $queued_file == index.md ||
    ! -f $TEAM_HOME/tasks/queued/$queued_file ]] || is_queued=true
  # ready, the project, size, title and summary, or refuse and why, each ending in a NUL.
  mapfile -d '' -t item < <(jq -j --arg f "$queued_file" --argjson queued "$is_queued" '
    (first(.ready[] | select(.file == $f)) // null) as $ready
    | (first(.waiting[] | select(.file == $f)) // null) as $waiting
    | (first(.opened[] | select(.file == $f)) // null) as $opened
    | (first(.unranked[] | select(.file == $f)) // null) as $unranked
    | if $ready != null then ["ready", $ready.project, $ready.size, $ready.title, ($ready.summary // "")]
      elif $waiting != null then
        ["refuse", "\($f) waits for \([$waiting.waits // empty] + [$waiting.after[] | select(.met | not) | .condition] | join(", ")); open it without --queued and link it with team-queue take when that is meant"]
      elif $opened != null then ["refuse", "\($f) is opened by \($opened.opened), which builds it"]
      elif $unranked != null then
        ["refuse", "\($f) is unranked: \($unranked.problems | join("; ")); fix it first (team-queue index --check names it)"]
      elif $queued then
        ([.ready[], .waiting[], .opened[] | select(IN(.takes[]; $f)) | .file] | unique) as $takers
        | ["refuse", "\($f) is taken by \(if $takers == [] then "another queued item" else $takers | join(", ") end): open its taker instead"]
      else ["refuse", "\($f) is not queued (team-queue list)"] end
    | .[] | "\(.)\u0000"' <<<"$queue")
  [[ ${item[0]:-} == ready || ${item[0]:-} == refuse ]] || die "cannot read $queued_file from team-queue list"
  [[ ${item[0]} == ready ]] || die "${item[1]}"
  item_project=${item[1]} item_size=${item[2]} item_title=${item[3]} item_summary=${item[4]}
  if [[ -z $project ]]; then
    project=$item_project
    if [[ $item_size == S ]]; then path=small type=fix; else path=feature type=feat; fi
    slug=${queued_file%.md}
    if ((${#slug} > 40)); then
      slug=${slug:0:41}
      if [[ ${slug:40} == - ]]; then slug=${slug:0:40}; else slug=${slug:0:40} slug=${slug%-*}; fi
    fi
    [[ $slug =~ ^[a-z0-9]+(-[a-z0-9]+)*$ && ${#slug} -le 40 ]] ||
      die "the slug \"$slug\" from $queued_file is not lower-case kebab case of at most 40 characters; give every argument: team-open --queued $queued_file <project> <path> <type> <slug> <title...>"
    title=${item_title:-$item_summary}
    [[ $title =~ [^[:space:]] ]] || title=$item_summary
  elif [[ $project != "$item_project" ]]; then
    die "$queued_file is $item_project's, not $project's"
  fi
fi
if [[ -z $resume && -z $ticket ]]; then
  [[ $type =~ ^(feat|fix|docs|chore|build|ci|test|refactor|perf|research)$ ]] ||
    usage_error "type must be feat, fix, docs, chore, build, ci, test, refactor, perf or research, got '$type'"
  [[ $slug =~ ^[a-z0-9]+(-[a-z0-9]+)*$ && ${#slug} -le 40 ]] ||
    usage_error "slug must be lower-case kebab case of at most 40 characters, got '$slug'"
fi

# team-project refuses a broken registry itself, with every problem on stderr.
projects=$(team_project --list)
grep -qxF -- "$project" <<<"$projects" ||
  usage_error "unknown project '$project'; known: $(jq -Rnr '[inputs] | join(", ")' <<<"$projects")"
if [[ -n $resume ]]; then machine=$(machine_name) || exit 1; fi
[[ -z $story ]] || story_file "$project" "$story" >/dev/null || exit 1
facts=$(team_project "$project")
primary=$(jq -r .path <<<"$facts")
base=$(jq -r .base <<<"$facts")
task_dir=$(jq -r .task_dir <<<"$facts")
provider=$(jq -r .pool.provider <<<"$facts")
mapfile -t registered < <(jq -r '.pool.slots[]' <<<"$facts")
slots=()
git -C "$primary" rev-parse --git-dir >/dev/null 2>&1 || die "the primary checkout $primary is not a git checkout"
if [[ $provider == treehouse ]]; then
  mapfile -t slots < <(pool_slots treehouse "$primary" "${registered[@]}")
  lease=$(jq -r .pool.lease <<<"$facts")
  return_cmd=$(jq -r .pool.return <<<"$facts")
  [[ -x $lease ]] || die "the lease command $lease is not executable"
  [[ -x $return_cmd ]] || die "the return command $return_cmd is not executable"
fi

# The room check (see the header), before a new task claims its number or takes anything: the level
# must have room for a builder, the largest worker a task starts, as team-capacity admit would judge
# one now, keeping no admission. A worktree of the primary checkout already holding <branch> ("" for
# a number not yet claimed) is a half-open task to finish, which needs none.
room_to_open() {
  local list err rc=0 reason
  if [[ -n $1 ]]; then
    list=$(git -C "$primary" worktree list --porcelain)
    ! grep -qxF "branch refs/heads/$1" <<<"$list" || return 0
  fi
  err=$(TEAM_HOME=$TEAM_HOME "$bin/team-capacity" admit --kind session:builder --dry-run 2>&1 >/dev/null) || rc=$?
  ((rc != 0)) || return 0
  reason=$(grep . <<<"$err" | tail -n 1) || reason="team-capacity admit failed (exit $rc), giving no reason"
  if ((rc == 75)); then
    echo "team-open: no room to open a task: $reason" >&2
    exit 75
  fi
  die "cannot tell whether a task fits: $reason"
}

# The task number. Creating tasks/T<n>/ is the claim, so two runs never take the same number.
# --add claims nothing: its task must be open, with no open worktree in the project yet. --resume
# claims nothing either: its task must be open, with an open worktree in the project, whose
# branch, recorded path and archive it takes.
mkdir -p "$TEAM_HOME/tasks"
claimed=
if [[ -n $resume ]]; then
  events=$(open_task_events "$task")
  # The ticket worktree of NN, or the task's own worktree in the project (ticket null).
  nn=$(jq -n --arg n "$ticket" 'if $n == "" then null else $n end')
  open=$(ledger_jq 'archived_worktrees($home) | select(.project == $project and .ticket == $nn)' -c \
    --arg project "$project" --argjson nn "$nn" <<<"$events")
  [[ -n $open ]] || die "$task has no open worktree ${ticket:+of ticket $ticket }in $project"
  snapshot_due=$(ledger_jq 'snapshot_due($project; $nn; $machine)' --arg project "$project" --argjson nn "$nn" \
    --arg machine "$machine" <<<"$events")
  rehome_failed=$(ledger_jq 'any(rehome_failures[]; .project == $project and .ticket == $nn)' --arg project "$project" \
    --argjson nn "$nn" <<<"$events")
  branch=$(jq -r .branch <<<"$open")
  recorded=$(jq -r .worktree <<<"$open")
  archive=tasks/$task/$(jq -r .archive <<<"$open")
elif [[ -n $ticket ]]; then
  own=$(ledger_jq 'archived_worktrees($home) | select(.project == $project and .ticket == null)' -c \
    --arg project "$project" <<<"$events")
  [[ -n $own ]] || die "$task has no open worktree in $project, so ticket $ticket has no task branch to start from"
  task_branch=$(jq -r .branch <<<"$own")
  task_worktree=$(jq -r .worktree <<<"$own")
  # An open ticket worktree of NN already: its facts again, so a fill after a refused launch
  # reuses it.
  mine=$(ledger_jq '(map(select(.event == "worktree-added" and .ticket == $n)) | last) as $added
    | [open_worktrees(.[]; $home) | select(.ticket == $n)] | last | select(. != null)
    | {task, project, branch, base: $added.base, base_sha: $added.base_sha, worktree,
       task_dir: "\(.worktree)/\($dir)", ticket}' -c --arg n "$ticket" --arg dir "$task_dir" <<<"$events")
  if [[ -n $mine ]]; then
    echo "team-open: $task's ticket $ticket already has its worktree $(jq -r .worktree <<<"$mine")" >&2
    jq . <<<"$mine"
    exit 0
  fi
  [[ -d $task_worktree ]] || die "$task's worktree in $project, $task_worktree, is not on this machine"
  tip=$(git -C "$primary" rev-parse -q --verify "refs/heads/$task_branch^{commit}") ||
    die "the task branch $task_branch is not a branch of $primary"
elif [[ -n $add ]]; then
  open_task_events "$task" >/dev/null
  held=$(task_worktrees "$task" | jq -r --arg p "$project" 'select(.project == $p and .ticket == null) | "\(.worktree) (\(.branch))"')
  [[ -z $held ]] || die "$task already has an open worktree in $project: $held"
elif [[ -n $task ]]; then
  ! task_events "$task" | jq -se 'any(.[]; .event == "opened")' >/dev/null ||
    die "$task is already open: the ledger has its opened event"
  room_to_open "$type/$task-$slug"
  mkdir -p "$TEAM_HOME/tasks/$task"
else
  room_to_open ''
  n=$({
    ledger_jq 'ledger_events[].task' -nRr "$ledger"
    find "$TEAM_HOME/tasks" -mindepth 1 -maxdepth 1 -name 'T*' -printf '%f\n'
  } | sed -nE 's/^T([1-9][0-9]*)$/\1/p' | sort -n | tail -n 1)
  n=$((${n:-0} + 1))
  while ! mkdir "$TEAM_HOME/tasks/T$n" 2>/dev/null; do
    [[ -e $TEAM_HOME/tasks/T$n ]] || die "cannot create $TEAM_HOME/tasks/T$n"
    n=$((n + 1))
  done
  task=T$n claimed=1
fi
if [[ -n $resume ]]; then
  :
elif [[ -n $ticket ]]; then
  branch=$task_branch--$ticket
else
  branch=$type/$task-$slug
fi
# Who a treehouse lease is held by: the task, or for a ticket worktree T<n>--NN (resume_slot has a
# holder of its own).
lease_holder=$task${ticket:+--$ticket}

# On failure, a slot this run took and has not yet put on the branch is returned (forced when
# force_return is set: see the header), and a number this run claimed is given back while nothing
# holds it yet; once a slot holds the task's branch, the task is half open and re-running with
# --task (and --queued <file>, so the item is linked) finishes it.
worktree='' leased='' force_return='' lease_log='' new_branch=''
on_exit() {
  local status=$?
  [[ -z $lease_log ]] || rm -f "$lease_log"
  ((status != 0)) || return 0
  if [[ -n $leased && -n $force_return ]]; then
    if (cd "$primary" && "$return_cmd" "$leased" --force --if-lease-holder "$lease_holder") </dev/null >&2; then
      echo "team-open: handed $leased back to $return_cmd, discarding what its lease changed" >&2
    else
      echo "team-open: could not return $leased through $return_cmd; it stays leased to $lease_holder, and the next" \
        "run takes it again" >&2
    fi
  elif [[ -n $leased ]]; then
    if (cd "$primary" && "$return_cmd" "$leased") </dev/null >&2; then
      echo "team-open: handed $leased back to $return_cmd" >&2
    else
      echo "team-open: $leased stays leased to $lease_holder, which is Daniel's word: once nothing in it is needed," \
        "return it in a terminal, which asks before discarding: cd $primary && $return_cmd $leased" >&2
    fi
  fi
  if [[ -z $worktree ]]; then
    [[ -z $claimed ]] || rmdir "$TEAM_HOME/tasks/$task" 2>/dev/null || true
    return 0
  fi
  if [[ -n $resume ]]; then
    echo "team-open: $task's ${ticket:+ticket $ticket }worktree in $project is $worktree, not yet finished; finish it with:" \
      "team-open --task $task --resume $project${ticket:+ --ticket $ticket}" >&2
  elif [[ -n $ticket ]]; then
    echo "team-open: $task's ticket $ticket is half open in $worktree; finish it with:" \
      "team-open --task $task --ticket $ticket" >&2
  elif [[ -n $add ]]; then
    echo "team-open: $task is half open in $worktree; finish it with:" \
      "team-open --task $task --add $project $type $slug" >&2
  else
    echo "team-open: $task is half open in $worktree; finish it with:" \
      "team-open --task $task${queued_given:+ --queued $queued_file} $project $path $type $slug $(printf '%q' "$title")" >&2
  fi
}
trap on_exit EXIT

# Once the task is open, say in its plan that it is built from the queued item, a line below the
# "## Why" comment (after the comment's end, else before the next heading, else at the end, and
# never twice), and link the item with team-queue take; a take that fails is one line on stderr
# naming the command, never a failure of the open, since the heartbeat's queue step links an item
# a plan cites: link_queued
link_queued() {
  local line="From the queue: \`tasks/queued/$queued_file\`: $item_summary" out rc=0
  if ! grep -qxF -- "$line" "$plan"; then
    if awk -v line="$line" '
      !done && why && /^## / { print line; print ""; done = 1 }
      { print }
      !done && /^## Why$/ { why = 1; next }
      !done && why && /-->[[:space:]]*$/ { print ""; print line; done = 1 }
      END { if (!done) { print ""; print line } }' "$plan" >"$plan.$$"; then
      mv -f "$plan.$$" "$plan"
    else
      rm -f "$plan.$$"
      echo "team-open: cannot write the queue's line into $plan" >&2
    fi
  fi
  out=$(TEAM_HOME=$TEAM_HOME "$bin/team-queue" take "$task" "$queued_file" </dev/null 2>&1) || rc=$?
  if ((rc == 0)); then
    [[ -z $out ]] || printf 'team-open: %s\n' "${out//$'\n'/$'\n'team-open: }" >&2
  else
    echo "team-open: team-queue take $task $queued_file failed ($(grep -m1 . <<<"$out" || echo "no reason given")); run it to link the item: team-queue take $task $queued_file" >&2
  fi
}

# A new branch starts at origin's base; a resumed one is origin's branch, made here when missing,
# and a ticket branch, never pushed, its wip ref's head.
if [[ -n $resume ]]; then
  remote=''
  if [[ -z $ticket ]]; then
    remote=$(git -C "$primary" ls-remote origin "refs/heads/$branch") || die "cannot reach origin from $primary"
    remote=${remote%%[[:space:]]*}
  fi
  if [[ -n $remote ]]; then
    git -C "$primary" fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" ||
      die "cannot fetch $branch from origin in $primary"
  fi
  here=$(git -C "$primary" rev-parse -q --verify "refs/heads/$branch^{commit}") || here=''
  # The last checkpoint's wip/<project>/T<n> on the team home's origin, when the worktree resumes
  # from its snapshot (after a crash, or a handoff that stopped a worker with uncommitted changes)
  # or for a branch that is nowhere else: a snapshot (its parent is the branch head it saw) or the
  # branch head itself. A head there that origin's branch lacks, or a branch only there, is where
  # the branch goes: target. A ticket worktree's is wip/<project>/T<n>--NN, read always, since
  # nothing else keeps its branch.
  wip='' wip_head='' target=$remote target_name="origin's $branch" wip_ref=wip/$project/$task${ticket:+--$ticket}
  if [[ -n $ticket || $snapshot_due == true || (-z $remote && -z $here) ]]; then
    wip_url=$(wip_origin) || exit 1
    wip=$(git -C "$primary" ls-remote "$wip_url" "refs/heads/$wip_ref") ||
      die "cannot reach the team home's origin from $primary"
    wip=${wip%%[[:space:]]*}
  fi
  if [[ -n $wip ]]; then
    git -C "$primary" fetch -q "$wip_url" "+refs/heads/$wip_ref:refs/remotes/team-home/$wip_ref" ||
      die "cannot fetch $wip_ref from the team home's origin in $primary"
    wip_head=$wip
    if is_snapshot "$primary" "$wip" "$task"; then wip_head=$(git -C "$primary" rev-parse "$wip^1"); fi
    if [[ -n $ticket ]]; then
      # A ticket branch here holding the ref's head is this machine's later work: kept.
      target=$wip_head target_name=$wip_ref
      if [[ -n $here && $here != "$wip_head" ]] && git -C "$primary" merge-base --is-ancestor "$wip_head" "$here"; then
        target=$here target_name="$branch here"
        echo "team-open: $branch here is at ${here:0:7}, past $wip_ref at ${wip_head:0:7}, so it is kept" >&2
      fi
    elif [[ -z $remote ]] ||
      { [[ $wip_head != "$remote" ]] && git -C "$primary" merge-base --is-ancestor "$remote" "$wip_head"; }; then
      target=$wip_head target_name=$wip_ref
      if [[ -z $remote ]]; then
        echo "team-open: $branch is not on origin; it is taken from $wip_ref, at ${wip_head:0:7}" >&2
      else
        echo "team-open: $wip_ref has commits origin's $branch lacks; $branch is taken from it, at ${wip_head:0:7}" >&2
      fi
    fi
  fi
  [[ -n $wip || -z $ticket ]] ||
    die "$branch is on no origin, a ticket branch being never pushed, and the team home's origin has no $wip_ref," \
      "so $task's ticket $ticket worktree in $project cannot be made here"
  [[ -n $target || -n $here ]] ||
    die "$branch is neither on origin nor here, so $task's worktree in $project cannot be made here"
  start=''
  [[ -n $here ]] || start=$target
elif [[ -n $ticket ]]; then
  # The ticket branch starts at the task branch's local tip, with nothing fetched. One left by an
  # earlier ticket worktree of NN is moved there when the tip holds it.
  start=$tip new_branch=1
  if old=$(git -C "$primary" rev-parse -q --verify "refs/heads/$branch^{commit}"); then
    start='' new_branch=''
  fi
else
  git -C "$primary" fetch -q origin "$base" || die "cannot fetch $base from origin in $primary"
  start=origin/$base new_branch=1
fi

# The primary checkout's registered worktrees: real path -> checked-out branch ("" when detached),
# looked up by held and branch_at; pool_add_worktree reads them again under the pool's lock.
declare -A holds=()
while IFS=$'\t' read -r wt wt_branch; do
  holds[$(realpath -m -- "$wt")]=$wt_branch
done < <(git -C "$primary" worktree list --porcelain | awk '
  /^worktree / { if (path != "") print path "\t" branch; path = substr($0, 10); branch = "" }
  /^branch refs\/heads\// { branch = substr($0, 19) }
  END { if (path != "") print path "\t" branch }')

# The registered worktree that is the path <path>, however either is spelled (same_path), as
# holds names it; fails, printing nothing, when none is: held <path>
held() {
  local wt
  for wt in "${!holds[@]}"; do
    if same_path "$wt" "$1"; then echo "$wt" && return 0; fi
  done
  return 1
}

# The branch of the registered worktree that is the path <path>: nothing when it is detached, or
# when no registered worktree is <path>: branch_at <path>
branch_at() {
  local wt
  wt=$(held "$1") || return 0
  echo "${holds[$wt]}"
}

# Each slot, with the task holding it (a treehouse pool's lease holder, else from its branch's
# name) and its branch, on stderr.
list_slots() {
  local slot wt_branch holder leases=''
  [[ $provider != treehouse ]] || leases=$(pool_status "$primary") || leases=''
  for slot in "${slots[@]}"; do
    if ! held "$slot" >/dev/null; then
      echo "  $slot: not a worktree" >&2
      continue
    fi
    wt_branch=$(branch_at "$slot")
    holder=$(pool_entry "$leases" "$slot" | jq -r 'select(.holder != "") | .holder') || holder=''
    if [[ -n $holder ]]; then
      echo "  $slot: $holder (leased; ${wt_branch:-detached HEAD})" >&2
      continue
    fi
    holder=$(sed -nE 's#^[^/]+/(T[1-9][0-9]*)-.*#\1#p' <<<"$wt_branch")
    echo "  $slot: ${holder:-no task} (${wt_branch:-detached HEAD})" >&2
  done
}

# A git pool: add the path given while it is still free, else a free registered slot, else the
# lowest free <primary>/.claude/worktrees/<n> (pool_add_worktree, under the pool's lock), on the
# branch: a new one from $start (no upstream), or the existing one when $start is empty.
take_git_slot() {
  local found
  if [[ -n $start ]]; then
    found=$(pool_add_worktree "$primary" "${1:-}" ${registered[@]+"${registered[@]}"} -- --no-track -b "$branch" "$start") ||
      exit $?
  else
    found=$(pool_add_worktree "$primary" "${1:-}" ${registered[@]+"${registered[@]}"} -- "$branch") || exit $?
  fi
  worktree=$found added=1
}

# A treehouse pool: take the slot an earlier run left leased to the task, else lease one for it;
# check it is trusted and clean, then switch it to the branch. The lease command's stderr (its
# pre-warm progress) is shown only when it fails.
take_treehouse_slot() {
  local slot trusted='' found=() list changes pool dirty=''
  pool=$(pool_status "$primary") || die "cannot read $project's pool: treehouse status --json did not answer in $primary"
  # Never one on a branch: that is a worktree, not a lease a failed run left.
  while IFS= read -r slot; do
    if [[ -z $leased && -z $(branch_at "$slot") ]]; then leased=$slot; fi
  done < <(jq -r --arg holder "$lease_holder" 'select(.holder == $holder) | .path' <<<"$pool")
  if [[ -n $leased ]]; then
    echo "team-open: $leased is already leased to $lease_holder, by an earlier run; it is taken again" >&2
  else
    lease_log=$(mktemp)
    if ! leased=$(cd "$primary" && "$lease" "$lease_holder" 2>"$lease_log"); then
      leased=
      echo "team-open: $project's lease command found no free slot:" >&2
      cat "$lease_log" >&2
      echo "team-open: $project's slots:" >&2
      list_slots
      exit 75
    fi
    [[ -n $leased ]] || die "the lease command $lease printed no path"
    # Leased by this run: forced back on failure, unless the pool saw it dirty before the lease.
    dirty=$(pool_entry "$pool" "$leased" | jq -r 'select(.status == "dirty") | .path') || dirty=''
    [[ -n $dirty ]] || force_return=1
  fi
  # The lease may have made a numbered slot the registry lacks, which the pool trusts too.
  trusted=$(pool_trusted treehouse "$primary" "$leased" "${registered[@]}") ||
    die "the lease command handed out $leased, which is not one of $project's slots"
  changes=$(slot_changes "$primary" "$trusted" "$task_dir") || die "$changes"
  if [[ -n $changes ]]; then
    mapfile -t found <<<"$changes"
    list=$(printf '%s; ' "${found[@]}")
    if [[ -n $force_return ]]; then
      die "the leased slot $trusted is not clean: ${list%; }; it was clean before this lease, so the lease" \
        "command's pre-warm made these changes, which the return discards"
    elif [[ -n $dirty ]]; then
      die "the leased slot $trusted is not clean: ${list%; }; the pool reported it dirty before this lease," \
        "so the changes may be someone's work"
    fi
    die "the leased slot $trusted is not clean: ${list%; }; an earlier run leased it, so the changes may be" \
      "someone's work"
  fi

  if [[ -n $start ]]; then
    git -C "$trusted" switch -q --no-track -c "$branch" "$start" || die "cannot switch the leased slot $trusted to $branch"
  else
    git -C "$trusted" switch -q "$branch" || die "cannot switch the leased slot $trusted to $branch"
  fi
  worktree=$trusted added=1 leased='' force_return=''
}

# Undo take_*_slot for a slot this run took: remove or return it, and drop a new branch.
release_slot() {
  case $provider in
    git) git -C "$primary" worktree remove --force "$worktree" ;;
    treehouse)
      (cd "$worktree" && rmdir -p -- "$task_dir" 2>/dev/null) || true
      git -C "$worktree" switch -q --detach
      leased=$worktree
      ;;
  esac
  [[ -z $new_branch ]] || git -C "$primary" branch -q -D "$branch"
  worktree=
}

# The path <path> as the pool trusts it (pool_trusted: a registered slot, or a numbered worktree
# of the pool's), if it does.
slot_at() {
  pool_trusted "$provider" "$primary" "$1" ${registered[@]+"${registered[@]}"} || true
}

# --resume: the worktree already holding the branch (the recorded one or a slot) is brought up to
# origin's head, a branch here with commits origin's lacks is refused, and with no worktree holding
# it, the recorded slot when free, else one from the pool, is put on it.
resume_slot() {
  local wt holder='' salvage ref url found=() list
  for wt in "${!holds[@]}"; do
    [[ ${holds[$wt]} != "$branch" ]] && continue
    if same_path "$wt" "$recorded"; then
      holder=$recorded
    else
      holder=$(slot_at "$wt")
      [[ -n $holder ]] || die "$branch is checked out in $wt, which is not one of $project's slots"
    fi
  done
  if [[ -n $here && -n $target && $here != "$target" ]] && ! git -C "$primary" merge-base --is-ancestor "$here" "$target"; then
    # To the team home's origin, as a snapshot goes: the project's origin may be public.
    url=$(wip_origin) || exit 1
    ref=refs/heads/salvage/$project/$task${ticket:+--$ticket}-$machine
    salvage="git -C $primary push $url refs/heads/$branch:$ref"
    [[ -z $holder ]] || salvage="git -C $holder push $url HEAD:$ref"
    die "$branch here has commits that $target_name lacks; save them with: $salvage," \
      "then make $branch here equal to $target_name and run this again"
  fi
  if [[ -n $holder ]]; then
    if [[ -n $target && $here != "$target" ]]; then
      mapfile -t found < <(worktree_changes "$holder")
      if ((${#found[@]})); then
        list=$(printf '%s; ' "${found[@]}")
        die "$holder has uncommitted changes (${list%; }) on $branch at ${here:0:7}, which is behind" \
          "$target_name at ${target:0:7}; save or discard them, then run this again"
      fi
      git -C "$holder" merge -q --ff-only "$target" || die "cannot fast-forward $holder to $target_name"
    fi
    worktree=$holder
    return
  fi
  if [[ -n $here && -n $target && $here != "$target" ]]; then
    git -C "$primary" update-ref "refs/heads/$branch" "$target" "$here"
  fi
  case $provider in
    git) take_git_slot "$(slot_at "$recorded")" ;;
    treehouse) take_treehouse_slot ;;
    *) die "team-open does not take worktrees from a $provider pool" ;;
  esac
}

# --resume of a worktree that resumes from a snapshot: the last checkpoint's (wip/<project>/T<n>,
# fetched above) applied to the worktree as uncommitted changes when its parent is the head the branch was
# made equal to (target), which the worktree is at now, and the worktree has no other uncommitted
# changes.
# Sets snapshot to its facts, {ref, commit, parent, at, applied, reason}, parent null when
# wip/<project>/T<n> is the branch head of a clean checkpoint, and says what it did on stderr.
apply_snapshot() {
  local ref=$wip_ref parent='' at reason='' current patch
  if [[ -z $wip ]]; then
    reason="the team home's origin has no $ref: no checkpoint saved this task's work"
    echo "team-open: $ref not applied: $reason" >&2
    snapshot=$(jq -cn --arg ref "$ref" --arg reason "$reason" \
      '{ref: $ref, commit: null, parent: null, at: null, applied: false, reason: $reason}')
    return
  fi
  at=$(git -C "$primary" show -s --format=%ct "$wip" | jq -r 'tonumber | todate')
  current=$(worktree_tree "$worktree") || die "cannot read the changes in $worktree"
  if [[ $wip_head == "$wip" ]]; then
    reason="the checkpoint saw no uncommitted changes"
  else
    parent=$wip_head
    if [[ $parent != "$target" ]]; then
      if git -C "$primary" merge-base --is-ancestor "$parent" "$target"; then
        reason="$target_name is at ${target:0:7}, past the snapshot's parent ${parent:0:7}"
      else
        reason="the snapshot's parent ${parent:0:7} is not on $target_name, which is at ${target:0:7}"
      fi
    elif [[ $current == "$(git -C "$primary" rev-parse "$wip^{tree}")" ]]; then
      echo "team-open: $ref ${wip:0:7} (the checkpoint of $at) is already applied in $worktree" >&2
    elif [[ $current != "$(git -C "$worktree" rev-parse "HEAD^{tree}")" ]]; then
      reason="$worktree has uncommitted changes other than the snapshot's, so it is not applied over them"
    else
      patch=$(mktemp)
      git -C "$primary" diff --binary "$parent" "$wip" >"$patch"
      if ! git -C "$worktree" apply --whitespace=nowarn "$patch"; then
        rm -f "$patch"
        die "cannot apply $ref ${wip:0:7} to $worktree"
      fi
      rm -f "$patch"
      echo "team-open: applied $ref ${wip:0:7} (the checkpoint of $at) to $worktree as uncommitted changes" >&2
    fi
  fi
  [[ -z $reason ]] || echo "team-open: $ref ${wip:0:7} not applied: $reason" >&2
  snapshot=$(jq -cn --arg ref "$ref" --arg commit "$wip" --arg parent "$parent" --arg at "$at" --arg reason "$reason" \
    '{ref: $ref, commit: $commit, parent: (if $parent == "" then null else $parent end), at: $at,
      applied: ($reason == ""), reason: (if $reason == "" then null else $reason end)}')
}

# The primary checkout follows the base, so the pool's lease and return commands it holds, run from
# it, are the merged ones: brought level with origin's when it can be, else left as it is.
# A new ticket worktree needs no network, so it leaves the primary checkout as it is.
if [[ -n $ticket && -z $resume ]]; then
  :
elif same_path "$primary" "$TEAM_HOME"; then
  echo "team-open: the primary checkout $primary is the team home, so the next records push (team-checkpoint, team-handoff) brings it level with origin's $base" >&2
else
  NET_ERR=$(mktemp)
  if follow_base "$primary" "$base"; then
    [[ $FF_RESULT == *" is up to date at "* ]] || echo "team-open: the primary checkout $primary: $FF_RESULT" >&2
  else
    echo "team-open: the primary checkout $primary is left as it is: $FOLLOW_REASON" >&2
  fi
  rm -f "$NET_ERR"
fi

# The trusted worktree already holding the task's branch (a half-open task), else one from the
# pool; the branch checked out anywhere else is refused.
added=
if [[ -n $resume ]]; then
  resume_slot
else
  for wt in "${!holds[@]}"; do
    [[ ${holds[$wt]} == "$branch" ]] || continue
    worktree=$(slot_at "$wt")
    [[ -n $worktree ]] || die "$branch is checked out in $wt, which is not one of $project's slots"
  done
fi
if [[ -z $worktree ]]; then
  if [[ -n $ticket && -z $new_branch ]]; then
    git -C "$primary" merge-base --is-ancestor "$old" "$tip" ||
      die "the branch $branch exists at ${old:0:8} with commits the task branch lacks; integrate or remove it first"
    if [[ $old != "$tip" ]]; then
      git -C "$primary" update-ref "refs/heads/$branch" "$tip" "$old"
      echo "team-open: moved $branch from ${old:0:8} to the task branch's tip ${tip:0:8}" >&2
    fi
  else
    ! git -C "$primary" show-ref -q --verify "refs/heads/$branch" ||
      die "branch $branch already exists in $primary but no slot holds it"
  fi
  case $provider in
    git) take_git_slot ;;
    treehouse) take_treehouse_slot ;;
    *) die "team-open does not take worktrees from a $provider pool" ;;
  esac
fi
if [[ -n $resume ]]; then
  :
elif [[ -n $ticket ]]; then
  base_sha=$(git -C "$worktree" merge-base HEAD "$tip")
else
  base_sha=$(git -C "$worktree" merge-base HEAD "origin/$base")
fi

# The task directory must never be committed: refuse a project whose git does not ignore it.
mkdir -p "$worktree/$task_dir"
if ! git -C "$worktree" check-ignore -q -- "$task_dir"; then
  [[ -z $added ]] || release_slot
  die "git does not ignore $task_dir in $project; add it to the project's .gitignore first"
fi

if [[ -n $resume ]]; then
  # The archive is the task directory as the last checkpoint or handoff left it, wherever it was.
  restored=null
  if [[ -d $TEAM_HOME/$archive ]]; then
    # What an archive leaves out of the task directory stays here as it is.
    keep=$(mktemp)
    while IFS=$'\t' read -r -d '' _ left; do rsync_rule "$left"; done < <(archive_left_out "$worktree/$task_dir") >"$keep"
    if ! rsync -a --delete --from0 --exclude-from="$keep" -- "$TEAM_HOME/$archive/" "$worktree/$task_dir/"; then
      rm -f "$keep"
      die "cannot mirror $archive into $worktree/$task_dir"
    fi
    rm -f "$keep"
    restored=$(jq -n --arg a "$archive" '$a')
  else
    echo "team-open: $task has no archive at $archive; $worktree/$task_dir is left as it is" >&2
  fi
  snapshot=null
  [[ $snapshot_due != true ]] || apply_snapshot
  moved=false
  if ! same_path "$worktree" "$recorded"; then
    moved=true
    ledger_append "$(jq -cn --arg task "$task" --arg project "$project" --arg branch "$branch" --arg from "$recorded" \
      --arg worktree "$worktree" --arg machine "$machine" --argjson nn "$nn" \
      '{ts: (now | todate), task: $task, event: "worktree-moved", project: $project, branch: $branch,
        from: $from, worktree: $worktree, machine: $machine} + if $nn then {ticket: $nn} else {} end')"
  elif [[ $rehome_failed == true ]]; then
    ledger_append "$(jq -cn --arg task "$task" --arg project "$project" --arg branch "$branch" \
      --arg worktree "$worktree" --arg machine "$machine" --argjson nn "$nn" \
      '{ts: (now | todate), task: $task, event: "rehomed", project: $project, branch: $branch,
        worktree: $worktree, machine: $machine} + if $nn then {ticket: $nn} else {} end')"
  fi

  jq -n --arg task "$task" --arg project "$project" --arg branch "$branch" --arg worktree "$worktree" \
    --arg task_dir "$worktree/$task_dir" --arg head "$(git -C "$worktree" rev-parse HEAD)" --arg from "$recorded" \
    --argjson moved "$moved" --argjson archive "$restored" --argjson snapshot "$snapshot" --argjson nn "$nn" \
    '{task: $task, project: $project, branch: $branch, worktree: $worktree, task_dir: $task_dir, head: $head,
      from: $from, moved: $moved, archive: $archive, snapshot: $snapshot} + if $nn then {ticket: $nn} else {} end'
  # The overlap with other tasks was judged when this one opened.
  exit 0
elif [[ -n $ticket ]]; then
  # The ticket's builder starts from what the task knows: the spec, the scope, the tickets and the
  # build notes of every ticket integrated so far.
  from=$task_worktree/$task_dir
  for name in spec.md scope.txt; do
    [[ ! -f $from/$name ]] || cp -p -- "$from/$name" "$worktree/$task_dir/$name" ||
      die "cannot copy $from/$name into $worktree/$task_dir"
  done
  for name in tickets build-notes; do
    [[ ! -d $from/$name ]] || rsync -a --delete -- "$from/$name/" "$worktree/$task_dir/$name/" ||
      die "cannot copy $from/$name into $worktree/$task_dir"
  done
  ledger_append "$(jq -cn --arg task "$task" --arg project "$project" --arg branch "$branch" --arg base "$task_branch" \
    --arg base_sha "$base_sha" --arg worktree "$worktree" --arg ticket "$ticket" \
    '{ts: (now | todate), task: $task, event: "worktree-added", project: $project, branch: $branch,
      base: $base, base_sha: $base_sha, worktree: $worktree, ticket: $ticket}')"

  jq -n --arg task "$task" --arg project "$project" --arg branch "$branch" --arg base "$task_branch" \
    --arg base_sha "$base_sha" --arg worktree "$worktree" --arg task_dir "$worktree/$task_dir" --arg ticket "$ticket" \
    '{task: $task, project: $project, branch: $branch, base: $base, base_sha: $base_sha,
      worktree: $worktree, task_dir: $task_dir, ticket: $ticket}'
  # The other open tasks were shown when this one opened.
  exit 0
elif [[ -n $add ]]; then
  ledger_append "$(jq -cn --arg task "$task" --arg project "$project" --arg branch "$branch" --arg base "$base" \
    --arg base_sha "$base_sha" --arg worktree "$worktree" \
    '{ts: (now | todate), task: $task, event: "worktree-added", project: $project, branch: $branch,
      base: $base, base_sha: $base_sha, worktree: $worktree}')"

  jq -n --arg task "$task" --arg project "$project" --arg branch "$branch" --arg base "$base" \
    --arg base_sha "$base_sha" --arg worktree "$worktree" --arg task_dir "$worktree/$task_dir" \
    '{task: $task, project: $project, branch: $branch, base: $base, base_sha: $base_sha,
      worktree: $worktree, task_dir: $task_dir}'
else
  plan=$TEAM_HOME/tasks/$task/plan.md
  if [[ ! -e $plan ]]; then
    render_template "$(<"$templates/plan.md")" "$(jq -n --arg task "$task" --arg title "$title" \
      --arg project "$project" --arg path "$path" --arg base "$base" --arg branch "$branch" \
      --arg date "$(date +%F)" '$ARGS.named')" >"$plan"
  fi

  thread=$(TEAM_HOME=$TEAM_HOME "$bin/team-thread" "$task" "$project" "$title")

  ledger_append "$(jq -cn --arg task "$task" --arg project "$project" --arg path "$path" --arg type "$type" \
    --arg title "$title" --arg branch "$branch" --arg base "$base" --arg base_sha "$base_sha" --arg worktree "$worktree" \
    --arg story "$story" \
    '{ts: (now | todate), task: $task, event: "opened", project: $project, path: $path, type: $type,
      title: $title, branch: $branch, base: $base, base_sha: $base_sha, worktree: $worktree}
      + if $story == "" then {} else {story: $story} end')"

  [[ -z $queued_given ]] || link_queued

  jq -n --arg task "$task" --arg project "$project" --arg path "$path" --arg title "$title" --arg branch "$branch" \
    --arg base "$base" --arg base_sha "$base_sha" --arg worktree "$worktree" --arg task_dir "$worktree/$task_dir" \
    --arg thread "$thread" --arg plan "$plan" --arg story "$story" \
    '{task: $task, project: $project, path: $path, title: $title, branch: $branch, base: $base,
      base_sha: $base_sha, worktree: $worktree, task_dir: $task_dir, thread: $thread, plan: $plan}
      + if $story == "" then {} else {story: $story} end'
fi

# Overlap between tasks is the coordinator's judgment: show the project's other open tasks, each
# with the files its branch changes against the base, origin's branch when it is pushed, else the
# local one. The task is open by now, so a branch that cannot be read is only said.
others=() branches=()
while IFS= read -r -d '' line && IFS= read -r -d '' other_branch; do
  others+=("$line") branches+=("$other_branch")
done < <(ledger_jq 'ledger_events as $events
  | ($events | by_task | with_entries(select(.value | is_open))) as $open
  | open_worktrees($events[] | select($open[.task]); $home)
  | select(.project == $project and .task != $task and .ticket == null)
  | ($open[.task] | map(select(.event == "opened")) | first | .title) as $title
  | "  \(.task) \(.branch) in \(.worktree)\(if $title then ": \($title)" else "" end)\u0000\(.branch)\u0000"' \
  -nRj --arg project "$project" --arg task "$task" "$ledger")
((${#others[@]})) || exit 0
declare -A pushed=()
refspecs=() read_origin=''
if heads=$(git -C "$primary" ls-remote --heads origin "${branches[@]}"); then
  read_origin=1
  for other_branch in "${branches[@]}"; do
    if cut -f 2 <<<"$heads" | grep -qxF -- "refs/heads/$other_branch"; then
      pushed[$other_branch]=1
      refspecs+=("+refs/heads/$other_branch:refs/remotes/origin/$other_branch")
    fi
  done
  if ((${#refspecs[@]})) && ! git -C "$primary" fetch -q origin "${refspecs[@]}"; then read_origin=''; fi
fi
if [[ -z $read_origin ]]; then
  echo "team-open: cannot read the other tasks' branches from origin; their local branches are shown" >&2
  pushed=()
fi
echo "team-open: other open tasks in $project:" >&2
for i in "${!others[@]}"; do
  echo "${others[i]}" >&2
  other_branch=${branches[i]}
  if [[ -v pushed[$other_branch] ]]; then
    ref=refs/remotes/origin/$other_branch from="origin's branch"
  elif git -C "$primary" rev-parse -q --verify "refs/heads/$other_branch^{commit}" >/dev/null; then
    ref=refs/heads/$other_branch from="the local branch, not pushed"
  else
    echo "    no branch yet" >&2
    continue
  fi
  if ! files=$(git -C "$primary" diff --name-only --line-prefix='      ' "origin/$base...$ref"); then
    echo "    cannot diff $ref against origin/$base" >&2
  elif [[ -z $files ]]; then
    echo "    no changes against $base yet" >&2
  else
    echo "    changes against $base ($from):" >&2
    echo "$files" >&2
  fi
done
