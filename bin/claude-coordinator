#!/usr/bin/env bash
# Start the one session that owns Discord: the team's coordinator.
#
# The Discord plugin logs in to Discord from every session that loads it, so it is off in user
# settings and on here alone, through this session's own --settings. Bypass mode, by Daniel's
# choice; workers run in auto mode, and crossSessionInbound: accept (user settings) keeps their
# messages to this session from being held. With the safety classifier off here, deny rules and
# GitHub rulesets are what block force-push, reset --hard and merging unapproved PRs.
#
# The manual, roles/coordinator.md, is appended to the system prompt, and the coordinator's own
# skills (handoff, recover-worker, resume, status-report, stow) load from
# plugins/coordinator-skills; no worker
# loads either. Its settings are coordinator.settings.json with @TEAM_CODE@ (in its hook
# commands) naming this checkout, written to ~/.local/state/agent-team/coordinator.settings.json;
# the manual, the skills, the settings and the hooks all come from this script's checkout.
#
# Its MCP servers are toolkits/coordinator's alone (its README), passed with --mcp-config after
# @TEAM_CODE@ is replaced, as ~/.local/state/agent-team/coordinator.mcp.json. --strict-mcp-config
# connects no plugin server, the Discord channel's included, so it is not used: instead the
# launch runs `claude mcp list` in the working directory and its settings deny
# (deniedMcpServers) every server the list names but the toolkit's and those of a plugin they
# enable, and turn off every claude.ai connector. A failed list refuses the launch (exit 1).
#
# It compacts at 200k tokens, by the launch's --autocompact flag rather than autoCompactWindow in
# its settings: the flag is not preempted by a higher-priority settings scope, so a /autocompact
# Daniel once ran in their own session (saved in user settings) cannot widen the coordinator's
# window; CLAUDE_CODE_AUTO_COMPACT_WINDOW, which would override the flag, stays unset. Its
# settings add idle compaction from 100k tokens, so a long idle does not rewrite a large cache.
#
# Only on the lease holder: it refuses (exit 1) unless `team-lease check` confirms against origin
# that this machine holds the lease, naming the holder, or saying a coordinator never starts
# offline when GitHub is unreachable.
#
# Only one coordinator: it refuses (exit 1, naming the session id) while `claude agents --json`
# lists a live session named coordinator, so the ledger keeps one writer and Discord one
# listener. A non-blocking flock on ~/.local/state/agent-team/coordinator-launch.lock, held from
# that check through the launch, makes a second launch at the same moment exit 1 at once.
#
# Usage: claude-coordinator [--prompt <text>] [working-directory]   (default: the team home)
#   --prompt  the session's first prompt, in place of "You are the coordinator. Daniel talks to
#             you on Discord. Wait for their messages." (team-resume names its report and the
#             resume skill in it)
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: claude-coordinator [--prompt <text>] [working-directory]"
prompt="You are the coordinator. Daniel talks to you on Discord. Wait for their messages."
if [[ ${1:-} == --prompt ]]; then
  [[ $# -ge 2 && -n $2 ]] || usage_error "$usage"
  prompt=$2
  shift 2
fi
(($# <= 1)) || usage_error "$usage"
[[ ${1:-} != -* ]] || usage_error "$usage"
# The manual, the skills, the settings and the hooks are code: they come from this checkout,
# beside bin/.
code=$(dirname "$(dirname "$TEAM_LIB")")
cd "${1:-$TEAM_HOME}"

# The lock only serialises launches: `claude --bg` returns at once, so the session list, not
# the lock, says whether a coordinator is alive.
state=$HOME/.local/state/agent-team
lock=$state/coordinator-launch.lock
mkdir -p "$state"
exec {lock_fd}>"$lock"
flock -n "$lock_fd" || die "another claude-coordinator is launching right now (it holds $lock)"

live_sessions
live=$(jq -r 'map(select(.name == "coordinator")) | first
  | if . then .id // ((.sessionId // "")[:8]) else empty end' <<<"$LIVE_SESSIONS")
[[ -z $live ]] || die "a coordinator is already live: session $live; stop it with claude stop $live first"

# The lock's file is closed for team-lease, so no helper its git leaves running holds it.
lease_gate "a coordinator" {lock_fd}>&-

# @TEAM_CODE@ names this checkout, where the hooks and the toolkit live.
substitute='walk(if type == "string" then gsub("@TEAM_CODE@"; $code) else . end)'

# The MCP servers: the toolkit's, written whole, then moved into place.
mcp=$state/coordinator.mcp.json
jq --arg code "$code" "$substitute" "$code/toolkits/coordinator/.mcp.json" >"$mcp.$$"
mv -f "$mcp.$$" "$mcp"

# Every other server this session would load: each line of the list is "<name>: <what it runs>
# - <health>", and a name holds no ": ". Its health check starts the servers, so they get no lock.
listed=$(claude mcp list {lock_fd}>&-) || die "claude mcp list failed, so the servers to deny are unknown"
servers=()
while IFS= read -r line; do
  if [[ $line =~ ^(([^:]|:[^ ])+):\ .+\ -\ .+$ ]]; then servers+=("${BASH_REMATCH[1]}"); fi
done <<<"$listed"

# The settings, with the hooks of this checkout and those servers denied; written whole, then
# moved into place. A plugin's servers are named plugin:<plugin>:<server>.
settings=$state/coordinator.settings.json
jq --arg code "$code" --slurpfile mcp "$mcp" "$substitute"' as $settings
  | ($mcp[0].mcpServers // {} | keys) as $own
  | [$settings.enabledPlugins // {} | to_entries[] | select(.value == true) | "plugin:\(.key | split("@")[0]):"] as $plugins
  | $settings
  | .deniedMcpServers = [$ARGS.positional | unique[]
      | select(. as $name | ($own | index($name)) == null and all($plugins[]; . as $p | $name | startswith($p) | not))
      | {serverName: .}]' "$code/coordinator.settings.json" --args "${servers[@]}" >"$settings.$$"
mv -f "$settings.$$" "$settings"

# Not exec: this shell keeps the lock until claude returns, and the session it starts does not
# inherit the lock's file, so a running coordinator never holds the next launch's lock.
claude --bg --name coordinator \
  --autocompact 200k \
  --mcp-config "$mcp" \
  --channels plugin:discord@claude-plugins-official \
  --dangerously-skip-permissions \
  --append-system-prompt-file "$code/roles/coordinator.md" \
  --plugin-dir "$code/plugins/coordinator-skills" \
  --settings "$settings" \
  "$prompt" \
  {lock_fd}>&-
