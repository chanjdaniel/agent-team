#!/usr/bin/env bash
# Keep what Daniel pointed at for a UI fix in the task's directory, tasks/T<n>/ui/, where
# team-brief names it in the planner's, builders' and reviewers' briefs. A capture stays on this
# machine, but for an image a walk's planner posts under team-post's guards: the team home's git
# ignores tasks/*/ui/, so no checkpoint or handoff carries it, and team-close removes it with the task.
#
# Usage: team-ui T<n> [--capture [--note-file <file>]] [--attach <file>]...
#        team-ui T<n> --walk start [--in interview [--reseeded <message id>]] | --walk stop | --walk status
#   --capture  Run the frontend toolkit's ui-capture into a new directory, tasks/T<n>/ui/capture-<k>/,
#              k one more than the highest capture-<k> there (from 1), so no capture overwrites
#              another: the page Daniel is on in the Agent Chrome (its URL, route, title, Vue
#              route, screenshot, accessibility snapshot, console problems and failed requests),
#              and the element selected in its DevTools Elements panel when there is one (its
#              HTML, matched CSS, Vue source file and line, and screenshot); toolkits/frontend/
#              README.md says which page it takes.
#   --note-file  Write the text of <file>, the words Daniel posted that the capture goes with, as
#              the session taking it copied them, with the time, to note.md in the capture's directory.
#              A file, never the words on the command line, which a permission rule reads whole.
#              The coordinator writes it to tasks/T<n>/ui/.note-<message id>, a name team-ui and
#              team-brief list nowhere. A planner's hook refuses writes there, so a worker's note
#              file must be in its task's own directory (<worktree>/<task_dir> of an open worktree),
#              judged by its real path. Only with --capture, once.
#   --attach   Copy <file>, a screenshot Daniel attached in Discord as the Discord plugin's
#              download_attachment saved it, into tasks/T<n>/ui/ under its own name, numbered
#              (-2, -3, ... before the extension) when that name is taken.
# At least one of --capture and --attach. Attachments are copied first, so a capture that fails
# keeps them; it removes the directory it made.
# Prints ui-capture's line, then "captured: element and page" when the capture holds ui-pick.md,
# else "captured: page", then every file tasks/T<n>/ui/ holds: those at its top (the attachments,
# and a flat capture an older team-ui left there), then each capture directory's, by number.
# --walk turns the task's manual QC walk on (start) or off (stop), or says which it is (status),
# a form of its own. While a walk is on, each message of Daniel's in the task's thread is a walk
# note, which the coordinator takes a capture with; outside one, it captures only when Daniel asks.
# Each change is a walk event in the ledger, which a restarted or compacted coordinator reads, and
# team-state shows a walk that is on; a walk left on ends when its task closes. start prints
# "walk on for T<n>" and stop "walk off for T<n>"; a start while on, or a stop while off, logs
# nothing and says "walk already on for T<n> since <ts>" or "walk already off for T<n>"; status
# logs nothing and prints "walk on for T<n> since <ts>" or "walk off for T<n>".
#   --in interview  Only with --walk start: the walk runs in the task's interview thread, and its
#              planner follows it there, which the walk event's thread records, and each line
#              above about the walk says with " in its interview thread" at its end. Only one such
#              walk is on at a time, since Daniel has one Agent Chrome window.
#   --reseeded  Only with --walk start --in interview: the Discord message of Daniel's saying the
#              primary stack was just reseeded, read back through daniel_message from the task's
#              interview thread, its thread or #coordinator, so a model's word never stands in for
#              theirs. It must be theirs, sent within the last hour, and hold "seed" in any case
#              (reseeded, re-seeded, seeded), so that no other message of theirs is taken for it.
#              The walk event's reseeded records it, the walk's lines above say so, and team-post
#              then lets that walk's captures leave from a port not the task's own stack's, until
#              the walk stops; a later start needs a new word.
# Refused, exit 1: a worker session, any task and any form (worker_refusal in bin/lib/team.sh), since
# an image can leave the machine in a worker's team-post, and the Agent Chrome may show real data;
# the one exception is --capture, with or without --note-file, by a planner of the task while its
# walk is on in its interview thread, by Daniel's decision (Discord 1567568771311337525;
# capture_refusal in bin/lib/team.sh), so that planner reads the page Daniel drives, and never
# touches it. Refused too: a task that is not open, an attachment or a note file that is not a
# readable file, a note file with no words (nothing copied), a worker's note file outside its task's
# directory, a ui/ it cannot make the capture's directory in, and a capture that fails, with
# ui-capture's own line; of --walk start, a walk on in the task's other thread, which a stop must
# end first, and with --in interview, a task with no interview thread, or another task's interview
# walk that is on, which the refusal names; with --reseeded, a message that cannot be read, or that
# is not Daniel's, old or silent on seeding, and a walk on with no word or another, which a stop must
# end first, since a start that changed nothing must not read as cleared. Exit 2 a malformed command line, --walk with no word, another word, a second --walk, or
# with --capture, --note-file or --attach among them, --in with any word but interview, or without
# --walk start, and --reseeded with no message id, or without --walk start --in interview.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-ui T<n> [--capture [--note-file <file>]] [--attach <file>]... | team-ui T<n> --walk start [--in interview [--reseeded <message id>]] | --walk stop | --walk status"
task='' capture=0 note='' note_file='' noted=0 attachments=() walk='' in='' reseeded=''
# How long Daniel's word that the primary stack was just reseeded holds for a walk's start, in seconds.
RESEEDED_SECONDS=3600
while (($#)); do
  case $1 in
    --walk)
      [[ -z $walk ]] || usage_error "one --walk at a time"
      [[ $# -ge 2 ]] || usage_error "--walk needs start, stop or status"
      [[ $2 =~ ^(start|stop|status)$ ]] || usage_error "--walk needs start, stop or status, got '$2'"
      walk=$2
      shift 2
      ;;
    --in)
      [[ $# -ge 2 ]] || usage_error "--in takes only interview"
      [[ $2 == interview ]] || usage_error "--in takes only interview, got '$2'"
      in=$2
      shift 2
      ;;
    --reseeded)
      [[ $# -ge 2 && $2 =~ ^[1-9][0-9]{0,18}$ ]] || usage_error "--reseeded needs the id of Daniel's message"
      reseeded=$2
      shift 2
      ;;
    --capture) capture=1 && shift ;;
    --note-file)
      ((!noted)) || usage_error "one --note-file per capture"
      [[ $# -ge 2 && -n $2 ]] || usage_error "--note-file needs the file Daniel's words were written to"
      note_file=$2 noted=1
      shift 2
      ;;
    --attach)
      [[ $# -ge 2 ]] || usage_error "--attach needs a file"
      attachments+=("$2")
      shift 2
      ;;
    -*) usage_error "unexpected argument '$1'" ;;
    *)
      [[ -z $task ]] || usage_error "$usage"
      task=$1
      shift
      ;;
  esac
done
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "$usage"
[[ -z $in || $walk == start ]] || usage_error "--in goes only with --walk start"
[[ -z $reseeded || ($walk == start && -n $in) ]] || usage_error "--reseeded goes only with --walk start --in interview"
# A worker's one form is --capture with no attachment, which its gate judges.
if [[ -z $walk ]] && ((capture && !${#attachments[@]})); then
  why=$(capture_refusal "$task") && die "$why"
else
  why=$(worker_refusal "$task" "runs no team-ui") && die "$why"
fi

# What a walk's line adds for Daniel's word <message id>, or nothing: on_word <message id or "">
on_word() {
  [[ -z $1 ]] || echo ", on Daniel's word $1 that the primary stack was just reseeded"
}

# Refuse unless Daniel's message $reseeded says the primary stack was just reseeded, read back from
# Discord: check_reseeded
check_reseeded() {
  local places=() channel word sent
  while IFS= read -r channel; do
    places+=("$task's thread $channel")
  done < <(jq -r '(map(select(.event == "interview-thread")) | last | .discord_thread | strings),
    (map(select(.event == "thread")) | last | .discord_thread | strings)' <<<"$events")
  places+=("#coordinator $COORDINATOR_CHANNEL")
  word=$(daniel_message "$reseeded" "the word that the primary stack was reseeded" "${places[@]}" 2>&1) || die "$word"
  jq -e '.message.content | strings | test("seed"; "i")' <<<"$word" >/dev/null ||
    die "Discord message $reseeded does not say the primary stack was reseeded: ask Daniel to say so in a new message"
  # A Discord id holds the milliseconds since 2015-01-01 above its low 22 bits.
  sent=$(((10#$reseeded >> 22) / 1000 + 1420070400))
  (($(date +%s) - sent <= RESEEDED_SECONDS)) ||
    die "Discord message $reseeded was sent at $(date -ud "@$sent" +%FT%TZ), over an hour ago, so it does not say the primary stack was just reseeded: ask Daniel to say so in a new message"
}

# Start this task's walk in its interview thread: only one such walk is on at a time, which a lock
# of the machine's holds while it reads the ledger and appends to it. Discord is read before that.
start_interview_walk() {
  local state=$HOME/.local/state/agent-team lock other
  ledger_jq 'any(.[]; .event == "interview-thread")' -e <<<"$events" >/dev/null ||
    die "$task has no interview thread in the ledger; team-thread $task --interview opens one"
  [[ -z $reseeded ]] || check_reseeded
  mkdir -p "$state"
  exec {lock}>>"$state/walk.lock"
  flock -w 30 -x "$lock" || die "another team-ui still holds $state/walk.lock after 30 seconds"
  other=$(ledger_jq 'ledger_events | by_task | to_entries | map(select(.value | qc_walk | .thread == "interview"))
    | first // empty | "\(.key)\t\(.value | qc_walk | .since)"' -nRr "$TEAM_HOME/ledger.jsonl")
  [[ -z $other ]] ||
    die "${other%%$'\t'*}'s interview walk is on since ${other#*$'\t'}, and Daniel has one Agent Chrome window: team-ui ${other%%$'\t'*} --walk stop ends it"
  ledger_append "$(jq -cn --arg task "$task" --arg word "$reseeded" '{ts: (now | todate), task: $task, event: "walk", state: "on", thread: "interview"}
    + (if $word != "" then {reseeded: $word} else {} end)')"
}

if [[ -n $walk ]]; then
  ((!capture && !noted && !${#attachments[@]})) || usage_error "--walk goes alone, without --capture, --note-file or --attach"
  events=$(open_task_events "$task")
  since='' thread='' word=''
  json_vars --ledger since='qc_walk.since' thread='qc_walk.thread' word='qc_walk.reseeded' <<<"$events"
  where=${thread:+ in its $thread thread}$(on_word "$word")
  case $walk:${since:+on} in
    status:on) echo "walk on for $task since $since$where" ;;
    status:) echo "walk off for $task" ;;
    start:on)
      [[ $thread == "$in" ]] || die "$task's walk is on since $since in its ${thread:-task} thread: stop it before starting it in another thread"
      [[ -z $reseeded || $reseeded == "$word" ]] ||
        die "$task's walk is on since $since$where: stop it before starting it on Daniel's word $reseeded"
      echo "walk already on for $task since $since$where"
      ;;
    stop:) echo "walk already off for $task" ;;
    start:)
      if [[ -n $in ]]; then
        start_interview_walk
        echo "walk on for $task in its $in thread$(on_word "$reseeded")"
      else
        ledger_append "$(jq -cn --arg task "$task" '{ts: (now | todate), task: $task, event: "walk", state: "on"}')"
        echo "walk on for $task"
      fi
      ;;
    stop:on)
      ledger_append "$(jq -cn --arg task "$task" '{ts: (now | todate), task: $task, event: "walk", state: "off"}')"
      echo "walk off for $task"
      ;;
  esac
  exit 0
fi
((capture || !noted)) || usage_error "--note-file goes with --capture"
((capture || ${#attachments[@]})) || usage_error "$usage"

open_task_events "$task" >/dev/null
for file in "${attachments[@]}"; do
  [[ -f $file && -r $file ]] || die "cannot read $file"
done
if ((noted)); then
  [[ -f $note_file && -r $note_file ]] || die "cannot read $note_file"
  note=$(<"$note_file")
  [[ $note == *[![:space:]]* ]] || die "$note_file holds no words"
  if [[ -n ${AGENT_TEAM_ROLE:-} && $AGENT_TEAM_ROLE != coordinator ]]; then
    task_own_dirs "$task"
    path_under "$(realpath -e -- "$note_file")" "${TASK_OWN_DIRS[@]}" ||
      die "cannot use $note_file: a worker session's note file must be in $task's task directory"
  fi
fi

# Code comes from this checkout, beside bin/.
code=$(dirname "$(dirname "$TEAM_LIB")")
ui=$TEAM_HOME/tasks/$task/ui
mkdir -p "$ui"

# A name not yet taken in tasks/T<n>/ui/: <name>, else <stem>-2<.ext>, -3, ...
free_name() {
  local name=$1 stem ext n=2
  [[ -e $ui/$name ]] || { printf '%s\n' "$name"; return; }
  if [[ $name == ?*.* ]]; then stem=${name%.*} ext=.${name##*.}; else stem=$name ext=''; fi
  while [[ -e $ui/$stem-$n$ext ]]; do n=$((n + 1)); done
  printf '%s\n' "$stem-$n$ext"
}
for file in "${attachments[@]}"; do
  cp -- "$file" "$ui/$(free_name "$(basename -- "$file")")"
done

# The next capture's directory, claimed by mkdir so two intakes at once never share one:
# capture-<k>, k one more than the highest there, the next while another intake took that one.
claim_capture_dir() {
  local k=0 dir n
  for dir in "$ui"/capture-*/; do
    n=${dir%/} n=${n##*/capture-}
    [[ $n =~ ^[1-9][0-9]*$ ]] && ((n > k)) && k=$n
  done
  until mkdir -- "$ui/capture-$((k + 1))" 2>/dev/null; do
    [[ -e $ui/capture-$((k + 1)) ]] || die "cannot make a capture directory in $ui"
    k=$((k + 1))
  done
  printf '%s\n' "$ui/capture-$((k + 1))"
}

# note.md: the words in a fence longer than any run of backticks in them, so they read as written.
write_note() {
  local fence='```' run
  while IFS= read -r run; do
    ((${#run} < ${#fence})) || fence=$run'`'
  done < <(grep -o '`\+' <<<"$note" || true)
  printf "# Daniel's note\n\nDaniel's words this capture goes with, as the %s copied them, at %s.\n\n%s\n%s\n%s\n" \
    "${AGENT_TEAM_ROLE:-coordinator}" "$(date -u +%FT%TZ)" "$fence" "$note" "$fence" >"$1/note.md"
}

failed=''
if ((capture)); then
  dir=$(claim_capture_dir)
  if ! out=$("$code/toolkits/frontend/scripts/ui-capture" "$dir" 2>&1); then
    failed=$out
    rm -rf -- "$dir"
  else
    printf '%s\n' "$out"
    if [[ -f $dir/ui-pick.md ]]; then echo "captured: element and page"; else echo "captured: page"; fi
    ((!noted)) || write_note "$dir"
  fi
fi
echo "tasks/$task/ui/ holds:"
find "$ui" -maxdepth 1 -type f ! -name '.*' | LC_ALL=C sort
find "$ui" -mindepth 1 -maxdepth 1 -type d -regex '.*/capture-[1-9][0-9]*' -printf '%f\n' | sort -V |
  while IFS= read -r dir; do find "$ui/$dir" -maxdepth 1 -type f ! -name '.*' | LC_ALL=C sort; done
[[ -z $failed ]] || die "the capture failed: $(grep -m1 . <<<"$failed")"
