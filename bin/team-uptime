#!/usr/bin/env bash
# Check each project's production, as projects.toml's uptime key names it, and post in
# #coordinator when a check is down and again when it is back, and show each check's last result.
# The heartbeat's uptime step runs it on the lease holder at every run (team-timers).
#
# Usage: team-uptime run | status [--json]
#
# run: one round of checks, on the lease holder only: a machine that is fenced, or whose lease
# record (~/.local/state/agent-team/lease.json, as team-lease leaves it) does not say it holds the
# lease, checks nothing and exits 1 saying so ("team-uptime: <machine> does not hold the lease, so
# it checks nothing"). One run at a time: while another holds ~/.local/state/agent-team/uptime.lock
# it prints "another team-uptime run is checking; skipped" and exits 0. With no check in the
# registry it makes no request, prints nothing, posts nothing and writes no state.
#
# Each check is one fetch, in turn, the same plain GET every time, with no curlrc (-q), no header,
# cookie or credential of its own and no redirect followed:
#   curl -q --silent --show-error --proto =http,https --connect-timeout <min(5, t)> --max-time <t>
#        --max-filesize 1048576 --user-agent agent-team-uptime/1 --output <temporary file>
#        --write-out '%{http_code}' <url>
# with <t> 10 seconds. A check is good when curl exits 0, the status is 200 to 299 and the body
# holds the check's expect as a fixed string; a redirect is a failure, so the registry names the
# final URL. A failure's reason, cut to 200 characters: "HTTP <code>", "HTTP <code>, but its
# answer lacks `<expect>`", "no answer in <t> s" (curl's exit 28), "answer over 1 MiB" (63), or
# curl's last stderr line without its "curl: (<n>) " prefix, or "curl exited <n>".
#
# The known-good probe: when a check failed, and only then, the same fetch of https://github.com/,
# a site the heartbeat already depends on, which counts as reachable when it gave any HTTP status,
# whatever its status and body. When it gave none, this machine cannot reach the internet: no
# result of the run is counted, nothing is posted, the state's written time alone changes, and it
# prints "cannot reach the internet: <known-good URL>: <reason>; <n> failing check(s) not
# counted", says "team-uptime: this machine cannot reach the internet (<known-good URL>:
# <reason>), so <n> failing check(s) were not counted" on stderr, and exits 1, so the heartbeat's
# uptime step fails and its own alert names it after an hour.
#
# Counting, as bin/lib/uptime.jq says: a failure adds one to the check's failures in a row, unless
# its last counted result is more than 15 minutes old, when it counts as the first again; a good
# result ends the streak. A check failing 2 runs in a row opens an outage and is due its down post;
# one that answers again after its down post went through is due its back post, which closes it,
# and one that answers before its down post ever went through is closed with no post. A check still
# down 240 minutes after its down post, or its last reminder, is due a reminder. One that fails
# again before its back post went through stays the same outage, with no new down post. The posts
# of one run are at most one message for the down posts, one for the reminders and one for the
# back posts, in that order, a line per check in registry order, each cut to Discord's 2000
# characters, mentioning no one and with Discord's link previews off (flags 4), so Discord's
# crawler never fetches production:
#   Production down: <project> <name> (<<url>>) since <HH:MM>, <n> checks in a row from <machine>: <reason>.
#   Production still down: <project> <name> (<<url>>) since <HH:MM>, <duration>: <reason>.
#   Production back: <project> <name> (<<url>>) answers again at <HH:MM>, down since <HH:MM> (<duration>).
# times as this machine's local hours and minutes, durations as "<n> minutes", "<h> hours" or
# "<h> hours <n> minutes", singular for 1. A post that went through is recorded, so neither a
# later run nor a restart posts it again; one Discord refused is not, so it is due again at the
# next run, and it fails this one ("team-uptime: the post to #coordinator failed (<reason>); it
# is tried again next run" on stderr). A check the registry no longer names, or names with
# another url or expect, is dropped from the state, so a changed one starts fresh; one dropped
# after its down post went through gets the line "<project>/<name>: no longer checked as it was;
# its open outage is closed without a post".
#
# It prints, a line each, every failing check ("<project>/<name>: failed: <reason> (<n> in a row,
# since <UTC time>)"), every outage closed with no post, and every post ("posted to #coordinator
# (message <id>): <down|still down|back>: <project>/<name>[, ...]", the id none when Discord gave
# none); a run whose checks are all good and change nothing prints nothing. It exits 0 when every
# check was counted and every due post went through, production down or not; 1 when the
# known-good site was unreachable, a post failed, the state file was set aside or the state could
# not be written, the rest of the run done first; and 1 at once, checking nothing, when the
# registry cannot be read.
#
# The state is ~/.local/state/agent-team/uptime.json, team-uptime/1, written whole and moved into
# place; bin/lib/uptime.jq's header describes it. A state file that is not JSON, or not
# team-uptime/1, is set aside as uptime.json.bad (one file, overwritten), said on stderr
# ("team-uptime: <file> is not a team-uptime/1 state; it is set aside as <file>.bad, and this run
# starts from an empty state"), and the run starts from an empty state, so production down then
# takes two more runs to post.
#
# status: each check's last result, from the registry and the state file alone, with no request
# and no post, on any machine, holder or not; a line per check in registry order,
#   <project>/<name> <state>[ since <HH:MM>][: <reason>], checked <HH:MM> (<url>)
# its state up, down (2 failures or more in a row, or any while its outage is open, since the
# outage began) or failing (any other failure), or "<project>/<name> not checked yet (<url>)" for
# one with no state, or a state for another url or expect; nothing with no check in the registry.
# With --json, the object team-snapshot carries as production: {schema: team-uptime/1, written
# (when a run last wrote the state, null for none), line, checks: [{project, name, url, expect,
# state (up, failing, down or unchecked), checked, since, failures, reason, alert}]}, the state's
# fields of each check (null, and failures 0, for an unchecked one). line is the digest's
# Production line, null with no check: "Production: all <n> checks up, last checked <HH:MM>", or
# each check not up ("<project> <name> down since <HH:MM>: <reason>", "<project> <name> failed
# once: <reason>" or "<project> <name> not checked yet") joined by "; ", then "; <n> more up"
# when any is, then ", last checked <HH:MM>" when the state was written, cut to 200 characters. A
# state file that is not team-uptime/1 is left as it is and fails it ("team-uptime: <file> is not
# a team-uptime/1 state"), as a registry that cannot be read does.
#
# Seams for the tests: TEAM_UPTIME_SECONDS replaces each fetch's 10 seconds,
# TEAM_UPTIME_KNOWN_GOOD the known-good site, and TEAM_UPTIME_REMIND_MINUTES the 240 minutes
# between reminders (a whole number).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

USAGE="usage: team-uptime run | status [--json]"
STATE_DIR=$HOME/.local/state/agent-team
STATE_FILE=$STATE_DIR/uptime.json
FETCH_SECONDS=${TEAM_UPTIME_SECONDS:-10}
KNOWN_GOOD=${TEAM_UPTIME_KNOWN_GOOD:-https://github.com/}
REMIND_MINUTES=${TEAM_UPTIME_REMIND_MINUTES:-}
CONNECT_SECONDS=$((FETCH_SECONDS < 5 ? FETCH_SECONDS : 5))
POST_TIMEOUT=20

# jq with the uptime module: uptime_jq <filter> [jq options and files...]
uptime_jq() {
  jq -L "$TEAM_LIB" "include \"uptime\"; $1" "${@:2}"
}

# Fail unless this machine holds the lease, by its own record: not fenced, and lease.json naming
# it the holder of a held lease, with no network.
holder_only() {
  if fence_reason >/dev/null ||
    ! jq -e --arg machine "$machine" '.holder == $machine and .state == "held"' "$STATE_DIR/lease.json" >/dev/null 2>&1; then
    die "$machine does not hold the lease, so it checks nothing"
  fi
}

# Every project's checks, [{project, name, url, expect}] in registry order and each project's.
registry_checks() {
  local projects project
  projects=$(team_project --list) || return 1
  for project in $projects; do
    team_project "$project" uptime | jq -c --arg project "$project" 'map({project: $project} + .)' || return 1
  done | jq -sc 'add // []'
}

# GET <url> once, the same plain fetch every check and the known-good probe make, its body in
# $body: sets the caller's code (curl's %{http_code}, 000 for no answer) and reason (why curl
# failed, empty when it exited 0).
get() {
  local rc=0 last
  : >"$body"
  code=$(curl -q --silent --show-error --proto =http,https --connect-timeout "$CONNECT_SECONDS" \
    --max-time "$FETCH_SECONDS" --max-filesize 1048576 --user-agent agent-team-uptime/1 \
    --output "$body" --write-out '%{http_code}' "$1" 2>"$err") || rc=$?
  reason=''
  if ((rc == 28)); then
    reason="no answer in $FETCH_SECONDS s"
  elif ((rc == 63)); then
    reason="answer over 1 MiB"
  elif ((rc != 0)); then
    last=$(grep . "$err" | tail -n 1 | sed -E 's/^curl: \([0-9]+\) //') || last=''
    reason=${last:-curl exited $rc}
  fi
}

# Fetch <url> and judge its answer by <expect>: prints {ok, reason}.
fetch() {
  local code reason
  get "$1"
  if [[ -z $reason ]]; then
    if [[ ! $code =~ ^2[0-9][0-9]$ ]]; then
      reason="HTTP $code"
    elif ! grep -qF -- "$2" "$body"; then
      reason="HTTP $code, but its answer lacks \`$2\`"
    fi
  fi
  jq -cn --arg reason "$reason" '{ok: ($reason == ""), reason: (if $reason == "" then null else $reason end)}'
}

# Whether this machine reaches the internet: the known-good site answers any HTTP status, whatever
# its body. Fails printing why it does not.
reachable() {
  local code reason
  get "$KNOWN_GOOD"
  [[ ${code:-000} != 000 ]] || {
    echo "${reason:-no HTTP status}"
    return 1
  }
}

# The state file's state, or uptime_empty's when there is none; fails, printing nothing, when it
# is not one JSON object of schema team-uptime/1 with an object of checks.
read_state() {
  if [[ ! -e $STATE_FILE ]]; then
    uptime_jq uptime_empty -nc
    return
  fi
  local state
  state=$(jq -cs 'select(length == 1 and (.[0] | type == "object" and .schema == "team-uptime/1"
    and (.checks | type) == "object")) | .[0]' "$STATE_FILE" 2>/dev/null) || state=''
  [[ -n $state ]] || return 1
  printf '%s\n' "$state"
}

# Write <state> whole to the state file, moved into place; a failure fails the run.
write_state() {
  local why
  if ! why=$({ printf '%s\n' "$1" >"$STATE_FILE.$$" && mv -f "$STATE_FILE.$$" "$STATE_FILE"; } 2>&1); then
    rm -f "$STATE_FILE.$$"
    echo "team-uptime: cannot write $STATE_FILE: $(grep -m1 . <<<"$why" || echo "no reason given")" >&2
    rc=1
  fi
}

# Post <content> to #coordinator, mentioning no one and with no link preview; prints the new
# message's id (empty when Discord gave none), or fails with discord_api's reason in $err.
post() {
  local payload reply
  payload=$(jq -cn --arg content "$1" '{content: $content, allowed_mentions: {parse: []}, flags: 4}')
  reply=$(discord_api "channels/$COORDINATOR_CHANNEL/messages" -X POST -H "Content-Type: application/json" \
    --max-time "$POST_TIMEOUT" -d "$payload" 2>"$err") || return 1
  jq -r '.id // empty | strings' <<<"$reply" 2>/dev/null || true
}

run_round() {
  local checks check key url expect results=() now previous plan state count i what keys content id
  local failing why limits
  machine=$(machine_name) || exit 1
  limits=$(uptime_jq uptime_limits -nc)
  if [[ -n $REMIND_MINUTES ]]; then
    [[ $REMIND_MINUTES =~ ^[1-9][0-9]*$ ]] || die "TEAM_UPTIME_REMIND_MINUTES must be a whole number of minutes, not '$REMIND_MINUTES'"
    limits=$(jq -c --argjson m "$REMIND_MINUTES" '.remind_minutes = $m' <<<"$limits")
  fi
  holder_only
  mkdir -p "$STATE_DIR"
  exec {lock_fd}>>"$STATE_DIR/uptime.lock"
  if ! flock -n "$lock_fd"; then
    echo "another team-uptime run is checking; skipped"
    exit 0
  fi
  checks=$(registry_checks) || exit 1
  [[ $checks != '[]' ]] || exit 0

  if ! previous=$(read_state); then
    mv -f "$STATE_FILE" "$STATE_FILE.bad"
    echo "team-uptime: $STATE_FILE is not a team-uptime/1 state; it is set aside as $STATE_FILE.bad, and this run starts from an empty state" >&2
    rc=1
    previous=$(uptime_jq uptime_empty -nc)
  fi

  body=$(mktemp) err=$(mktemp)
  trap 'rm -f "$body" "$err"' EXIT
  now=$(date -u +%FT%TZ)
  while IFS= read -r check; do
    json_vars key='"\(.project)/\(.name)"' url=.url expect=.expect <<<"$check"
    results+=("$(fetch "$url" "$expect" | jq -c --arg key "$key" '{key: $key, value: .}')")
  done < <(jq -c '.[]' <<<"$checks")

  # A failure counts only once the known-good site shows this machine reaches the internet.
  failing=$(printf '%s\n' "${results[@]}" | jq -s 'map(select(.value.ok | not)) | length')
  if ((failing > 0)) && ! why=$(reachable); then
    echo "cannot reach the internet: $KNOWN_GOOD: $why; $failing failing check(s) not counted"
    echo "team-uptime: this machine cannot reach the internet ($KNOWN_GOOD: $why), so $failing failing check(s) were not counted" >&2
    write_state "$(uptime_jq 'uptime_uncounted($now)' -c --arg now "$now" <<<"$previous")"
    exit 1
  fi

  plan=$(printf '%s\n' "${results[@]}" | jq -sc 'from_entries' |
    uptime_jq '. as $results | $previous | uptime_round($checks; $results; $now; $machine; $limits)' \
      --argjson previous "$previous" --argjson checks "$checks" --arg now "$now" --arg machine "$machine" \
      --argjson limits "$limits")
  jq -r '.lines[]' <<<"$plan"
  state=$(jq -c .state <<<"$plan")
  write_state "$state"

  count=$(jq '.posts | length' <<<"$plan")
  for ((i = 0; i < count; i++)); do
    json_vars what=".posts[$i].kind" keys=".posts[$i].keys | join(\", \")" content=".posts[$i].content" <<<"$plan"
    if id=$(post "$content"); then
      echo "posted to #coordinator (message ${id:-none}): $what: $keys"
      state=$(uptime_jq 'uptime_posted($post; (if $id == "" then null else $id end); $at)' -c \
        --argjson post "$(jq -c ".posts[$i]" <<<"$plan")" --arg id "$id" --arg at "$(date -u +%FT%TZ)" <<<"$state")
      write_state "$state"
    else
      echo "team-uptime: the post to #coordinator failed ($(grep -m1 . "$err" || echo "no reason given")); it is tried again next run" >&2
      rc=1
    fi
  done
  exit "$rc"
}

# Each check's last result, read-only: show_status [--json]
show_status() {
  local checks state status
  checks=$(registry_checks) || exit 1
  state=$(read_state) || die "$STATE_FILE is not a team-uptime/1 state"
  status=$(uptime_jq 'uptime_status($checks; uptime_limits)' -c --argjson checks "$checks" <<<"$state")
  if [[ ${1:-} == --json ]]; then
    jq . <<<"$status"
  else
    uptime_jq uptime_status_text -r <<<"$status"
  fi
}

rc=0 machine='' body='' err=''
case ${1:-} in
  run)
    (($# == 1)) || usage_error "$USAGE"
    run_round
    ;;
  status)
    (($# == 1)) || [[ $# == 2 && $2 == --json ]] || usage_error "$USAGE"
    show_status "${2:-}"
    ;;
  *) usage_error "$USAGE" ;;
esac
