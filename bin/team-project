#!/usr/bin/env -S python3 -I
# Read the project registry, projects.toml in the team home: the one way any script reads it.
#
# Usage: team-project <name>          the project as JSON, every path with a fixed root absolute
#        team-project <name> <key>    one value; a dotted key such as pool.provider works;
#                                     strings print bare, lists and tables as JSON
#        team-project --list          the project names, one per line, in file order
#        team-project --find <key> <value>
#                                     the projects whose key (dotted, as above) is the value, or
#                                     holds it when a list, one per line; repo compares in any
#                                     case, and path, pool.slots, pool.lease and pool.return as
#                                     the same file, however spelled (a symlink, or another case
#                                     on a case-insensitive filesystem); a key no project has is
#                                     refused
#        team-project --check         check the whole file and list every problem; the name
#                                     coordinator is reserved (team-config's folder for the
#                                     team home's own auto memory)
#
# The registry has one table per project the team works on, keyed by its short name.
# Per project:
#   repo             the GitHub repository, owner/name
#   path             the primary checkout
#   base             the branch tasks start from and PRs target
#   delivery         how a builder delivers: "no-mistakes" (the gate opens the PR) or "direct-pr"
#   merge_method     how team-merge merges a PR: "merge", "squash" or "rebase"
#   required_checks  checks that must be present and green on the PR's head, beyond the
#                    server's own required checks
#   local_checks     optional: shell commands, run from the root of a checkout of the PR's exact
#                    head, that must all pass before team-merge merges it (default none)
#   task_dir         a task's scratch directory
#   docs             what a worker reads first
#   toolkits         the toolkits a worker of this project may be given
# Per project pool ([<name>.pool]), where task worktrees come from:
#   provider         "treehouse" (leased pre-warmed slots) or "git" (plain git worktrees)
#   lease, return    treehouse only: the lease and return commands, run from the primary
#                    checkout: lease <holder> prints the leased slot's path; return <slot> hands
#                    it back, and passes --force and --if-lease-holder <holder> on to treehouse
#                    return (team-open forces back a slot its own lease dirtied)
#   slots            the trusted slot paths a task's worktree may be; for treehouse, each other
#                    numbered slot in their pool's folder is trusted too (team-open)
# Per project stack ([<name>.stack]), optional: the Docker stacks team-stack manages for the
# project's worktrees (sops/docker.md); a project without one has none:
#   compose          the project's compose wrapper, which meets the wrapper contract
#   seed             the command that seeds a stack, run with team-stack env's exports
#   log_services     the services whose logs team-stack down saves
#   images           optional: the shared image repositories the reaper manages (default none)
#   legacy_images    optional: patterns of image repositories reap --legacy may remove
#                    (default none)
#   legacy_gate      optional: the pattern of the project names of gate stacks with no team
#                    labels (default none)
# A pattern is an extended regular expression matched against a whole name, kept to what
# Python, jq and Bash read alike: literals, ., bracket expressions, *, +, ?, {n,m}, | and
# groups; --check refuses one that does not compile, a backslash class such as \d, and a (?...)
# group such as a lookaround.
# Paths in the file are relative to $HOME, except pool.lease and pool.return (relative to the
# primary checkout) and task_dir, docs, stack.compose and stack.seed (relative to a worktree, so
# they stay relative).
# A new key goes in this list and in the script's key lists.
#
# Every command refuses a registry that fails --check. Exit 0 done, 1 refused or a check
# failed, 2 usage error. Python standard library only (tomllib, Python 3.11 or later).

import json
import os
import re
import sys

# tomllib is Python 3.11's; macOS's own python3 is older. This file must parse on it to say so.
if sys.version_info < (3, 11):
    print(
        f"{os.path.basename(sys.argv[0])}: needs Python 3.11 or later (tomllib), but runs under"
        f" Python {sys.version.split()[0]} ({sys.executable}); on macOS run `brew install python@3.12`,"
        " whose python3 the team's scripts put first on PATH",
        file=sys.stderr,
    )
    sys.exit(1)

import tomllib

NAME = os.path.basename(sys.argv[0])
USAGE = "usage: team-project <name> [<key>] | --list | --find <key> <value> | --check"

# The keys of a project and of its pool, in the order problems are reported.
PROJECT_STRINGS = ("repo", "path", "base", "delivery", "merge_method", "task_dir")
PROJECT_LISTS = ("required_checks", "docs", "toolkits")
PROJECT_KEYS = PROJECT_STRINGS + PROJECT_LISTS + ("pool",)
# Names no project may take: coordinator is the team home's own auto memory folder,
# memory/coordinator/ (team-config).
RESERVED = {"coordinator": "the team home's auto memory, memory/coordinator/"}
# Optional keys, with the value a project without one has.
PROJECT_OPTIONAL = {"local_checks": []}
POOL_KEYS = ("provider", "lease", "return", "slots")
# A stack block's keys: its required strings and list, then its optional lists and pattern, with
# the value a block without one has (legacy_gate has none).
STACK_KEYS = ("compose", "seed", "log_services", "images", "legacy_images", "legacy_gate")
STACK_REQUIRED = ("compose", "seed", "log_services")
STACK_OPTIONAL = {"images": [], "legacy_images": []}
TREEHOUSE_ONLY = ("lease", "return")
ENUMS = {
    "delivery": ("no-mistakes", "direct-pr"),
    "merge_method": ("merge", "squash", "rebase"),
    "provider": ("treehouse", "git"),
}
RELATIVE_PATHS = ("path", "task_dir", "lease", "return")
# The keys --find compares as paths (same_path), once resolved.
ABSOLUTE_PATHS = ("path", "pool.slots", "pool.lease", "pool.return")


def fail(message, status=1):
    print(f"{NAME}: {message}", file=sys.stderr)
    sys.exit(status)


# Print this script's header: the comment block under its shebang, as bin/lib/team.sh does.
def print_help():
    with open(__file__, encoding="utf-8") as script:
        next(script)
        for line in script:
            if not line.startswith("#"):
                break
            print(re.sub(r"^# ?", "", line), end="")


# The team home, found as the library finds it: TEAM_HOME when set; else the first line of
# ~/.config/agent-team/home, a path relative to HOME unless it is absolute; refused with neither.
def team_home():
    home = os.environ.get("TEAM_HOME")
    setting = os.path.join(os.environ.get("HOME", ""), ".config", "agent-team", "home")
    fix = (
        "name its checkout there, relative to your home directory:"
        " echo agent-team-records > ~/.config/agent-team/home"
    )
    if not home and os.path.isfile(setting):
        with open(setting, encoding="utf-8") as file:
            home = file.readline().rstrip("\n")
        if not home:
            fail(f"the setting ~/.config/agent-team/home names no team home; {fix}")
        home = os.path.join(os.environ["HOME"], home)
        if not os.path.isdir(home):
            fail(f"the team home {home}, named by ~/.config/agent-team/home, is not a directory; {fix}")
    if not home:
        fail(f"neither TEAM_HOME nor ~/.config/agent-team/home names the team home; {fix}")
    if not os.path.isdir(home):
        fail(f"team home {home} is not a directory")
    return home


def is_relative_path(value):
    return value != "" and not value.startswith(("/", "~")) and ".." not in value.split("/")


def is_string_list(value):
    return isinstance(value, list) and all(isinstance(item, str) for item in value)


def check_string(where, key, value, problems):
    if not isinstance(value, str):
        problems.append(f"{where}.{key}: must be a string")
    elif key in ENUMS and value not in ENUMS[key]:
        problems.append(f"{where}.{key}: '{value}' is not one of {', '.join(ENUMS[key])}")
    elif key in RELATIVE_PATHS and not is_relative_path(value):
        problems.append(f"{where}.{key}: '{value}' must be a relative path")
    elif key == "repo" and not re.fullmatch(r"[\w.-]+/[\w.-]+", value):
        problems.append(f"{where}.{key}: '{value}' is not owner/name")


def check_keys(where, table, known, required, problems):
    problems.extend(f"{where}: missing required key '{key}'" for key in required if key not in table)
    problems.extend(f"{where}: unknown key '{key}'" for key in table if key not in known)


# Check one project's pool; slot_owners maps every slot seen so far to its project, so a slot
# shared by two pools is caught too.
def check_pool(name, pool, slot_owners, problems):
    where = f"{name}.pool"
    if not isinstance(pool, dict):
        problems.append(f"{where}: must be a table")
        return
    check_keys(where, pool, POOL_KEYS, ("provider", "slots"), problems)
    for key in ("provider",) + TREEHOUSE_ONLY:
        if key in pool:
            check_string(where, key, pool[key], problems)
    for key in TREEHOUSE_ONLY:
        if pool.get("provider") == "treehouse" and key not in pool:
            problems.append(f"{where}: a treehouse pool needs '{key}'")
        if pool.get("provider") == "git" and key in pool:
            problems.append(f"{where}: '{key}' is for treehouse pools only")
    slots = pool.get("slots", [])
    if not is_string_list(slots):
        problems.append(f"{where}.slots: must be a list of strings")
        return
    seen = set()
    for slot in slots:
        if not is_relative_path(slot):
            problems.append(f"{where}.slots: '{slot}' must be a relative path")
            continue
        key = os.path.normpath(slot)
        owner = slot_owners.setdefault(key, name)
        if owner != name:
            problems.append(f"{where}.slots: '{slot}' is already a slot of {owner}")
        elif key in seen:
            problems.append(f"{where}.slots: '{slot}' is listed twice")
        seen.add(key)


# The problem with the pattern <pattern> at <where>, or None: it must compile in Python and keep
# to what jq and Bash's =~ read alike.
def pattern_problem(where, pattern):
    if re.search(r"\\[A-Za-z0-9]", pattern):
        return (
            f"{where}: '{pattern}' uses a backslash class, which Bash and jq read differently;"
            " use a bracket expression such as [0-9]"
        )
    if "(?" in pattern:
        return f"{where}: '{pattern}' uses a (?...) group, a lookaround or another extension Bash does not read"
    try:
        re.compile(pattern)
    except re.error as error:
        return f"{where}: '{pattern}' is not a valid pattern: {error}"
    return None


# Check one project's stack block.
def check_stack(name, stack, problems):
    where = f"{name}.stack"
    if not isinstance(stack, dict):
        problems.append(f"{where}: must be a table")
        return
    check_keys(where, stack, STACK_KEYS, STACK_REQUIRED, problems)
    for key in ("compose", "seed"):
        if key not in stack:
            continue
        if not isinstance(stack[key], str):
            problems.append(f"{where}.{key}: must be a string")
        elif not is_relative_path(stack[key]):
            problems.append(f"{where}.{key}: '{stack[key]}' must be a relative path")
    patterns = []
    for key in ("log_services", "images", "legacy_images"):
        if key in stack and not is_string_list(stack[key]):
            problems.append(f"{where}.{key}: must be a list of strings")
        elif key == "legacy_images":
            patterns.extend((key, pattern) for pattern in stack.get(key, []))
    if "legacy_gate" in stack and not isinstance(stack["legacy_gate"], str):
        problems.append(f"{where}.legacy_gate: must be a string")
    elif "legacy_gate" in stack:
        patterns.append(("legacy_gate", stack["legacy_gate"]))
    for key, pattern in patterns:
        problem = pattern_problem(f"{where}.{key}", pattern)
        if problem:
            problems.append(problem)


# Every problem with the registry, as one line each; none means it is valid.
def check(registry):
    problems = [] if registry else ["defines no projects"]
    slot_owners = {}
    for name, project in registry.items():
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
            problems.append(f"{name}: a project name is lowercase letters, digits and dashes")
        if name in RESERVED:
            problems.append(f"{name}: the name is reserved for {RESERVED[name]}")
        if not isinstance(project, dict):
            problems.append(f"{name}: must be a table")
            continue
        check_keys(name, project, PROJECT_KEYS + tuple(PROJECT_OPTIONAL) + ("stack",), PROJECT_KEYS, problems)
        for key in PROJECT_STRINGS:
            if key in project:
                check_string(name, key, project[key], problems)
        for key in PROJECT_LISTS:
            if key in project and not is_string_list(project[key]):
                problems.append(f"{name}.{key}: must be a list of strings")
        checks = project.get("local_checks", [])
        if not is_string_list(checks):
            problems.append(f"{name}.local_checks: must be a list of strings")
        elif any(not command.strip() or "\n" in command for command in checks):
            problems.append(f"{name}.local_checks: each command must be one line, not empty")
        if is_string_list(project.get("docs")):
            problems.extend(
                f"{name}.docs: '{doc}' must be a relative path"
                for doc in project["docs"]
                if not is_relative_path(doc)
            )
        if "pool" in project:
            check_pool(name, project["pool"], slot_owners, problems)
        if "stack" in project:
            check_stack(name, project["stack"], problems)
    return problems


# The registry, parsed and checked; any problem refuses with every problem listed.
def load(path):
    try:
        with open(path, "rb") as registry_file:
            registry = tomllib.load(registry_file)
    except FileNotFoundError:
        fail(f"no registry at {path}")
    except tomllib.TOMLDecodeError as error:
        fail(f"{path}: not valid TOML: {error}")
    problems = check(registry)
    if problems:
        print("\n".join(f"{NAME}: {path}: {problem}" for problem in problems), file=sys.stderr)
        fail(f"{path}: {len(problems)} problem{'s' if len(problems) > 1 else ''}")
    return registry


# A checked project with every path that has a fixed root made absolute.
def resolve(project, home):
    resolved = dict(project, pool=dict(project["pool"]))
    for key, default in PROJECT_OPTIONAL.items():
        resolved.setdefault(key, default)
    if "stack" in project:
        resolved["stack"] = dict(project["stack"])
        for key, default in STACK_OPTIONAL.items():
            resolved["stack"].setdefault(key, default)
    pool = resolved["pool"]
    resolved["path"] = os.path.normpath(os.path.join(home, project["path"]))
    pool["slots"] = [os.path.normpath(os.path.join(home, slot)) for slot in pool["slots"]]
    for key in TREEHOUSE_ONLY:
        if key in pool:
            pool[key] = os.path.normpath(os.path.join(resolved["path"], pool[key]))
    return resolved


def lookup(name, project, dotted):
    value, where = project, name
    for part in dotted.split("."):
        if not isinstance(value, dict):
            fail(f"{name} has no key '{dotted}'; {where} is not a table")
        if part not in value:
            fail(f"{name} has no key '{dotted}'; {where} has: {', '.join(value)}")
        value, where = value[part], part
    return value


# Whether the paths a and b name one file, as the library's same_path says: both existing, by
# identity, so two spellings of one directory are one (a symlink, or another case on a
# case-insensitive filesystem, where realpath keeps the case it is given); neither existing, when
# their real paths have the same last name under one directory, so compared; else never.
def same_path(a, b):
    if not a or not b:
        return False
    if os.path.exists(a) and os.path.exists(b):
        return os.path.samefile(a, b)
    if os.path.exists(a) or os.path.exists(b):
        return False
    a, b = os.path.realpath(a), os.path.realpath(b)
    return os.path.basename(a) == os.path.basename(b) and same_path(os.path.dirname(a), os.path.dirname(b))


# The names of the projects whose dotted key is value, or holds it when a list.
def find(registry, home, dotted, value):
    if dotted == "repo":
        same = lambda held: held.casefold() == value.casefold()
    elif dotted in ABSOLUTE_PATHS:
        same = lambda held: same_path(held, value)
    else:
        same = lambda held: held == value
    found, known = [], False
    for name, project in registry.items():
        held = resolve(project, home)
        for part in dotted.split("."):
            held = held.get(part) if isinstance(held, dict) else None
        if held is None:
            continue
        known = True
        if any(isinstance(item, str) and same(item) for item in (held if isinstance(held, list) else [held])):
            found.append(name)
    if not known:
        fail(f"no project has a key '{dotted}'")
    return found


def main(args):
    if args[:1] in (["--help"], ["-h"]):
        print_help()
        return
    if args in (["--list"], ["--check"]) or (args[:1] == ["--find"] and len(args) == 3):
        pass
    elif not 1 <= len(args) <= 2 or args[0].startswith("-"):
        fail(USAGE, 2)
    home = os.environ.get("HOME") or fail("HOME is not set")
    path = os.path.join(team_home(), "projects.toml")
    registry = load(path)
    if args[0] == "--check":
        print(f"{path}: {len(registry)} projects ok")
    elif args[0] == "--list":
        print("\n".join(registry))
    elif args[0] == "--find":
        for name in find(registry, home, args[1], args[2]):
            print(name)
    elif args[0] not in registry:
        fail(f"unknown project '{args[0]}'; known: {', '.join(registry)}")
    else:
        value = resolve(registry[args[0]], home)
        if len(args) == 2:
            value = lookup(args[0], value, args[1])
        print(value if isinstance(value, str) else json.dumps(value, indent=2))


if __name__ == "__main__":
    main(sys.argv[1:])
