#!/usr/bin/env bash
# Start one agent-team worker as its own background session, in auto mode, with its role's
# settings and nothing else: no user-level MCP servers, no plugin MCP, no claude.ai connectors or
# synced skills and plugins, and none of the tools and skills its role never uses (settings/).
#
# Usage: team-worker <task> <role> <worktree> [--toolkit <name>]... [--model <alias>] [--request <link>] -- <first prompt>
#   task       T<n>, e.g. T1
#   role       planner | builder | reviewer | ops
#   worktree   a linked git worktree of the task's repo (never a primary checkout); for a task
#              opened by team-open, one of its open worktrees (opened or added, not returned)
#   --model    not for ops: the model alias or name to launch on instead of the registry's, such
#              as opus for a model trial's paired review (sops/model-trials.md)
#   --request  ops only, and required for it: the link to Daniel's Discord message asking
#
# Refuses a closed task, a task with no Discord thread, and a launch on a machine that does not
# hold the lease (`team-lease check`, confirmed against origin) or cannot reach GitHub. Prints the
# background session id and logs the launch to ledger.jsonl, with the worktree's project and
# branch when the task was opened by team-open, the machine's team name
# (~/.config/agent-team/machine), and the request for ops. T0, the load check, needs no thread and
# no lease, and is not logged. Recorded worktrees are compared as paths on this machine: one
# recorded under another machine's home is the same path under this HOME.
# Before it launches, it stops each idle live session of the task's earlier launches whose work
# is handed on (every planner and reviewer, and every builder of the same worktree when the new
# worker is a builder: one builder holds a worktree's work at a time) once the ledger follows its
# launch with an event of its own (a done of its session, a paused, a reviewer's review, a builder's
# pr or ticket-done). It leaves a busy one, one waiting for input, one whose status is not idle,
# one with no such event (the sweep's silent one) and an ops session; team-close still removes
# every session at the close. Each stop and each session left is said on stderr; a stop that
# fails, or a session list that cannot be read, is a warning, and the launch goes on. T0 stops
# nothing.
# When the worktree's project names a model for the role in the registry (team-project's models),
# or --model names one, the session launches on it (claude --model) and the launch logs it as
# model; otherwise it runs on the user settings' model, and logs none. Ops never takes one, and
# T0 and tasks from before team-open none from the registry.
# The merged settings and MCP config are generated into tasks/<task>/ (gitignored); @TEAM_CODE@
# in either names this checkout, @TASK@ the task, @TASK_DIR@ the team home's tasks/<task>/, and
# @ROLE@ the role (the settings' AGENT_TEAM_ROLE, the signal a hook sees in a team session, and
# with AGENT_TEAM_TASK, the task, what worker_refusal in bin/lib/team.sh reads).
#
# The coordinator toolkit is claude-coordinator's alone, never a worker's, and the frontend toolkit
# Daniel's own sessions', since it attaches to their one Agent Chrome window.
# Production toolkits (prod-*) are for the ops role only, which needs prod-read (prod-write comes
# only beside it) and --request, and is refused while any T<n>-ops session is listed by claude
# agents (one at a time; end it with team-ops-end). An ops session runs with --restricted and only
# the built-in tools Read, Glob, Grep, Edit, Write, ToolSearch, SendMessage, ListAgents and Skill
# (for its toolkits' skills): no shell, no web.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

# Roles, settings, toolkits and hooks are code: they come from this checkout, beside bin/.
code=$(dirname "$(dirname "$TEAM_LIB")")

[[ $# -ge 3 ]] || usage_error "usage: team-worker <task> <role> <worktree> [--toolkit <name>]... [--model <alias>] [--request <link>] -- <first prompt>"
task=$1 role=$2 worktree=$3
shift 3
[[ $task =~ ^T[0-9]+$ ]] || usage_error "task must look like T<n>, got '$task'"
[[ -f $code/roles/$role.md && -f $code/settings/$role.json ]] || usage_error "unknown role '$role'"

toolkits=() request='' model=''
while [[ $# -gt 0 && $1 != -- ]]; do
  case $1 in
    --toolkit)
      [[ $# -ge 2 ]] || usage_error "--toolkit needs a name"
      [[ -d $code/toolkits/$2 ]] || usage_error "unknown toolkit '$2'"
      [[ $2 != coordinator ]] || usage_error "toolkit 'coordinator' is the coordinator's own (claude-coordinator loads it)"
      [[ $2 != frontend ]] || usage_error "toolkit 'frontend' is Daniel's own (claude --plugin-dir in their session): it attaches to their one Agent Chrome window, never a worker's"
      toolkits+=("$2")
      shift 2
      ;;
    --model)
      # An alias or name as claude --model takes it: sonnet, claude-sonnet-5-5, sonnet[1m].
      [[ $# -ge 2 && $2 =~ ^[A-Za-z0-9][][A-Za-z0-9._-]*$ ]] || usage_error "--model needs a model alias or name"
      model=$2
      shift 2
      ;;
    --request)
      [[ $# -ge 2 && -n $2 ]] || usage_error "--request needs Daniel's Discord message link"
      request=$2
      shift 2
      ;;
    *) usage_error "unexpected argument '$1'" ;;
  esac
done
[[ ${1:-} == -- ]] || usage_error "missing '--' before the first prompt"
shift
prompt="$*"
[[ -n $prompt ]] || usage_error "missing first prompt"
[[ -z $request || $role == ops ]] || usage_error "--request is for the ops role only"
[[ -z $model || $role != ops ]] || usage_error "--model is not for the ops role, which runs on the default model"

# Production reaches only the ops role, and only on Daniel's recorded request.
for kit in "${toolkits[@]}"; do
  [[ $kit != prod-* || $role == ops ]] || die "toolkit '$kit' is for the ops role only"
done
if [[ $role == ops ]]; then
  # A write session reads through the read user, never the write user.
  [[ " ${toolkits[*]} " != *" prod-write "* || " ${toolkits[*]} " == *" prod-read "* ]] ||
    die "prod-write needs --toolkit prod-read beside it"
  [[ " ${toolkits[*]} " == *" prod-read "* ]] || die "the ops role needs --toolkit prod-read"
  [[ -n $request ]] || die "the ops role needs --request <the link to Daniel's Discord message>"
fi

# A worker runs only in a linked worktree, so it can never edit a primary checkout.
real=$(realpath -e -- "$worktree" 2>/dev/null) || die "$worktree does not exist"
worktree=$real
git_dir=$(git -C "$worktree" rev-parse --absolute-git-dir 2>/dev/null) || die "$worktree is not a git checkout"
common_dir=$(realpath -- "$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)")
! same_path "$git_dir" "$common_dir" || die "$worktree is a primary checkout, not a linked worktree"

# T0 is the load check, not a task: it has no ledger entry and stays out of the ledger.
worktree_event=
if [[ $task != T0 ]]; then
  events=$(task_events "$task" | jq -cs .)
  status=$(task_status "$events")
  [[ $status != closed ]] || die "$task is closed"
  # Every task has its Discord thread before any worker starts (bin/team-thread).
  jq -e 'any(.[]; .event == "thread")' <<<"$events" >/dev/null ||
    die "$task has no Discord thread; open one first with team-thread"

  # A task opened by team-open launches only in one of its open worktrees; tasks from before
  # team-open (no opened event) launch in any linked worktree.
  if [[ $status == open ]]; then
    open=
    while IFS= read -r line; do
      wt=$(jq -r .worktree <<<"$line")
      if same_path "$wt" "$worktree"; then worktree_event=$line; fi
      open+=$'\n'"  $(jq -r '"\(.worktree) (\(.project), \(.branch))"' <<<"$line")"
    done < <(task_worktrees "$task")
    [[ -n $worktree_event ]] || die "$worktree is not one of $task's open worktrees:${open:- it has none}"
  fi

  lease_gate "a worker"
  machine=$(machine_name) || exit 1
fi

# The project's model for the role, from the registry, unless --model named one; ops stays on the
# default model.
project=$(jq -r '.project // empty' <<<"${worktree_event:-null}")
if [[ -z $model && -n $project && $role != ops ]]; then
  models=$(team_project "$project" models) || exit 1
  model=$(jq -r --arg role "$role" '.[$role] // empty' <<<"$models")
fi
model_args=()
if [[ -n $model ]]; then model_args=(--model "$model"); fi

taskdir=$TEAM_HOME/tasks/$task
mkdir -p "$taskdir"

# One ops session at a time, across every task.
if [[ $role == ops ]]; then
  live_sessions
  busy=$(jq -r '[.[] | select((.name // "") | test("^T[0-9]+-ops$")) | "\(.name) (\(.id))"] | join(", ")' <<<"$LIVE_SESSIONS")
  [[ -z $busy ]] || die "an ops session is already listed: $busy; end it with team-ops-end first"
fi

# @TEAM_CODE@ names this checkout, where the hooks and toolkits live; @TASK@ names the task, and
# @TASK_DIR@ its directory in the team home, where its records live (the ops log); @ROLE@ the role.
substitute='walk(if type == "string" then gsub("@TEAM_CODE@"; $code) | gsub("@TASK@"; $task)
  | gsub("@TASK_DIR@"; $taskdir) | gsub("@ROLE@"; $role) else . end)'

# Role settings layered on the shared worker settings; permission lists and each event's hook
# list are concatenated, the shared ones first, so a role's hooks add to the shared hooks.
settings=$taskdir/settings.$role.json
jq -s --arg code "$code" --arg task "$task" --arg taskdir "$taskdir" --arg role "$role" '.[0] as $base | .[1] as $own
  | ($base * $own)
  | .permissions.deny = (($base.permissions.deny // []) + ($own.permissions.deny // []))
  | .permissions.allow = (($base.permissions.allow // []) + ($own.permissions.allow // []))
  | .permissions.ask = (($base.permissions.ask // []) + ($own.permissions.ask // []))
  | .permissions |= with_entries(select(.value != []))
  | if $base.hooks or $own.hooks then
      .hooks = reduce ((($base.hooks // {}) + ($own.hooks // {})) | keys[]) as $event ({};
        .[$event] = (($base.hooks[$event] // []) + ($own.hooks[$event] // [])))
    else . end
  | '"$substitute" \
  "$code/settings/worker.json" "$code/settings/$role.json" >"$settings"

# MCP servers come only from the chosen toolkits.
mcp=$taskdir/mcp.$role.json
plugin_args=()
mcp_files=()
for kit in "${toolkits[@]}"; do
  dir=$code/toolkits/$kit
  plugin_args+=(--plugin-dir "$dir")
  if [[ -f $dir/.mcp.json ]]; then mcp_files+=("$dir/.mcp.json"); fi
done
if [[ ${#mcp_files[@]} -gt 0 ]]; then
  jq -s --arg code "$code" --arg task "$task" --arg taskdir "$taskdir" --arg role "$role" '{mcpServers: (map(.mcpServers // {}) | add)} | '"$substitute" \
    "${mcp_files[@]}" >"$mcp"
else
  echo '{"mcpServers": {}}' >"$mcp"
fi

# An ops session gets no shell, no web and no other outbound tool.
restricted=()
if [[ $role == ops ]]; then
  restricted=(--restricted --tools "Read,Glob,Grep,Edit,Write,ToolSearch,SendMessage,ListAgents,Skill")
fi

# The task's finished workers: each live session of its earlier launches whose work is handed on
# is stopped while it is idle, so it stops holding the machine's memory. Handed on is every planner
# and reviewer, and every builder of this worktree when this is a builder (one builder holds a
# worktree's work at a time), whose launch the ledger follows with an event of its own: a done of
# its session, a paused (a stow), and a reviewer's review or a builder's pr or ticket-done. A
# session that is busy, waiting for input, not idle by its status, or idle with no such event (the
# sweep's silent one) is left and named, and so is an ops session. The session list is read only
# when such a launch exists, and a list that cannot be read or a stop that fails never stops the
# launch.
if [[ $task != T0 ]]; then
  finished=$(jq -c --arg role "$role" '. as $events
    | [to_entries[] | .key as $i | .value | select(.event == "launch" and (.session | type) == "string" and .session != ""
        and (.role == "planner" or .role == "reviewer" or (.role == "builder" and $role == "builder")))
      | . as $l
      | . + {handed_on: any($events[$i + 1:][]; (.event == "done" and .session == $l.session) or .event == "paused"
          or (.event == "review" and $l.role == "reviewer") or ((.event == "pr" or .event == "ticket-done") and $l.role == "builder"))}]' <<<"$events")
  if [[ $finished != '[]' ]]; then
    if listed=$(live_sessions 2>/dev/null && printf '%s' "$LIVE_SESSIONS"); then
      LIVE_SESSIONS=$listed
      while IFS=$'\t' read -r session worker state wt; do
        # A builder of another worktree (a second project's PR) still holds its own work.
        if [[ $worker == builder ]] && ! same_path "$wt" "$worktree"; then continue; fi
        if [[ $state != handed-on ]]; then
          echo "team-worker: left $task-$worker $session: $state" >&2
        elif stop_out=$(bounded 30 claude stop "$session" 2>&1 </dev/null); then
          echo "team-worker: stopped $task-$worker $session: its work is handed on" >&2
        else
          echo "team-worker: warning: could not stop $task-$worker $session ($(grep -m1 . <<<"$stop_out" || echo "claude stop failed")); the launch goes on" >&2
        fi
      done < <(ledger_jq '.[] | live_session(.session; $sessions) as $live | select($live != null)
          | [.session, .role,
              if $live.status == "busy" then "busy"
              elif $live.state == "blocked" then "waiting for input"
              elif $live.status == null then "no status"
              elif $live.status != "idle" then "status \($live.status)"
              elif .handed_on | not then "idle with no event of its own since its launch"
              else "handed-on" end,
              (.worktree | local_path($home))] | @tsv' -r --argjson sessions "$LIVE_SESSIONS" <<<"$finished")
    else
      echo "team-worker: warning: cannot read the live session list (claude agents --json), so no finished session was stopped" >&2
    fi
  fi
fi

name=$task-$role
# --mcp-config and --tools take several values, so neither may come right before the prompt.
out=$(cd "$worktree" && claude --bg "${restricted[@]}" \
  --strict-mcp-config --mcp-config "$mcp" \
  "${plugin_args[@]}" \
  --settings "$settings" \
  --append-system-prompt-file "$code/roles/$role.md" \
  --permission-mode auto \
  "${model_args[@]}" \
  --name "$name" \
  "$prompt")
[[ $out != *"send a prompt to start"* ]] || die "the session started without its prompt: $out"
id=$(grep -oE '\b[0-9a-f]{8}\b' <<<"$out" | head -n 1) || die "could not read the session id from: $out"

if [[ $task != T0 ]]; then
  ledger_append "$(jq -cn --arg task "$task" --arg role "$role" --arg session "$id" --arg worktree "$worktree" \
    --arg machine "$machine" --arg model "$model" --arg request "$request" --argjson at "${worktree_event:-null}" --args '{ts: (now | todate), task: $task,
      event: "launch", role: $role, session: $session, worktree: $worktree, toolkits: $ARGS.positional}
      + ($at // {} | {project, branch} | with_entries(select(.value != null)))
      + {machine: $machine}
      + (if $model == "" then {} else {model: $model} end)
      + (if $request == "" then {} else {request: $request} end)' "${toolkits[@]}")"
fi

echo "$id"
