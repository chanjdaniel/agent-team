#!/usr/bin/env bash
# Merge a task's PR on Daniel's recorded word, only with every required check green on its head.
#
# Usage: team-merge T<n> [--pr <url>]
# The PR is the task's latest pr event, or --pr, which must be one of the task's pr events; its
# repo must be a project in projects.toml. Checks first, changing nothing, each failure a reason:
#   a merge-approved event names the PR's url (the latest counts; a trailing slash aside), and
#   its discord_message is a message sent no earlier than the first event that logged its head
#   (a pr event of the url, or a review of the task since the url's first pr event; by the time
#   in its id), in the task's thread or in #coordinator, read with the bot token through
#   the Discord API, whose author is in allowFrom of ~/.claude/channels/discord/access.json;
#   Daniel's word holds for the PR's head when it is the approval's head, or when every commit
#   since that head not on origin's base is a merge commit (read in the primary checkout, after
#   fetching the PR's branch and the base) and a review with verdict pass on the head now is
#   logged after the approval; a head that does not hold the approval's, or holds a commit of
#   its own since it (the first is named), is refused, to ask again; the approval's head must be
#   one such an event logged; a legacy approval with no head holds for any head, its
#   message sent no earlier than the PR's latest pr event;
#   or, only when no merge-approved names the PR's url, Daniel's plan-time word: the latest
#   merge-preapproved of the PR's project stands (no merge-preapproval-withdrawn of the project
#   since; a withdrawn one is refused naming when and in which message), its discord_message is
#   sent no earlier than the latest asked of the id it answers logged before it, and read back
#   from Discord as a merge-approved's is; the project opts in now (merge_with_plan, read from
#   projects.toml at each run) and is not the team's own (own_project: agent-team by name, by
#   path or by repo); the PR's head branch is the task's branch for the project (its latest
#   opened, worktree-added or branch-renamed event's, so a branch the gate made the builder move
#   to counts once the coordinator logs it); the latest review of the head (by the shorter
#   prefix) has verdict pass and logged guarded as an empty list (one that left it out, or named
#   areas, is refused, naming them); no review of the task counted a security or real-data
#   finding, fixed or not, or left out its findings, each such review named by its head and time;
#   the PR's changed files, read from GitHub's paged list of its files (each filename, and each
#   rename's previous filename), number the PR's changedFiles, else the list is refused as not
#   read in full; each changed path is within the approval's scope (an entry ending in / covers
#   every path under it, any other that path only), each one outside named; and no changed path
#   matches a guarded pattern of bin/lib/guarded (CI, dependencies, migrations, settings,
#   permissions, secrets), as it is or with its camelCase humps split off by underscores, each
#   one named with its areas; a per-head merge checks none of these; every check below holds for
#   it too, and a refusal ends with a line saying to ask Daniel for the per-head word on the
#   head;
#   the PR is open, not a draft, does not conflict, and targets the project's base;
#   every required check (the base branch's protection, gh pr checks --required and the
#   project's required_checks) is present on the head and passed (a skipped one passes);
#   no check on the head is failing or pending; agent-review is success on the head;
#   no commit of the PR carries an agent attribution line, and the list read ends at the head.
# Then, for a project with local_checks, team-checks runs them on the PR's head (fetched from
# origin) from the primary checkout, labelled "team-merge T<n>" under the heavy-run lock, and each
# must pass (exit 75: the lock stayed held, try again later); the head read again after must not
# have moved.
# Any failure is exit 1 with every reason, and gh pr merge is never called.
# Then: gh pr merge <number> --repo <repo> --<merge_method> --match-head-commit <head>, never
# --auto or --admin; the PR is read again and must be merged (if gh left it open with auto-merge
# on, auto-merge is turned off and it is exit 1); then merged is appended with pr, merge, head,
# by (naming the Discord message and its author), project, branch, discord_message,
# discord_channel, url (the PR's), approval (head for the per-head word, plan for the plan-time
# one), and local_checks (the commands that passed on head) when there were any. Prints {task,
# pr, merge, head, by}.
# Then, on the plan-time word only, team-post posts one message to the task's thread and one to
# #coordinator: the task, the PR's URL, the merge commit, Daniel's message as a link (its guild
# the one team-inbox keeps, else #coordinator's channel's; with none, the message is named and a
# line on stderr says why), and how to revert: the PR page's Revert button, or on the base
# git revert -m 1 <merge> for a merge, git revert <merge> for a squash, and for a rebase
# git revert <merge>~<n>..<merge>, the PR's n commits less its merges; with no thread, it posts to
# #coordinator alone, saying so on stderr. A post that fails (Discord refuses it, or team-post
# refuses on a fenced machine) is said on stderr, naming where, with its full text, for the
# coordinator to post with team-post; the merge stands and the exit stays 0. A per-head merge
# posts nothing.
# Then, when the project's primary checkout is the code checkout this runs from, that checkout
# follows the base, so merged code reaches the scripts: on the base branch and clean (untracked
# files aside), it is fast-forwarded to origin's, said on one line; on another branch or a
# detached HEAD, with local changes, ahead or diverged, with untracked files in the way, or with
# origin out of reach, it is left as it is, with the reason and the command to run, and the exit
# stays 0.
# Last, team-inbox takes the PR out of the Waiting on you message; when that fails, a line on
# stderr says so, and the exit stays 0.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-merge T<n> [--pr <url>]"

task='' url=''
while (($#)); do
  case $1 in
    --pr)
      [[ $# -ge 2 && -n $2 ]] || usage_error "$usage"
      url=${2%/}
      shift
      ;;
    -*) usage_error "$usage" ;;
    *)
      [[ -z $task ]] || usage_error "$usage"
      task=$1
      ;;
  esac
  shift
done
[[ -n $task ]] || usage_error "$usage"
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"

events=$(known_task_events "$task")
jq -e 'any(.[]; .event == "pr")' <<<"$events" >/dev/null || die "$task has no pr event, so there is no PR to merge"
if [[ -z $url ]]; then
  pr=$(jq -c 'map(select(.event == "pr")) | last' <<<"$events")
else
  pr=$(jq -c --arg url "$url" 'map(select(.event == "pr" and (.url | rtrimstr("/")) == $url)) | last' <<<"$events")
  [[ $pr != null ]] ||
    die "$url is not one of $task's pr events:"$'\n'"$(jq -r '.[] | select(.event == "pr") | "  \(.url)"' <<<"$events")"
fi

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# The PR as team-state sees it: the repo, the project, the head and the checks by bucket.
facts=$(pr_part "$events" "$pr" "$scratch") || exit 1
url=$(jq -r .url <<<"$facts")
[[ $(jq -r '.number // empty' <<<"$facts") ]] || die "$(jq -r .error <<<"$facts")"
number=$(jq -r .number <<<"$facts") repo=$(jq -r .repo <<<"$facts") project=$(jq -r '.project // empty' <<<"$facts")
[[ -n $project ]] || die "PR #$number is in $repo, which is not a project in projects.toml, so it has no base or merge method"
base=$(team_project "$project" base)
method=$(team_project "$project" merge_method)

problems=()
# Each line jq prints is one reason more; a jq that fails ends the run, nothing merged:
# add_problems <jq arguments>...
add_problems() {
  local out line
  out=$(jq -r "$@") || die "PR #$number cannot be checked: jq failed (exit $?), so nothing changed"
  while IFS= read -r line; do if [[ -n $line ]]; then problems+=("$line"); fi; done <<<"$out"
}

# Daniel's word on the PR, per head or at plan time. A <kind> event names Daniel's Discord message,
# which holds when it is an id sent no earlier than <since> (the time of <what>) and Discord shows
# it in the task's thread or #coordinator from an allowFrom author; then by and channel name it,
# else its reason is one among the rest: word_from <kind> <message> <since> <what>
thread=$(jq -r 'map(select(.event == "thread")) | last | .discord_thread // empty' <<<"$events")
by='' channel=''
word_from() {
  local kind=$1 message=$2 since=$3 what=$4 sent places=() reply
  if [[ ! $message =~ ^[1-9][0-9]{0,18}$ ]]; then
    problems+=("$kind names discord_message '$message', which is not a Discord message id")
    return
  fi
  # A Discord id holds the milliseconds since 2015-01-01 above its low 22 bits.
  sent=$(((10#$message >> 22) / 1000 + 1420070400))
  if ((sent < $(date -ud "$since" +%s))); then
    problems+=("Discord message $message was sent at $(date -ud "@$sent" +%FT%TZ), before $what at $since, so it is not Daniel's word on this PR")
    return
  fi
  if [[ -n $thread ]]; then places+=("the task's thread $thread"); fi
  places+=("#coordinator $COORDINATOR_CHANNEL")
  if reply=$(daniel_message "$message" "the approval" "${places[@]}" 2>"$scratch/word"); then
    by="Discord message $message in $(jq -r .place <<<"$reply"), from $(jq -r .who <<<"$reply")"
    channel=$(jq -r .channel <<<"$reply")
  else
    problems+=("$(<"$scratch/word")")
  fi
}

# The per-head word: the latest merge-approved naming this PR's URL, its message sent since the
# first pr or review event that logged the head it names (a legacy one names none: the PR's latest
# pr event). A number alone names a PR in any repo, so it never counts.
word=head message='' task_branch=''
approval=$(jq -c --arg url "${url%/}" '
  [to_entries[] | .value + {i: .key}
    | select(.event == "merge-approved" and (.url | strings | rtrimstr("/")) == $url)] | last' <<<"$events")
approved=$(jq -r '.head // empty' <<<"$approval")
# The event the message is timed against: the first that logged the approval's head (head_logged),
# or for a legacy approval the PR's latest pr event.
logged=$(ledger_jq '
  if $head == "" then map(select(.event == "pr" and (.url | rtrimstr("/")) == $url)) | last else head_logged($url; $head) end
  | if . == null then empty else "\(.ts) \(.event)" end' -r --arg url "${url%/}" --arg head "$approved" <<<"$events")
pr_ts=${logged% *}
# The plan-time word, read only when no per-head word names the PR: the latest merge-preapproved of
# the PR's project, standing until a later withdrawal, with asked, the latest asked of the id it
# answers logged before it.
preapproval=null
if [[ $approval == null ]]; then
  preapproval=$(ledger_jq '. as $events
    | ([to_entries[] | select(.value.event == "merge-preapproved" and .value.project == $p)] | last | .key) as $k
    | merge_preapproval($p) | if . == null then null else . as $a | . + {asked: ($events[:$k] | latest_asked($a.ask))} end' \
    -c --arg p "$project" <<<"$events")
fi
if [[ $approval != null ]]; then
  if [[ -z $pr_ts ]]; then
    problems+=("merge-approved names the head ${approved:0:7}, which no pr event of $url, nor a review since, logged: ask again on the PR's head")
  else
    message=$(jq -r '.discord_message | tostring' <<<"$approval")
    word_from merge-approved "$message" "$pr_ts" "the ${logged#* } event of $url${approved:+ at ${approved:0:7}}"
  fi
elif [[ $preapproval == null ]] || jq -e '.withdrawn != null' <<<"$preapproval" >/dev/null; then
  problems+=("no merge-approved event for $url: Daniel's word is not recorded")
  if [[ $preapproval != null ]]; then
    problems+=("$(jq -r '"Daniel'"'"'s plan-time word on \(.project), Discord message \(.discord_message), was withdrawn at \(.withdrawn.ts) in Discord message \(.withdrawn.discord_message)"' <<<"$preapproval")")
  fi
else
  word=plan
  message=$(jq -r '.discord_message | tostring' <<<"$preapproval")
  ask=$(jq -r .ask <<<"$preapproval")
  if [[ $(jq -r .asked <<<"$preapproval") == null ]]; then
    problems+=("merge-preapproved answers the ask $ask, which $task did not log before it")
  else
    word_from merge-preapproved "$message" "$(jq -r .asked.ts <<<"$preapproval")" "the asked $ask"
  fi
  # Read now, so a project that stops opting in stops merging at once.
  if own_project "$project"; then
    problems+=("$project is the team's own project, whose PRs merge only on Daniel's word per head")
  elif [[ $(team_project "$project" merge_with_plan) != true ]]; then
    problems+=("$project does not opt in to plan-time merges now: its merge_with_plan in projects.toml is false")
  fi
  task_branch=$(ledger_jq 'task_branch($project) // ""' -r --arg project "$project" <<<"$events")
fi

# GitHub's facts: the checks from pr_part, the rest from one more view, the base branch's
# protection and the commit list.
head='' branch=''
if jq -e 'has("error")' <<<"$facts" >/dev/null; then
  problems+=("GitHub cannot be read: $(jq -r .error <<<"$facts")")
elif ! github "$scratch" pr pr view "$number" --repo "$repo" --json isDraft,mergeable,headRefName,headRefOid,changedFiles ||
  ! github "$scratch" branch api "repos/$repo/branches/$base" ||
  ! github "$scratch" commits api "repos/$repo/pulls/$number/commits" --paginate; then
  problems+=("GitHub cannot be read: $(<"$scratch/error")")
else
  head=$(jq -r .head <<<"$facts") branch=$(jq -r .headRefName "$scratch/pr")
  state=$(jq -r .state <<<"$facts")
  [[ $state == open ]] || problems+=("PR #$number is $state, not open")
  [[ $(jq -r .isDraft "$scratch/pr") != true ]] || problems+=("PR #$number is a draft")
  case $(jq -r .mergeable "$scratch/pr") in
    MERGEABLE) ;;
    CONFLICTING) problems+=("PR #$number conflicts with its base") ;;
    *) problems+=("GitHub has not worked out yet whether PR #$number conflicts with its base; try again in a minute") ;;
  esac
  [[ $(jq -r .base <<<"$facts") == "$base" ]] || problems+=("PR #$number targets $(jq -r .base <<<"$facts"), not $project's base $base")
  [[ $(jq -r .headRefOid "$scratch/pr") == "$head" ]] || problems+=("the head moved while it was read (${head:0:7}, then $(jq -r '.headRefOid[:7]' "$scratch/pr")); run team-merge again")
  while IFS= read -r line; do problems+=("$line"); done < <(jq -r --slurpfile branch "$scratch/branch" '
    ((.required + ($branch[0].protection.required_status_checks.contexts // [])) | unique) as $required
    | (.checks.passed + .checks.failing + .checks.pending) as $present
    | ($required[] | select(IN($present[]) | not) | "required check \(.) is missing on the head"),
      ([$required[] | select(IN($present[]))] - .checks.passed | .[] | "required check \(.) has not passed on the head"),
      (.checks.failing | select(length > 0) | "checks failing on the head: \(join(", "))"),
      (.checks.pending | select(length > 0) | "checks pending on the head: \(join(", "))"),
      (.agent_review | select(. != "success") | "agent-review is \(.) on the head, not success")' <<<"$facts")
  commits=$(jq -cs 'add // []' "$scratch/commits")
  last=$(jq -r 'last.sha // ""' <<<"$commits")
  [[ $last == "$head" ]] || problems+=("the PR's commit list ends at ${last:0:7}, not at the head ${head:0:7}, so not every commit could be checked")
  attributed=''
  while IFS= read -r sha; do
    msg=$(jq -r --arg s "$sha" '.[] | select(.sha == $s) | .commit.message' <<<"$commits")
    while IFS= read -r line; do
      problems+=("commit ${sha:0:7} ($(head -n 1 <<<"$msg")) carries an attribution line: $line")
      attributed=1
    done < <(attribution_lines <<<"$msg")
  done < <(jq -r '.[].sha' <<<"$commits")
fi

# The plan-time word holds only for the task's own branch for the project, only on a head whose
# latest review (by the shorter prefix) is a pass that found no guarded area, only for a PR whose
# every changed path is within the scope Daniel approved and matches no guarded pattern
# (bin/lib/guarded), and only for a task no review of which counted a security or real-data
# finding, or left its counts out.
if [[ $word == plan && -n $head ]]; then
  if [[ -z $task_branch ]]; then
    problems+=("$task logged no branch for $project: no opened, worktree-added or branch-renamed event of it")
  elif [[ $branch != "$task_branch" ]]; then
    problems+=("PR #$number comes from $branch, not $task_branch, $task's branch for $project")
  fi
  reviewed=$(ledger_jq '[.[] | select(.event == "review" and same_head(.head; $head))] | last' -c --arg head "$head" <<<"$events")
  if [[ $reviewed == null ]]; then
    problems+=("no review of the head ${head:0:7} is logged, so no reviewer has passed it")
  elif [[ $(jq -r .verdict <<<"$reviewed") != pass ]]; then
    problems+=("$(jq -r --arg h "${head:0:7}" '"the latest review of the head \($h), at \(.ts), is \(.verdict), not pass"' <<<"$reviewed")")
  fi
  add_problems --arg h "${head:0:7}" '
    select(. != null) | "the latest review of the head \($h), at \(.ts), " as $review
    | if has("guarded") | not then "\($review)logged no guarded areas, so no reviewer has said the change touches none"
      elif .guarded != [] then "\($review)found the change touching guarded areas: \(.guarded | join(", "))"
      else empty end' <<<"$reviewed"
  add_problems '
    .[] | select(.event == "review") | "the review of the head \(.head[:7]), at \(.ts), " as $review
    | if has("findings") | not then
        "\($review)logged no finding counts, so whether it found a security or real-data issue is not known"
      else
        [.findings | ("security", "real-data") as $kind | .[$kind] | select(. > 0)
          | "\(.) \($kind) finding\(if . == 1 then "" else "s" end)"]
        | select(length > 0)
        | "\($review)counted \(join(" and ")): such a finding on the task, even fixed, comes back to Daniel"
      end' <<<"$events"

  # The PR's changed paths, each rename's old path too, from GitHub's paged list, which must hold
  # every file the PR changes.
  if ! github "$scratch" files api "repos/$repo/pulls/$number/files" --paginate; then
    problems+=("GitHub cannot be read: $(<"$scratch/error")")
  else
    changed=$(jq -cs 'add // [] | [.[] | {path: .filename}, (select(.previous_filename) | {path: .previous_filename, renamed: .filename})]' \
      "$scratch/files")
    listed=$(jq -s 'add // [] | length' "$scratch/files") count=$(jq -r '.changedFiles // "unknown number of"' "$scratch/pr")
    [[ $listed == "$count" ]] ||
      problems+=("GitHub's list of PR #$number's files holds $listed files, not its $count changed files, so not every file could be checked")
    # Each guarded pattern's matches among the changed paths, as {path, area} lines: a path matches
    # as it is, or with each camelCase hump split off by an underscore (applicantSessionExpiry.ts
    # as applicant_Session_Expiry.ts, CSRFToken.ts as CSRF_Token.ts), so a pattern's words match
    # inside such a name. A path with a line break, which grep would read as two, is refused below.
    paths=$(jq -r '.[].path' <<<"$changed") guarded=''
    humps=$(sed -E 's/([[:lower:][:digit:]])([[:upper:]])/\1_\2/g; s/([[:upper:]])([[:upper:]][[:lower:]])/\1_\2/g' <<<"$paths")
    while read -r area pattern; do
      [[ -n $area && $area != '#'* ]] || continue
      lines=''
      for form in "$paths" "$humps"; do
        rc=0
        found=$(grep -Eixn -e "$pattern" <<<"$form") || rc=$?
        if ((rc > 1)); then
          problems+=("the guarded pattern '$pattern' ($area) in bin/lib/guarded cannot be read by grep -E")
          break
        fi
        lines+=$(cut -d: -f1 <<<"$found")$'\n'
      done
      matched=$(awk 'NR == FNR { if ($0 != "") hit[$0]; next } FNR in hit' <(printf '%s' "$lines") <(printf '%s\n' "$paths"))
      guarded+=$(jq -cR --arg area "$area" 'select(. != "") | {path: ., area: $area}' <<<"$matched")$'\n'
    done <"$TEAM_LIB/guarded"
    add_problems --argjson scope "$(jq -c .scope <<<"$preapproval")" --argjson guarded "$(jq -cs . <<<"$guarded")" '
      def name: if .renamed then "\(.path), renamed to \(.renamed)," else .path end;
      (.[] | select(.path | test("\n")) | "\(.path | @json) holds a line break, so no guarded pattern can be matched against it"),
      (.[] | .path as $p | select(any($scope[]; . as $entry | if endswith("/") then $p | startswith($entry) else $p == $entry end) | not)
        | "\(name) is outside the scope of Daniel'"'"'s plan-time word: \($scope | join(", "))"),
      (.[] | . as $file | [$guarded[] | select(.path == $file.path) | .area]
        | reduce .[] as $a ([]; if IN(.[]; $a) then . else . + [$a] end) | select(. != [])
        | "\($file | name) is a guarded path (\(join(", "))): a change there comes back to Daniel")' <<<"$changed"
  fi
fi

# Daniel's word on a head the PR has since moved past holds only through merges of the base whose
# passing review was logged after the word, read in the primary checkout once the PR's branch and
# the base are fetched from origin.
if [[ -n $approved && -n $pr_ts && -n $head ]] &&
  ! ledger_jq 'same_head($a; $b)' -ne --arg a "$approved" --arg b "$head" >/dev/null; then
  primary=$(team_project "$project" path)
  if ! git -C "$primary" fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" \
    "+refs/heads/$base:refs/remotes/origin/$base" 2>"$scratch/fetch-error"; then
    problems+=("the head ${head:0:7} cannot be fetched into $primary to check it against Daniel's word on ${approved:0:7}: $(grep -m1 . "$scratch/fetch-error" || echo "git fetch failed")")
  elif ! git -C "$primary" merge-base --is-ancestor "$approved" "$head" 2>/dev/null; then
    problems+=("the head ${head:0:7} does not hold ${approved:0:7}, the head Daniel's word named: ask again")
  else
    own=$(git -C "$primary" rev-list --reverse --no-merges "$head" "^$approved" "^origin/$base")
    if [[ -n $own ]]; then
      problems+=("the head moved past Daniel's word with ${own:0:7}: ask again")
    elif ! ledger_jq 'any(.[$approval.i + 1:][]; .event == "review" and .verdict == "pass" and same_head(.head; $head))' \
      -e --argjson approval "$approval" --arg head "$head" <<<"$events" >/dev/null; then
      problems+=("the head ${head:0:7} is ${approved:0:7}, Daniel's word, with merges of the base, but no passing review of ${head:0:7} is logged after the word: review it, or ask again")
    fi
  fi
fi

# Refuse, with every reason, when there is any.
refuse_on_problems() {
  ((${#problems[@]})) || return 0
  {
    echo "team-merge: $task cannot merge PR #$number, so nothing changed:"
    printf '  %s\n' "${problems[@]}"
    if [[ -n ${attributed:-} ]]; then echo "  (team-clean-messages <worktree> strips them; push its rewrite and wait for the checks again)"; fi
    if [[ $word == plan ]]; then
      local on="the PR's head"
      if [[ -n $head ]]; then on="the head ${head:0:7}"; fi
      echo "  (Daniel's plan-time word does not hold: ask them for the per-head word on $on with team-ask, naming $url)"
    fi
  } >&2
  exit 1
}
refuse_on_problems

# The project's local checks, last since they are the slowest: team-checks runs them in a detached
# worktree of the primary checkout at the PR's exact head, then the head is read again.
mapfile -t local_checks < <(team_project "$project" local_checks | jq -r '.[]')
if ((${#local_checks[@]})); then
  primary=$(team_project "$project" path)
  if ! git -C "$primary" fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>"$scratch/fetch-error" ||
    ! git -C "$primary" cat-file -e "$head^{commit}" 2>/dev/null; then
    problems+=("the head ${head:0:7} cannot be fetched into $primary for the local checks: $(grep -m1 . "$scratch/fetch-error" || echo "origin's $branch is elsewhere")")
    refuse_on_problems
  fi
  rc=0
  "$(dirname "$TEAM_LIB")/team-checks" "$project" "$head" --from "$primary" --label "team-merge $task" >"$scratch/checks" || rc=$?
  if ((rc)); then
    problems+=("the local checks did not pass on the head ${head:0:7} (team-checks exit $rc):"$'\n'"$({ grep -v "' passed on the head " "$scratch/checks" || true; } | sed 's/^/    /')")
  fi
  if github "$scratch" again pr view "$number" --repo "$repo" --json headRefOid; then
    moved=$(jq -r .headRefOid "$scratch/again")
    [[ $moved == "$head" ]] ||
      problems+=("the head moved while the local checks ran (${head:0:7}, then ${moved:0:7}); run team-merge again")
  else
    problems+=("GitHub cannot be read after the local checks: $(<"$scratch/error")")
  fi
  refuse_on_problems
fi

gh pr merge "$number" --repo "$repo" "--$method" --match-head-commit "$head" >&2 ||
  die "gh pr merge did not merge PR #$number (exit $?); nothing was logged"

github "$scratch" after pr view "$number" --repo "$repo" --json state,mergeCommit,headRefOid,autoMergeRequest ||
  die "PR #$number's state cannot be read after gh pr merge ($(<"$scratch/error")); check it on GitHub before logging anything"
if [[ $(jq -r .state "$scratch/after") != MERGED ]]; then
  if [[ $(jq -r .autoMergeRequest "$scratch/after") != null ]]; then
    gh pr merge "$number" --repo "$repo" --disable-auto >&2 ||
      die "PR #$number is still open after gh pr merge, with auto-merge on, and turning it off failed: turn it off on GitHub"
    die "PR #$number is still open after gh pr merge, with auto-merge on; turned auto-merge off, so nothing merges unseen"
  fi
  die "PR #$number is $(jq -r '.state | ascii_downcase' "$scratch/after") after gh pr merge, not merged; nothing was logged"
fi
merge=$(jq -r '.mergeCommit.oid // empty' "$scratch/after")
[[ -n $merge ]] || die "PR #$number is merged but GitHub names no merge commit; log it by hand with what GitHub shows"
[[ $(jq -r .headRefOid "$scratch/after") == "$head" ]] ||
  die "PR #$number was merged at $(jq -r '.headRefOid[:7]' "$scratch/after"), not at the checked head ${head:0:7}; check it on GitHub"

trap 'status=$?; rm -rf "$scratch"; ((status == 0)) || echo "team-merge: PR #$number is merged (merge $merge), but its merged event was not logged" >&2' EXIT
ledger_append "$(jq -cn --arg task "$task" --argjson pr "$number" --arg merge "$merge" --arg head "$head" \
  --arg by "$by" --arg project "$project" --arg branch "$branch" --arg message "$message" --arg channel "$channel" \
  --arg url "$url" --arg approval "$word" --argjson checks "$(printf '%s\n' "${local_checks[@]}" | jq -R . | jq -cs 'map(select(. != ""))')" \
  '{ts: (now | todate), task: $task, event: "merged", pr: $pr, merge: $merge, head: $head, by: $by,
    project: $project, branch: $branch, discord_message: $message, discord_channel: $channel, url: $url,
    approval: $approval}
    + if $checks == [] then {} else {local_checks: $checks} end')"
trap 'rm -rf "$scratch"' EXIT
jq -n --arg task "$task" --arg url "$url" --arg merge "$merge" --arg head "$head" --arg by "$by" \
  '{task: $task, pr: $url, merge: $merge, head: $head, by: $by}'

# On the plan-time word, Daniel hears of the merge at once, with how to revert it: one post in the
# task's thread and one in #coordinator, through team-post. A post that fails is said on stderr
# with its text, for the coordinator to post; the merge stands and the exit stays 0.
if [[ $word == plan ]]; then
  # Daniel's message as a link, which needs the guild: the one team-inbox keeps, else Discord's.
  guild=$(jq -r --arg c "$COORDINATOR_CHANNEL" 'select((.channel | tostring) == $c) | .guild | tostring | select(test("^[0-9]+$"))' \
    "$HOME/.local/state/agent-team/inbox.json" 2>/dev/null) || guild=''
  if [[ -z $guild ]] && reply=$(discord_api "channels/$COORDINATOR_CHANNEL" --max-time 20 2>"$scratch/guild"); then
    guild=$(jq -r '.guild_id | strings | select(test("^[0-9]+$"))' <<<"$reply" 2>/dev/null) || guild=''
  fi
  if [[ -n $guild ]]; then
    word_link="https://discord.com/channels/$guild/$channel/$message"
  else
    word_link=$by
    echo "team-merge: the posts name Daniel's message without a link: Discord named no guild for #coordinator: $(grep -m 1 . "$scratch/guild" 2>/dev/null || echo "its channel names none")" >&2
  fi
  case $method in
    merge) revert="\`git revert -m 1 $merge\`" ;;
    squash) revert="\`git revert $merge\`" ;;
    # A rebase puts each of the PR's commits on the base, its merges of the base left out, the
    # last of them the merge commit GitHub names.
    rebase)
      rebased=$(jq '[.[] | select((.parents // []) | length < 2)] | length' <<<"$commits")
      revert="\`git revert $merge~$rebased..$merge\`, the $rebased rebased commits"
      ;;
  esac
  title=$(jq -r 'map(select(.event == "opened")) | first | .title // empty' <<<"$events")
  printf '%s\n' "$task${title:+ $title}: merged $url on your plan-time word, $word_link" \
    "Merge commit: $merge on $base." \
    "To revert: the Revert button on the PR's page opens a revert PR; or, on $base, $revert." >"$scratch/post"
  # post <where> <team-post's arguments before --file>...
  post() {
    TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-post" "${@:2}" --file "$scratch/post" >/dev/null 2>"$scratch/post-error" && return 0
    echo "team-merge: PR #$number is merged, but its post to $1 failed ($(grep -m 1 . "$scratch/post-error" || echo "team-post failed")); post this text with team-post ${*:2} --file <its file>:" >&2
    cat "$scratch/post" >&2
  }
  if [[ -n $thread ]]; then
    post "the task's thread $thread" "$task"
  else
    echo "team-merge: $task has no Discord thread, so Daniel hears of the merge in #coordinator alone" >&2
  fi
  post "#coordinator $COORDINATOR_CHANNEL" --coordinator
fi

# The code checkout this runs from, when it is the merged project's primary checkout, follows the
# base: fast-forwarded to origin's when it is on the base and clean, otherwise left as it is,
# saying why and how. git replaces each file it changes, so a script running from it reads on.
code=$(cd "$(dirname "$TEAM_LIB")/.." && pwd -P)
primary=$(team_project "$project" path)
if same_path "$primary" "$code"; then
  bring="to bring in the merged code: git -C $code switch $base && git -C $code pull --ff-only origin $base"
  NET_ERR=$scratch/net-err
  if follow_base "$code" "$base"; then
    echo "team-merge: the code checkout $code: $FF_RESULT" >&2
  else
    echo "team-merge: the code checkout $code is left as it is: $FOLLOW_REASON; $bring" >&2
  fi
fi
refresh_inbox
