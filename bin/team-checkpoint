#!/usr/bin/env bash
# Make the work in flight survive a dead machine: on the lease holder, on each run of the
# heartbeat (team-timers run, every 5 minutes), or at once with --force (a handoff, or a record
# that must be durable now).
#
# Usage: team-checkpoint [--force]
# Refuses unless team-lease check says this machine holds the lease (exit 1), and exits 75 when
# GitHub is unreachable; either way nothing changes. Without --force, a checkpoint less than 5
# minutes (less a minute for the timer's slack) after the last does nothing but say so.
# For each open task, in task number order, for each of its open worktrees:
#   1. A worktree that is missing, on another branch than its recorded one, or locked by a running
#      git command (index.lock) is skipped with a line saying why.
#   2. Its task directory is mirrored into tasks/T<n>/scratch/ (the project the task was opened
#      in) or tasks/T<n>/scratch-<project>/ (one added later), as team-close does; a missing or
#      empty one is reported on stderr and archives nothing. It is mirrored less what
#      archive_left_out (bin/lib/team.sh) leaves out, each named on stderr.
#   3. Its work is kept on the team home's origin, never the project's (which may be public), as
#      refs/heads/wip/<project>/T<n>, pushed from the worktree to that origin's URL in place of
#      what is there (the one forced push, a script's, never on a task branch, and no PR's head;
#      a project's first push sends its history there once): its uncommitted changes (tracked or
#      untracked; ignored files excluded) as a snapshot commit, built from a temporary index with
#      the worktree's HEAD as parent; untracked files that may hold a secret (a name starting
#      with .env or ending with .pem or .key, or the end of a target in machine/secrets.json) are
#      left out, each named on a line; with none, the branch head itself, so a branch never
#      pushed is kept too and an older snapshot is gone.
#      A wip/<project>/T<n> already that head, or a snapshot with the same tree and parent, is
#      left alone. The worktree's files, index, branch and stash are never touched.
# Then team-tokens export writes this machine's usage of each complete UTC day into usage/<machine>/
# (its lines prefixed "usage: "); a failed export is reported on stderr and fails nothing, since
# the transcripts stay and the next checkpoint exports what this one could not.
# Then, in the team home, the ledger's lock held: commits every records path bin/lib/records lists
# (the ledger, level.jsonl, tasks/ with the scratch archives, plans, briefs and their records and
# tasks/current.md or its removal, projects/, projects.toml, memory/, machine/, usage/ and
# manual-steps.md), less what git ignores, as "chore: checkpoint" on the branch checked out (dev),
# leaving whatever else is staged as it was, and pushes the branch when it is ahead of origin's;
# a path the team home's hook refuses (an image) fails the commit, named. A rejected push fetches
# and replays the commits origin lacks onto origin's branch when they apply cleanly and no local
# change is in the way (what is staged stays staged), then pushes again; else they stay unpushed
# and it says why. No change, no commit and no push.
# Writes ~/.local/state/agent-team/last-checkpoint, dated the checkpoint's start, once every step
# succeeded. Prints one line per step; a failed step is reported on stderr and the rest still run.
# Exit 0 done, 1 refused or a step failed, 2 usage error, 75 GitHub unreachable or another
# checkpoint still running.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

INTERVAL_MINUTES=5
# The heartbeat's timer may start a run up to a minute after its mark.
SLACK_SECONDS=60
# Seconds: the most one call to an origin may take, and the longest wait for another checkpoint.
NET_TIMEOUT=60
LOCK_WAIT=120

usage="usage: team-checkpoint [--force]"
force=''
if (($# > 1)) || [[ $# -eq 1 && $1 != --force ]]; then usage_error "$usage"; fi
(($# == 0)) || force=1

machine=$(machine_name) || exit 1
bin=$(dirname "$TEAM_LIB")
state=$HOME/.local/state/agent-team
last=$state/last-checkpoint
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
NET_ERR=$scratch/err
failed=0

mkdir -p "$state"
exec {lock_fd}>>"$state/checkpoint.lock"
if ! flock -w "$LOCK_WAIT" "$lock_fd"; then
  echo "team-checkpoint: another checkpoint is still running" >&2
  exit 75
fi

start=$(date +%s)
if [[ -z $force && -e $last ]]; then
  age=$((start - $(date -r "$last" +%s)))
  if ((age < INTERVAL_MINUTES * 60 - SLACK_SECONDS)); then
    echo "not due: the last checkpoint was $((age / 60)) minutes ago (--force makes one now)"
    exit 0
  fi
fi

rc=0
TEAM_HOME=$TEAM_HOME "$bin/team-lease" check >/dev/null {lock_fd}>&- || rc=$?
case $rc in
  0) ;;
  75)
    echo "team-checkpoint: GitHub unreachable; no checkpoint while offline" >&2
    exit 75
    ;;
  *) die "only the machine that holds the lease checkpoints" ;;
esac

# Where every worktree's work is kept: the team home's origin, which is private.
wip_url=$(wip_origin) || exit 1

# A step's line: say <what happened>
say() {
  printf '%s\n' "$*"
}

# A failed step, on stderr; the checkpoint goes on and exits 1: fail <what failed>
fail() {
  echo "team-checkpoint: $*" >&2
  failed=1
}

# Why the worktree <wt> of <branch> is skipped, or nothing when it is checkpointed.
skip_reason() {
  local wt=$1 branch=$2 top current
  if [[ ! -d $wt ]] || ! top=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) ||
    ! same_path "$top" "$wt"; then
    echo "$wt is missing"
  elif ! current=$(git -C "$wt" symbolic-ref -q --short HEAD); then
    echo "$wt is on a detached HEAD, not $branch"
  elif [[ $current != "$branch" ]]; then
    echo "$wt is on $current, not $branch"
  elif [[ -e $(git -C "$wt" rev-parse --path-format=absolute --git-path index.lock) ]]; then
    echo "a git command is running in $wt (index.lock)"
  fi
}

# Keep the work of the worktree <wt> of <task> in <project> on the team home's origin as
# wip/<project>/<task>: its branch head, or a snapshot of its uncommitted changes on that head:
# snapshot <task> <project> <wt> <label>
snapshot() {
  local task=$1 project=$2 wt=$3 label=$4 wip=wip/$2/$1 tree head remote old commit what left rc=0
  tree=$(worktree_tree "$wt")
  left=$(snapshot_left_out "$wt" | paste -sd ' ')
  [[ -z $left ]] || say "$label: left out of $wip, as files that may hold a secret: $left"
  head=$(git -C "$wt" rev-parse HEAD)
  remote=$(origin_git -C "$wt" ls-remote "$wip_url" "refs/heads/$wip") || rc=$?
  if ((rc)); then
    fail "$label: cannot read $wip on the team home's origin: $(origin_reason "$rc")"
    return
  fi
  old=${remote%%[[:space:]]*}
  if [[ $tree == "$(git -C "$wt" rev-parse "HEAD^{tree}")" ]]; then
    commit=$head what="the branch head, no uncommitted changes"
    if [[ $old == "$head" ]]; then
      say "$label: $wip is up to date (${old:0:7}, no uncommitted changes)"
      return
    fi
  else
    if [[ -n $old ]] && git -C "$wt" cat-file -e "$old^{commit}" 2>/dev/null && is_snapshot "$wt" "$old" "$task" &&
      [[ $(git -C "$wt" rev-parse "$old^{tree}") == "$tree" && $(git -C "$wt" rev-parse "$old^1") == "$head" ]]; then
      say "$label: $wip is up to date (${old:0:7})"
      return
    fi
    commit=$(git -C "$wt" commit-tree "$tree" -p "$head" -m "$(snapshot_message "$task" "$machine" "$(date -u -d "@$start" +%FT%TZ)")")
    what="uncommitted changes on ${head:0:7}"
  fi
  origin_git -C "$wt" push -q "$wip_url" "+$commit:refs/heads/$wip" || rc=$?
  if ((rc)); then
    fail "$label: cannot push $wip to the team home's origin: $(origin_reason "$rc")"
    return
  fi
  say "$label: pushed $wip ${commit:0:7} ($what)"
}

# Each open worktree of each open task, as {task, project, branch, worktree, archive}.
worktrees=()
if [[ -e $TEAM_HOME/ledger.jsonl ]]; then
  mapfile -t worktrees < <(ledger_jq 'ledger_events | by_task | to_entries | sort_by(.key[1:] | tonumber) | .[]
    | .key as $task | .value | select(task_status == "open") | archived_worktrees($home) | . + {task: $task}' \
    -nRc "$TEAM_HOME/ledger.jsonl")
fi

for wt_json in "${worktrees[@]}"; do
  IFS=$'\t' read -r task project branch wt archive < <(jq -r '[.task, .project, .branch, .worktree, .archive] | @tsv' <<<"$wt_json")
  label="$task $project"
  why=$(skip_reason "$wt" "$branch")
  if [[ -n $why ]]; then
    say "$label: skipped: $why"
    continue
  fi
  task_dir=$(team_project "$project" task_dir)
  if archive_task_dir "$wt/$task_dir" "$project" "tasks/$task/$archive"; then
    say "$label: archived $task_dir to tasks/$task/$archive"
  fi
  snapshot "$task" "$project" "$wt" "$label"
done

# This machine's usage, each complete day of it, for the commit.
rc=0
out=$(TEAM_HOME=$TEAM_HOME "$bin/team-tokens" export 2>"$scratch/tokens-err" {lock_fd}>&-) || rc=$?
while IFS= read -r line; do say "usage: $line"; done < <(grep . <<<"$out")
((rc == 0)) || echo "team-checkpoint: usage: $(sed -n '1s/^team-tokens: //p' "$scratch/tokens-err"); the next checkpoint exports it" >&2

# The team home's records, every one: commit them, then push the branch when it is ahead of origin's.
commit_records "chore: checkpoint" || failed=1

((failed == 0)) || exit 1
date -u -d "@$start" +%FT%TZ >"$last"
touch -d "@$start" "$last"
