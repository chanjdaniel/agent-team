#!/usr/bin/env bash
# Record Claude Code's quota reading from each session's status line, and read the newest one.
#
# Usage: team-quota line
#        team-quota status [--json]
# A reading is what Claude Code says of the Claude plan's rate limits, as its status line input's
# rate_limits gives them: {at, machine, windows: {<name>: {used, resets_at}}, models: [{name, used,
# resets_at}]}, at the UTC time it was read, machine this machine's team name
# (~/.config/agent-team/machine, or null), used a percentage (above 100 once a window is
# exceeded) and resets_at a UTC time (YYYY-MM-DDTHH:MM:SSZ). windows holds every window of
# rate_limits under its own name (five_hour, the 5-hour window; seven_day, the week; and any
# other, such as seven_day_sonnet) whose used_percentage and resets_at (epoch seconds) are numbers;
# models each per-model weekly window of rate_limits.model_scoped (Fable's) whose display_name is a
# string, utilization a number from 0 to 1000 (a percentage, as /usage gives it) and resets_at an
# ISO time. A window or model window with a field missing or of another type is left out, never
# the whole reading.
# line: the status line command, which settings/worker.json and coordinator.settings.json set
# (and the shared user config, for Daniel's own sessions). It reads Claude Code's JSON on stdin,
# giving up on input still open after QUOTA_READ_SECONDS, and prints one line: the model's display
# name, "ctx <n>%" (the context window's use), "5h <n>%", "week <n>%", "<name> <n>%" for each model
# window, then "resets <ddd HH:MM>" (the week's reset in the machine's local time), each part left
# out when absent, joined by " · ", every percentage rounded down. Then, when the reading differs
# from this machine's last one (a window's or model window's whole percent, any resets_at, or a
# window that appeared or went), it appends it to the team home's
# usage/<machine>/quota/<YYYY-MM-DD>.jsonl (its UTC day), which team-checkpoint commits with the
# other usage files, then writes it to ~/.local/state/agent-team/quota.json, the machine's latest;
# both under the lock quota.lock beside that file, taken without waiting (flock -n), the write
# skipped when another session holds it. A reading with no window at all (rate_limits null or
# absent: an API key, or a session before its first reply) is never written. With no team home,
# or no machine name, it writes the state file only; a failed append leaves the state file as it
# was, so the next line tries again. It exits 0 whatever happens, printing what it can (at least
# the model, read from the text when it is not JSON) and writing nothing on any error.
# status: the newest reading across every machine's usage/*/quota/ (each machine's latest day file)
# and this machine's state file, by its at; lines that are not a reading are skipped. It prints
# "read on <machine> <n> min ago" (": stale, over 180 minutes old" past QUOTA_FRESH_MINUTES), then
# one line per window, five_hour, seven_day, every other window by name and each model window as
# model:<name>: "<name> <n>% (resets <ddd HH:MM>)", or "(reset at <ddd HH:MM>, since this reading)"
# once that time has passed, with ", past <thresholds>" for the thresholds it has crossed. A
# window crosses a threshold of QUOTA_THRESHOLDS when its use is at least the threshold and it has
# not reset since the reading. With no reading anywhere it prints "no quota reading yet: no session
# has shown a status line since team-quota was set up". With --json (schema team-quota/1):
# {schema, reading (or null), age_minutes (or null), fresh (age_minutes at most 180), windows:
# [{name, used, resets_at, crossed}]}. Reads only, and exits 0 whenever the team home reads.
# Exit 0 done, 1 refused, 2 usage error.
set -euo pipefail

# Whatever happens, the status line exits 0 and prints what it can: Claude Code shows the line of
# every session, and a broken team home or machine must never break it. Bash older than 5, which
# the library refuses, gets the model alone, read from the text.
if [[ ${1:-} == line ]]; then
  trap 'exit 0' EXIT
  if ((BASH_VERSINFO[0] < 5)); then
    IFS= read -r -d '' -t 1 quota_input || true
    quota_model='"display_name"[[:space:]]*:[[:space:]]*"([^"]*)"'
    if [[ $quota_input =~ $quota_model ]]; then echo "${BASH_REMATCH[1]}"; fi
    exit 0
  fi
  # shellcheck disable=SC2034 # read by bin/lib/team.sh: neither a missing team home nor the
  # platform's tools refuses the line
  team_home_report=1 platform_report=1
fi
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

USAGE="usage: team-quota line | status [--json]"

# How long the line waits for its input to end: Claude Code writes the whole JSON at once and
# closes it, so input still open is a caller's mistake, and the line must answer within 200 ms.
QUOTA_READ_SECONDS=0.15
# A reading read at most this many minutes ago is fresh: older, a busy week's use has moved on
# (a critique run's sizing and the heartbeat's posts read it, in later tickets).
QUOTA_FRESH_MINUTES=180
# The percentages each window is judged against: the week warns at 70 and again at 90, the
# 5-hour window and each model's week at 90, when sessions are about to stall.
QUOTA_THRESHOLDS='{"seven_day": [70, 90], "five_hour": [90], "model": [90]}'

STATE_DIR=$HOME/.local/state/agent-team
STATE=$STATE_DIR/quota.json

# The jq definitions both subcommands share.
# shellcheck disable=SC2016 # jq's variables
QUOTA_JQ='
# An ISO time (2026-11-17T09:00:00.000Z, or with an offset such as +02:00) as epoch seconds.
def iso_epoch:
  capture("^(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})([.][0-9]+)?(?<z>Z|[+-][0-9]{2}:?[0-9]{2})$")
  | (.d + "Z" | fromdateiso8601) - (if .z == "Z" then 0 else (.z | gsub(":"; "")) as $o
      | (($o[1:3] | tonumber) * 3600 + ($o[3:5] | tonumber) * 60) * (if $o[0:1] == "-" then -1 else 1 end) end);
def is_number: type == "number" and isinfinite == false and isnan == false;
# A time shown to Daniel: the machine'"'"'s local day and time.
def clock: strflocaltime("%a %H:%M");
'

# The status line, then the reading's windows and models as one compact JSON line, from Claude
# Code's JSON on stdin.
# shellcheck disable=SC2016 # jq's variables
LINE_JQ=$QUOTA_JQ'
(if type == "object" then . else {} end) as $in
| ($in.rate_limits | if type == "object" then . else {} end) as $limits
| ($limits | to_entries | map(select(.key != "model_scoped" and (.value | type) == "object"
    and (.value.used_percentage | is_number) and .value.used_percentage >= 0
    and (.value.resets_at | is_number) and .value.resets_at > 0)
  | {key, value: {used: .value.used_percentage, resets_at: (.value.resets_at | floor | todate)}}) | from_entries) as $windows
| [($limits.model_scoped | if type == "array" then .[] else empty end)
  | select(type == "object" and (.display_name | type) == "string" and .display_name != ""
    and (.utilization | is_number) and .utilization >= 0 and .utilization <= 1000 and (.resets_at | type) == "string")
  | (try (.resets_at | iso_epoch) catch null) as $reset
  | select($reset != null)
  | {name: .display_name, used: .utilization, resets_at: ($reset | todate)}] as $models
| def pct: "\(floor)%";
  [ ($in.model.display_name | strings | select(. != "")),
    ($in.context_window.used_percentage | select(is_number) | "ctx \(pct)"),
    ($windows.five_hour.used // empty | "5h \(pct)"),
    ($windows.seven_day.used // empty | "week \(pct)"),
    ($models[] | "\(.name) \(.used | pct)"),
    ($windows.seven_day.resets_at // empty | "resets \(fromdateiso8601 | clock)") ]
  | map(gsub("[\\r\\n]"; " ")) | join(" · "),
  ({windows: $windows, models: $models} | tojson)
'

# What makes two readings differ: each window and model window by its whole percent and reset.
# shellcheck disable=SC2016 # jq's variables
SAME_JQ='def key: {windows: (.windows | map_values({used: (.used | floor), resets_at})),
    models: (.models | map({name, used: (.used | floor), resets_at}) | sort_by(.name))};
  try ($last[0] | key) catch null | . == ($new | key)'

# Record the reading <json> ({windows, models}) when it differs from this machine's last one,
# under the lock, or skip it while another session holds the lock.
record() {
  local reading=$1 lock at machine full day
  mkdir -p "$STATE_DIR"
  exec {lock}>"$STATE_DIR/quota.lock"
  flock -n "$lock" || return 0
  if [[ -f $STATE ]] && [[ $(jq -n --slurpfile last "$STATE" --argjson new "$reading" "$SAME_JQ") == true ]]; then
    return 0
  fi
  at=$(date -u +%FT%TZ)
  machine=$(machine_name 2>/dev/null) || machine=''
  full=$(jq -c --arg at "$at" --arg machine "$machine" \
    '{at: $at, machine: (if $machine == "" then null else $machine end)} + .' <<<"$reading")
  if [[ -n $machine && -z $TEAM_HOME_PROBLEM && -n $TEAM_HOME && -d $TEAM_HOME ]]; then
    day=${at%%T*}
    mkdir -p "$TEAM_HOME/usage/$machine/quota"
    printf '%s\n' "$full" >>"$TEAM_HOME/usage/$machine/quota/$day.jsonl"
  fi
  printf '%s\n' "$full" >"$STATE.tmp"
  mv -f "$STATE.tmp" "$STATE"
}

# The status line: print it, then record the reading in a process of its own, where set -e holds
# (it would not in a function called from a condition), so any failure stops the write there.
quota_line() {
  local input='' out='' line='' reading='' model='"display_name"[[:space:]]*:[[:space:]]*"([^"]*)"'
  IFS= read -r -d '' -t "$QUOTA_READ_SECONDS" input || true
  if out=$(LC_ALL=C jq -r "$LINE_JQ" <<<"$input" 2>/dev/null) && [[ $out == *$'\n'* ]]; then
    line=${out%%$'\n'*} reading=${out#*$'\n'}
  elif [[ $input =~ $model ]]; then
    line=${BASH_REMATCH[1]}
  fi
  [[ -z $line ]] || printf '%s\n' "$line"
  [[ -n $reading && $reading != '{"windows":{},"models":[]}' ]] || return 0
  record "$reading" 2>/dev/null &
  wait "$!" || true
}

# The newest reading of every machine's latest day file and this machine's state file, or null.
newest_reading() {
  local files=() dir latest
  for dir in "$TEAM_HOME"/usage/*/quota; do
    [[ -d $dir ]] || continue
    latest=$(find "$dir" -maxdepth 1 -name '*.jsonl' -type f | sort | tail -n 1)
    [[ -z $latest ]] || files+=("$latest")
  done
  [[ ! -f $STATE ]] || files+=("$STATE")
  ((${#files[@]})) || { echo null; return; }
  cat -- "${files[@]}" | jq -cRn '[inputs | fromjson? | select(type == "object" and (.at | type) == "string"
      and (.at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
      and (.windows | type) == "object" and (.models | type) == "array")]
    | max_by(.at)'
}

# team-quota status's object from the reading on stdin (or null).
# shellcheck disable=SC2016 # jq's variables
STATUS_JQ=$QUOTA_JQ'
now as $now
| if . == null then {schema: "team-quota/1", reading: null, age_minutes: null, fresh: false, windows: []}
  else . as $r
  | ((($now - ($r.at | fromdateiso8601)) / 60 | floor) | if . < 0 then 0 else . end) as $age
  | def crossing($thresholds): . as $w | . + {crossed: (if (.resets_at | fromdateiso8601) <= $now then []
      else [$thresholds[] | select($w.used >= .)] end)};
    ($r.windows | to_entries | map({name: .key, used: .value.used, resets_at: .value.resets_at})
      | sort_by(if .name == "five_hour" then 0 elif .name == "seven_day" then 1 else 2 end, .name)
      | map(crossing($thresholds[.name] // []))) as $windows
  | ($r.models | sort_by(.name) | map({name: "model:\(.name)", used, resets_at} | crossing($thresholds.model))) as $models
  | {schema: "team-quota/1", reading: $r, age_minutes: $age, fresh: ($age <= $fresh), windows: ($windows + $models)}
  end
'

# The status's text from its object on stdin.
# shellcheck disable=SC2016 # jq's variables
STATUS_TEXT_JQ=$QUOTA_JQ'
now as $now
| if .reading == null then "no quota reading yet: no session has shown a status line since team-quota was set up"
  else "read on \(.reading.machine // "an unnamed machine") \(.age_minutes) min ago\(if .fresh then "" else ": stale, over \($fresh) minutes old" end)",
    (.windows[] | (.resets_at | fromdateiso8601) as $reset
      | "\(.name) \(.used | floor)% (\(if $reset <= $now then "reset at \($reset | clock), since this reading" else "resets \($reset | clock)" end))"
        + (if .crossed == [] then "" else ", past \(.crossed | map("\(.)%") | if length > 1 then (.[:-1] | join(", ")) + " and " + .[-1] else .[0] end)" end))
  end
'

quota_status() {
  local json='' status
  while (($#)); do
    case $1 in
      --json) [[ -z $json ]] || usage_error "$USAGE"; json=1 ;;
      *) usage_error "$USAGE" ;;
    esac
    shift
  done
  status=$(newest_reading | jq -c --argjson thresholds "$QUOTA_THRESHOLDS" --argjson fresh "$QUOTA_FRESH_MINUTES" "$STATUS_JQ")
  if [[ -n $json ]]; then
    printf '%s\n' "$status"
  else
    LC_ALL=C jq -r --argjson fresh "$QUOTA_FRESH_MINUTES" "$STATUS_TEXT_JQ" <<<"$status"
  fi
}

case ${1:-} in
  line) (($# == 1)) || usage_error "$USAGE"; quota_line ;;
  status) shift; quota_status "$@" ;;
  *) usage_error "$USAGE" ;;
esac
