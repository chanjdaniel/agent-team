#!/usr/bin/env bash
# Strip agent attribution lines from the messages of a task branch's own commits, prove nothing
# else changed, move the branch and print the push for the coordinator to run with Daniel's OK.
#
# Usage: team-clean-messages <worktree> [--check | --clear-gate-lane]
# The range is origin/<base>..HEAD after git fetch origin <base>, the base being projects.toml's
# for the project whose primary checkout the worktree belongs to (any other repo is refused).
# Attribution lines are the library's (attribution_lines): a Co-Authored-By naming Claude,
# Anthropic or an anthropic.com address (human co-authors stay), Claude-Session trailers and the
# "Generated with Claude Code" line; the blank lines they leave at a message's end go too.
# --check prints each offending commit (short sha and subject) with its lines, exit 1 if any,
# and changes nothing.
# Otherwise it refuses, changing nothing, on a detached HEAD, on the base branch or main, on a
# branch naming no task (<type>/T<n>-...), with uncommitted changes, with a root commit or a merge
# of anything but the base (a merge any of whose parents but its first is not on origin/<base>) in
# the range, or when origin's branch has commits this one lacks. From the first offender on, each
# commit is rebuilt with git commit-tree (never signed) on its own tree, its new first parent and
# a merge's other parents as they were, with its author's and committer's names, emails and dates
# and its encoding; only the message changes. The branch moves, by a compare-and-swap ref update
# against the old head, only when every rebuilt commit has its original's tree, author, committer
# and other parents, and no attribution lines, one that had none its original's message byte for
# byte, the commit count matches and the old and new heads have an empty diff; otherwise exit 1 and
# nothing moves.
# It never pushes: it prints git push --force-with-lease=<branch>:<old head> origin <branch> on
# stdout (the lease is origin's head of the branch: the old head, an older one while commits are
# unpushed, empty while origin has none) and appends history-rewritten. With nothing to clean it
# says so and exits 0.
# When the project's no-mistakes remote holds the branch, the gate's next run would refuse the old
# commits there as at risk, so it prints a second line on stdout, the step to run after the push:
# this script with --clear-gate-lane. It reads the mirror and moves nothing there.
# --clear-gate-lane clears the branch's ref in the gate's private mirror, the bare repository
# directly under ~/.no-mistakes/repos/, links resolved, that the no-mistakes remote names, with
# none of its hooks run, so the gate's next run takes the branch as new. A remote naming anything
# else is refused, and gets no printed step. Like the push, it runs with Daniel's OK, which nothing
# checks; a worker session is refused by its AGENT_TEAM_ROLE (worker_refusal), and no deny rule
# names it. It refuses, moving nothing, on what a rewrite refuses for the branch and its tree, while
# a gate run is active on the branch, until origin's branch is this one's head, and unless each
# commit only the mirror holds makes the same change as its own commit of the branch: each path's
# modes and blob ids against the first parent, so a merge has one, a binary's bytes and whitespace
# count, and equal changes have equal patch ids. Then it keeps the mirror's head at
# refs/tags/no-mistakes-abandoned/<branch>/<sha>, as the gate's own reconciliation does, deletes
# that one branch ref, leased on the value it checked, and appends gate-lane-cleared. It touches no
# other ref, nothing on origin and no worktree. With no such ref on the mirror, or no commit only
# the mirror holds, it says there is nothing to clear and exits 0.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-clean-messages <worktree> [--check | --clear-gate-lane]"

worktree='' check='' clear=''
while (($#)); do
  case $1 in
    --check) check=1 ;;
    --clear-gate-lane) clear=1 ;;
    -*) usage_error "$usage" ;;
    *)
      [[ -z $worktree ]] || usage_error "$usage"
      worktree=$1
      ;;
  esac
  shift
done
[[ -n $worktree ]] || usage_error "$usage"
[[ -z $check || -z $clear ]] || usage_error "$usage"
if [[ -n $clear ]]; then
  why=$(worker_refusal "" "clears no gate lane") && die "$why"
fi

git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$worktree is not a git worktree"
worktree=$(git -C "$worktree" rev-parse --show-toplevel)
# git in the worktree.
g() { git -C "$worktree" "$@"; }

# The project: the registered one whose primary checkout this worktree belongs to.
primary=$(dirname "$(g rev-parse --path-format=absolute --git-common-dir)")
primary=$(realpath -m -- "$primary")
project=$(team_project --find path "$primary") || exit 1
project=${project%%$'\n'*}
[[ -n $project ]] || die "$worktree is a worktree of $primary, which is no project's primary checkout in projects.toml"
base=$(team_project "$project" base) || exit 1

g fetch -q origin "$base" || die "cannot fetch $base from origin"
g rev-parse -q --verify "refs/remotes/origin/$base^{commit}" >/dev/null || die "origin has no branch $base"
branch=$(g symbolic-ref -q --short HEAD) || branch=''
old_head=$(g rev-parse HEAD)
range="origin/$base..${branch:-HEAD}"

# The refusals of a run that moves a ref: a task's branch, with nothing uncommitted. Sets task.
require_task_branch() {
  [[ -n $branch ]] || die "$worktree is on a detached HEAD; check out the task's branch first"
  [[ $branch != "$base" && $branch != main ]] || die "$branch is the base branch or main; only a task branch is cleaned"
  [[ $branch =~ ^[^/]+/(T[1-9][0-9]*)- ]] || die "$branch names no task (<type>/T<n>-<slug>)"
  task=${BASH_REMATCH[1]}
  mapfile -t changes < <(worktree_changes "$worktree")
  ((${#changes[@]} == 0)) || die "$worktree has uncommitted changes: $(printf '%s; ' "${changes[@]}" | sed 's/; $//')"
}

# git in the gate's mirror, once find_mirror has found it, running none of the mirror's hooks.
mirror_git() { git -c core.hooksPath=/dev/null --git-dir "$mirror" "$@"; }

# Set mirror to the gate's mirror: the bare repository directly under ~/.no-mistakes/repos/, links
# resolved, that the project's no-mistakes remote names. Otherwise fail, with mirror_why saying why:
# that remote is config any worktree of the project can change, and Daniel's OK is for the mirror.
find_mirror() {
  local url root
  url=$(g remote get-url no-mistakes 2>/dev/null) || {
    mirror_why="$worktree has no no-mistakes remote: its project has no gate lane to clear"
    return 1
  }
  root=$(realpath -m -- "$HOME/.no-mistakes/repos")
  mirror=$(realpath -m -- "$url")
  if [[ $mirror != "$root"/* || ${mirror#"$root"/} == */* || ! -d $mirror || $(mirror_git rev-parse --is-bare-repository 2>/dev/null) != true ]]; then
    mirror_why="the no-mistakes remote names $url, which is no bare repository directly under $root"
    return 1
  fi
}

# What the commit <sha> changes against its first parent, so a merge has one too: each path's modes
# and blob ids, which a binary's bytes and whitespace change, so two equal ones have equal patch ids
# and more; "empty" for a commit that changes nothing.
change_id() {
  local raw
  raw=$(g diff-tree -r --no-renames "$1^" "$1") || return 1
  echo "${raw:-empty}"
}

clear_gate_lane() {
  local gate remote mirror_head stale live_commits sha id tag unmatched=()
  local -A live=()
  require_task_branch
  find_mirror || die "$mirror_why"
  mirror_head=$(mirror_git rev-parse -q --verify "refs/heads/$branch^{commit}") || {
    echo "team-clean-messages: nothing to clear: the gate's mirror has no $branch" >&2
    return 0
  }

  gate=$(cd "$worktree" && no-mistakes axi 2>&1) || die "cannot read the gate's state in $worktree: $(head -n 1 <<<"$gate"); no ref moved"
  ! grep -q '^active_run:' <<<"$gate" || die "a gate run is active on $branch: let it end or abort it first; no ref moved"

  remote=$(g ls-remote --heads origin "refs/heads/$branch") || die "cannot read $branch from origin; no ref moved"
  remote=${remote%%$'\t'*}
  [[ -n $remote ]] || die "origin has no branch $branch: run the push first; no ref moved"
  [[ $remote == "$old_head" ]] || die "origin's $branch is at ${remote:0:7}, not this branch's ${old_head:0:7}: run the push first; no ref moved"

  g fetch -q --no-tags "$mirror" "refs/heads/$branch" || die "cannot fetch $branch from the gate's mirror; no ref moved"
  stale=$(g rev-list "$mirror_head" --not "$old_head" "origin/$base") || die "cannot list what only the gate's mirror holds; no ref moved"
  if [[ -z $stale ]]; then
    echo "team-clean-messages: nothing to clear: the gate's mirror holds no commit $branch lacks" >&2
    return 0
  fi
  live_commits=$(g rev-list "$old_head" --not "$mirror_head" "origin/$base") || die "cannot list what only $branch holds; no ref moved"

  # Each commit of the branch answers for one commit of the mirror, so a repeated change counts.
  for sha in $live_commits; do
    id=$(change_id "$sha") || die "cannot read the change of $sha; no ref moved"
    live[$id]=$((${live[$id]:-0} + 1))
  done
  for sha in $stale; do
    id=$(change_id "$sha") || die "cannot read the change of $sha; no ref moved"
    if ((${live[$id]:-0} > 0)); then
      live[$id]=$((${live[$id]} - 1))
    else
      unmatched+=("$(g rev-parse --short "$sha")")
    fi
  done
  ((${#unmatched[@]} == 0)) || die "the gate's mirror holds ${unmatched[*]}, with no commit of the same change on $branch; no ref moved"

  tag=refs/tags/no-mistakes-abandoned/$branch/$mirror_head
  mirror_git update-ref "$tag" "$mirror_head" || die "cannot keep $mirror_head at $tag; no branch ref moved"
  mirror_git update-ref -d "refs/heads/$branch" "$mirror_head" || die "$branch moved on the gate's mirror while it was being cleared, so it was left there; $tag keeps $mirror_head"
  ledger_append "$(jq -cn --arg task "$task" --arg project "$project" --arg branch "$branch" \
    --arg head "$mirror_head" --arg tag "$tag" \
    '{ts: (now | todate), task: $task, event: "gate-lane-cleared", project: $project, branch: $branch,
      head: $head, tag: $tag}')"
  echo "team-clean-messages: cleared $branch on the gate's mirror; $tag keeps its head $mirror_head" >&2
}

if [[ -n $clear ]]; then
  clear_gate_lane
  exit 0
fi

commits=$(g rev-list --reverse "origin/$base..$old_head") || die "cannot list $range"
mapfile -t commits <<<"$commits"
[[ -n ${commits[0]} ]] || commits=()

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# Each commit's message, exactly as stored, in $scratch/<sha>, and its attribution lines in
# $scratch/<sha>.lines; offenders lists the commits that have any.
offenders=()
for sha in "${commits[@]}"; do
  g cat-file commit "$sha" | sed '1,/^$/d' >"$scratch/$sha"
  attribution_lines <"$scratch/$sha" >"$scratch/$sha.lines"
  [[ ! -s $scratch/$sha.lines ]] || offenders+=("$sha")
done

# One line for the commit <sha>: its short sha and subject.
describe() { g log -1 --format='%h %s' "$1"; }

if [[ -n $check ]]; then
  for sha in "${offenders[@]}"; do
    describe "$sha"
    sed 's/^/  /' "$scratch/$sha.lines"
  done
  ((${#offenders[@]} == 0)) || exit 1
fi

# The parents of the commit <sha> after its first, on one line.
other_parents() { g rev-list --parents -n 1 "$1" | cut -s -d' ' -f3-; }

if [[ -z $check ]]; then
  require_task_branch
  # A merge of the base has only its first parent in the range, so the range stays one line of
  # commits to rebuild; any other merge would need its side's commits rebuilt too.
  merges=''
  for sha in $(g rev-list --min-parents=2 "origin/$base..$old_head"); do
    for other in $(other_parents "$sha"); do
      if ! g merge-base --is-ancestor "$other" "origin/$base"; then
        merges+=" $(g rev-parse --short "$sha")"
        break
      fi
    done
  done
  [[ -z $merges ]] || die "there is a merge commit in $range:$merges; only a merge of origin/$base can be rebuilt message by message"
  roots=$(g rev-list --max-parents=0 --abbrev-commit "origin/$base..$old_head" | paste -sd ' ')
  [[ -z $roots ]] || die "$roots is a root commit: $branch does not start from origin/$base"
  # The push must replace only what origin has: its branch is absent, or the old head or behind it.
  remote=$(g ls-remote --heads origin "refs/heads/$branch") || die "cannot read $branch from origin"
  remote=${remote%%$'\t'*}
  if [[ -n $remote ]] && ! { g cat-file -e "$remote^{commit}" 2>/dev/null && g merge-base --is-ancestor "$remote" "$old_head"; }; then
    die "origin's $branch is at ${remote:0:7}, which this branch does not contain; bring those commits in first"
  fi
fi

if ((${#offenders[@]} == 0)); then
  if ((${#commits[@]} == 1)); then count="the 1 commit of $range carries"; else count="the ${#commits[@]} commits of $range carry"; fi
  echo "team-clean-messages: nothing to clean: $count no attribution lines" >&2
  exit 0
fi

# The headers of the commit <sha> that a rebuild must keep: all but its parents and signature.
kept_headers() {
  g cat-file commit "$1" |
    awk '/^$/ { exit } /^parent / { next } /^gpgsig(-sha256)? / { sig = 1; next } sig && /^ / { next } { sig = 0; print }'
}

# The name, email and raw date (@<seconds> <zone>) of the commit <sha>'s <author|committer>, one
# per line.
person() {
  g cat-file commit "$2" | sed -n "/^\$/q; s/^$1 \(.*\) <\(.*\)> \([0-9]* [-+][0-9]*\)\$/\1\n\2\n@\3/p"
}

# Rebuild from the first offender on: until then, every commit stays as it is.
parent=$(g rev-parse "${commits[0]}^")
rebuilt=()
for sha in "${commits[@]}"; do
  msg=$scratch/$sha
  if [[ -s $scratch/$sha.lines ]]; then
    strip_attribution <"$scratch/$sha" >"$scratch/$sha.new"
    grep -q '[^[:space:]]' "$scratch/$sha.new" || die "$(describe "$sha") would be left with an empty message; nothing moved"
    msg=$scratch/$sha.new
  elif [[ $(g rev-parse "$sha^") == "$parent" ]]; then
    parent=$sha
    rebuilt+=("$sha")
    continue
  fi
  mapfile -t author < <(person author "$sha")
  mapfile -t committer < <(person committer "$sha")
  ((${#author[@]} == 3 && ${#committer[@]} == 3)) ||
    die "cannot read the author and committer of $(describe "$sha"); nothing moved"
  # A commit in another encoding names it in its header, and so must its rebuild.
  encoding=$(g cat-file commit "$sha" | sed -n '/^$/q; s/^encoding //p')
  parents=(-p "$parent")
  for other in $(other_parents "$sha"); do parents+=(-p "$other"); done
  parent=$(GIT_AUTHOR_NAME=${author[0]} GIT_AUTHOR_EMAIL=${author[1]} GIT_AUTHOR_DATE=${author[2]} \
    GIT_COMMITTER_NAME=${committer[0]} GIT_COMMITTER_EMAIL=${committer[1]} GIT_COMMITTER_DATE=${committer[2]} \
    g -c i18n.commitEncoding="${encoding:-UTF-8}" commit-tree --no-gpg-sign "$(g rev-parse "$sha^{tree}")" "${parents[@]}" -F "$msg") ||
    die "cannot rebuild $(describe "$sha"); nothing moved"
  rebuilt+=("$parent")
done
new_head=$parent

# The proof, before anything moves: same trees, people, dates and merged parents, every message
# clean and any without attribution lines its original's, byte for byte, same count, no diff.
for i in "${!commits[@]}"; do
  sha=${commits[i]} new=${rebuilt[i]}
  [[ $(g rev-parse "$sha^{tree}") == "$(g rev-parse "$new^{tree}")" ]] ||
    die "the rebuilt $(describe "$sha") is wrong: its tree differs; nothing moved"
  [[ $(kept_headers "$sha") == "$(kept_headers "$new")" ]] ||
    die "the rebuilt $(describe "$sha") is wrong: its author, committer or headers differ; nothing moved"
  [[ $(other_parents "$sha") == "$(other_parents "$new")" ]] ||
    die "the rebuilt $(describe "$sha") is wrong: its parents differ; nothing moved"
  g cat-file commit "$new" | sed '1,/^$/d' >"$scratch/$new.rebuilt"
  [[ -s $scratch/$sha.lines ]] || cmp -s "$scratch/$sha" "$scratch/$new.rebuilt" ||
    die "the rebuilt $(describe "$sha") is wrong: its message differs; nothing moved"
  [[ -z $(attribution_lines <"$scratch/$new.rebuilt") ]] ||
    die "the rebuilt $(describe "$sha") is wrong: it still carries attribution lines; nothing moved"
done
[[ $(g rev-list --count "origin/$base..$new_head") == "${#commits[@]}" ]] ||
  die "the rebuilt branch does not have ${#commits[@]} commits on origin/$base; nothing moved"
g diff --quiet "$old_head" "$new_head" -- || die "the rebuilt branch's content differs from $branch's; nothing moved"

g update-ref -m "team-clean-messages: strip attribution lines" "refs/heads/$branch" "$new_head" "$old_head" 2>"$scratch/update" ||
  die "$branch moved while it was being cleaned, so it was left where it is: $(head -n 1 "$scratch/update")"

# The lease is origin's head of the branch: the old head once it is pushed, empty while origin
# has no such branch.
push="git push --force-with-lease=$branch:$remote origin $branch"
trap 'status=$?; rm -rf "$scratch"; ((status == 0)) || echo "team-clean-messages: $branch moved to $new_head, but history-rewritten is not in the ledger; push it with: $push" >&2' EXIT
ledger_append "$(jq -cn --arg task "$task" --arg project "$project" --arg branch "$branch" \
  --arg old "$old_head" --arg new "$new_head" \
  '{ts: (now | todate), task: $task, event: "history-rewritten", project: $project, branch: $branch,
    old_head: $old, head: $new}')"

{
  echo "team-clean-messages: rewrote the messages of ${#offenders[@]} of ${#commits[@]} commits of $range:"
  for sha in "${offenders[@]}"; do
    removed=$(wc -l <"$scratch/$sha.lines")
    ((removed == 1)) && removed="1 line" || removed="$removed lines"
    echo "  $(describe "$sha") ($removed removed)"
  done
  echo "team-clean-messages: $branch moved from ${old_head:0:7} to ${new_head:0:7}; nothing is pushed. With Daniel's OK, run:"
} >&2
echo "$push"

# The gate's mirror keeps the old commits past the push, so a gate on this branch needs the step.
if find_mirror && mirror_git rev-parse -q --verify "refs/heads/$branch^{commit}" >/dev/null 2>&1; then
  echo "team-clean-messages: the gate's mirror still holds the old commits of $branch, so its next run would refuse them. Once that push has landed and no gate run is active, with Daniel's OK, run:" >&2
  printf '%q %q --clear-gate-lane\n' "$(realpath -- "$0")" "$worktree"
fi
