#!/usr/bin/env bash
# List a task's tickets with each one's state, or check their Blocked by:, Waits for: and Phase: lines.
#
# Usage: team-tickets T<n> [--check] [--json] [--html <file> | --graph]
# The tickets are the files tickets/NN-<slug>.md in the task directory (the project's task_dir) of
# each open worktree of the task, one set whose numbers are the task's: NN is the ticket's
# two-digit number, which no two files share.
# Each ticket has exactly one Blocked by: line, the ticket numbers it waits on, and at most one
# Waits for: line, an outside condition (a PR, another task), each label optionally bold:
#   Blocked by: None
#   **Blocked by:** 01, 03
#   Waits for: T171 merged
# and at most one Phase: line, the phase of a task split into phases whose PR it goes in, a whole
# number from 1, phase 1 without one (a blocker is in the ticket's phase or an earlier one):
#   Phase: 2
# A line counts as one of them when its text, after any indent, list marker and bold or italic
# marks, starts with "Blocked by" or "Waits for" in any case, or with "Phase" and a colon,
# outside a fenced code block; so a mention inside a sentence or a "- [ ]" item is none.
# Its state, from the ledger: running (a builder's launch with the brief brief-build-NN, and no
# ticket-done of NN since), done (a ticket-done of NN), blocked (a blocker not done, named),
# waiting (every blocker done, and a Waits for: line, quoted) or ready (every blocker done).
# It prints one line per ticket, "NN <state> <slug>", then ": session <id>" for running, ": on
# <blockers not done>" for blocked and ": <its Waits for: text>" for waiting; --json prints a list
# of {ticket, slug, state, project, file, phase, blocked_by, waits_for, on, session, minutes},
# waits_for and session null when there is none, and minutes a done ticket's build minutes: from
# the latest builder launch on brief-build-NN to the latest ticket-done of NN, rounded half up and
# at least 1, null for a ticket not done or done with no launch before it (logged by hand). A task
# with no ticket files prints none (--json, []), saying so on stderr.
# --check prints, as "<file>:<line>: <reason>" (the file alone when there is no line), and exits 1
# on: a file in tickets/ not named NN-<slug>.md; a number two files share; a missing, second or
# malformed Blocked by: line; a second or malformed Waits for: or Phase: line; a blocker that is
# no ticket of the task, that the line names twice or that is in a later phase than its ticket;
# and a cycle of blockers, named once at the Blocked by:
# line of its lowest ticket. The listing refuses such a set the same way. A clean set prints how
# many tickets it read; one with none says so on stderr.
# --html <file> writes the tickets as one self-contained HTML page of their dependency graph
# (bin/lib/ticket_graph.py draws it, its header says how): each ticket a box by level, top to
# bottom, with its number, state, minutes and slug, each phase a band, an arrow per Blocked by:
# entry routed clear of every box, the critical path in red, weighed by build minutes (a done
# ticket its own, every other ticket their median, or each ticket 1 when none has any), and a
# header with the task's title, the serial total, the critical path, the widest level and how the
# tickets were weighed; its head carries the digest of the --json list it was drawn from
# (tickets_digest). It writes through a temporary file in <file>'s directory, renamed over
# <file>, prints nothing, refuses a directory that does not exist, and writes nothing for a set
# the listing refuses; a task with no tickets gets a page saying so.
# --graph writes that page as tickets.html and a PNG of it as tickets.png in the task directory of
# the task's first ticket listed (ticket_graph_dir), which git ignores and whose archive leaves
# images out, and prints the PNG's path, then the page's; a task with no tickets is refused.
# The PNG is headless Chrome's screenshot of the page, its window the page's exact size at twice
# its scale, so it holds every level: Chrome is the file TEAM_CHROME names (a .app directory run as
# <app>/Contents/MacOS/<its name less .app>), else Google Chrome's app on macOS, else the first of
# google-chrome-stable, google-chrome, chromium and chromium-browser on PATH, run under a 60-second
# timeout with a fresh profile directory, removed after. With no Chrome, or Chrome failing, timing
# out or writing no PNG, the page is still written and its path printed, any old tickets.png is
# removed, stderr says why there is no PNG, and the exit is 1.
# --html and --graph go with no other mode. Nothing else is written.
# Exit codes: 0 done, 1 refused or a check failed, 2 a malformed command line.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-tickets T<n> [--check] [--json] [--html <file> | --graph]"
task='' check='' json='' html='' html_set='' graph=''
while (($#)); do
  case $1 in
    --check) check=1 ;;
    --json) json=1 ;;
    --html)
      [[ -z $html_set && $# -ge 2 && -n $2 ]] || usage_error "$usage"
      html=$2 html_set=1
      shift ;;
    --graph) [[ -z $graph ]] || usage_error "$usage"; graph=1 ;;
    T[0-9]*) [[ -z $task && $1 =~ ^T[0-9]+$ ]] || usage_error "$usage"; task=$1 ;;
    *) usage_error "$usage" ;;
  esac
  shift
done
[[ -n $task ]] || usage_error "$usage"
[[ -z $check || -z $json ]] || usage_error "--check and --json do not go together; $usage"
[[ -z $html_set || -z $check$json$graph ]] || usage_error "--html goes with no other mode; $usage"
[[ -z $graph || -z $check$json ]] || usage_error "--graph goes with no other mode; $usage"
if [[ -n $html_set ]]; then
  html_dir=$(dirname -- "$html")
  [[ -d $html_dir ]] || die "$html_dir is not a directory, so $html cannot be written"
  [[ ! -d $html ]] || die "$html is a directory, not a file the page can be written to"
fi

events=$(known_task_events "$task")

# The ticket files (files) and each one's project (projects), in the order of the worktrees, then
# of the file names; a task directory reached twice (two worktrees at one path) is read once.
files=()
projects=()
declare -A seen=()
while IFS=$'\t' read -r project worktree; do
  [[ -d $worktree ]] || { echo "${0##*/}: skipping $worktree: not on this machine" >&2; continue; }
  dir=$worktree/$(team_project "$project" task_dir)/tickets
  [[ -d $dir ]] || continue
  key=$(realpath -- "$dir")
  [[ -z ${seen[$key]:-} ]] || continue
  seen[$key]=1
  while IFS= read -r -d '' file; do
    files+=("$file")
    projects+=("$project")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -name '*.md' -print0 | sort -z)
done < <(ledger_jq 'open_worktrees(.[]; $home) | [.project, .worktree] | @tsv' -r <<<"$events")

# Each line of the files that counts as a Blocked by:, Waits for: or Phase: line, as
# "<file>\t<line>\t<blocked, waits or phase>\t<1 when well-formed, else 0>\t<value>", the value
# the blockers, the condition or the phase when well-formed, else the whole line: read_lines <file>...
read_lines() {
  awk '
    FNR == 1 { fence = 0 }
    { text = $0; sub(/\r$/, "", text) }
    text ~ /^[[:space:]]*(```|~~~)/ { fence = !fence; next }
    fence { next }
    {
      probe = text
      sub(/^[[:space:]]*([-*+][[:space:]]+)?/, "", probe)
      sub(/^(\*\*|__|\*|_)/, "", probe)
      probe = tolower(probe)
      if (probe ~ /^blocked[[:space:]]+by/) {
        label = "blocked"
        good = text ~ /^(\*\*Blocked by:\*\*|Blocked by:) +(None|[0-9][0-9](, [0-9][0-9])*) *$/
      } else if (probe ~ /^waits[[:space:]]+for/) {
        label = "waits"
        good = text ~ /^(\*\*Waits for:\*\*|Waits for:) +[^ ]/
      } else if (probe ~ /^phase[[:space:]]*(\*\*|__|\*|_)?[[:space:]]*:/) {
        label = "phase"
        good = text ~ /^(\*\*Phase:\*\*|Phase:) +[1-9][0-9]* *$/
      } else next
      value = text
      if (good) { sub(/^(\*\*[^*]*\*\*|[^:]*:) +/, "", value); sub(/ +$/, "", value) }
      printf "%s\t%d\t%s\t%d\t%s\n", FILENAME, FNR, label, good, value
    }' "$@"
}


# The files and the marks as tab-separated rows, read into the analysis's $files and $marks.
files_tsv=''
for i in "${!files[@]}"; do files_tsv+="${projects[$i]}"$'\t'"${files[$i]}"$'\n'; done
marks_tsv=''
((${#files[@]} == 0)) || marks_tsv=$(read_lines "${files[@]}")

# The analysis, over the task's events as its input: {problems, tickets}, each problem
# "<file>[:<line>]: <reason>", each ticket with its state.
read -r -d '' program <<'JQ' || true
def where($m): "\($m.file):\($m.line)";
def blocked_form: "write 'Blocked by: None' or 'Blocked by: 01, 03'";
# The cycle of blockers through $start in $g (each ticket to its blockers), from $start back to
# it, or null: a breadth-first search from $start that keeps the ticket each was reached from.
def cycle($g; $start):
  def search($queue; $from):
    if ($queue | length) == 0 then null
    elif $queue[0] == $start then $from
    else reduce ($g[$queue[0]][] | select($from[.] == null)) as $v
        ([$queue[1:], $from]; [.[0] + [$v], (.[1] + {($v): $queue[0]})])
      | search(.[0]; .[1])
    end;
  search($g[$start]; reduce $g[$start][] as $v ({}; . + {($v): $start}))
  | if . == null then null
    else . as $from | [$start | recurse($from[.]; . != $start)] | [$start] + (.[1:] | reverse) + [$start]
    end;
. as $events
| [$files[] | .file as $f | (.file | sub(".*/"; "")) as $name
    | . + {name: $name, number: ($name | capture("^(?<n>[0-9]{2})-(?<s>.+)\\.md$")),
           blocked: [$marks[] | select(.file == $f and .label == "blocked")],
           waits: [$marks[] | select(.file == $f and .label == "waits")],
           phases: [$marks[] | select(.file == $f and .label == "phase")]}
    // . + {name: $name, number: null}] as $all
| [$all[] | select(.number) | . + {ticket: .number.n, slug: .number.s}] as $named
| [$named[].ticket] as $numbers
| (reduce $named[] as $t ({}; . + {($t.ticket): (($t.phases[0] | select(. and .good) | .value | tonumber) // 1)})) as $phase
| [$named[] | {(.ticket): ((.blocked[0] | select(. and .good and .value != "None") | .value | split(", ")) // [])}]
  | add // {} | map_values(map(select(. as $n | $numbers | index($n))) | unique) as $graph
| [ ($all[] | select(.number == null) | "\(.file): not named NN-<slug>.md, NN the ticket's two-digit number"),
    ($named | to_entries[] | .value as $t
      | ($named[:.key] | map(select(.ticket == $t.ticket)) | first) as $earlier
      | select($earlier) | "\($t.file): ticket \($t.ticket) is also \($earlier.file)"),
    ($named[] | .blocked as $b | .waits as $w | .phases as $p | .ticket as $self
      | (select($b == []) | "\(.file): no Blocked by: line; \(blocked_form)"),
        ($b[1:][] | "\(where(.)): a second Blocked by: line (the first is line \($b[0].line))"),
        ($w[1:][] | "\(where(.)): a second Waits for: line (the first is line \($w[0].line))"),
        ($p[1:][] | "\(where(.)): a second Phase: line (the first is line \($p[0].line))"),
        ($b[] | select(.good | not)
          | "\(where(.)): a malformed Blocked by: line; \(blocked_form), the label optionally bold, nothing else on the line"),
        ($w[] | select(.good | not)
          | "\(where(.)): a malformed Waits for: line; write 'Waits for: <an outside condition>', the label optionally bold"),
        ($p[] | select(.good | not)
          | "\(where(.)): a malformed Phase: line; write 'Phase: 2', a whole number from 1, the label optionally bold, nothing else on the line"),
        ($b[0] | select(. and .good and .value != "None") | . as $m | (.value | split(", ")) as $list
          | $list | unique[] | . as $n
          | (select($numbers | index($n) | not) | "\(where($m)): blocker \($n) is no ticket of \($task)"),
            (select([$list[] | select(. == $n)] | length > 1) | "\(where($m)): blocker \($n) is named twice"),
            (select($phase[$n] != null and $phase[$n] > $phase[$self])
              | "\(where($m)): blocker \($n) is in phase \($phase[$n]), after this ticket's phase \($phase[$self])"))),
    ($named[] | . as $t | cycle($graph; .ticket) | select(. != null and min == $t.ticket)
      | "\(where($t.blocked[0])): a cycle of blockers: \(join(" -> "))")
  ] as $problems
| ($events | to_entries) as $indexed
| (reduce ($named[] | .ticket) as $n ({};
    . + {($n): {
      done: ([$indexed[] | select(.value.event == "ticket-done" and .value.ticket == $n) | .key] | last),
      launch: ([$indexed[] | select(.value.event == "launch" and .value.role == "builder"
        and .value.brief == "brief-build-\($n)")] | last)}})) as $runs
| ($runs | map_values(
    if .launch and (.done == null or .launch.key > .done) then "running"
    elif .done != null then "done" else null end)) as $ran
# A done ticket's build minutes: from its latest launch to its latest ticket-done, rounded half up
# and at least 1, or null with no launch before that ticket-done or a time that does not parse.
| ($runs | map_values(
    if .done != null and .launch and .launch.key < .done then
      (try ((($events[.done].ts | fromdate) - (.launch.value.ts | fromdate)) / 60 + 0.5 | floor | [., 1] | max)
       catch null)
    else null end)) as $minutes
| {problems: $problems,
   tickets: [$named[]
     | (.blocked[0].value // "None" | if . == "None" then [] else split(", ") end) as $blockers
     | [$blockers[] | select($ran[.] != "done")] as $on
     | (.waits[0].value // null) as $waits
     | {ticket, slug,
        state: ($ran[.ticket] // (if $on != [] then "blocked" elif $waits then "waiting" else "ready" end)),
        project, file, phase: $phase[.ticket], blocked_by: $blockers, waits_for: $waits, on: [], session: null,
        minutes: null} as $t
     | $t + (if $t.state == "blocked" then {on: $on}
             elif $t.state == "running" then {session: $runs[.ticket].launch.value.session}
             elif $t.state == "done" then {minutes: $minutes[.ticket]} else {} end)]}
JQ

# One jq run: the analysis, then a first line of its problem and ticket counts, then each problem,
# then the tickets as --json prints them or as text lines.
mode=text
[[ -z $json$html_set$graph ]] || mode=json
out=$(jq -r --arg task "$task" --arg files_tsv "$files_tsv" --arg marks_tsv "$marks_tsv" --arg me "${0##*/}" \
  --arg mode "$mode" '
  def rows: split("\n") | map(select(. != "") | split("\t"));
  ($files_tsv | rows | map({project: .[0], file: .[1]})) as $files
  | ($marks_tsv | rows | map({file: .[0], line: (.[1] | tonumber), label: .[2], good: (.[3] == "1"), value: .[4]})) as $marks
  | ('"$program"')
  | "\(.problems | length) \(.tickets | length)",
    (.problems[] | "\($me): \(.)"),
    (if (.problems | length) > 0 then empty
     elif $mode == "json" then .tickets
     else .tickets[] | "\(.ticket) \(.state + "       " | .[:7]) \(.slug)" + (
       if .state == "running" then ": session \(.session)"
       elif .state == "blocked" then ": on \(.on | join(", "))"
       elif .state == "waiting" then ": \(.waits_for)" else "" end) end)' <<<"$events")
read -r problems count <<<"${out%%$'\n'*}"
rest=''
[[ $out != *$'\n'* ]] || rest=${out#*$'\n'}
if ((problems > 0)); then
  printf '%s\n' "$rest" >&2
  exit 1
fi
# --graph draws nothing for a task with no tickets, so it says only that.
((count || ! graph)) || die "$task has no tickets, so it has no graph"
((count)) || echo "${0##*/}: $task has no tickets in its open worktrees" >&2
if [[ -n $check ]]; then
  ((count == 0)) || echo "$task: $count tickets, every Blocked by:, Waits for: and Phase: line well-formed"
  exit 0
fi

# What the script made and removes as it ends, whatever way it ends.
made=()
trap 'rm -rf -- "${made[@]}"' EXIT

# Write the page to <file> through a temporary file in <dir>, renamed over <file> once whole, and
# set size to the page's "<width> <height>" in CSS pixels: write_page <file> <dir>
write_page() {
  local title digest tmp
  title=$(jq -r 'map(select(.event == "opened")) | last | .title // "" | tostring' <<<"$events")
  digest=$(tickets_digest <<<"$rest")
  tmp=$(mktemp "$2/.${1##*/}.XXXXXX")
  made+=("$tmp")
  size=$(python3 -I "$TEAM_LIB/ticket_graph.py" --task "$task" --title "$title" \
    --as-of "$(date -u '+%Y-%m-%d %H:%M')" --digest "$digest" --out "$tmp" <<<"$rest") ||
    die "could not draw $task's tickets"
  mv -f -- "$tmp" "$1"
}

if [[ -n $html_set ]]; then
  write_page "$html" "$html_dir"
  exit 0
fi

# The Chrome --graph screenshots the page with, or nothing: TEAM_CHROME, else Google Chrome's app
# on macOS, else the first of its commands on PATH in the doctor's order; a .app directory is run as
# the executable inside it.
chrome_command() {
  local chrome name
  if [[ -n ${TEAM_CHROME:-} ]]; then
    chrome=${TEAM_CHROME%/}
  elif [[ ${TEAM_KERNEL:-$(uname -s)} == Darwin ]]; then
    chrome='/Applications/Google Chrome.app'
  else
    chrome=$(command -v google-chrome-stable google-chrome chromium chromium-browser | head -n 1) || true
  fi
  if [[ $chrome == *.app && -d $chrome ]]; then
    name=${chrome##*/}
    chrome=$chrome/Contents/MacOS/${name%.app}
  fi
  [[ -z $chrome || ! -f $chrome || ! -x $chrome ]] || printf '%s\n' "$chrome"
}

if [[ -n $graph ]]; then
  dir=$(ticket_graph_dir <<<"$rest")
  page=$dir/tickets.html png=$dir/tickets.png
  write_page "$page" "$dir"
  read -r width height <<<"$size"
  # The page stands without a PNG, and an old PNG never stands for it: no_png <reason>
  no_png() {
    rm -f -- "$png"
    printf '%s\n' "$page"
    die "no PNG of $task's graph: $1"
  }
  chrome=$(chrome_command)
  [[ -n $chrome ]] || no_png "no Chrome found; set TEAM_CHROME or install Google Chrome"
  profile=$(mktemp -d)
  shot=$(mktemp --suffix=.png "$dir/.tickets.XXXXXX")
  err=$(mktemp)
  made+=("$profile" "$shot" "$err")
  url=file://$(jq -rn --arg path "$page" '$path | split("/") | map(@uri) | join("/")')
  status=0
  timeout -k 5 60 "$chrome" --headless=new --disable-gpu --hide-scrollbars --no-first-run \
    --no-default-browser-check --disable-extensions --disable-background-networking \
    --disable-component-update --disable-sync --mute-audio --user-data-dir="$profile" \
    --force-device-scale-factor=2 --window-size="$width,$height" --screenshot="$shot" "$url" \
    </dev/null >/dev/null 2>"$err" || status=$?
  # A Chrome helper still ending may hold it a moment longer; the EXIT trap removes it then.
  rm -rf -- "$profile" 2>/dev/null || true
  ((status != 124)) || no_png "Chrome timed out after 60 s"
  last=$(grep -v '^[[:space:]]*$' "$err" | tail -n 1) || true
  ((status == 0)) || no_png "Chrome exited $status${last:+: $last}"
  [[ $(image_type "$shot") == png ]] || no_png "Chrome exited 0 and wrote no PNG${last:+: $last}"
  mv -f -- "$shot" "$png"
  printf '%s\n%s\n' "$png" "$page"
  exit 0
fi
[[ -z $rest ]] || printf '%s\n' "$rest"
