#!/usr/bin/env bash
# Put this machine's secret files in place from 1Password, and say which are missing, without
# ever printing, logging or reading a value.
#
# machine/secrets.json in the team home (a record) lists every secret file the team needs, never
# a value: per entry its id, its target (a path under HOME), its mode ("600"), its ref (the
# 1Password secret reference, op://agent-team/<id>/<file name>), what it is (about), and enabled
# (default true; false leaves it out of everything until it is needed). Each is a 1Password
# Document in the agent-team vault titled with its id; machine/secrets.md says where each comes
# from and how to rotate it.
#
# Usage: team-secrets check [--json] | restore | save <id>
#   check     One line per enabled secret, from its target's existence, size and mode alone (not a
#             byte of it is read): "PASS <id>", or "FAIL <id>: missing" (or empty, mode 644, not a
#             file). Exit 1 on any FAIL. --json prints one array of {id, verdict, reason} instead,
#             reason "" on a PASS.
#   restore   For each secret failing check, missing, empty or off its mode: it is fetched from
#             1Password into a new temporary file beside its target, with its mode (any folder it
#             makes is 700), by `op read --out-file <temporary> --file-mode 0<mode> <ref>`, else
#             `op document get <id> --vault agent-team --out-file ...`, and moved into place. When
#             1Password gives nothing, the temporary file goes and Daniel is asked to paste the
#             file, not echoed, into a temporary file already at its mode (Ctrl-D alone skips it).
#             A file off its mode may be stale (a machine's old copy), so it is replaced, never
#             given its mode: once the new one is in hand, the old one is kept beside it as
#             <target>.bak-<date and time>, mode 600, and its line says "replaced" with the
#             backup's path; skipped, it is left as it was. A passing secret, or a target that is
#             not a file, is left alone. Ends with check, and exits as check does.
#   save      Puts this machine's file of secret <id> into 1Password, after a rotation:
#             `op document edit` on the agent-team vault's document titled <id>, or
#             `op document create <target> --vault agent-team --title <id>` when there is none.
#             Prints the id and the result.
# restore and save run only when stdin and stdout are both a terminal, so they refuse before any
# op call in an agent's Bash tool; 1Password's own prompt (Touch ID on macOS, system
# authentication on Linux) is Daniel's approval, one per terminal session. op's output is never
# shown, only the first line of its error. Nothing is written to the ledger or a log.
# Exit 0 done (check: every secret passes), 1 refused or a check failed, 2 usage error.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-secrets check [--json] | restore | save <id>"
[[ $# -ge 1 ]] || usage_error "$usage"
command=$1
shift
json=0
case $command in
  check)
    [[ $# -eq 0 || ($# -eq 1 && $1 == --json) ]] || usage_error "$usage"
    [[ $# -eq 0 ]] || json=1
    ;;
  restore) [[ $# -eq 0 ]] || usage_error "$usage" ;;
  save) [[ $# -eq 1 ]] || usage_error "$usage" ;;
  *) usage_error "$usage" ;;
esac

VAULT=agent-team
manifest=$TEAM_HOME/machine/secrets.json
[[ -f $manifest ]] || die "no machine/secrets.json in $TEAM_HOME"
problems=$(jq -r '
  def kebab: type == "string" and test("^[a-z0-9]+(-[a-z0-9]+)*$");
  def relative: type == "string" and test("^[^/\t\n][^\t\n]*$") and (split("/") | all(. != ".." and . != "."));
  if type != "object" or (.secrets | type) != "array" then "it has no secrets array" else
    [(.secrets | to_entries[] | .key as $i | .value
      | if type != "object" then "entry \($i) is not an object" else
          (if .id | kebab then .id else "entry \($i)" end) as $name
          | (if .id | kebab then empty else "\($name): id is not lower-case kebab case" end),
            (if .target | relative then empty else "\($name): target is not a path under HOME" end),
            (if .mode | type == "string" and test("^[0-7]{3}$") then empty else "\($name): mode is not three octal digits" end),
            (if .ref | type == "string" and test("^op://[^\t\n]+/[^\t\n/]+$") then empty else "\($name): ref is not an op:// reference" end),
            (if .about | type == "string" then empty else "\($name): about is not a string" end),
            (if .enabled == null or (.enabled | type) == "boolean" then empty else "\($name): enabled is not true or false" end)
        end),
      ([.secrets[] | objects | .id | strings] | group_by(.) | .[] | select(length > 1) | "\(.[0]): listed twice")]
    | join("; ")
  end' "$manifest" 2>/dev/null) || die "machine/secrets.json is not JSON"
[[ -z $problems ]] || die "machine/secrets.json: $problems"

err=$(mktemp)
tmp='' saved_tty=''
cleanup() {
  [[ -z $saved_tty ]] || stty "$saved_tty" 2>/dev/null || true
  rm -f -- "$err" ${tmp:+"$tmp"}
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

# The enabled secrets, one "id<TAB>target<TAB>mode<TAB>ref<TAB>about" line each.
entries() {
  jq -r '.secrets[] | select(.enabled != false) | [.id, .target, .mode, .ref, .about] | @tsv' "$manifest"
}

# Why <path> fails to be a secret file of <mode>, from its metadata alone; nothing when it
# passes: state <path> <mode>
state() {
  local mode
  if [[ ! -e $1 && ! -L $1 ]]; then
    echo missing
  elif [[ ! -f $1 ]]; then
    echo "not a file"
  elif [[ ! -s $1 ]]; then
    echo empty
  else
    mode=$(stat -L -c %a -- "$1")
    [[ $mode == "$2" ]] || echo "mode $mode"
  fi
}

# <path> as ~/..., for messages.
tilde() {
  printf '%s\n' "${1/#"$HOME"\//\~/}"
}

# The first line op wrote to stderr (in $err), without its "[ERROR] <date> <time> " prefix.
op_reason() {
  local line
  line=$(grep -m1 . "$err" || true)
  line=$(sed -E 's/^\[ERROR\] [0-9/]+ [0-9:]+ //' <<<"$line")
  printf '%s\n' "${line:-op failed with no message}"
}

# Refuse unless Daniel's own terminal runs this: need_terminal <command>
need_terminal() {
  [[ -t 0 && -t 1 ]] ||
    die "$1 runs only in Daniel's own terminal (stdin and stdout a terminal), never in an agent's shell: type team-secrets $1 there"
}

check() {
  local id target mode ref about reason results=() failed=0
  while IFS=$'\t' read -r id target mode ref about; do
    reason=$(state "$HOME/$target" "$mode")
    [[ -z $reason ]] || failed=1
    if ((json)); then
      results+=("$(jq -cn --arg id "$id" --arg reason "$reason" \
        '{id: $id, verdict: (if $reason == "" then "PASS" else "FAIL" end), reason: $reason}')")
    elif [[ -z $reason ]]; then
      printf 'PASS %s\n' "$id"
    else
      printf 'FAIL %s: %s\n' "$id" "$reason"
    fi
  done < <(entries)
  if ((json)); then printf '%s\n' ${results[@]+"${results[@]}"} | jq -s .; fi
  return "$failed"
}

# Run an op command that writes the temporary file $tmp, its output dropped; it succeeds when $tmp
# is then a file with something in it, else $tmp is removed and op_error says why: fetch <op args...>
fetch() {
  op_error=''
  if ! command -v op >/dev/null; then
    op_error="op is not installed"
    return 1
  fi
  if op "$@" >/dev/null 2>"$err" </dev/null; then
    [[ -f $tmp && -s $tmp ]] && return 0
    op_error="1Password gave an empty file"
  else
    op_error=$(op_reason)
  fi
  rm -f -- "$tmp"
  return 1
}

# Ask Daniel to paste the secret into $tmp, made with <mode> before anything is written to it and
# with the terminal's echo off: paste_secret <id> <path> <mode> <about>; fails when nothing was
# pasted.
paste_secret() {
  (umask 077 && set -C && : >"$tmp")
  chmod "$3" -- "$tmp"
  saved_tty=$(stty -g)
  stty -echo
  printf '%s: paste %s (%s), then Ctrl-D on a line of its own; Ctrl-D alone skips it. What you paste is not shown.\n' \
    "$1" "$(tilde "$2")" "$4"
  cat >>"$tmp" || true
  stty "$saved_tty"
  saved_tty=''
  echo
  [[ -s $tmp ]] && return 0
  rm -f -- "$tmp"
  return 1
}

# Restore one secret that fails check for <reason>: restore_one <id> <path> <mode> <ref> <about> <reason>
restore_one() {
  local id=$1 path=$2 mode=$3 ref=$4 about=$5 reason=$6 dir how backup
  case $reason in
    "not a file")
      echo "$id: $(tilde "$path") is not a file; left alone"
      return 0
      ;;
  esac
  dir=$(dirname "$path")
  if [[ ! -d $dir ]] && ! (umask 077 && mkdir -p -- "$dir"); then
    echo "$id: cannot make $(tilde "$dir"); left $reason"
    return 0
  fi
  tmp=$(mktemp -u "$dir/.${path##*/}.restore.XXXXXX")
  if fetch read --out-file "$tmp" --file-mode "0$mode" "$ref"; then
    how="1Password (op read)"
  else
    echo "$id: op read gave nothing: $op_error"
    if fetch document get "$id" --vault "$VAULT" --out-file "$tmp" --file-mode "0$mode"; then
      how="1Password (op document get)"
    else
      echo "$id: op document get gave nothing: $op_error"
      if paste_secret "$id" "$path" "$mode" "$about"; then
        how="what you pasted"
      else
        tmp=''
        echo "$id: skipped; still $reason"
        return 0
      fi
    fi
  fi
  chmod "$mode" -- "$tmp"
  if [[ $reason == mode* ]]; then
    # The old file stays at its path until the new one replaces it, kept beside it as a hard link
    # made with mode 600; ln refuses a backup already there.
    backup=$path.bak-$(date +%Y-%m-%dT%H%M%S)
    if ! ln -- "$path" "$backup" 2>/dev/null; then
      rm -f -- "$tmp"
      tmp=''
      echo "$id: cannot keep the old file as $(tilde "$backup"); left $reason"
      return 0
    fi
    chmod 600 -- "$backup"
    mv -f -- "$tmp" "$path"
    tmp=''
    echo "$id: replaced from $how; the old one ($reason) is $(tilde "$backup"), mode 600"
    return 0
  fi
  mv -f -- "$tmp" "$path"
  tmp=''
  echo "$id: restored from $how"
}

case $command in
  check) check ;;
  restore)
    need_terminal restore
    while IFS=$'\t' read -r -u 3 id target mode ref about; do
      reason=$(state "$HOME/$target" "$mode")
      if [[ -z $reason ]]; then
        echo "$id: in place; untouched"
      else
        restore_one "$id" "$HOME/$target" "$mode" "$ref" "$about" "$reason"
      fi
    done 3< <(entries)
    echo
    echo "team-secrets check:"
    check
    ;;
  save)
    need_terminal save
    id=$1
    IFS=$'\t' read -r _ target _ ref _ < <(entries | awk -F'\t' -v id="$id" '$1 == id') ||
      die "machine/secrets.json lists no enabled secret $id"
    path=$HOME/$target
    [[ -f $path && -s $path ]] || die "$id: $(tilde "$path") is missing or empty, so there is nothing to save"
    command -v op >/dev/null || die "$id: op is not installed (team-doctor's tool op line says how)"
    list=$(op document list --vault "$VAULT" --format json 2>"$err" </dev/null) ||
      die "$id: 1Password did not list the $VAULT vault: $(op_reason)"
    items=$(jq -r --arg id "$id" '.[] | select(.title == $id) | .id' <<<"$list" 2>/dev/null) ||
      die "$id: 1Password's document list is not JSON"
    case $(grep -c . <<<"$items") in
      0)
        op document create "$path" --vault "$VAULT" --title "$id" --file-name "${ref##*/}" >/dev/null 2>"$err" </dev/null ||
          die "$id: 1Password did not create its document: $(op_reason)"
        echo "saved $id: created its document in the $VAULT vault"
        ;;
      1)
        op document edit "$items" "$path" --vault "$VAULT" --file-name "${ref##*/}" >/dev/null 2>"$err" </dev/null ||
          die "$id: 1Password did not update its document: $(op_reason)"
        echo "saved $id: updated its document in the $VAULT vault"
        ;;
      *) die "$id: the $VAULT vault has more than one document titled $id; delete the extra ones in 1Password" ;;
    esac
    ;;
esac
