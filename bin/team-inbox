#!/usr/bin/env bash
# Keep one "Waiting on you" message in #coordinator current: what waits on Daniel, from the
# ledger alone, edited in place through the Discord REST API, so no model turn writes it.
#
# Usage: team-inbox
# The message lists, for each open task in task number order: each ask nothing settled (an asked
# with no answered or merge-preapproved of its id and no merge-approved whose url its text names,
# as team-sweep reads it), with the task, the ask's id, its first line and a link to the question
# (its discord_message, which team-ask logs, in the task's thread; else the thread); each PR ready
# to merge (the task's phase awaiting-merge, the PR not merged and no merge-approved logged at its
# head), with its full URL; and each interview under way (an interview-thread with no planner's
# done or plan-approved after it), with its thread. With none, it says "Nothing waits on you". The
# line after the items is the team's resource level, from team-level status --stored --json (it
# takes no reading): "Resources: manual, minor (30%): 9.2 GiB and 3.6 cores for the team; 6.1
# GiB reserved; T171 stowed, waiting to resume", naming each open task whose latest stowed (for the
# level or a handoff) names roles to relaunch and that no launch has followed; when team-level fails the line is left out, with a line
# on stderr saying why. Its last line is the time of this run. Items past Discord's 2000
# characters are left out from the end, counted in a line.
# A PR ready to merge is left out while it waits on no word of Daniel's: the task's latest
# merge-preapproved of the PR's project (the registered one whose repo is the URL's) stands, and
# that project opts in now (team-project --find merge_with_plan true) and is not the team's own
# (own_project in bin/lib/team.sh), so team-merge merges it on that plan-time word. One it
# refuses comes back as the coordinator's ask, its text naming the PR's URL, listed with the asks.
# A PR ready to merge is left out too while a standing word of Daniel's stands for its project (the
# latest merge-standing or merge-standing-withdrawn naming the project or all is a merge-standing),
# so team-merge merges it on that word; one it refuses comes back as the coordinator's ask too.
# While a standing word stands, one line per word above the last line names the registered
# projects it stands for and links Daniel's message: "-# Standing merge word on <projects> since
# <link>"; the length limit never cuts those lines.
# The registry is read only once the ledger holds a merge-preapproved or a merge-standing; when it
# cannot be read, every PR ready to merge is listed, the standing word lines name the projects as
# the words were logged (all as "every project"), and a line on stderr says why.
# It edits the message named in ~/.local/state/agent-team/inbox.json ({channel, guild, message})
# and posts a new one only when there is none there, it is another channel's, or Discord no longer
# has it (404), keeping the new one's id. It never pings: no mention in it notifies anyone, and
# Discord sends no notice of an edit (team-ask's ping does that for a new ask). The guild, which a
# question's link needs, is read once from #coordinator's channel and kept in the same file.
# team-ask, team-answer, team-merge and team-close run it at their end (refresh_inbox in
# bin/lib/team.sh), going on with a line on stderr when it fails; team-timers run runs it every
# five minutes on the lease holder. It refuses on a machine that is fenced or lost the lease
# (lease_refusal in bin/lib/team.sh) and in a worker session (worker_refusal), and one run at a
# time holds ~/.local/state/agent-team/inbox.lock.
# Prints "edited <the message's link>" or "posted <the message's link>".
# Exit codes: 0 done; 1 refused, or Discord refused a call; 2 a malformed command line; 75 Discord
# answered 429, or another run held the lock for a minute.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

# Discord's limit on a message's characters, the most one call may take and the longest wait for
# another run's lock, in seconds.
LIMIT=2000
CALL_TIMEOUT=20
LOCK_SECONDS=60
# Discord's message flag SUPPRESS_EMBEDS, so a PR's link shows no preview card.
SUPPRESS_EMBEDS=4

(($# == 0)) || usage_error "usage: team-inbox"
why=$(worker_refusal "" "edits nothing in Discord") && die "$why"

why=$(lease_refusal "posts nothing to Discord; the coordinator on the holder answers there.") && die "$why"
discord_token >/dev/null || die "no DISCORD_BOT_TOKEN in ~/.claude/channels/discord/.env"

state_dir=$HOME/.local/state/agent-team
state=$state_dir/inbox.json
mkdir -p "$state_dir"
exec {lock}>>"$state_dir/inbox.lock"
flock -w "$LOCK_SECONDS" "$lock" || {
  echo "team-inbox: another run has held $state_dir/inbox.lock for ${LOCK_SECONDS}s; try again later" >&2
  exit 75
}

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# Call Discord: call <path> [<curl options>...]; writes the answer to $scratch/answer, or sets
# STATUS (the HTTP status, empty with no answer) and ERROR (curl's first line) and fails.
STATUS='' ERROR=''
call() {
  rm -f "$scratch/headers"
  if discord_api "$1" --max-time "$CALL_TIMEOUT" -D "$scratch/headers" "${@:2}" >"$scratch/answer" 2>"$scratch/error"; then
    return 0
  fi
  # curl writes the headers it got, a failed status's included; none when it got no answer.
  touch "$scratch/headers"
  STATUS=$(sed -nE 's#^HTTP/[0-9.]+ ([0-9]{3}).*#\1#p' "$scratch/headers" | tail -n 1)
  ERROR=$(grep -m 1 . "$scratch/error" || echo "no reason given")
  return 1
}

# Fail as Discord's answer says: exit 75 on a 429, with when to try again, else 1.
refused() {
  local retry
  if [[ $STATUS == 429 ]]; then
    retry=$(sed -nE 's/^(retry-after|x-ratelimit-reset-after):[[:space:]]*([^[:space:]]+).*/\2/Ip' "$scratch/headers" | head -n 1)
    echo "team-inbox: Discord is rate-limiting the bot (429) on $1: try again ${retry:+in $retry s}$([[ -n $retry ]] || echo later)" >&2
    exit 75
  fi
  die "Discord refused $1: $ERROR"
}

# The kept message, when it is #coordinator's.
read -r guild message < <(jq -r --arg channel "$COORDINATOR_CHANNEL" '
  select(type == "object" and (.channel | tostring) == $channel)
  | [(.guild // "" | tostring), (.message // "" | tostring)] | map(select(test("^[0-9]+$")) // "-") | join(" ")' \
  "$state" 2>/dev/null) || true
[[ ${guild:--} != - ]] || guild=''
[[ ${message:--} != - ]] || message=''

if [[ -z $guild ]]; then
  call "channels/$COORDINATOR_CHANNEL" || refused "the read of #coordinator's channel"
  guild=$(jq -r '.guild_id | strings | select(test("^[0-9]+$"))' "$scratch/answer" 2>/dev/null) || guild=''
  [[ -n $guild ]] || die "Discord named no guild for #coordinator ($COORDINATOR_CHANNEL)"
fi

ledger=$TEAM_HOME/ledger.jsonl
[[ -e $ledger ]] || ledger=/dev/null

# The repos, lowercased, of the projects whose PRs may merge on Daniel's plan-time word, each to
# its project: those that opt in now and are not the team's own; and, for the standing word, the
# registered projects and every one's repo. The registry is read only once the ledger holds such a
# word, and one that cannot be read lists every PR, the standing word lines naming the projects as
# the words were logged.
words=$(ledger_jq 'ledger_events | {plan: any(.[]; .event == "merge-preapproved"),
  standing: [.[] | select(.event == "merge-standing") | .project | strings] | unique}' -nRc "$ledger")
plan_repos='{}' repos='{}' projects='[]' unreadable=''
if jq -e .plan <<<"$words" >/dev/null; then
  if found=$(team_project --find merge_with_plan true 2>"$scratch/registry"); then
    while IFS= read -r project; do
      if [[ -z $project ]] || own_project "$project"; then continue; fi
      repo=$(team_project "$project" repo) || exit 1
      plan_repos=$(jq -c --arg repo "$repo" --arg project "$project" '.[$repo | ascii_downcase] = $project' <<<"$plan_repos")
    done <<<"$found"
  else
    unreadable=1
  fi
fi
if [[ -z $unreadable ]] && jq -e '.standing != []' <<<"$words" >/dev/null; then
  if found=$(team_project --list 2>"$scratch/registry"); then
    while IFS= read -r project; do
      [[ -n $project ]] || continue
      repo=$(team_project "$project" repo) || exit 1
      repos=$(jq -c --arg repo "$repo" --arg project "$project" '.[$repo | ascii_downcase] = $project' <<<"$repos")
      projects=$(jq -c --arg project "$project" '. + [$project]' <<<"$projects")
    done <<<"$found"
  else
    unreadable=1
  fi
fi
if [[ -n $unreadable ]]; then
  plan_repos='{}' repos='{}' projects=$(jq -c .standing <<<"$words")
  aside=$(jq -r '[if .plan then "plan-time" else empty end, if .standing != [] then "standing" else empty end]
    | "\(join(" and ")) word\(if length > 1 then "s" else "" end)"' <<<"$words")
  echo "team-inbox: lists every PR ready to merge, Daniel's $aside aside, since the registry cannot be read: $(grep -m 1 . "$scratch/registry" || echo "team-project failed")" >&2
fi

# The team's resource level, for the line after the items; left out, saying why, when team-level
# cannot tell it.
level=$(machine_level)
if why=$(jq -er '.error // empty' <<<"$level"); then
  echo "team-inbox: leaves out the resources line, since team-level status failed: $why" >&2
fi

ledger_jq 'ledger_events | (by_task | awaiting_resume) as $stowed | inbox_items($plan_repos; $repos; $projects)
  | inbox_text($guild; $limit; now | floor; resources_line($level; $stowed))
  | {content: ., allowed_mentions: {parse: []}, flags: $flags}' -nRc --argjson plan_repos "$plan_repos" \
  --argjson repos "$repos" --argjson projects "$projects" --argjson level "$level" \
  --arg guild "$guild" --argjson limit "$LIMIT" --argjson flags "$SUPPRESS_EMBEDS" "$ledger" >"$scratch/body"

# Keep the message's place: keep <message>
keep() {
  jq -n --arg channel "$COORDINATOR_CHANNEL" --arg guild "$guild" --arg message "$1" \
    '{channel: $channel, guild: $guild, message: $message}' >"$state.$$"
  mv -f "$state.$$" "$state"
}

done_as=edited
if [[ -n $message ]]; then
  if ! call "channels/$COORDINATOR_CHANNEL/messages/$message" -X PATCH -H "Content-Type: application/json" \
    --data-binary "@$scratch/body"; then
    [[ $STATUS == 404 ]] || refused "the edit of message $message"
    message=''
  fi
fi
if [[ -z $message ]]; then
  call "channels/$COORDINATOR_CHANNEL/messages" -X POST -H "Content-Type: application/json" \
    --data-binary "@$scratch/body" || refused "the post"
  message=$(jq -r '.id | strings | select(test("^[0-9]+$"))' "$scratch/answer" 2>/dev/null) || message=''
  [[ -n $message ]] || die "Discord's answer to the post names no message id"
  done_as=posted
fi
keep "$message"
echo "$done_as https://discord.com/channels/$guild/$COORDINATOR_CHANNEL/$message"
