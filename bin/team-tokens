#!/usr/bin/env -S python3 -I
# Where Claude usage goes: this machine's usage exported into the team home, with no content.
#
# Usage: team-tokens export [--through-now]
#        team-tokens          the report; not built yet, it says so in one line and exits 1
#
# export reads this machine's Claude Code transcripts (~/.claude/projects/*/*.jsonl and each
# session's subagents/*.jsonl) and writes one line per assistant reply into the team home's
# usage/<machine>/<YYYY-MM-DD>.jsonl, a file per UTC day, sorted by time; the machine is the name
# in ~/.config/agent-team/machine. Each line is a whitelist, never message content:
#   ts               the reply's time, its first transcript line's
#   machine          this machine
#   session          the session's id; a subagent's reply carries its parent session's
#   agent            a subagent's reply only: its agent id
#   project_dir      the transcript's directory under ~/.claude/projects (the encoded cwd)
#   model            the model id, <synthetic> for Claude Code's own error replies
#   request          the API request id
#   input, cache_read, output
#                    the usage's token counts
#   cache_write_1h, cache_write_5m
#                    the cache write by lifetime, from usage.cache_creation; a transcript without
#                    it counts the whole write as one-hour for a main session and five-minute for
#                    a subagent (the subscription's defaults)
#   thinking         thinking tokens (part of output), when the transcript records them
# Claude Code writes one transcript line per content block, each with the reply's usage: a reply
# is one line per request id, wherever it appears (a forked session's copy included), taking each
# count's largest value (a subagent's early lines carry a partial output) and the rest from its
# earliest line; a line with no request id is left out.
# Only days before today (UTC) are written, so each day file is written once in practice;
# --through-now writes today's too. A day file is rewritten only when it gains a reply or a reply
# in it grew. A transcript is read again only when its size or modification time changed since
# the last export (~/.local/state/agent-team/usage-scan.json), or while it holds replies of a day
# not written yet. A rerun with nothing new changes no file.
# Prints a line per day file written, then "read <n> of <m> transcripts; ...".
# team-checkpoint runs the export each time and commits usage/; team-handoff runs it with
# --through-now before it commits and pushes the records. Claude Code deletes transcripts after
# 30 days by default (cleanupPeriodDays), so the day files are the lasting record.
#
# bin/lib/prices.json holds each model's list prices, per million tokens, with the date they were
# read and their source: the weights the report gives each reply.
# Exit 0 done, 1 refused, 2 usage error. Python standard library only, Python 3.11 or later.

import glob
import json
import os
import re
import sys
from datetime import datetime, timedelta, timezone

if sys.version_info < (3, 11):
    print(
        f"{os.path.basename(sys.argv[0])}: needs Python 3.11 or later, but runs under"
        f" Python {sys.version.split()[0]} ({sys.executable}); on macOS run `brew install python@3.12`,"
        " whose python3 the team's scripts put first on PATH",
        file=sys.stderr,
    )
    sys.exit(1)

NAME = os.path.basename(sys.argv[0])
USAGE = "usage: team-tokens [export [--through-now]]"
# The token counts of a line, in their order; each is the largest of the reply's lines.
COUNTS = ("input", "cache_write_1h", "cache_write_5m", "cache_read", "output", "thinking")
# A line's fields, in the order it is written.
FIELDS = ["ts", "machine", "session", "agent", "project_dir", "model", "request", *COUNTS]
SCAN_VERSION = 1


def fail(message, status=1):
    print(f"{NAME}: {message}", file=sys.stderr)
    sys.exit(status)


# Print this script's header: the comment block under its shebang, as bin/lib/team.sh does.
def print_help():
    with open(__file__, encoding="utf-8") as script:
        next(script)
        for line in script:
            if not line.startswith("#"):
                break
            print(re.sub(r"^# ?", "", line), end="")


# The team home, found as the library finds it: TEAM_HOME when set; else the first line of
# ~/.config/agent-team/home, a path relative to HOME unless it is absolute; else the directory
# above bin/.
def team_home():
    home = os.environ.get("TEAM_HOME")
    setting = os.path.join(os.environ.get("HOME", ""), ".config", "agent-team", "home")
    if not home and os.path.isfile(setting):
        fix = (
            "name its checkout there, relative to your home directory:"
            " echo agent-team-records > ~/.config/agent-team/home"
        )
        with open(setting, encoding="utf-8") as file:
            home = file.readline().rstrip("\n")
        if not home:
            fail(f"the setting ~/.config/agent-team/home names no team home; {fix}")
        home = os.path.join(os.environ["HOME"], home)
        if not os.path.isdir(home):
            fail(f"the team home {home}, named by ~/.config/agent-team/home, is not a directory; {fix}")
    home = home or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if not os.path.isdir(home):
        fail(f"team home {home} is not a directory")
    return home


# This machine's team name, as the library's machine_name reads it.
def machine_name(home):
    path = os.path.join(home, ".config", "agent-team", "machine")
    fix = "write one with: echo <name> > ~/.config/agent-team/machine"
    if not os.path.isfile(path):
        fail(f"this machine has no team name; {fix}")
    with open(path, encoding="utf-8") as file:
        name = file.readline().rstrip("\n")
    if not re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", name):
        fail(f"~/.config/agent-team/machine names '{name}', not a lower-case kebab-case name like home-pc; {fix}")
    return name


def count(value):
    return value if isinstance(value, int) and not isinstance(value, bool) else 0


# The usage line of one transcript line, or None when it is no assistant reply with a request id.
# Only the whitelisted fields are read: reply <line> <machine> <project_dir>
def reply(line, machine, project_dir):
    # Most lines are no reply: skip them before parsing.
    if '"assistant"' not in line:
        return None
    try:
        entry = json.loads(line)
    except ValueError:
        return None
    if not isinstance(entry, dict) or entry.get("type") != "assistant":
        return None
    message = entry.get("message")
    request, ts, session = entry.get("requestId"), entry.get("timestamp"), entry.get("sessionId")
    if not isinstance(message, dict) or not all(isinstance(v, str) and v for v in (request, ts, session)):
        return None
    try:
        when = datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None
    if when.tzinfo is None:
        return None
    if not ts.endswith("Z"):
        ts = when.astimezone(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
    agent = entry.get("agentId") if entry.get("isSidechain") else None
    usage = message.get("usage") if isinstance(message.get("usage"), dict) else {}
    write = count(usage.get("cache_creation_input_tokens"))
    lifetimes = usage.get("cache_creation")
    if isinstance(lifetimes, dict):
        write_1h = count(lifetimes.get("ephemeral_1h_input_tokens"))
        write_5m = count(lifetimes.get("ephemeral_5m_input_tokens"))
    elif agent:
        write_1h, write_5m = 0, write
    else:
        write_1h, write_5m = write, 0
    row = {"ts": ts, "machine": machine, "session": session}
    if isinstance(agent, str) and agent:
        row["agent"] = agent
    model = message.get("model")
    row.update(
        project_dir=project_dir,
        model=model if isinstance(model, str) else "",
        request=request,
        input=count(usage.get("input_tokens")),
        cache_write_1h=write_1h,
        cache_write_5m=write_5m,
        cache_read=count(usage.get("cache_read_input_tokens")),
        output=count(usage.get("output_tokens")),
    )
    details = usage.get("output_tokens_details")
    if isinstance(details, dict) and isinstance(details.get("thinking_tokens"), int):
        row["thinking"] = count(details["thinking_tokens"])
    return row


# Merge the reply <new> into <old>, both lines of one request: the earliest line's fields, each
# count's largest value. Returns the merged line.
def merge(old, new):
    first, other = (new, old) if new["ts"] < old["ts"] else (old, new)
    merged = dict(first)
    for key in COUNTS:
        if key in other:
            merged[key] = max(merged.get(key, 0), other[key])
    return {key: merged[key] for key in sorted(merged, key=FIELDS.index)}


def dumps(row):
    return json.dumps(row, separators=(",", ":"))


def read_day(path):
    rows = {}
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as file:
            for line in file:
                if not line.strip():
                    continue
                try:
                    row = json.loads(line)
                    rows[row["request"]] = row
                except (ValueError, TypeError, KeyError):
                    fail(f"cannot export: {path} holds a line that is no usage line; fix or remove it")
    return rows


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = f"{path}.tmp-{os.getpid()}"
    with open(temporary, "w", encoding="utf-8") as file:
        file.write(text)
    os.replace(temporary, path)


def plural(n, one, many):
    return f"{n} {one if n == 1 else many}"


def export(through_now):
    home = os.environ.get("HOME") or fail("HOME is not set")
    team = team_home()
    machine = machine_name(home)
    projects = os.path.join(home, ".claude", "projects")
    state_path = os.path.join(home, ".local", "state", "agent-team", "usage-scan.json")
    out_dir = os.path.join(team, "usage", machine)

    state = {}
    if os.path.isfile(state_path):
        try:
            with open(state_path, encoding="utf-8") as file:
                saved = json.load(file)
            if saved.get("version") == SCAN_VERSION and isinstance(saved.get("files"), dict):
                state = saved["files"]
        except (ValueError, AttributeError):
            state = {}

    transcripts = sorted(
        glob.glob(os.path.join(glob.escape(projects), "*", "*.jsonl"))
        + glob.glob(os.path.join(glob.escape(projects), "*", "*", "subagents", "*.jsonl"))
    )
    today = datetime.now(timezone.utc).date()
    # The last day written: yesterday, or today with --through-now.
    last = (today if through_now else today - timedelta(days=1)).isoformat()
    replies, read, seen, pending = {}, 0, {}, set()
    for path in transcripts:
        try:
            info = os.stat(path)
        except FileNotFoundError:
            continue
        mark = [info.st_size, info.st_mtime_ns]
        seen[path] = mark
        if state.get(path) == mark:
            continue
        read += 1
        project_dir = os.path.relpath(path, projects).split(os.sep)[0]
        with open(path, encoding="utf-8", errors="replace") as file:
            for line in file:
                row = reply(line, machine, project_dir)
                if row is None:
                    continue
                old = replies.get(row["request"])
                replies[row["request"]] = merge(old, row) if old else row
                if row["ts"][:10] > last:
                    pending.add(path)

    days = {}
    for row in replies.values():
        days.setdefault(row["ts"][:10], []).append(row)
    lines, written, left = [], 0, 0
    for day in sorted(days):
        if day > last:
            left += len(days[day])
            continue
        path = os.path.join(out_dir, f"{day}.jsonl")
        existing = read_day(path)
        merged = dict(existing)
        for row in days[day]:
            old = merged.get(row["request"])
            merged[row["request"]] = merge(old, row) if old else row
        if merged == existing:
            continue
        rows = sorted(merged.values(), key=lambda r: (r["ts"], r["request"]))
        write_atomic(path, "".join(dumps(row) + "\n" for row in rows))
        written += 1
        new = len(merged) - len(existing)
        lines.append(f"usage/{machine}/{day}.jsonl: {plural(len(rows), 'reply', 'replies')}, {new} new")

    # A transcript holding a reply of a day not written is read again next time.
    files = {path: mark for path, mark in seen.items() if path not in pending}
    if files != state:
        write_atomic(state_path, json.dumps({"version": SCAN_VERSION, "files": files}, indent=1, sort_keys=True) + "\n")

    summary = f"read {read} of {len(transcripts)} transcripts; "
    summary += f"wrote {plural(written, 'day file', 'day files')}" if written else "no day file changed"
    if left:
        summary += f"; {plural(left, 'reply', 'replies')} of today left for a later export"
    lines.append(summary)
    print("\n".join(lines))


def main(args):
    if args[:1] in (["--help"], ["-h"]):
        print_help()
    elif not args:
        fail("the report is not built yet; team-tokens export writes this machine's usage into the team home")
    elif args[0] == "export" and args[1:] in ([], ["--through-now"]):
        try:
            export(args[1:] == ["--through-now"])
        except OSError as error:
            fail(f"cannot export: {error}")
    else:
        fail(USAGE, 2)


if __name__ == "__main__":
    main(sys.argv[1:])
