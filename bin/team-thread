#!/usr/bin/env bash
# Open a task's Discord thread under #coordinator and record it in the ledger, or its interview
# thread under the interview channel, or wait in that thread for Daniel's next messages.
# Every task has a thread; bin/team-worker refuses to launch a worker for a task without it.
# Discord archives either thread after 3 days with no messages.
#
# Usage: team-thread <task> <project> <title>
#        team-thread T<n> --interview
#        team-thread wait T<n> [--after <message id>]
#   <task> <project> <title>  Opens the task's thread under #coordinator, named "T<n> · <project>
#             · <title>", logs it as thread and prints its id; one already logged is printed
#             without calling Discord.
#   --interview  Opens the open task's interview thread under the interview channel
#             (INTERVIEW_CHANNEL in bin/lib/team.sh), named as its thread from its opened event,
#             logs it as interview-thread and prints its id, or prints the one already logged.
#             The plugin delivers nothing from that channel, so the coordinator never hears what
#             is said there: a planner whose brief is planner-interview or planner-walk talks with Daniel there.
#   wait      Blocks until Daniel posts in the open task's interview thread, then prints each of
#             their new messages, oldest first, as one JSON line: {"id", "sent" (Discord's
#             timestamp), "text" (verbatim), "attachments" (only when there are any: each one's
#             {"url", "saved"} or {"url", "error"})}. New means after --after's message, else
#             after the bot's latest post in the thread (the last question, so an answer that came
#             before the wait began is still new), else every message in it. Daniel is the
#             top-level allowFrom of the Discord plugin's ~/.claude/channels/discord/access.json;
#             any other author's message is skipped, never printed, and its attachments never
#             fetched. Run it with Bash run_in_background, and pass the last id it printed as
#             --after to the next wait when no question was posted between.
#             It reads the thread every 5 seconds through the REST API (discord_api), 100 messages
#             a read; on a 429 it waits Discord's Retry-After, and on a failed connection or a
#             5xx it waits twice as long each time, up to a minute.
#             An attachment of Daniel's is saved in tasks/T<n>/ui/, where the team home's git
#             ignores it and team-close removes it with the task's captures, and "saved" is its
#             path: a PNG, JPEG, GIF or WebP by its first bytes, of at most 20 MiB, named for
#             Discord's file name with anything but letters, digits, ".", "_" and "-" replaced,
#             its extension from those bytes, and numbered (-2, -3, ... before the extension) when
#             that name is taken, so it never overwrites a file. Anything else keeps its link, with
#             "error" saying why it was not saved: a link off Discord's CDN, a type Discord calls
#             no image or a size Discord gives over the limit (none of these fetched), a file over
#             the limit, first bytes of another kind, a failed download or a ui/ it cannot write
#             in. None of these ends the wait.
#             While the task's walk is on in this thread, it first logs the latest of them as a
#             walk-note, its id and the time, never its words, which keeps the walk counting
#             (walk_holds in bin/lib/ledger.jq); a line that cannot be logged is said on stderr, and
#             the messages still print.
# --interview and wait refuse on a machine that is fenced or that lost the lease (lease_refusal,
# checked before each read), and with no interview channel set; wait ends with the hold's
# message (offline_hold) when the team holds offline. In a worker session only a planner's wait
# on its own task runs (worker_refusal in bin/lib/team.sh); the coordinator opens the threads.
# Needs the bot token in ~/.claude/channels/discord/.env.
# Exit codes: 0 done, 1 refused or Discord refused a read, 2 a malformed command line, 75 the
# team holds offline.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

# A read's interval, the longest backoff and the most one read may take, in seconds.
POLL_SECONDS=5
MAX_BACKOFF=60
READ_TIMEOUT=20
# The largest attachment of Daniel's kept, in bytes (what team-post sends, so one posted is one
# kept), the hosts Discord serves attachments from, and the most one download and its retries may
# take, in seconds.
MAX_IMAGE=$((20 * 1024 * 1024))
CDN_LINK='^https://(cdn\.discordapp\.com|media\.discordapp\.net)/[^[:space:][:cntrl:]]+$'
FETCH_TIMEOUT=60
FETCH_RETRIES_TIMEOUT=120
# Minutes with no message before Discord archives a thread: 3 days (it allows 60, 1440, 4320 or 10080).
ARCHIVE_MINUTES=4320
USAGE="usage: team-thread <task> <project> <title> | team-thread T<n> --interview | team-thread wait T<n> [--after <message id>]"
NO_CHANNEL="no interview channel is set: Daniel makes it (manual-steps.md), and a PR sets its id as INTERVIEW_CHANNEL in bin/lib/team.sh"

# Fail with why this machine must not <does>, if it must not: fenced <does>
fenced() {
  local why
  if why=$(lease_refusal "$1"); then die "$why"; fi
}

# The thread under <channel> named for the task, from the ledger's <kind> event, or a new one
# logged as <kind>: open_thread <task> <kind> <channel> <name>
open_thread() {
  local existing body id
  existing=$(task_events "$1" | jq -r --arg kind "$2" 'select(.event == $kind) | .discord_thread | strings' | tail -n 1)
  if [[ -n $existing ]]; then
    echo "$existing"
    return 0
  fi
  discord_token >/dev/null || die "no DISCORD_BOT_TOKEN in ~/.claude/channels/discord/.env"
  body=$(jq -cn --arg name "$4" --argjson archive "$ARCHIVE_MINUTES" \
    '{name: $name[0:100], type: 11, auto_archive_duration: $archive}')
  id=$(discord_api "channels/$3/threads" -X POST -H "Content-Type: application/json" \
    -d "$body" | jq -r .id 2>/dev/null || true)
  [[ $id =~ ^[0-9]+$ ]] || die "Discord did not return a thread id"
  ledger_append "$(jq -cn --arg task "$1" --arg kind "$2" --arg thread "$id" \
    '{ts: (now | todate), task: $task, event: $kind, discord_thread: $thread}')"
  echo "$id"
}

# Read the messages in <thread> at <query> into $page, as a JSON array oldest first, retrying a
# 429, a failed connection and a 5xx after a wait, and failing on any other refusal; the hold and
# the fence are checked before each try: read_page <thread> <query>
read_page() {
  local backoff=$POLL_SECONDS status retry reply hold
  while true; do
    if hold=$(offline_hold); then
      echo "team-thread: $hold" >&2
      exit 75
    fi
    fenced "$WAITS"
    rm -f "$scratch/headers"
    if reply=$(discord_api "channels/$1/messages?$2" --max-time "$READ_TIMEOUT" -D "$scratch/headers" 2>"$scratch/error") &&
      page=$(jq -ce 'select(type == "array") | sort_by(.id | [length, .])' <<<"$reply" 2>/dev/null); then
      return 0
    fi
    touch "$scratch/headers"
    status=$(sed -nE 's#^HTTP/[0-9.]+ ([0-9]{3}).*#\1#p' "$scratch/headers" | tail -n 1)
    if [[ $status == 429 ]]; then
      retry=$(sed -nE 's/^retry-after:[[:space:]]*([0-9.]+).*/\1/Ip' "$scratch/headers" | tail -n 1)
      sleep "$(jq -n --arg r "${retry:-$POLL_SECONDS}" '$r | tonumber | ceil | [., 1] | max')"
    elif [[ -z $status || $status == 5* || $status == 200 ]]; then
      sleep "$backoff"
      backoff=$((backoff * 2 > MAX_BACKOFF ? MAX_BACKOFF : backoff * 2))
    else
      die "Discord refused reading the interview thread $1: $(grep -m 1 . "$scratch/error" || echo "HTTP $status")"
    fi
  done
}

# Save the attachment <json> describes in $ui under a free name and print its path, or print why
# not and fail. It downloads to a hidden file in $ui, and only a whole, checked file takes its name,
# by a hard link, which fails on a name already taken, a dangling link's included; one killed midway
# leaves only the hidden file, which nothing lists and team-close removes. The CDN takes no token,
# so this is plain curl rather than discord_api, whose token must reach the API alone:
# save_image <json>
save_image() {
  local url stem type incoming bytes kind target n=2 why=''
  url=$(jq -r .url <<<"$1")
  [[ $url =~ $CDN_LINK ]] || { echo "not saved: its link is not on Discord's CDN, so it was not fetched"; return 1; }
  type=$(jq -r '.content_type | strings' <<<"$1")
  if [[ -n $type && $type != image/* ]]; then
    echo "not saved: Discord calls it $type, so it was not fetched"
    return 1
  fi
  if jq -e --argjson max "$MAX_IMAGE" '(.size | numbers) > $max' <<<"$1" >/dev/null; then
    echo "not saved: over the limit of $MAX_IMAGE bytes"
    return 1
  fi
  if ! mkdir -p -- "$ui" 2>/dev/null || ! incoming=$(mktemp "$ui/.incoming.XXXXXX" 2>/dev/null); then
    echo "not saved: cannot write in $ui/"
    return 1
  fi
  if ! curl -fsS -g --max-filesize "$MAX_IMAGE" --max-time "$FETCH_TIMEOUT" --retry 2 \
    --retry-max-time "$FETCH_RETRIES_TIMEOUT" -o "$incoming" "$url" </dev/null 2>"$scratch/error"; then
    why="not saved: $(grep -m 1 . "$scratch/error" || echo "the download failed")"
  else
    bytes=$(wc -c <"$incoming")
    kind=$(image_type "$incoming")
    if ((bytes > MAX_IMAGE)); then
      why="not saved: over the limit of $MAX_IMAGE bytes"
    elif [[ -z $kind ]]; then
      why="not saved: not a PNG, JPEG, GIF or WebP by its first bytes"
    else
      # The last part of Discord's file name, its extension gone, in letters, digits, ".", "_" and "-",
      # with no leading ".", "_" or "-", so it is no path and no hidden file.
      stem=$(jq -r '.filename | strings | sub("^.*[/\\\\]"; "") | sub("\\.[^.]*$"; "")
        | gsub("[^A-Za-z0-9._-]"; "_") | sub("^[._-]+"; "") | .[0:80]' <<<"$1")
      target=${stem:-image}.$kind
      until ln -T -- "$incoming" "$ui/$target" 2>/dev/null; do
        if [[ ! -e $ui/$target && ! -L $ui/$target ]]; then
          why="not saved: cannot write in $ui/"
          break
        fi
        target=${stem:-image}-$n.$kind
        n=$((n + 1))
      done
    fi
  fi
  rm -f -- "$incoming"
  if [[ -n $why ]]; then
    echo "$why"
    return 1
  fi
  echo "$ui/$target"
}

# Print a message of Daniel's read from the thread, each attachment saved or with why it was not:
# print_message <found line>
print_message() {
  local attachment result
  : >"$scratch/outcomes"
  while read -r attachment; do
    if result=$(save_image "$attachment"); then
      jq -c --arg saved "$result" '{url, saved: $saved}' <<<"$attachment"
    else
      jq -c --arg error "$result" '{url, error: $error}' <<<"$attachment"
    fi >>"$scratch/outcomes"
  done < <(jq -c '.attachments // [] | .[]' <<<"$1")
  jq -c --slurpfile outcomes "$scratch/outcomes" 'if .attachments then .attachments = $outcomes else . end' <<<"$1"
}

# What a machine that may not wait does instead, as the lease-fence hook says it.
WAITS="waits on no interview; stop, since the coordinator on the holder takes the task on."

# Log the latest message found as a walk note while the task's walk is on in this thread, read from
# the ledger now, since it may have started or stopped during the wait. Only its id and the time,
# never its words. A failure is said and never costs Daniel's message: log_walk_note <task> <found file>
log_walk_note() {
  local walk id
  walk=$(task_event_array "$1" | ledger_jq 'qc_walk.thread // empty' -r) || walk=''
  [[ $walk == interview ]] || return 0
  id=$(tail -n 1 "$2" | jq -r .id)
  (ledger_append "$(jq -cn --arg task "$1" --arg id "$id" '{ts: (now | todate), task: $task, event: "walk-note", discord_message: $id}')") ||
    echo "${0##*/}: could not log the walk note of message $id, so this message does not keep $1's walk counting" >&2
}

if [[ ${1:-} == wait ]]; then
  shift
  task='' after=''
  while (($#)); do
    case $1 in
      --after) (($# > 1)) && [[ $2 =~ ^[0-9]{1,20}$ ]] || usage_error "$USAGE"; after=$2; shift ;;
      T*) [[ -z $task ]] || usage_error "$USAGE"; task=$1 ;;
      *) usage_error "$USAGE" ;;
    esac
    shift
  done
  [[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "$USAGE"
  if why=$(worker_refusal "$task" "waits on Daniel in Discord" --interview); then die "$why"; fi
  [[ -n $INTERVIEW_CHANNEL ]] || die "$NO_CHANNEL"
  events=$(open_task_events "$task")
  thread=$(jq -r 'map(select(.event == "interview-thread") | .discord_thread | strings) | last // empty' <<<"$events")
  [[ -n $thread ]] || die "$task has no interview thread in the ledger; team-thread $task --interview opens one"
  allow=$(jq -ce '.allowFrom | select(type == "array" and length > 0) | map(tostring)' \
    "$HOME/.claude/channels/discord/access.json" 2>/dev/null) ||
    die "cannot read allowFrom from ~/.claude/channels/discord/access.json, so no message can be known as Daniel's"
  fenced "$WAITS"
  discord_token >/dev/null || die "no DISCORD_BOT_TOKEN in ~/.claude/channels/discord/.env"
  scratch=$(mktemp -d)
  trap 'rm -rf "$scratch"' EXIT
  ui=$TEAM_HOME/tasks/$task/ui

  if [[ -z $after ]]; then
    read_page "$thread" "limit=100"
    after=$(jq -r 'map(select(.author.bot == true)) | last | .id // "0"' <<<"$page")
  fi
  [[ $after =~ ^[0-9]+$ ]] || die "Discord answered a message id that is not a number"
  while true; do
    read_page "$thread" "after=$after&limit=100"
    if [[ $page != '[]' ]]; then
      after=$(jq -r 'last.id' <<<"$page")
      [[ $after =~ ^[0-9]+$ ]] || die "Discord answered a message id that is not a number"
      jq -c --argjson allow "$allow" '.[]
        | select(.author.bot != true and (.author.id | tostring | IN($allow[])))
        | {id, sent: .timestamp, text: (.content // "")}
          + ([.attachments // [] | .[] | select(.url | type == "string") | {url, filename, content_type, size}]
            | if . == [] then {} else {attachments: .} end)' \
        <<<"$page" >>"$scratch/found"
    fi
    # A full page means more may follow at once.
    [[ $(jq length <<<"$page") -lt 100 ]] || continue
    if [[ -s $scratch/found ]]; then
      log_walk_note "$task" "$scratch/found"
      while IFS= read -r message; do print_message "$message"; done <"$scratch/found"
      exit 0
    fi
    sleep "$POLL_SECONDS"
  done
fi

if [[ $# -eq 2 && $2 == --interview ]]; then
  task=$1
  [[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "$USAGE"
  if why=$(worker_refusal "$task" "opens a Discord thread"); then die "$why"; fi
  [[ -n $INTERVIEW_CHANNEL ]] || die "$NO_CHANNEL"
  events=$(open_task_events "$task")
  # Printing the thread already logged calls no one, so only a new one is fenced.
  jq -e 'any(.[]; .event == "interview-thread")' <<<"$events" >/dev/null ||
    fenced "opens no interview thread; the coordinator on the holder does."
  open_thread "$task" interview-thread "$INTERVIEW_CHANNEL" \
    "$(jq -r 'map(select(.event == "opened")) | last | "\(.task) · \(.project) · \(.title)"' <<<"$events")"
  exit 0
fi

[[ $# -eq 3 ]] || usage_error "$USAGE"
task=$1 project=$2 title=$3
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"
if why=$(worker_refusal "$task" "opens a Discord thread"); then die "$why"; fi
open_thread "$task" thread "$COORDINATOR_CHANNEL" "$task · $project · $title"
