#!/usr/bin/env bash
# Say what this machine still lacks to run the team: one PASS, WARN or FAIL line per check, each
# WARN and FAIL with its reason and its fix ("FAIL tool jq: 1.6, below the minimum 1.8.1; fix: ...").
#
# Usage: team-doctor [--json]
#   --json   One array of {check, verdict, reason, fix} instead of the lines; fix is "" on a PASS.
# Logins are asked of claude and gh themselves, and trust by starting a session: no credential
# file or ~/.claude.json is read, nor of ~/.claude/channels/ anything but the Discord plugin's
# access.json, for its allowFrom lists, whose ids no line prints, and the bot token, which only
# the interview channel line uses, through discord_api to Discord alone; no line carries a secret.
# Read-only, but for the trust probes' sessions, which it removes.
# TEAM_OS_RELEASE names the os-release file to read instead of /etc/os-release, TEAM_1PASSWORD_APP
# the 1Password app to look for, TEAM_CHROME the browser, TEAM_MEMINFO the file read in place
# of /proc/meminfo (the tests' seams), and TEAM_DOCTOR_CHECKS, when not empty, the checks to run
# (the tests' seam, and team-bootstrap's machine stage's, which asks for the team home history line
# alone): their file names in bin/lib/doctor.d/ ("040-docker.sh 220-lease.sh"), run in name order
# with every check they read state from, directly or not; a name that is no check file is refused.
# Exit 0 nothing failed, 1 a check failed, 2 usage error.
# The checks, in order, one file each in bin/lib/doctor.d/, sourced in the order of their names
# (three digits by tens, so a new check goes between two without renaming any), each calling the
# doctor's report:

# shellcheck disable=SC2329 # the checks call the doctor's functions
set -euo pipefail
# The doctor reports a missing Homebrew or GNU tool as its homebrew line instead of refusing.
# shellcheck disable=SC2034 # read by bin/lib/platform.sh
platform_report=1
# Nor a team home setting that names no directory: the team home line reports it.
# shellcheck disable=SC2034 # read by bin/lib/team.sh
team_home_report=1
# --help ends with the checks: each file of bin/lib/doctor.d/ begins with its lines of the list.
help_more() {
  local check
  for check in "$(dirname "${BASH_SOURCE[0]}")"/lib/doctor.d/*.sh; do
    sed -n '/^# shellcheck /d; /^# reads state from: /d; /^#/!q; s/^# \{0,1\}/  /p' "$check"
  done
}
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

[[ $# -eq 0 || ($# -eq 1 && $1 == --json) ]] || usage_error "usage: team-doctor [--json]"
json=0
[[ ${1:-} != --json ]] || json=1

# The run's scratch: err, a command's stderr for first_error, and what a check keeps there.
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
err=$scratch/err
: >"$err"
# Each check's check, verdict, reason and fix, in order, for --json.
results=() failed=0

# Record one check: report <check> <verdict> <reason> [<fix>]; the line is printed at once.
report() {
  local line
  results+=("$1" "$2" "$3" "${4:-}")
  [[ $2 != FAIL ]] || failed=1
  if ((json)); then return 0; fi
  line="$2 $1: $3"
  [[ -z ${4:-} ]] || line+="; fix: $4"
  printf '%s\n' "$line"
}

# The first line a command wrote to stderr (in $err), without its "<script>: " prefix.
first_error() {
  local line
  line=$(grep -m1 . "$err" || true)
  printf '%s\n' "${line#team-*: }"
}

# A check's first problem (first_error), with the count its last line gives when it wrote more:
# "<file>:1: not JSON (2 of 2 lines break the ledger contract)".
first_problem() {
  local first last
  first=$(first_error)
  last=$(grep . "$err" | tail -n 1)
  last=${last#team-*: }
  [[ $last == "$first" ]] || first+=" (${last##*: })"
  printf '%s\n' "$first"
}

# <path> with $HOME as ~.
tilde() {
  printf '%s\n' "${1/#"$HOME"/\~}"
}

# team_project <argument>... in registry_reply, its answer kept for the same arguments later in the
# run once it succeeded, since the doctor never changes the registry; a failure is asked again, its
# stderr the caller's: project_registry <argument>...
declare -A registry_kept=()
project_registry() {
  local key="$*"
  if [[ -n ${registry_kept[$key]+set} ]]; then
    registry_reply=${registry_kept[$key]}
    return 0
  fi
  registry_reply=$(team_project "$@") || return
  registry_kept[$key]=$registry_reply
}

# The trust line of <project> (or "team home"), from trust_probe in its root <path> with the probe
# session <name> (team-doctor-trust-<project> by default).
probe_trust() {
  local project=$1 path=$2 name=${3:-team-doctor-trust-$1} shown reason
  shown=$(tilde "$path")
  trust_probe "$path" "$name"
  case $trust_verdict in
    untrusted)
      reason="claude --bg in $shown says Workspace not trusted"
      ((${#trust_left[@]} == 0)) || reason+="; its probe session ${trust_left[*]} is left (claude rm ${trust_left[*]})"
      report "trust $project" FAIL "$reason" "Daniel runs claude once in $shown and accepts the trust dialog"
      ;;
    trusted)
      if ((${#trust_left[@]} == 0)); then
        report "trust $project" PASS "claude starts background sessions in $shown"
      else
        report "trust $project" WARN "claude starts background sessions in $shown, but its probe session ${trust_left[*]} is left" \
          "claude rm ${trust_left[*]}"
      fi
      ;;
    *)
      report "trust $project" FAIL "\`claude --bg\` in $shown printed no session id (exit $trust_rc): $(grep -m1 . <<<"$trust_out" || true)" \
        "the tool claude and claude login lines"
      ;;
  esac
}

# What the checks read: bin/, and what a check leaves for the later ones: the OS (macos, arch, or
# empty when it is neither), the machine's team name, team-secrets check's array and whether it
# answered, the fence's reason (empty unless fenced), whether this machine holds the lease (yes,
# no, or empty when the lease line cannot say), whether its heartbeat is enabled (enabled,
# disabled, or empty when team-timers did not answer), and the tools whose version command
# answered at all, by name.
# shellcheck disable=SC2034
bin=$(dirname "$TEAM_LIB") os='' machine='' secrets='' secrets_read=0 fenced='' holding='' heartbeat=''
# shellcheck disable=SC2034
declare -A installed=()

# The checks to run: every file of doctor.d/, or the ones TEAM_DOCTOR_CHECKS names with those
# they read state from. A check reads only what the doctor sets above and what an earlier check
# leaves (the os check's os, which the docker check reads), and names each such earlier check on a
# "# reads state from:" line of its header, which --help leaves out; with the seam those run too,
# and the ones they name, all in name order.
checks=("$TEAM_LIB"/doctor.d/*.sh)
if [[ -n ${TEAM_DOCTOR_CHECKS:-} ]]; then
  declare -A wanted=()
  read -ra pending <<<"$TEAM_DOCTOR_CHECKS"
  while ((${#pending[@]})); do
    check=${pending[0]} pending=("${pending[@]:1}")
    [[ -z ${wanted[$check]+set} ]] || continue
    [[ $check == *.sh && $check != */* && -f $TEAM_LIB/doctor.d/$check ]] ||
      usage_error "TEAM_DOCTOR_CHECKS names $check, no check file of bin/lib/doctor.d/"
    wanted[$check]=1
    read -ra reads <<<"$(sed -n '/^#/!q; s/^# reads state from: //p' "$TEAM_LIB/doctor.d/$check")"
    pending+=("${reads[@]}")
  done
  for check in "${!checks[@]}"; do
    [[ -n ${wanted[${checks[check]##*/}]+set} ]] || unset 'checks[check]'
  done
fi

# shellcheck source=/dev/null # each check, by name
for check in "${checks[@]}"; do source "$check"; done

if ((json)); then
  printf '%s\0' "${results[@]}" | jq -Rs 'split("\u0000")[:-1] | [range(0; length; 4) as $i | .[$i:$i + 4]
    | {check: .[0], verdict: .[1], reason: .[2], fix: .[3]}]'
fi
exit "$failed"