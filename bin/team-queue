#!/usr/bin/env bash
# Keep the queue of approved work, the team home's tasks/queued/, and its ranked index,
# tasks/queued/index.md, from the files' front matter and the ledger (bin/lib/queue.jq), and say
# what is ready to open and whether the level has room for it.
#
# Usage: team-queue index [--check]
#        team-queue set <table>
#        team-queue take T<n> <file>... [--part]
#        team-queue list [--json] [--plan <file>]
# An item is work Daniel approved: one Markdown file in tasks/queued/ but index.md, its first "# "
# line its title. It opens with front matter, a "---" line, then "<key>: <value>" lines, each key
# at most once, then a "---" line. Required keys:
#   summary   one non-empty line saying what the work is
#   project   a project team-project --list names
#   priority  1 fixes something failing now or Daniel asked for it next; 2 approved work with a
#             clear payoff (the default for Daniel's approvals); 3 follow-ups and polish (the
#             default for a review's notes); 4 someday
#   size      S (one small PR), M (a ticketed task of 2 to 5 tickets) or L (several phases)
# Optional keys:
#   after     conditions joined by ", ", every one of which must hold first: "T<n> merged" (T<n>
#             merged whole: the ledger's lifecycle left in its merged phase, so a merge logged with
#             no phases_left that a builder launch, a PR or a merged part followed is none), "T<n>
#             phase <k> merged" (a merged of T<n> whose phases_left does not hold k, or T<n> merged
#             whole), "T<n> closed", a YYYY-MM-DD date
#             (today's UTC date is that day or later; TEAM_QUEUE_TODAY stands for today), or
#             "<name>.md" (that item left the queue: it is in some tasks/T<m>/queued/, not here)
#   waits     one line naming what outside the ledger and the calendar it waits on; removed by
#             hand when the wait ends
#   from      the tasks it came from, T<n> joined by ", "
#   opened    the one task that builds it, T<n>
#   takes     other queued items it carries, <name>.md joined by ", ", which leave with it
#   alone     yes, for work that runs with the project's other tasks held
#   guarded   the short-list areas (bin/lib/guarded) the work touches, shown and never ranked
# An item's state, the first that holds: unranked (it has a problem, below), finished (opened by a
# task that merged whole or closed), opened (opened by a task still building it), taken (another
# item takes it; it is listed under each taker, never alone), waiting (a waits line, or an after
# condition not met), else ready.
# Ready items rank across every project: by priority (1 first), then by how many queued items'
# after names them (more first), then by size (S, M, L), then by file name; waiting items list in
# the same order, opened and finished ones by task number, unranked ones by name.
# index writes tasks/queued/index.md: "# Queued work", a line saying team-queue index writes it,
# then the sections "## Ready, ranked" ("<rank>. <file> (<project>, priority <p>, <size>):
# <summary>"), "## Waiting" (the same as a "- " line, then "; waits for <the waits line and each
# condition not met, joined by ", ">"), "## Opened" ("- <file> (<project>, <task>): <summary>") and
# "## Unranked" ("- <file>: <its problems, joined by "; ">"), a section with no item left out,
# ", guarded: <text>" and ", alone" after the size when given, and under each item a
# "   - takes <file>: <summary>" line for each queued item it takes; an item with no summary shows
# its title. It writes through a temporary file, under the ledger's lock, and commits the index
# alone (commit_records), as "chore: queued index", then pushes the team home's branch; an index
# already as written commits nothing. It prints "wrote tasks/queued/index.md: <n> files" ("1 file").
# --check writes nothing, and prints each problem as "tasks/queued/<file>: <reason>", exiting 1
# when it prints any: a front matter with no closing "---", a key given twice, a line that is no
# "<key>: <value>", a key it does not read, task: (now from:), no summary (or no summary and no
# title), an empty summary or waits, a required key missing or a value not as above (a project
# not in projects.toml), an after, from or opened naming a task the ledger does not hold, an after
# naming a file neither queued nor in a task's queued/, a takes naming a file not queued, itself,
# an item that takes others or one a task opened, an item whose task merged or closed over 15
# minutes ago that is still queued (the heartbeat should have moved it), and an item two open
# tasks' plans cite that either could take (its project one of the task's, its from not naming
# the task, not opened and not taken); then "tasks/queued/: projects not checked: <why>" first
# when the registry cannot be read, and last "tasks/queued/index.md: not as team-queue index
# writes it" when the index is stale.
# set writes many files' front matter from one table, a tab-separated file whose header's first
# column is file and whose others are front matter keys, each once; each line after it but a blank
# one is a row, a cell per column, naming a queued file. A row sets each column's key on its file
# to its cell, trimmed, or removes the key for an empty cell, keeps the file's other keys and its
# body, drops task:, and writes the keys in the order above, then the file's others. It judges the
# whole table first and writes nothing on any refusal, printing each as "<table>:<line>: <reason>"
# and exiting 1: a header not as above, a row of more or fewer cells, a file not queued or on two
# rows, a file whose front matter it cannot rewrite without losing a line (no closing "---", a key
# twice, a line that is no "<key>: <value>"), and a row whose result --check refuses for a key the
# table has a column for, as "<table>:<line>: tasks/queued/<file>: <problem>". Else it writes every
# row's file and the index, through temporary files, under the ledger's lock, as one commit of
# those files alone, "chore: queued set", and prints "set <n> files" ("1 file") and the index's
# line, then each line --check still names (a file the table leaves alone, a key it has no column
# for, a finished item, an item two plans cite), exiting 1 when it prints any.
# take links queued items to the task that builds them: it writes opened: T<n> into each file
# given, or with --part, for a task that builds only part of an item, adds T<n> to its from: once.
# It judges every file first and writes nothing on any refusal, printing each and exiting 1: a
# task with no opened in the ledger or with a closed ("T<n> has no opened in the ledger", "T<n>
# closed at <ts>"), a file not queued ("<file> is not queued"), and as "tasks/queued/<file>:
# <reason>" a file whose front matter it cannot rewrite without losing a line (as set), an item
# whose project is none of the task's (its opened's and worktree-added's projects), and, but with
# --part, an item another task opened or another item takes. Else it writes each file, its keys in
# the order above, and the index, through temporary files, under the ledger's lock, as one commit
# of those files alone, "chore: queued take T<n>", and prints "took <file> for T<n>" (with --part
# "T<n> builds part of <file>") for each; taking an item the task already opened again changes
# nothing. team-open --queued runs it once the task is open.
# list writes nothing. It says whether the level has room for one more task, read from
# team-capacity plan --json (the file --plan names when the caller already holds one, as the
# sweep does, which may be {error: <why>}, else its own run) and team-capacity costs --json: it
# fits when the level is not none, the plan has a budget and is not over it, its resume and launch
# lists are empty (stowed and refused work comes first), the budget less what is reserved is at
# least the session:builder estimate (every task soon launches a builder, the largest worker a
# task starts), and no open task has an opened with no launch after it (a task just opened gets
# its first worker before the next is named). Its line, the first that holds: "no room: the plan
# cannot be read: <why>" (team-capacity's last line on stderr, ~ for the home directory, "no plan
# at <file>", or "<file> is no team-capacity-plan/1 object"), "no room: the level is none", "no
# room: no reading of the machine's load, so no budget", "no room: over budget", "no room: T171
# waits to resume", "no room: T5 waits to launch", "no room: the costs cannot be read: <why>",
# "no room: the costs give no builder's estimate", "no room: 0.9 GiB free at minor (30%), a
# builder needs 1.7 GiB", "no room: T312, opened at 14:05, has no worker yet" (the first by task
# number; "at 2026-11-12 14:05" when not opened today, UTC), else "room for one more task at full
# (90%): 11.7 GiB of 16.9 GiB free, a builder needs 1.7 GiB". The text is that line, then the
# index's sections as index writes them. --json prints one line, {schema: "team-queue/1", room:
# {fits, says}, ready, waiting, opened (each [item], in the index's order), unranked: [{file,
# problems}], problems: [{file (null for the registry's), problem}] (every line --check names but
# the stale index's), findings}, an item being {file, title, summary, project, priority, size,
# after: [{condition, met}], waits, from, opened, takes, alone, guarded, unblocks (how many queued
# items' after names it), rank (null but for a ready one)}. findings are team-sweep's, each {task:
# null, kind, session: null, name: null, next, text}: queue-ready while the room fits and an item
# is ready, "queue: <the room's line>: open <file> (<project>, priority <p>, <size>): <summary,
# cut to 80 characters, the last three dots>; next: team-open --queued <file>", for an item that
# runs alone "...; it runs alone: hold <project>'s other open tasks (T<a>, T<b>) first; next: ..."
# while any is open; and queue while there are problems, "queue: <n> problem(s) in tasks/queued/:
# <the first two, as --check prints them, joined by "; ">; next: fix each file team-queue index
# --check names". A plan or costs that cannot be read is no room, never a failure: list exits 0.
# A push that fails keeps the commit for the next checkpoint to push, saying so on stderr, and
# exits 0; a commit that fails (the team home's hooks refuse it) leaves the change written for the
# next checkpoint to commit, saying so on stderr, and exits 1.
# It refuses in a worker session (worker_refusal in bin/lib/team.sh), list too, which only the
# coordinator, the sweep and the snapshot read.
# Exit codes: 0 done, 1 refused or a check failed, 2 a malformed command line (or a
# TEAM_QUEUE_TODAY that is no YYYY-MM-DD).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-queue index [--check] | set <table> | take T<n> <file>... [--part] | list [--json] [--plan <file>]"
queued=$TEAM_HOME/tasks/queued
index_rel=tasks/queued/index.md
index=$TEAM_HOME/$index_rel

# Every queued file's card, one JSON object a line in name order, {file, title, keys, problems}:
# its first "# " line, its front matter's "<key>: <value>" lines (a key twice kept once) and the
# problems of its form (no closing "---", a key twice, a line that is no "<key>: <value>"), every
# control character escaped, so a carriage return of a CRLF file never makes jq reject it, in one
# awk pass over all the files: cards
cards() {
  local -a paths=()
  local name
  while IFS= read -r name; do paths+=("$queued/$name"); done < <(files)
  ((${#paths[@]})) || return 0
  awk '
    BEGIN { for (i = 1; i < 32; i++) ctl[sprintf("%c", i)] = sprintf("\\u%04x", i) }
    function esc(s,  out, c, i) {
      out = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\\" || c == "\"") out = out "\\" c
        else if (c in ctl) out = out ctl[c]
        else out = out c
      }
      return out
    }
    function add(p) { problems = problems (problems == "" ? "" : ",") "\"" esc(p) "\"" }
    function flush(  name) {
      if (file == "") return
      if (in_front) add("front matter has no closing ---")
      name = file
      sub(/.*\//, "", name)
      card[file] = "{\"file\":\"" esc(name) "\",\"title\":\"" esc(title) "\",\"keys\":{" keys "},\"problems\":[" problems "]}"
    }
    FNR == 1 { flush(); file = FILENAME; in_front = 0; title = ""; keys = ""; problems = ""; split("", seen) }
    FNR == 1 && $0 == "---" { in_front = 1; next }
    in_front && $0 == "---" { in_front = 0; next }
    in_front {
      if (match($0, /^[a-z_]+:/)) {
        key = substr($0, 1, RLENGTH - 1)
        value = substr($0, RLENGTH + 1)
        sub(/^ +/, "", value)
        if (key in seen) add(key " given twice")
        else { seen[key] = 1; keys = keys (keys == "" ? "" : ",") "\"" key "\":\"" esc(value) "\"" }
      } else add("front matter line \"" $0 "\" is no <key>: <value>")
      next
    }
    title == "" && /^# / { title = substr($0, 3) }
    END {
      flush()
      for (i = 1; i < ARGC; i++) {
        if (ARGV[i] in card) { print card[ARGV[i]]; continue }
        name = ARGV[i]
        sub(/.*\//, "", name)
        print "{\"file\":\"" esc(name) "\",\"title\":\"\",\"keys\":{},\"problems\":[]}"
      }
    }' "${paths[@]}" </dev/null
}

# The queued files but the index, by name, one name a line: files
files() {
  find "$queued" -mindepth 1 -maxdepth 1 -type f -name '*.md' ! -name index.md -printf '%f\n' 2>/dev/null | LC_ALL=C sort
}

# Run one queue.jq program over every item, the ledger and what the items need: the registry's
# project names, the files that left the queue (tasks/T<n>/queued/<file>), the queued files each
# task's plan cites, today and now; the program sees $items (queue_items'), queue_items_of(<cards>)
# (queue_items over other cards), $cards, $registry_error and $current (the index as it is, ""
# when missing). jq's options come first: queue_jq <option>... <program>
queue_jq() {
  local names registry_error='' program=${*: -1}
  local -a plans opts=("${@:1:$#-1}")
  if ! names=$(team_project --list 2>&1); then
    registry_error=${names##*$'\n'} registry_error=${registry_error#team-project: } names=''
  fi
  shopt -s nullglob
  plans=("$TEAM_HOME"/tasks/T*/plan.md)
  shopt -u nullglob
  jq -nR -L "$TEAM_LIB" "${opts[@]}" \
    --slurpfile cards <(cards) \
    --arg names "$names" --arg registry_error "$registry_error" \
    --rawfile left <(find "$TEAM_HOME/tasks" -mindepth 3 -maxdepth 3 -type f -path "$TEAM_HOME/tasks/T*/queued/*.md" 2>/dev/null) \
    --rawfile cites <( ((${#plans[@]} == 0)) || grep -oHE 'tasks/queued/[A-Za-z0-9][A-Za-z0-9._-]*\.md' -- "${plans[@]}" || true) \
    --rawfile current <(cat "$index" 2>/dev/null || true) \
    --arg today "$today" \
    'include "queue"; include "ledger";
    (if $registry_error == "" then $names | split("\n") | map(select(. != "")) else null end) as $projects
    | [$left | split("\n")[] | capture("/(?<task>T[1-9][0-9]*)/queued/(?<file>[^/]+)$")] as $left
    | [$cites | split("\n")[] | capture("/(?<task>T[1-9][0-9]*)/plan\\.md:tasks/queued/(?<file>[^/]+)$")] as $cites
    | ledger_events as $events
    | def queue_items_of($c): queue_items($c; $events; $projects; $left; $cites; $today; now);
    queue_items_of($cards) as $items
    | '"$program" "$TEAM_HOME/ledger.jsonl"
}

# The index as team-queue index writes it, on stdout: index_text
index_text() {
  queue_jq -j '$items | queue_view | queue_index_text'
}

# Write the index, under the lock commit_records holds: edit_index
edit_index() {
  mkdir -p "$queued"
  if ! { index_text >"$index.$$" && mv -f "$index.$$" "$index"; }; then
    rm -f "$index.$$"
    die "cannot write $index"
  fi
}

# How many files the index lists, as "<n> files": counted
counted() {
  local n
  n=$(files | grep -c . || true)
  if ((n == 1)); then echo "1 file"; else echo "$n files"; fi
}

# The front matter and body a file is given, into a temporary file beside it, <file>.<pid>: the
# body is the file less its front matter (a first line "---" to the next): give <file> <front>
give() {
  {
    printf '%s' "$2"
    awk 'NR == 1 && $0 == "---" { skip = 1; next } skip && $0 == "---" { skip = 0; next } !skip' "$1"
  } >"$1.$$"
}

# Write the table's rows into their files and the index, under the lock commit_records holds, or
# print the table's refusals on the descriptor $stdout names (commit_records' stdout is not the
# command's) and exit 1, writing nothing; sets set_count: edit_set
edit_set() {
  local -a out temps=() targets=()
  local i
  queue_jq -j --rawfile table "$table" --arg name "$table" \
    'queue_set($table; $name; $cards; queue_items_of(.))
    | if .refusals != [] then "refuse\u0000", (.refusals[] | "\(.)\u0000")
      else "write\u0000", (.writes[] | "\(.file)\u0000\(.front)\u0000") end' >"$plan" ||
    die "cannot judge $table"
  mapfile -d '' -t out <"$plan"
  if [[ ${out[0]:-} != write ]]; then
    printf '%s\n' "${out[@]:1}" >&"$stdout"
    die "the table is refused whole, so nothing is written"
  fi
  for ((i = 1; i < ${#out[@]}; i += 2)); do
    targets+=("$queued/${out[i]}")
    temps+=("$queued/${out[i]}.$$")
    give "${targets[-1]}" "${out[i + 1]}" || { rm -f "${temps[@]}"; die "cannot write ${targets[-1]}"; }
  done
  for i in "${!temps[@]}"; do
    mv -f "${temps[i]}" "${targets[i]}" || { rm -f "${temps[@]}"; die "cannot write ${targets[i]}"; }
  done
  set_count=${#temps[@]}
  edit_index
}

# Write opened: T<n> (or with --part T<n> in from:) into each file take names, and the index,
# under the lock commit_records holds, or print take's refusals on the descriptor $stdout names and
# exit 1, writing nothing: edit_take
edit_take() {
  local -a out temps=() targets=()
  local i
  queue_jq -j --arg task "$take_task" --argjson files "$(printf '%s\n' "${take_files[@]}" | jq -Rnc '[inputs]')" \
    --argjson part "$part" \
    'queue_take($task; $files; $part; $cards; $events; $items)
    | if .refusals != [] then "refuse\u0000", (.refusals[] | "\(.)\u0000")
      else "write\u0000", (.writes[] | "\(.file)\u0000\(.front)\u0000") end' >"$plan" ||
    die "cannot judge the take"
  mapfile -d '' -t out <"$plan"
  if [[ ${out[0]:-} != write ]]; then
    printf '%s\n' "${out[@]:1}" >&"$stdout"
    die "nothing is taken"
  fi
  for ((i = 1; i < ${#out[@]}; i += 2)); do
    targets+=("$queued/${out[i]}")
    temps+=("$queued/${out[i]}.$$")
    give "${targets[-1]}" "${out[i + 1]}" || { rm -f "${temps[@]}"; die "cannot write ${targets[-1]}"; }
  done
  for i in "${!temps[@]}"; do
    mv -f "${temps[i]}" "${targets[i]}" || { rm -f "${temps[@]}"; die "cannot write ${targets[i]}"; }
  done
  edit_index
}

# team-capacity <sub> --json's object into <out>, or {error} with the last line it said on stderr
# (~ for the home directory) when it fails: capacity_json <sub> <out>
capacity_json() {
  local line
  if TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-capacity" "$1" --json >"$2" 2>"$2.err" </dev/null; then return 0; fi
  line=$(grep . "$2.err" | tail -n 1) || line="team-capacity $1 failed with no reason given"
  jq -cn --arg error "${line//"$HOME/"/"~/"}" '{error: $error}' >"$2"
}

# Commit <path>... as <message> through commit_records, which runs records_edit first: a push that
# failed (commit_records said why) is no failure here, a commit that failed is: commit <message> <path>...
commit() {
  local rc=0
  commit_records "$@" >/dev/null || rc=$?
  ((rc)) || return 0
  [[ -n $(git -C "$TEAM_HOME" status --porcelain -- "${@:2}") ]] || return 0
  die "the change is written but not committed; the next checkpoint commits it"
}

why=$(worker_refusal "" "$(if [[ ${1:-} == list ]]; then echo "reads no queue"; else echo "edits no records"; fi)") && die "$why"
(($#)) || usage_error "$usage"
today=${TEAM_QUEUE_TODAY:-$(date -u +%F)}
[[ $today =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || usage_error "TEAM_QUEUE_TODAY \"$today\" is not a YYYY-MM-DD date"
command=$1
shift
case $command in
  index)
    check=''
    case $#:${1:-} in
      0:) ;;
      1:--check) check=1 ;;
      *) usage_error "$usage" ;;
    esac
    if [[ -n $check ]]; then
      # The index is compared whole inside jq, never piped to cmp, which on macOS stops reading at
      # the first difference.
      problems=$(queue_jq -r '($items | queue_problem_lines($registry_error)),
        (select($current != ($items | queue_view | queue_index_text)) | "'"$index_rel"': not as team-queue index writes it")') ||
        exit 1
      [[ -n $problems ]] || exit 0
      printf '%s\n' "$problems"
      exit 1
    fi
    NET_ERR=$(mktemp)
    trap 'rm -f "$NET_ERR"' EXIT
    # shellcheck disable=SC2034 # read by commit_records
    records_edit=edit_index
    commit "chore: queued index" "$index_rel"
    echo "wrote $index_rel: $(counted)"
    ;;
  set)
    (($# == 1)) || usage_error "$usage"
    table=$1
    [[ -f $table && -r $table ]] || die "no table at $table"
    NET_ERR=$(mktemp)
    plan=$(mktemp)
    trap 'rm -f "$NET_ERR" "$plan"' EXIT
    # The paths to commit are the rows' files, read as queue_set reads the first column; a row
    # that names no queued file refuses the table before anything is committed.
    paths=("$index_rel")
    while IFS= read -r line; do
      line=${line%$'\r'} line=${line%%$'\t'*}
      line=${line#"${line%%[! ]*}"} line=${line%"${line##*[! ]}"}
      [[ -z $line ]] || paths+=("tasks/queued/$line")
    done < <(tail -n +2 -- "$table")
    set_count=0
    exec {stdout}>&1
    # shellcheck disable=SC2034 # read by commit_records
    records_edit=edit_set
    commit "chore: queued set" "${paths[@]}"
    echo "set $set_count file$( ((set_count == 1)) || echo s)"
    echo "wrote $index_rel: $(counted)"
    problems=$(queue_jq -r '$items | queue_problem_lines($registry_error)') || exit 1
    [[ -n $problems ]] || exit 0
    printf '%s\n' "$problems"
    exit 1
    ;;
  take)
    (($# >= 2)) || usage_error "$usage"
    take_task=$1 part=false
    shift
    [[ $take_task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$take_task'"
    take_files=()
    for arg; do
      if [[ $arg == --part ]]; then
        [[ $part == false ]] || usage_error "$usage"
        part=true
      elif [[ $arg == -* ]]; then
        usage_error "$usage"
      else
        take_files+=("$arg")
      fi
    done
    ((${#take_files[@]})) || usage_error "$usage"
    NET_ERR=$(mktemp)
    plan=$(mktemp)
    trap 'rm -f "$NET_ERR" "$plan"' EXIT
    # Only a name that may be queued is a path to commit; any other is refused before the commit.
    paths=("$index_rel")
    for name in "${take_files[@]}"; do
      [[ ! $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.md$ ]] || paths+=("tasks/queued/$name")
    done
    exec {stdout}>&1
    # shellcheck disable=SC2034 # read by commit_records
    records_edit=edit_take
    commit "chore: queued take $take_task" "${paths[@]}"
    mapfile -t take_files < <(printf '%s\n' "${take_files[@]}" | awk '!seen[$0]++')
    for name in "${take_files[@]}"; do
      if [[ $part == true ]]; then echo "$take_task builds part of $name"; else echo "took $name for $take_task"; fi
    done
    ;;
  list)
    json=false plan_file='' plan_given=''
    while (($#)); do
      case $1 in
        --json) [[ $json == false ]] || usage_error "$usage"; json=true; shift ;;
        --plan) [[ -z $plan_given && $# -ge 2 ]] || usage_error "$usage"; plan_given=1 plan_file=$2; shift 2 ;;
        *) usage_error "$usage" ;;
      esac
    done
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    capacity_json costs "$work/costs" &
    costs_pid=$!
    if [[ -z $plan_given ]]; then
      capacity_json plan "$work/plan" &
      plan_pid=$!
      plan_name="team-capacity plan --json's output"
      wait "$plan_pid" || true
    elif [[ -f $plan_file && -r $plan_file ]]; then
      cp -- "$plan_file" "$work/plan"
      plan_name=$plan_file
    else
      jq -cn --arg error "no plan at $plan_file" '{error: $error}' >"$work/plan"
      plan_name=$plan_file
    fi
    wait "$costs_pid" || true
    queue_jq -j --rawfile plan "$work/plan" --rawfile costs "$work/costs" --arg plan_name "$plan_name" --argjson json "$json" \
      '($plan | queue_capacity($plan_name; "team-capacity-plan/1")) as $plan
      | ($costs | queue_capacity("team-capacity costs --json'"'"'s output"; "team-capacity-costs/1")) as $costs
      | $items | queue_list($plan; $costs; $events; $registry_error; $today)
      | if $json then tojson + "\n" else queue_list_text($items | queue_view) end'
    ;;
  *) usage_error "$usage" ;;
esac
