{
  "enabledPlugins": {
    "discord@claude-plugins-official": true,
    "mongodb-atlas@claude-plugins-official": false
  },
  "crossSessionInbound": "accept",
  "isolatePeerMachines": true,
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh-axi pr merge*)",
      "Bash(gh api*pulls/*/merge*)",
      "Bash(sudo)",
      "Bash(sudo *)",
      "Bash(*team-lease*--steal*)",
      "Bash(git push * lease)",
      "Bash(git push * lease *)",
      "Bash(git push *:lease)",
      "Bash(git push *:lease *)",
      "Bash(git push *refs/heads/lease*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"@TEAM_HOME@/bin/hooks/session-digest\"", "timeout": 120 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"@TEAM_HOME@/bin/hooks/stop-sweep\"" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_discord_discord__reply|mcp__plugin_discord_discord__react|mcp__plugin_discord_discord__edit_message",
        "hooks": [{ "type": "command", "command": "\"@TEAM_HOME@/bin/hooks/lease-fence\"" }]
      }
    ]
  }
}
