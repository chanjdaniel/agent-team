{
  "enabledPlugins": {
    "discord@claude-plugins-official": true,
    "mongodb-atlas@claude-plugins-official": false
  },
  "crossSessionInbound": "accept",
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh-axi pr merge*)",
      "Bash(gh api*pulls/*/merge*)",
      "Bash(op *)",
      "Bash(* op *)",
      "Bash(*op read*)",
      "Bash(*op run*)",
      "Bash(*op item*)",
      "Bash(*op document*)",
      "Bash(*/proc/*/environ*)",
      "Read(//proc/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"@TEAM_HOME@/bin/hooks/session-digest\"", "timeout": 120 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"@TEAM_HOME@/bin/hooks/stop-sweep\"" }]
      }
    ]
  }
}
