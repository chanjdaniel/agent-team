{
  "enabledPlugins": {
    "discord@claude-plugins-official": true,
    "mongodb-atlas@claude-plugins-official": false,
    "cc-plugin-plugin-authoring@builtin": false
  },
  "syncClaudeAiPlugins": false,
  "crossSessionInbound": "accept",
  "isolatePeerMachines": true,
  "idleCompaction": true,
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "NotebookEdit",
      "SendFeedback",
      "Bash(gh pr merge*)",
      "Bash(gh-axi pr merge*)",
      "Bash(gh api*pulls/*/merge*)",
      "Bash(op)",
      "Bash(op *)",
      "Bash(*&& op *)",
      "Bash(*|| op *)",
      "Bash(*| op *)",
      "Bash(*$(op *)",
      "Bash(*/bin/op *)",
      "Bash(env op *)",
      "Bash(command op *)",
      "Bash(exec op *)",
      "Bash(*node *start-server.mjs*)",
      "Bash(./*start-server.mjs*)",
      "Bash(/*start-server.mjs*)",
      "Bash(toolkits/*start-server.mjs*)",
      "Bash(*node *mongodb-mcp*)",
      "Bash(./*mongodb-mcp*)",
      "Bash(/*mongodb-mcp*)",
      "Bash(servers/*mongodb-mcp*)",
      "Bash(*npx *mongodb-mcp*)",
      "Bash(*npm exec *mongodb-mcp*)",
      "Bash(*node_modules/.bin/mongodb-mcp*)",
      "Bash(scripts/*start-server.mjs*)",
      "Bash(*&& scripts/*start-server.mjs*)",
      "Bash(*; scripts/*start-server.mjs*)",
      "Bash(env *start-server.mjs*)",
      "Bash(bun *start-server.mjs*)",
      "Bash(deno *start-server.mjs*)",
      "Bash(env *mongodb-mcp*)",
      "Bash(bun *mongodb-mcp*)",
      "Bash(deno *mongodb-mcp*)",
      "Bash(*--plugin-dir*prod-*)",
      "Bash(*--mcp-config*prod-*)",
      "Bash(*/proc/*/environ)",
      "Bash(*/proc/*/environ |*)",
      "Bash(*/proc/*/environ|*)",
      "Bash(*/proc/*/environ >*)",
      "Bash(*/proc/*/environ>*)",
      "Bash(*/proc/*/environ 2>*)",
      "Bash(*/proc/*/environ &&*)",
      "Bash(*/proc/*/environ ||*)",
      "Bash(*/proc/*/environ))",
      "Bash(*/proc/*/environ')*)",
      "Bash(*/proc/*/environ\")*)",
      "Read(//proc/**)",
      "Bash(sudo)",
      "Bash(sudo *)",
      "Bash(*team-lease*--steal*)",
      "Bash(*team-resume*--steal*)",
      "Bash(git push * lease)",
      "Bash(git push * lease *)",
      "Bash(git push *:lease)",
      "Bash(git push *:lease *)",
      "Bash(git push *refs/heads/lease*)",
      "Bash(git * --no-verify)",
      "Bash(git * --no-verify *)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n -*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config \"core.hooksPath\" *)",
      "Bash(git config 'core.hooksPath' *)",
      "Bash(git config --global core.hooksPath *)",
      "Bash(git config --local core.hooksPath *)",
      "Bash(git config --system core.hooksPath *)",
      "Bash(git config --worktree core.hooksPath *)",
      "Bash(git config set *core.hooksPath*)",
      "Bash(git config --add *core.hooksPath*)",
      "Bash(git config *--unset*core.hooksPath*)",
      "Bash(git config unset *core.hooksPath*)",
      "Bash(git -C * config core.hooksPath *)",
      "Bash(git -C * config \"core.hooksPath\" *)",
      "Bash(git -C * config 'core.hooksPath' *)",
      "Bash(git -C * config --global core.hooksPath *)",
      "Bash(git -C * config --local core.hooksPath *)",
      "Bash(git -C * config --system core.hooksPath *)",
      "Bash(git -C * config --worktree core.hooksPath *)",
      "Bash(git -C * config set *core.hooksPath*)",
      "Bash(git -C * config --add *core.hooksPath*)",
      "Bash(git -C * config *--unset*core.hooksPath*)",
      "Bash(git -C * config unset *core.hooksPath*)",
      "Bash(git config core.hookspath *)",
      "Bash(git config \"core.hookspath\" *)",
      "Bash(git config 'core.hookspath' *)",
      "Bash(git config --global core.hookspath *)",
      "Bash(git config --local core.hookspath *)",
      "Bash(git config --system core.hookspath *)",
      "Bash(git config --worktree core.hookspath *)",
      "Bash(git config set *core.hookspath*)",
      "Bash(git config --add *core.hookspath*)",
      "Bash(git config *--unset*core.hookspath*)",
      "Bash(git config unset *core.hookspath*)",
      "Bash(git -C * config core.hookspath *)",
      "Bash(git -C * config \"core.hookspath\" *)",
      "Bash(git -C * config 'core.hookspath' *)",
      "Bash(git -C * config --global core.hookspath *)",
      "Bash(git -C * config --local core.hookspath *)",
      "Bash(git -C * config --system core.hookspath *)",
      "Bash(git -C * config --worktree core.hookspath *)",
      "Bash(git -C * config set *core.hookspath*)",
      "Bash(git -C * config --add *core.hookspath*)",
      "Bash(git -C * config *--unset*core.hookspath*)",
      "Bash(git -C * config unset *core.hookspath*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git -C * -c core.hooksPath*)",
      "Bash(git -c core.hookspath*)",
      "Bash(git -C * -c core.hookspath*)"
    ]
  },
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "code-review": "name-only",
    "codebase-design": "name-only",
    "diagnosing-bugs": "name-only",
    "domain-modeling": "name-only",
    "fewer-permission-prompts": "off",
    "git-guardrails-claude-code": "off",
    "implement": "off",
    "init": "off",
    "keybindings-help": "off",
    "migrate-to-shoehorn": "off",
    "no-mistakes": "name-only",
    "prototype": "name-only",
    "resolving-merge-conflicts": "name-only",
    "run": "name-only",
    "scaffold-exercises": "off",
    "security-review": "name-only",
    "setup-pre-commit": "off",
    "simplify": "off",
    "tdd": "off"
  },
  "env": {
    "AGENT_TEAM_ROLE": "coordinator",
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "100000",
    "LAVISH_AXI_TELEMETRY": "0",
    "CODEGRAPH_TELEMETRY": "0",
    "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
    "CHROME_DEVTOOLS_AXI_MCP_PATH": "@TEAM_CODE@/servers/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"@TEAM_CODE@/bin/hooks/session-digest\"", "timeout": 120 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"@TEAM_CODE@/bin/hooks/stop-sweep\"" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_discord_discord__reply|mcp__plugin_discord_discord__react|mcp__plugin_discord_discord__edit_message",
        "hooks": [{ "type": "command", "command": "\"@TEAM_CODE@/bin/hooks/lease-fence\"" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"@TEAM_CODE@/bin/hooks/lease-fence\" --coordinator" }]
      }
    ]
  }
}
