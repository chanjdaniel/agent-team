{
  "enabledPlugins": {
    "discord@claude-plugins-official": true,
    "mongodb-atlas@claude-plugins-official": false
  },
  "crossSessionInbound": "accept",
  "permissions": {
    "deny": ["Bash(gh pr merge*)", "Bash(gh-axi pr merge*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"$HOME/agent-team/bin/hooks/session-digest\"", "timeout": 120 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$HOME/agent-team/bin/hooks/stop-sweep\"" }]
      }
    ]
  }
}
