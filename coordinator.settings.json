{
  "enabledPlugins": {
    "discord@claude-plugins-official": true,
    "mongodb-atlas@claude-plugins-official": false
  },
  "crossSessionInbound": "accept",
  "isolatePeerMachines": true,
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh-axi pr merge*)",
      "Bash(gh api*pulls/*/merge*)",
      "Bash(op *)",
      "Bash(* op *)",
      "Bash(*op read*)",
      "Bash(*op run*)",
      "Bash(*op item*)",
      "Bash(*op document*)",
      "Bash(*node *start-server.mjs*)",
      "Bash(./*start-server.mjs*)",
      "Bash(/*start-server.mjs*)",
      "Bash(toolkits/*start-server.mjs*)",
      "Bash(*node *mongodb-mcp*)",
      "Bash(./*mongodb-mcp*)",
      "Bash(/*mongodb-mcp*)",
      "Bash(servers/*mongodb-mcp*)",
      "Bash(*npx *mongodb-mcp*)",
      "Bash(*npm exec *mongodb-mcp*)",
      "Bash(*node_modules/.bin/mongodb-mcp*)",
      "Bash(scripts/*start-server.mjs*)",
      "Bash(*&& scripts/*start-server.mjs*)",
      "Bash(*; scripts/*start-server.mjs*)",
      "Bash(env *start-server.mjs*)",
      "Bash(bun *start-server.mjs*)",
      "Bash(deno *start-server.mjs*)",
      "Bash(env *mongodb-mcp*)",
      "Bash(bun *mongodb-mcp*)",
      "Bash(deno *mongodb-mcp*)",
      "Bash(*--plugin-dir*prod-*)",
      "Bash(*--mcp-config*prod-*)",
      "Bash(*/proc/*/environ*)",
      "Read(//proc/**)",
      "Bash(sudo)",
      "Bash(sudo *)",
      "Bash(*team-lease*--steal*)",
      "Bash(*team-resume*--steal*)",
      "Bash(git push * lease)",
      "Bash(git push * lease *)",
      "Bash(git push *:lease)",
      "Bash(git push *:lease *)",
      "Bash(git push *refs/heads/lease*)",
      "Bash(git * --no-verify)",
      "Bash(git * --no-verify *)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n -*)",
      "Bash(git *config* core.hooksPath *)",
      "Bash(git *config* core.hookspath *)",
      "Bash(git *config*unset* core.hooksPath*)",
      "Bash(git *config*unset* core.hookspath*)",
      "Bash(git *config* \"core.hooksPath\" *)",
      "Bash(git *config* \"core.hookspath\" *)",
      "Bash(git *config* 'core.hooksPath' *)",
      "Bash(git *config* 'core.hookspath' *)",
      "Bash(git *config*unset* \"core.hooksPath\"*)",
      "Bash(git *config*unset* \"core.hookspath\"*)",
      "Bash(git *config*unset* 'core.hooksPath'*)",
      "Bash(git *config*unset* 'core.hookspath'*)",
      "Bash(git *-c core.hooksPath*)",
      "Bash(git *-c core.hookspath*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"@TEAM_CODE@/bin/hooks/session-digest\"", "timeout": 120 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"@TEAM_CODE@/bin/hooks/stop-sweep\"" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_discord_discord__reply|mcp__plugin_discord_discord__react|mcp__plugin_discord_discord__edit_message",
        "hooks": [{ "type": "command", "command": "\"@TEAM_CODE@/bin/hooks/lease-fence\"" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"@TEAM_CODE@/bin/hooks/lease-fence\" --coordinator" }]
      }
    ]
  }
}
