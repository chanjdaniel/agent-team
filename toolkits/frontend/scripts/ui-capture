#!/usr/bin/env node
// Capture the element selected in the Agent Chrome's DevTools Elements panel into a directory, for
// an agent to fix: its page, HTML, matched CSS, Vue source location and two screenshots; or, when
// nothing is selected, a capture of the localhost page Daniel is on.
//
// Usage: ui-capture [--browser-url <url>] <out-dir>
//   --browser-url  The Agent Chrome's remote debugging address (default http://127.0.0.1:9222,
//                  where scripts/agent-chrome starts it).
// The page it takes, the first that applies:
//   1. the localhost page whose DevTools Elements panel has an element selected: an element
//      capture of it;
//   2. else a localhost page with DevTools open and nothing selected (DevTools' default <body>,
//      or <html>), among several the first in step 3's order: a page capture of it, "DevTools is
//      open on it, nothing selected";
//   3. else the visible localhost tab (the front tab of a window that is not minimised), among
//      several (several windows) the one whose document has focus, else the most recently
//      active: a page capture of it, "the visible localhost tab";
//   4. else, when no localhost tab is visible (its window shows another page, or is minimised),
//      the most recently active localhost tab: a page capture of it, "the most recently active
//      localhost tab; none is visible".
// Recency is the order of the Agent Chrome's /json/list, most recently active first. Visibility
// and focus are read before the server selects any page, over one short DevTools protocol
// session per localhost tab that evaluates document.visibilityState and document.hasFocus() and
// nothing else: the server turns on focus emulation for each page it selects, which makes every
// page read visible and focused while it is connected. No tab off localhost is attached to, by
// the server or by that read.
// Writes, creating <out-dir> if needed, for an element capture:
//   ui-pick.md    the time, the page's URL and route, the snapshot line of the selected element,
//                 its source chain (vite-plugin-vue-inspector's file:line:column, innermost
//                 first, relative to the front end's root) and component chain, its outerHTML
//                 (trimmed to 4000 characters) and every matched CSS rule (get_css_styles)
//   element.png   a screenshot of the element
//   page.png      a screenshot of the page
// and for a page capture:
//   ui-page.md    the time, the page's URL, route and title, why it took that page, the other
//                 localhost tabs, the Vue route (the current route's matched records of the Vue
//                 app mounted on the page, outermost first, each its path, name, component and
//                 file; "(no Vue router found)" on a page without one) and the files
//   page.png      a screenshot of the viewport, unless the tab is not visible: Chrome paints no
//                 hidden tab, so a screenshot of it never comes, and ui-page.md says so
//   page-snapshot.txt  the page's accessibility snapshot (take_snapshot)
// Of those five names, a capture removes the ones it did not write once it has written its own;
// a failed capture writes and removes nothing.
// It speaks MCP to the pinned chrome-devtools-mcp (servers/, installed by servers/install),
// attached to the Agent Chrome with an allowlist of http://localhost:*/*, http://127.0.0.1:*/*
// and DevTools' own frontend (devtools://devtools/*, where the selection is read; without it
// the server waits forever), so it never lists or reads another page, and with Google's usage
// statistics, CrUX and update checks off. It never navigates, clicks or types.
// The element is the one DevTools marks in the page's snapshot ("selected in the DevTools
// Elements panel"); one outside the accessibility tree is found in a verbose snapshot.
// Exit 0 captured, its one line on stdout naming the element or the page; 1 with one line on
// stderr when no Agent Chrome answers, the Agent Chrome has no localhost page open, the element
// carries no Vue source data (a production build, or a Vue DevTools without the inspector), the
// server never attached to an open tab, or a page does not answer in 30 s (a busy machine can
// cause either); 2 a malformed command line.
import { mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { setTimeout } from "node:timers/promises";
import { fileURLToPath } from "node:url";

const code = resolve(dirname(fileURLToPath(import.meta.url)), "..", "..", "..");
const modules = join(code, "servers", "node_modules");
const server = join(modules, "chrome-devtools-mcp", "build", "src", "bin", "chrome-devtools-mcp.js");
// The localhost pages, and DevTools' own frontend, which the server reads the Elements panel's
// selection from; it lists DevTools windows as pages only with --experimentalDevtools, never set.
const allowed = ["http://localhost:*/*", "http://127.0.0.1:*/*", "devtools://devtools/*"];
const htmlLimit = 4000;

const fail = (reason, status = 1) => {
  process.stderr.write(`ui-capture: ${reason}\n`);
  process.exit(status);
};
const usage = "usage: ui-capture [--browser-url <url>] <out-dir>";

// The header above, without the comment marks, is the --help.
function help() {
  const header = [];
  for (const line of readFileSync(fileURLToPath(import.meta.url), "utf8").split("\n").slice(1)) {
    if (!line.startsWith("//")) break;
    header.push(line.replace(/^\/\/ ?/, ""));
  }
  process.stdout.write(`${header.join("\n")}\n`);
  process.exit(0);
}

let browserUrl = "http://127.0.0.1:9222";
let out;
const args = process.argv.slice(2);
for (let i = 0; i < args.length; i++) {
  if (args[i] === "--help" || args[i] === "-h") help();
  else if (args[i] === "--browser-url" && i + 1 < args.length) browserUrl = args[++i];
  else if (!args[i].startsWith("-") && out === undefined) out = args[i];
  else fail(usage, 2);
}
if (out === undefined) fail(usage, 2);
if (!/^http:\/\/(127\.0\.0\.1|localhost):\d+\/?$/.test(browserUrl)) {
  fail(`--browser-url must be http://127.0.0.1:<port> or http://localhost:<port>, not ${browserUrl}`, 2);
}

// The Agent Chrome answers before the server is started, so its absence is one plain line.
try {
  const response = await fetch(new URL("/json/version", browserUrl), { signal: AbortSignal.timeout(5000) });
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
} catch {
  fail(`no Agent Chrome answers at ${browserUrl}; start it with toolkits/frontend/scripts/agent-chrome`);
}

let Client, StdioClientTransport;
try {
  ({ Client } = await import(join(modules, "@modelcontextprotocol", "sdk", "dist", "esm", "client", "index.js")));
  ({ StdioClientTransport } = await import(join(modules, "@modelcontextprotocol", "sdk", "dist", "esm", "client", "stdio.js")));
} catch {
  fail("the pinned MCP client and server are not installed: run servers/install");
}

// A connection to a new chrome-devtools-mcp process attached to the Agent Chrome.
let client;
async function connect() {
  client = new Client({ name: "ui-capture", version: "1" });
  try {
    await client.connect(
      new StdioClientTransport({
        command: process.execPath,
        args: [
          server,
          `--browser-url=${browserUrl}`,
          "--allowedUrlPattern", ...allowed,
          "--no-usage-statistics",
          "--no-performance-crux",
          "--no-page-id-routing",
        ],
        env: {
          PATH: process.env.PATH ?? "/usr/bin:/bin",
          HOME: process.env.HOME ?? "",
          CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS: "1",
          CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS: "1",
        },
        stderr: "pipe",
      }),
    );
  } catch (error) {
    fail(`chrome-devtools-mcp did not start: ${String(error.message ?? error).split("\n")[0]}`);
  }
}
const done = async (status, reason) => {
  await client.close().catch(() => {});
  if (status) fail(reason, status);
  process.exit(0);
};

// One tool call: its text and images; a tool error ends the capture with its first line. A call
// with no answer in 30 s is a tab whose page does not answer the DevTools protocol, hung or
// starved on a busy machine.
async function call(name, args = {}) {
  let result;
  try {
    result = await client.callTool({ name, arguments: args }, undefined, { timeout: 30_000 });
  } catch (error) {
    const reason = String(error.message ?? error).split("\n")[0];
    if (/timed out/i.test(reason)) {
      await done(1, `${name} got no answer in 30 s: a page of the Agent Chrome does not answer (a busy machine can cause it, or a hung page); reload it, or wait, and try again`);
    }
    await done(1, `${name} failed: ${reason}`);
  }
  const text = result.content.filter((c) => c.type === "text").map((c) => c.text).join("\n");
  if (result.isError) await done(1, `${name} failed: ${text.split("\n")[0]}`);
  return { text, images: result.content.filter((c) => c.type === "image") };
}

await connect();

// list_pages' lines, "<id>: <title> (<url>)" or "<id>: <url>" for a page with no title, each
// maybe followed by " [selected]" and an isolated context: [{ id, url }].
function listedPages(text) {
  return [...text.matchAll(/^(\d+): (.*)$/gm)].map(([, id, rest]) => {
    rest = rest.replace(/( \[selected\])?( isolatedContext=\S+)?$/, "");
    const titled = rest.endsWith(")") ? rest.lastIndexOf(" (") : -1;
    return { id: Number(id), url: titled === -1 ? rest : rest.slice(titled + 2, -1) };
  });
}

// Each localhost page, by its id in list_pages, until one has an element selected: the line its
// snapshot marks as DevTools' selection, in a verbose snapshot when the selection is outside the
// accessibility tree. A page whose snapshot carries that mark or DevTools' "not included" note
// has DevTools open; one whose selection is <body> (DevTools' default when it opens) or <html>,
// or whose mark no snapshot shows, has nothing selected.
const selectedMark = "[selected in the DevTools Elements panel]";
const notInTree = /there is a selected element in the DevTools Elements panel but it is not included/;
// The server lists a tab once it has attached to it, and on a busy machine an attach can be slow,
// or fail and drop the tab for the rest of that connection: until it lists every localhost tab
// the browser itself reports (asked again each time, so a tab that navigates is followed), ask
// again, and twice start a new connection, which attaches anew. Tabs still missing then are named
// in the failure, should no page listed give a capture.
// The browser's own list is the localhost page targets, most recently active first.
const localhost = /^http:\/\/(localhost|127\.0\.0\.1)(:\d+)?\//;
const localTabs = () =>
  fetch(new URL("/json/list", browserUrl), { signal: AbortSignal.timeout(5000) })
    .then((response) => response.json())
    .then((targets) => targets.filter((t) => t.type === "page" && localhost.test(t.url)))
    .catch(() => []);
let pages = [];
let missing = [];
let tabs = [];
listing: for (let connection = 1; ; connection++) {
  for (let attempt = 0; attempt < 30; attempt++) {
    pages = listedPages((await call("list_pages")).text).filter((p) => /^https?:/.test(p.url));
    tabs = await localTabs();
    missing = tabs.map((t) => t.url).filter((url) => !pages.some((p) => p.url === url));
    if (missing.length === 0) break listing;
    await setTimeout(100);
  }
  if (connection === 3) break;
  await client.close().catch(() => {});
  await connect();
}
const unattached = () =>
  `chrome-devtools-mcp never attached to ${missing.join(", ")}, which the Agent Chrome has open (a busy machine can cause it); wait, and try again`;
if (pages.length === 0) await done(1, missing.length ? unattached() : "the Agent Chrome has no localhost page open");

// Whether a localhost tab is visible and its document focused, read over a DevTools protocol
// session of its own: the server's evaluate_script cannot tell, since each page the server selects
// gets focus emulation, under which every page reads visible and focused. Only a page target whose
// URL is a localhost one is attached to; the session evaluates this one fixed expression and
// nothing else, enables no domain, and is closed at once. A tab that does not answer in 5 s is
// unread: neither visible nor focused in the order, but still given a screenshot.
const stateExpression = "({ visible: document.visibilityState === 'visible', focus: document.hasFocus() })";
async function tabState(target) {
  const unread = { visible: null, focus: false };
  if (target.type !== "page" || !localhost.test(target.url) || !/^ws:\/\/(127\.0\.0\.1|localhost)(:\d+)?\//.test(target.webSocketDebuggerUrl ?? "")) return unread;
  const socket = new WebSocket(target.webSocketDebuggerUrl);
  try {
    const answer = await Promise.race([
      new Promise((resolve, reject) => {
        socket.onopen = () => socket.send(JSON.stringify({ id: 1, method: "Runtime.evaluate", params: { expression: stateExpression, returnByValue: true } }));
        socket.onmessage = ({ data }) => {
          const message = JSON.parse(data);
          if (message.id === 1) resolve(message.result?.result?.value);
        };
        socket.onerror = () => reject(new Error("no connection"));
      }),
      setTimeout(5000, undefined, { ref: false }),
    ]);
    return answer ? { visible: answer.visible === true, focus: answer.focus === true } : unread;
  } catch {
    return unread;
  } finally {
    socket.close();
  }
}
// The listed pages in the order steps 2 and 3 choose by: visible first, then focused, then most
// recently active (its URL's place in /json/list); two tabs on one URL keep the server's order.
const states = await Promise.all(tabs.map(async (t) => ({ url: t.url, ...(await tabState(t)) })));
for (const page of pages) {
  const same = states.filter((t) => t.url === page.url);
  page.visible = same.some((t) => t.visible === true) || (same.some((t) => t.visible === false) ? false : null);
  page.focus = same.some((t) => t.focus);
  page.recency = same.length ? states.indexOf(same[0]) : states.length;
}
const order = (a, b) => (b.visible === true) - (a.visible === true) || b.focus - a.focus || a.recency - b.recency;
pages.sort(order);

// A JSON value evaluate_script returned.
const evaluated = (text) => JSON.parse(text.match(/```json\n([\s\S]*?)\n```/)?.[1] ?? "null");
// The element's own facts, read in the page: its route, HTML, and the inspector's source data
// (vite-plugin-vue-inspector keeps "src/...vue:line:column" in each vnode's hidden props).
const elementFacts = async (uid) =>
  evaluated(
    (
      await call("evaluate_script", {
        function: `(el) => {
          const loc = (e) => e?.__vnode?.props?.__v_inspector;
          const source = [];
          for (let e = el; e; e = e.parentElement) if (loc(e)) source.push(e.tagName.toLowerCase() + " " + loc(e));
          const components = [];
          let node = el;
          while (node && !node.__vueParentComponent) node = node.parentElement;
          for (let i = node?.__vueParentComponent; i; i = i.parent) {
            const file = i.type.__file ? i.type.__file.replace(/^.*?\\/(src\\/)/, "$1") : "";
            components.push((i.type.__name || i.type.name || "anonymous") + (file ? " " + file : ""));
          }
          return { tag: el.tagName, route: location.pathname + location.search + location.hash, url: location.href,
            source, components, html: el.outerHTML };
        }`,
        args: [uid],
      })
    ).text,
  );

let pick, inspected;
for (const page of pages) {
  await call("select_page", { pageId: page.id });
  const snapshot = (await call("take_snapshot")).text;
  page.snapshot = snapshot;
  const marked = snapshot.includes(selectedMark)
    ? snapshot
    : notInTree.test(snapshot) ? (await call("take_snapshot", { verbose: true })).text : null;
  if (marked === null) continue;
  const line = marked.split("\n").find((l) => l.includes(selectedMark))?.trim();
  const facts = line && (await elementFacts(line.match(/uid=(\S+)/)[1]));
  if (line && !facts) await done(1, "evaluate_script returned nothing readable for the selected element");
  if (!line || facts.tag === "BODY" || facts.tag === "HTML") {
    inspected ??= page;
    continue;
  }
  pick = { ...page, line, uid: line.match(/uid=(\S+)/)[1], facts };
  break;
}
// A tab the server never attached to may hold the selection, so that comes first.
if (!pick && missing.length) await done(1, unattached());

const fence = (text) => "`".repeat(Math.max(3, ...[...text.matchAll(/`+/g)].map((m) => m[0].length + 1)));
const block = (lang, text) => `${fence(text)}${lang}\n${text}\n${fence(text)}`;
const captured = `Captured ${new Date().toISOString()} by ui-capture from the Agent Chrome at ${browserUrl}.`;
// The five files ui-capture owns in <out-dir>: those a capture does not write are removed once it
// has written its own, so no file of an earlier capture is left beside it; a failure touches none.
const owned = ["ui-page.md", "page.png", "page-snapshot.txt", "ui-pick.md", "element.png"];
const write = (files) => {
  mkdirSync(out, { recursive: true });
  for (const [name, data] of Object.entries(files)) writeFileSync(join(out, name), data);
  for (const name of owned) if (!(name in files)) rmSync(join(out, name), { force: true });
};

if (!pick) {
  // The page capture: nothing is selected, so the page is the one DevTools is open on (step 2),
  // else the first in step 3's order, visible (step 3) or not (step 4). Its facts are read in the
  // page: its route and title, and the matched records of the current route of the Vue 3 app
  // mounted on it (__vue_app__ on its container, which Vue marks data-v-app), when there is one.
  const chosen = inspected ?? pages[0];
  const reason = inspected
    ? "DevTools is open on it, nothing selected"
    : chosen.visible === true ? "the visible localhost tab" : "the most recently active localhost tab; none is visible";
  await call("select_page", { pageId: chosen.id });
  const seen = evaluated(
    (
      await call("evaluate_script", {
        function: `() => {
          let matched;
          try {
            const mounted = (list) => [...list].find((e) => e.__vue_app__)?.__vue_app__;
            const app = mounted(document.querySelectorAll("[data-v-app]")) ?? mounted(document.querySelectorAll("*"));
            matched = app?.config?.globalProperties?.$router?.currentRoute?.value?.matched;
          } catch {}
          const vue = Array.isArray(matched)
            ? matched.map((record) => {
                const c = record?.components?.default;
                return {
                  path: String(record?.path ?? ""),
                  name: record?.name == null ? "" : String(record.name),
                  component: c ? c.__name || c.name || "anonymous" : "",
                  file: c?.__file ? String(c.__file).replace(/^.*?\\/(src\\/)/, "$1") : "",
                };
              })
            : null;
          return { url: location.href, route: location.pathname + location.search + location.hash, title: document.title, vue };
        }`,
      })
    ).text,
  );
  if (!seen) await done(1, "evaluate_script returned nothing readable for the page");
  // A tab read as hidden gets none: Chrome paints no hidden tab, so its screenshot never comes.
  const screenshot = chosen.visible === false ? null : (await call("take_screenshot")).images[0];
  if (chosen.visible !== false && !screenshot) await done(1, "take_screenshot returned no image");
  const others = pages.filter((p) => p.id !== chosen.id).map((p) => p.url);
  const route = (r) => `- ${r.path}${r.name ? ` (${r.name})` : ""}: ${r.component ? r.component + (r.file ? ` ${r.file}` : "") : "(no component)"}`;
  write({
    ...(screenshot && { "page.png": Buffer.from(screenshot.data, "base64") }),
    "page-snapshot.txt": `${chosen.snapshot.replace(/\n*$/, "")}\n`,
    "ui-page.md": [
      "# The page capture",
      "",
      captured,
      `Page: ${seen.url}`,
      `Route: ${seen.route}`,
      `Title: ${seen.title || "(none)"}`,
      "",
      `Taken because: ${reason}`,
      `Other localhost tabs: ${others.length ? others.join(", ") : "none"}`,
      "",
      ...(seen.vue === null
        ? ["Vue route: (no Vue router found)"]
        : seen.vue.length === 0
          ? ["Vue route: (the router matched no route)"]
          : ["Vue route: the current route's matched records, outermost first (path, name, component and file)", "", ...seen.vue.map(route)]),
      "",
      "Files:",
      "",
      screenshot
        ? "- page.png: the viewport, as Daniel sees it"
        : "- no page.png: the tab is not visible, and Chrome paints no hidden tab, so it has no screenshot",
      "- page-snapshot.txt: the page's accessibility snapshot (take_snapshot)",
      "",
    ].join("\n"),
  });
  process.stdout.write(`ui-capture: page ${seen.url} (${reason}), no element selected -> ${join(out, "ui-page.md")}\n`);
  await done(0);
}

// The element capture: the page holding the selection is the one the loop left selected.
const facts = pick.facts;
if (facts.source.length === 0) {
  await done(1, `the page carries no Vue source data (no __v_inspector on ${pick.line.replace(/^uid=\S+ /, "")} or its parents): a production build, or a Vue DevTools without the inspector`);
}

const css = (await call("get_css_styles", { uid: pick.uid, pageSize: 1000 })).text;
const element = (await call("take_screenshot", { uid: pick.uid })).images[0];
const page = (await call("take_screenshot")).images[0];
if (!element || !page) await done(1, "take_screenshot returned no image");

const html = facts.html.length > htmlLimit
  ? `${facts.html.slice(0, htmlLimit)}\n<!-- trimmed: ${facts.html.length} characters in all -->`
  : facts.html;
write({
  "element.png": Buffer.from(element.data, "base64"),
  "page.png": Buffer.from(page.data, "base64"),
  "ui-pick.md": [
    "# The selected element",
    "",
    captured,
    `Page: ${facts.url}`,
    `Route: ${facts.route}`,
    "",
    "## Where it is",
    "",
    `Snapshot line: \`${pick.line}\``,
    "",
    "Source, innermost first (vite-plugin-vue-inspector, relative to the front end's root):",
    "",
    ...facts.source.map((s) => `- ${s}`),
    "",
    "Components, innermost first:",
    "",
    ...(facts.components.length ? facts.components.map((c) => `- ${c}`) : ["- (none found)"]),
    "",
    "## HTML",
    "",
    block("html", html),
    "",
    "## Matched CSS",
    "",
    "Every rule that matches it, in cascade order, overridden declarations marked [overloaded] (get_css_styles).",
    "In the dev server a rule's location is the injected style tag; the scoped attribute and the source chain above name the file.",
    "",
    block("", css),
    "",
    "## Screenshots",
    "",
    "- element.png: the element",
    "- page.png: the page",
    "",
  ].join("\n"),
});
process.stdout.write(`ui-capture: ${pick.line.replace(/^uid=\S+ /, "")} at ${facts.source[0]} -> ${join(out, "ui-pick.md")}\n`);
await done(0);
